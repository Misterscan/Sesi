/**
  Examples for Sesi programming language.
  The examples are organized in a way that makes it easy to explore and understand different aspects of the language.

  Some examples are intentionally excluded from this file because they are intended to be used directly by the user.
*/
allow "lib/ansi" in as TERM
allow "std/time" in with {sleep}

TERM.warning_bg("Enable accessibility features (text-to-speech)? (y/n, default: n)")
// Prompt the user to enable accessibility features (text-to-speech).
let accessibility = input(" ") | trim | to_lower
if is_null(accessibility) || accessibility == "" {accessibility = "n"}
// Accessibility is enabled if the user chose "y".
let enableAccessibility = accessibility == "y"
TERM.reset()

/**
  Example categories and their corresponding file paths.

  Fields:
  - `main`: An array of main example titles.
  - `optional`: An array of optional example titles.
*/
let examples = {
  "main": [
    "Hello, Sesi!",
    "Variables",
    "Functions",
    "Conditionals",
    "Loops",
    "Arrays & Objects",
    "Prompts",
    "Structured Output",
    "Memory Storage",
    "Classification",
    "Data Pipeline + Lazy Summary",
    "Modules",
    "HTTP Client",
    "Parallel Requests + Profiling",
    "Web Search",
    "Custom Tools",
    "File Conversion",
    "HTTP Server",
    "Webpage Server",
    "Database",
    "Robust Web DB",
    "Tool Piping",
    "Error Recovery + Timeout",
    "Synthesizer",
    "Browser Automation",
    "Base64 + Encryption",
    "SesiAPI Server",
    "Speech & Language",
    "Regex & Local Media"
  ],
  "optional": [
    "Model Call",
    "Code Generation",
    "Folder Explainer",
    "Image Generation",
    "Model Aliases",
    "Reasoning + Custom Tools",
    "Streaming",
    "AI Video Generation"
  ]
}

// Main examples.
let main = examples["main"]
// Optional examples.
let optional = examples["optional"]

/**
  All examples and their corresponding commands.

  Fields:
  - `title`: The title of the example.
  - `cmd`: The command to run the example.
  - `optional`: (Optional) A boolean indicating if the example is optional.
*/
let all_examples = [
    {"title": main[0], "cmd": "sesi examples/main/01_hello.sesi"},
    {"title": main[1], "cmd": "sesi examples/main/02_variables.sesi"},
    {"title": main[2], "cmd": "sesi examples/main/03_functions.sesi"},
    {"title": main[3], "cmd": "sesi examples/main/04_conditionals.sesi"},
    {"title": main[4], "cmd": "sesi examples/main/05_loops.sesi"},
    {"title": main[5], "cmd": "sesi examples/main/06_arrays_objects.sesi"},
    {"title": main[6], "cmd": "sesi examples/main/07_prompts.sesi"},
    {"title": optional[0], "cmd": "sesi examples/optional/08_model_call.sesi", "optional": true},
    {"title": main[7], "cmd": "sesi examples/main/09_structured_output.sesi"},
    {"title": optional[1], "cmd": "sesi examples/optional/10_code_generation.sesi", "optional": true},
    {"title": main[8], "cmd": "sesi examples/main/11_memory_storage.sesi"},
    {"title": main[9], "cmd": "sesi examples/main/12_classification.sesi"},
    {"title": main[10], "cmd": "sesi examples/main/13_data_pipeline.sesi"},
    {"title": optional[2], "cmd": "sesi examples/optional/14_folder_explainer.sesi", "optional": true},
    {"title": optional[3], "cmd": "sesi examples/optional/15_image_generation.sesi", "optional": true},
    {"title": main[11], "cmd": "sesi examples/main/16_modules.sesi"},
    {"title": main[12], "cmd": "sesi examples/main/17_http_client.sesi"},
    {"title": main[13], "cmd": "sesi examples/main/18_parallel_requests.sesi"},
    {"title": main[14], "cmd": "sesi examples/main/19_search_web.sesi"},
    {"title": optional[4], "cmd": "sesi examples/optional/20_model_aliases.sesi", "optional": true},
    {"title": main[15], "cmd": "sesi examples/main/21_custom_tools.sesi"},
    {"title": optional[5], "cmd": "sesi examples/optional/22_reasoning_plus_custom_tools.sesi", "optional": true},
    {"title": main[16], "cmd": "sesi examples/main/23_file_conversion.sesi"},
    {"title": main[17], "cmd": "sesi examples/main/24_http_server.sesi -l"},
    {"title": main[18], "cmd": "sesi examples/main/25_webpage_server.sesi -l"},
    {"title": main[19], "cmd": "sesi examples/main/26_database.sesi -l"},
    {"title": main[20], "cmd": "sesi examples/main/27_robust_web_db.sesi -l"},
    {"title": optional[6], "cmd": "sesi examples/optional/28_streaming.sesi", "optional": true},
    {"title": main[21], "cmd": "sesi examples/main/29_tool_piping.sesi"},
    {"title": main[22], "cmd": "sesi examples/main/30_error_recovery.sesi"},
    {"title": main[23], "cmd": "sesi examples/main/31_synthesizer.sesi"},
    {"title": main[24], "cmd": "sesi examples/main/32_browser_automation.sesi -l"},
    {"title": main[25], "cmd": "sesi examples/main/33_base64.sesi"},
    {"title": main[26], "cmd": "sesi examples/main/34_sesi_api.sesi -l"},
    {"title": main[27], "cmd": "sesi examples/main/35_speech_language.sesi"},
    {"title": main[28], "cmd": "sesi examples/main/36_regex_media.sesi -l"},
    {"title": optional[7], "cmd": "sesi examples/optional/37_ai_video_generation.sesi", "optional": true}
]

// Message indicating that the script is launching example files.
let launchTag = "Launching example files."
// Message prompting the user to press enter to continue, skip, or exit.
let enterTag = "Press enter to continue, type 'skip' to move on or type 'exit' to quit."
// Message indicating that the script is ending early.
let exitTag = "Ending script early."
// Message indicating that the current example is being skipped.
let skipTag = "Skipping."
// Message indicating that image generation may take a while.
let imageTag = "Image generation example may take a while. Bear with us!"
// Message indicating that AI video generation may take a while and can be expensive.
let videoTag = "AI video generation may take a while and can be expensive."
// Message indicating all examples have been completed.
let doneTag = "All done!"
// Error message prefix for handling exceptions.
let errorTag = "We're sorry but an error occurred: "

try {
    TERM.header("Sesi Example Launcher")
    sleep(500)
    TERM.badge("MODE", "Interactive examples", "brightMagenta")
    sleep(500)
    TERM.key_value("Available examples", all_examples | len | str)
    sleep(500)
    TERM.table(["Type", "Count"],
    [["Main", main | len | str],
    ["Optional", optional | len | str]],
    [15, 10])
    sleep(500)
    TERM.box("Optional examples may require API keys or take longer to run.")
    sleep(1000)
    TERM.newline()
    TERM.info_bg(launchTag)
    TERM.newline()
    if enableAccessibility {
        speech(launchTag)
        speech(enterTag)
    }
    for i = 0 to len(all_examples) {
        // Current example object.
        let ex = all_examples[i]
        let step = str(i + 1) + "/" + (all_examples | len | str)
        // Current example's title and step number.
        let title_tag = "[" + step + "] [" + ex["title"] + "]"

        if i > 0 {
            // Prompt the user to continue, skip, or exit before running the current example.
            let prompt_text = title_tag + " Press enter to continue (or type 'skip' to bypass, 'exit' to quit)...\n"
            if ex["optional"] == true {
                prompt_text = title_tag + " (OPTIONAL) Press enter to continue (or type 'skip' to bypass, 'exit' to quit)...\n"
            }
            let ans = input(prompt_text)
            if ans == "exit" {
                TERM.warning_bg(exitTag)
                if enableAccessibility {
                    speech(exitTag)
                }
                break
            } else if ans == "skip" {
                TERM.warning_bg("Skipped " + ex["title"])
                TERM.newline()
                if enableAccessibility {
                    speech(skipTag)
                }
                continue
            }
        } else {
            show title_tag
        }

        if ex["cmd"] == "sesi examples/optional/15_image_generation.sesi" {
            TERM.info_bg(imageTag)
            TERM.newline()
            if enableAccessibility {
                speech(imageTag)
            }
        }

        if ex["cmd"] == "sesi examples/optional/37_ai_video_generation.sesi" {
            TERM.warning_bg(videoTag)
            let continueInput = TERM.ask("Continue? (y/n)")
            if (continueInput | to_lower | trim) != "y" {
                TERM.warning_bg("Skipped " + ex["title"])
                TERM.newline()
                if enableAccessibility {
                    speech(skipTag)
                }
                continue
            }
            if enableAccessibility {
                speech(videoTag)
            }
        }

        let parts = split(ex["cmd"], " ")
        let local = contains(ex["cmd"], " -l")
        show sesi(parts[1], local)
    }
    TERM.success_bg("All done! No errors means Sesi is ready!")
    if enableAccessibility {
        speech(doneTag)
    }
} catch (error) {
    TERM.error_bg(errorTag + error.message)
    if enableAccessibility {
        speech(errorTag + error.message)
    }
}