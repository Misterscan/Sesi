/*
    test-runner.sesi
    A lightweight test-runner framework for modular Sesi scripts.
    Includes beautiful custom color logs, assertion utilities, and final test suite counters.
*/
allow "lib/ansi" in as TERM

/**
  Asserts if two values are equal and shows a colored PASS/FAIL message.

  Parameters:
  - actual: The actual value to be tested.
  - expected: The expected value to compare against.
  - testName: A descriptive name for the test case.

  Returns:
  true if the assertion passes, false otherwise.
*/
export fn assert_equals(actual, expected, testName: string) {
  if actual == expected {
    TERM.success("PASS:" + testName)
    return true
  } else {
    TERM.error("FAIL:" + testName) 
    TERM.info("  -> Expected:" expected)
    TERM.info("  -> Actual:" actual)
    return false
  }
}

/**
  Asserts if a value is not null and shows a colored PASS/FAIL message.

  Parameters:
  - val: The value to be tested.
  - testName: A descriptive name for the test case.

  Returns:
  true if the assertion passes, false otherwise.
*/
export fn assert_not_null(val, testName: string) {
  if val == null {
    TERM.error("FAIL:" + testName + " (Value is null)")
    return false
  } else {
    TERM.success("PASS:" + testName)
    return true
  }
}

/**
  Runs a test suite and shows a colored summary.

  Parameters:
  - suiteName: The name of the test suite.
  - results: An array of boolean test results.

  Returns:
  true if all tests pass, false otherwise.
*/
export fn run_test_suite(suiteName: string, results: array) {
  TERM.header("   TEST SUITE RUNNER:" + suiteName)
  
  let passed = 0
  let failed = 0
  
  for res in results {
    if res == true {
      passed = passed + 1
    } else {
      failed = failed + 1
    }
  }
  
  TERM.divider("-", 40)
  TERM.info("📊 Final Summary:")
  TERM.info("   Passed:" passed)
  TERM.info("   Failed:" failed)
  
  if failed == 0 {
    TERM.success("ALL TESTS PASSED SUCCESSFULLY!")
  } else {
    TERM.warning("SOME TESTS FAILED. PLEASE AUDIT SPECIFICATIONS.")
  }
  TERM.divider("=", 40)
  
  if failed == 0 {
    return true
  }
  return false
}

export fn test_runner() {
  let tool_refs = {}

  fn register_tool(name: string, func, desc: string) {
    define_tool(name, func, desc)
    tool_refs[name] = desc
  }

  register_tool("assert_equals", assert_equals, "Asserts if two values are equal, shows colored PASS/FAIL")
  register_tool("assert_not_null", assert_not_null, "Asserts if a value is not null, shows colored PASS/FAIL")
  register_tool("run_test_suite", run_test_suite, "Runs a test suite and shows a colored summary")
  register_tool("test_runner", test_runner, "Returns a map of all test runner tools")

  let _registry = list_tools()
  TERM.info("📦 test-runner tool registry loaded —" + str(len(_registry)) + " tools available")
  TERM.info(to_json(tool_refs))
}

test_runner()