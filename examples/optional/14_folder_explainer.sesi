// Example 14: Folder Explainer using native list_dir
allow "helpers/safe" in with {isEmpty, getFiles, read, md}

let targetDir = "docs"
let files = []

if targetDir | isEmpty {
    show "Error: Could not list directory" targetDir
} else {
    files = targetDir | getFiles
    show "Analyzing directory:" targetDir
}
show "Files found in directory:" files | length

let reports = []

fn analyzeFile(fullPath: string) -> object {
    try  {
        let source = fullPath | read
        return structured_output({fileName: string, summary: string, complexity: string})(model("gemini-3.1-flash-lite") {temperature: 0.2, cache: false} {"
        Analyze this file and summarize its purpose.
        Return JSON with fileName, summary, and complexity (low/medium/high).
        File path: " fullPath " Contents: " source})
    } catch (e) {
        return {"fileName": fullPath, "summary": "Failed to read or analyze file", "complexity": "unknown"}
    }
}

 for file in files {
    let fullPath = targetDir + "/" + file
    let parts = file | split(".")
    if (parts | length) > 1 {
        let ext = parts[(parts | length) - 1]
        if ext == "md" {
            show "Analyzing:" fullPath
            let report = fullPath | analyzeFile
            reports | push(report)
            show "Summary:" report["summary"]
            show "Complexity:" report["complexity"]
            }
        }
    }

show "Generating folder overview..."
let folderSummary = structured_output({folderOverview: string, keyThemes: array<string>})(model("gemini-3.1-flash-lite") {temperature: 0.2, cache: false} {"
You are summarizing the contents of a documentation folder based on file analyses.
Return JSON with folderOverview and keyThemes.
Analysis:
"reports})

show "=== Final Folder Summary ==="
show "Overview:" folderSummary["folderOverview"]
show "Key Themes:" folderSummary["keyThemes"] | join(", ")

let overview = folderSummary["folderOverview"]
let themesStr = folderSummary["keyThemes"] | join(", ")

prompt mdBase {"# Folder Analysis Report

## Overview
"overview"

## Key Themes
"themesStr"

## File Details
"}

let finalMarkdown = mdBase

for report in reports {
    let fname = report["fileName"]
    let fsummary = report["summary"]
    let comp = report["complexity"]

    prompt fileEntry {"### " fname "
 **Complexity**: " comp "

 **Summary**: " fsummary "

    "}

    finalMarkdown = finalMarkdown + fileEntry
    let outPath = "folder_analysis"
    try {
        outPath | md(finalMarkdown)
        show "Wrote analysis to" outPath
    } catch (e) {
        show "Error writing file:" e
    }
}