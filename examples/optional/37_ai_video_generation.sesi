/*
  AI Video Generation

  Requires GEMINI_API_KEY and writes the returned Base64 MP4 data to disk:

      sesi --cli -l examples/optional/37_ai_video_generation.sesi

      Video generation can be expensive and may take a while. 
    You can use the "gemini-omni-flash-preview" model for fast previews, or the "veo-3.1-generate-preview" model for higher quality videos with audio.
*/

let outputDir = "generated_media/"
if list_dir(outputDir) == null {
    outputDir | make_dir
}

let promptText = "A tiny glass robot walks through a rain-soaked neon garden, cinematic tracking shot"
let outputPath = outputDir + "ai-video.mp4"

// Gemini Omni Flash is the default choice for fast text-to-video generation.
let clip = video("gemini-omni-flash-preview") {ratio: "16:9"} {promptText}
try {
    outputPath | write_file(clip, "base64")
    print "Saved generated video to" outputPath
} catch (e) {
    print "Error saving video:" e
}

/*
  Veo 3.1 uses the same Sesi expression shape and supports additional controls:

  let veoClip = video("veo-3.1-generate-preview") {ratio: "16:9", duration: 8, resolution: "1080p", audio: true} {promptText}
  try {
    write_file(outputDir + "/veo-video.mp4", veoClip, "base64")
    print "Saved Veo generated video to" outputDir + "/veo-video.mp4"
  } catch (e) {
    print "Error saving Veo video:" e
  }
*/
