/*
  AI Video Generation

  Requires GEMINI_API_KEY and writes the returned Base64 MP4 data to disk:

      sesi -l examples/optional/37_ai_video_generation.sesi

      Video generation can be expensive and may take a while. 
      Use a Gemini Omni video model. Veo generation is no longer supported.
*/
allow "helpers/safe" in as Safe

let outputDir = "generated_media/"
if !(outputDir | Safe.isFolder) {
    outputDir | Safe.makeFolder
}

let promptText = "A tiny glass robot walks through a rain-soaked neon garden, cinematic tracking shot"
let outputPath = outputDir + "ai-video.mp4"

// Gemini Omni Flash is the default choice for fast text-to-video generation.
let clip = video("gemini-omni-1.1-flash") {ratio: "16:9"} {promptText}
try {
    outputPath | Safe.saveMedia(clip)
    show "Saved generated video to" outputPath
} catch (e) {
    show "Error saving video:" e
}
