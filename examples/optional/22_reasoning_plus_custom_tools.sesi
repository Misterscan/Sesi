/*
    Example 22: Reasoning + Custom Tools
    Demonstrates automatic model function calling with registered Sesi tools.
*/

let fast = "fast"
fast | set_alias("gemini-3.1-flash-lite")

fn toBullet(text: string) -> string  {
    return "- " + text
}

fn addTag(text: string) -> string {
    return text + " [ready]"
}

define_tool("to_bullet", toBullet, "Convert text to bullet format")
define_tool("add_tag", addTag, "Append release tag")

let result = model(fast) {tools: list_tools(), max_tool_calls: 4, max_tokens: 180, cache: false} {"Write one concise launch note for model aliases and custom tools. Use to_bullet first, then add_tag. Return only the final processed note."}

show "Automatically orchestrated output:
" result