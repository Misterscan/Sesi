/*
  Regex and Local Media Builtins

  Demonstrates regex(), gif(), video(), and ffmpeg(). Run with local mode:
      sesi -l examples/main/36_regex_media.sesi

  FFmpeg must be installed and available in PATH.
*/
allow "std/draw" in as Draw
allow "helpers/safe" in as Safe

show "--- Regex ---"

let source = "draft-17, Draft-23; release-42"
let words = "[A-Za-z]+" | regex(source, {"flags": "g", "mode": "match"})
let hasRelease = "release-[0-9]+" | regex(source, {"flags": "i", "mode": "test"})
let renamed = "draft" | regex(source, {"flags": "gi", "mode": "replace", "replacement": "build"})
let fields = "[,;]" | regex(source, {"mode": "split"})

show "Matches:" words
show "Contains a release:" hasRelease
show "Replaced:" renamed
show "Split fields:" fields

show "\n--- Pixel frames ---"

let outputDir = "generated_media/"
if !(outputDir | Safe.isFolder) {
    outputDir | Safe.makeFolder
}

let palette = {
    ".": "#111827",
    "C": "#22d3ee",
    "P": "#f472b6"
}

let frame1 = [
    "C.......",
    ".C......",
    "..C.....",
    "...C....",
    "....C...",
    ".....C..",
    "......C.",
    ".......C"
]

let frame2 = [
    ".......P",
    "......P.",
    ".....P..",
    "....P...",
    "...P....",
    "..P.....",
    ".P......",
    "P......."
]

Draw.clear()
frame1 | Draw.pixel_grid(palette, 16)
outputDir + "frame-1.png" | Draw.save_png(128, 128)

Draw.clear()
frame2 | Draw.pixel_grid(palette, 16)
outputDir + "frame-2.png" | Draw.save_png(128, 128)

let frames = [outputDir + "frame-1.png", outputDir + "frame-2.png"]

show "\n--- GIF and video ---"

let gifPath = outputDir + "pixel-motion.gif"
let videoPath = outputDir + "pixel-motion.mp4"
try {
    frames | gif(gifPath, {"fps": 2, "width": 128, "loop": 0})
    frames | video(videoPath, {"fps": 2, "width": 128, "height": 128, "preset": "ultrafast"})

    show "Saved GIF:" gifPath
    show "Saved video:" videoPath
} catch (e) {
    show "Error generating GIF or video:" e
}

show "\n--- Raw FFmpeg ---"

let ffmpegInfo = ""
try {
    ffmpegInfo = ["-version"] | ffmpeg({"throw_on_error": false})
    show "FFmpeg available:" ffmpegInfo.ok
    show "FFmpeg exit code:" ffmpegInfo.code
} catch (e) {
    show "Error running FFmpeg:" e
}