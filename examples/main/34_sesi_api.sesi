/*
  Example 34: SesiAPI — FastAPI-style HTTP framework with auto docs

  Starts a REST API, fires test requests, then shuts down.
  Routes:
    GET  /users          → list all users
    POST /users          → create a user
    GET  /users/{id}     → get user by ID
    DELETE /users/{id}   → delete user
    GET  /health         → health check
    GET  /docs           → Swagger UI (auto-generated)
    GET  /openapi.json   → OpenAPI 3.1 spec (auto-generated)

  Usage:
    sesi examples/main/34_sesi_api.sesi -l
*/
allow "std/api" in as API

// In-memory store (no file dependency so example is self-contained)
let store = []
let nextId = 1

fn listUsers(req) {
  return {"status": 200, "body": {"users": store, "total": len(store)}}
}

fn createUser(req) {
  let data = req.body | from_json
  let user = {"id": str(nextId), "name": data.name, "email": data.email}
  nextId = nextId + 1
  store | push(user)
  return {"status": 201, "body": user}
}

fn getUser(req) {
  let userId = req.params.id
  let found = null
  for u in store {
    if u.id == userId {
      found = u
    }
  }
  if found == null {
    return {"status": 404, "body": {"detail": "User not found"}}
  }
  return {"status": 200, "body": found}
}

fn deleteUser(req) {
  let userId = req.params.id
  let kept = []
  for u in store {
    if u.id != userId {
      kept | push(u)
    }
  }
  store = kept
  return {"status": 204, "body": null}
}

fn healthCheck(req) {
  return {"status": 200, "body": {"status": "ok"}}
}

let app = ({
  "title": "Users API",
  "version": "1.0.0",
  "description": "A simple user management API built with Sesi"
}) | API.create_app

"/users" | app.get({
  "summary": "List users",
  "tags": ["Users"],
  "response": {"users": "array", "total": "number"}
}, listUsers)

"/users" | app.post({
  "summary": "Create user",
  "tags": ["Users"],
  "body": {"name": "string", "email": "string"},
  "response": {"id": "string", "name": "string", "email": "string"}
}, createUser)

"/users/{id}" | app.get({
  "summary": "Get user",
  "tags": ["Users"],
  "response": {"id": "string", "name": "string", "email": "string"}
}, getUser)

"/users/{id}" | app.delete({
  "summary": "Delete user",
  "tags": ["Users"]
}, deleteUser)

"/health" | app.get({
  "summary": "Health check",
  "tags": ["System"],
  "response": {"status": "string"}
}, healthCheck)

let server = 8080 | app.listen

try {
  let health = "http://localhost:8080/health" | web_get
  show "Health:        " health
} catch (error) {
  show "Health check failed:" error
}

try {
  let created = "http://localhost:8080/users" | web_send({"name": "Alice", "email": "alice@example.com"})
  show "POST /users:   " created
} catch (error) {
  show "Create user failed:" error
}

try {
  let list = "http://localhost:8080/users" | web_get
  show "GET /users:    " list
} catch (error) {
  show "List users failed:" error
}

try {
  let specRaw = "http://localhost:8080/openapi.json" | web_get
  let spec = specRaw | from_json
  show "OpenAPI title: " spec.info.title
  show "Paths:         " spec.paths | keys | join(", ")
} catch (error) {
  show "Fetch OpenAPI spec failed:" error
}

try {
  let docsHtml = "http://localhost:8080/docs" | web_get
  show "GET /docs HTML starts with: " docsHtml | trunc(15)
} catch (error) {
  show "Fetch /docs failed:" error
}

// 422 on missing required field
try {
  let badReq = "http://localhost:8080/users" | web_send({"name": "Bob"})
  show "Missing email: " badReq
} catch (error) {
  show "Missing email request failed:" error
}

let end = "Press enter to close the server and exit..." | input
server.close(end)