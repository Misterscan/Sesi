allow "lib/ansi" in as TERM

try {
    let geminiKey = $GEMINI_API_KEY // or GEMINI_API_KEY | env
    let isSafeMode = $SESI_SAFE_MODE // or SESI_SAFE_MODE | env
    let sesiPass = $SESI_PASSWORD // or SESI_PASSWORD | env

    TERM.badge("Gemini API Key (encrypted)", ": " + geminiKey)
    TERM.badge("Sesi Safe Mode ?", ": " + isSafeMode)
    TERM.badge("Sesi Password", ": " + sesiPass)
} catch (e) {
    TERM.warning("Environment variables could not be read.")
    TERM.error(str(e))
}