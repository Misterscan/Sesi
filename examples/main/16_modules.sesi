/* 
    Example 16: Modules and Scoped Lib Support

Demonstrates:
    1. Allowing access to variables/functions from standard library modules using allow.
    2. Allowing access to modules into scoped library namespaces using allow.
    3. Allowing access to custom Sesi modules using relative paths. 
*/
allow "std/terminal" in with { color }

show color("=== 1. Standard Math Module ===", "magenta")

allow "std/math" in as Math

show color("PI constant:", "cyan") str(Math.PI)
show "Euler's number:" str(Math.E)
show "Square root of 144:" str(Math.sqrt(144))
// or 144 | Math.sqrt
show "2 raised to power of 10:" str(Math.pow(2, 10))
// or 2 | Math.pow(10)
show "Sine of PI/2:" str(Math.sin(Math.PI / 2.0))
// or (Math.PI / 2.0) | Math.sin

show "=== 2. Scoped Lib Scoping ==="
allow "std/math" in as Math

show "Area of circle with radius 5 (using Math lib namespace):" str(Math.PI * Math.pow(5, 2))
// or 5 | Math.pow(2) * Math.PI

show "=== 3. Built-in JSON Conversion ==="
// "std/json" has been deprecated in favor of built-in to_json and from_json functions.
let original = {"project": "Sesi Language", "version": "1.8.6", "features": ["modules", "http", "parallel"]}
let json_str = to_json(original)
show "Serialized JSON string:"
show json_str
let restored = from_json(json_str)
show "Deserialized Project Name:" restored["project"]
show "Deserialized Version:" restored["version"]

show "=== 4. Custom Sesi Module ==="

/* Relative imports let you reuse Sesi code across files cleanly.
We will import custom exported variables and functions from a local module. */
allow "main/tests/temp_math_mod" in as LocalMath

show "Imported magic number from local module:" str(LocalMath.magic_number)
show "Running imported multiply(5, 5):" str(LocalMath.multiply(5, 5))
// or 5 | LocalMath.multiply(5)

show "=== 5. Third-Party Modules & Sesi Packages ==="

/* Sesi supports downloading and importing third-party packages from Git.
To install a package, run:
    sesi install owner/repo#ref
The package will be installed in `sesi_modules/repo`.
You can then import it like standard local modules:

allow "repo" in as MyRepo
*/
