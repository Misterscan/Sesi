// Functions
allow "std/terminal" in with { color }

fn add(a: number, b: number) -> number {show color(str(a + b), "green")}
fn greet(name: string = "World") -> string {show color("Hello " + name + "!", "cyan")}

add(5, 3) // or 5 | add(3)
greet()
greet("Alice") // or "Alice" | greet

// Advanced Functions
fn calculate(operation: string, a: number, b: number) -> any {
    if operation == "add" {
        show color(str(a + b), "green")
    } else if operation == "subtract" {
        show a - b
    } else if operation == "multiply" {
        show a * b
    } else if operation == "divide" {
        show a / b
    } else {
        show "Invalid operation"
    }
}

calculate("multiply", 5, 3) // or "multiply" | calculate(5, 3)

// Define your functions and call it using a custom tool
fn getSesi() -> string {
    return "1.8.6"
}

define_tool("get-sesi", getSesi, "Get the current Sesi version")
let v = tool_call(getSesi)() // or simply getSesi() since tool_call is optional for direct calls

show "Current version:" v

/*
    This section demonstrates the use of Sesi's built-in array functions:
    1. map: Transform elements of an array.
    2. filter: Select elements of an array based on a condition.
    3. reduce: Accumulate elements of an array.
    4. find: Find the first element matching a condition.

    And string functions:
    1. to_upper: Convert string to uppercase.
    2. to_lower: Convert string to lowercase.
    3. trim: Trim leading and trailing whitespace.
    4. slice: Extract a substring or sub-array.
    5. swap: Global string replacement.
    6. contains: Check if a string contains a substring.
    7. locate: Find the first index of a substring (-1 if not found).
    8. trunc: Truncate numbers to integers or trim strings to length.
*/
let numbers = [1, 2, 3, 4, 5, 6]
show "Initial numbers:" numbers

/*
  1. map(array, callback)
  Transform each number to its square
*/
fn square(x: number) -> number {
  return x * x
}
let squares = map(numbers, square) // or simply numbers | map(square)
show "Squares (map):" squares

/*
  2. filter(array, callback)
  Filter for even numbers
*/
fn isEven(x: number) -> bool {
  return x % 2 == 0
}
let evens = filter(numbers, isEven) // or simply numbers | filter(isEven)
show "Evens (filter):" evens

/*
  3. reduce(array, callback, initialValue)
  Sum all numbers with no initial value
*/
fn sum(accumulator: number, x: number) -> number {
  return accumulator + x
}
let totalSum = reduce(numbers, sum) // or simply numbers | reduce(sum)
show "Total Sum (reduce):" totalSum

// Product of all numbers starting with initial value of 10
fn multiply(accumulator: number, x: number) -> number {
  return accumulator * x
}
let product = reduce(numbers, multiply, 10) // or simply numbers | reduce(multiply, 10)
show "Product starting with 10 (reduce):" product

/*
  4. find(array, callback)
  Find the first number greater than 4
*/
fn greaterThanFour(x: number) -> number {
  return x > 4
}
let match = find(numbers, greaterThanFour) // or simply numbers | find(greaterThanFour)
show "First match > 4 (find):" match

// String functions

let original = "  Hello, Sesi V1.8.6!  "
show "Original string:" original

// 1. to_upper(string)
let shouted = to_upper(original) // or simply original | to_upper
show "Uppercase:" shouted

// 2. to_lower(string)
let whispered = to_lower(original) // or simply original | to_lower
show "Lowercase:" whispered

// 3. trim(string)
let cleaned = trim(original) // or simply original | trim
show "Trimmed:" cleaned

/*
    4. slice(collection, start, end = null)
    Slicing a string
*/
let part = slice(cleaned, 7, 11) // or simply cleaned | slice(7, 11) // "Sesi"
show "Sliced string (index 7 to 11):" part


// Slicing an array
let arr = [10, 20, 30, 40, 50]
let subArr = slice(arr, 1, 4) // or simply arr | slice(1, 4) // [20, 30, 40]
show "Original array:" arr
show "Sliced array (index 1 to 4):" subArr

/*
    5. swap(string, target, replacement)
    Global replacement of characters
*/
let replaced = swap(cleaned, " ", "_") // or simply cleaned | swap(" ", "_")
show "Replaced spaces with underscores:" replaced

// 6. contains(string, sub)
let hasVersion = contains(cleaned, "V1.8.6") // or simply cleaned | contains("V1.8.6")
show "Contains 'V1.8.6':" hasVersion

// 7. locate(string, sub)
let idx = locate(cleaned, "Sesi") // or simply cleaned | locate("Sesi")
show "Index of 'Sesi':" idx

// 8. trunc(value, length)
/*
    Truncate a float to an integer or truncate a string to a specified length.
    If the second argument is omitted, it defaults to truncating to an integer for numbers or the full length for strings.
*/
show "Truncate float (45.89):" trunc(45.89)
// or simply 45.89 | trunc
show "Truncate string to length 4:" trunc(cleaned, 4)
// or simply cleaned | trunc(4)

show "\n--- New String Functions ---"
/*
    1. length(string): Returns the length of the string.
    2. starts_with(string, prefix): Checks if the string starts with the given prefix.
    3. ends_with(string, suffix): Checks if the string ends with the given suffix.
    4. index_of(string, sub): Returns the index of the first occurrence of sub in string, or -1 if not found.
    5. repeat(string, count): Repeats the string count times.
*/
show "length('hello'):" length("hello")
// or simply "hello" | length
show "starts_with('hello', 'he'):" starts_with("hello", "he")
// or simply "hello" | starts_with("he")
show "ends_with('hello', 'lo'):" ends_with("hello", "lo")
// or simply "hello" | ends_with("lo")
show "index_of('hello', 'l'):" index_of("hello", "l")
// or simply "hello" | index_of("l")
show "repeat('a', 3):" repeat("a", 3)
// or simply "a" | repeat(3)

show "\n--- New Array Functions ---"
/*
    1. includes(array, value): Checks if the array includes the given value.
    2. reverse(array): Reverses the order of elements in the array.
    3. sort(array): Sorts the array in ascending order.
    4. unique(array): Returns a new array with unique elements.
    5. flatten(array): Flattens a nested array into a single-level array.
    6. append(array, value): Appends a value to the end of the array.
*/
let myArr = [3, 1, 4, 1, 5, 9]
show "Original array:" myArr
show "includes(myArr, 4):" includes(myArr, 4)
// or simply myArr | includes(4)
show "reverse(myArr):" reverse(myArr)
// or simply myArr | reverse
show "sort(myArr):" sort(myArr)
// or simply myArr | sort
show "unique(myArr):" unique(myArr)
// or simply myArr | unique
show "flatten([[1, 2], [3, 4]]):" flatten([[1, 2], [3, 4]])
// or simply [[1, 2], [3, 4]] | flatten
show "append(myArr, 2):" append(myArr, 2)
// or simply myArr | append(2)

show "\n--- Function Introspection ---"
/*
    1. name(func): Returns the name of the function.
    2. arity(func): Returns the number of parameters the function expects.
    3. is_function(value): Checks if the value is a function.
*/
fn sample_func(a: number, b: number) -> number { return a + b }
show "name(sample_func):" name(sample_func)
// or simply sample_func | name
show "arity(sample_func):" arity(sample_func)
// or simply sample_func | arity
show "is_function(sample_func):" is_function(sample_func)
// or simply sample_func | is_function

show "\n--- Collection / Type Checks ---"
/*
    1. is_array(value): Checks if the value is an array.
    2. is_object(value): Checks if the value is an object (dictionary).
    3. is_string(value): Checks if the value is a string.
    4. is_number(value): Checks if the value is a number.
    5. is_bool(value): Checks if the value is a boolean.
    6. is_null(value): Checks if the value is null.

    Wrap in parentheses to avoid ambiguity with the array literal syntax when using the pipe operator.
    Same applies when used in if else statements or other expressions
*/
show "is_array([1, 2]):" is_array([1, 2])
// or simply [1, 2] | is_array
// if !([1, 2] | is_array) {...}
show "is_object({'a': 1}):" is_object({"a": 1})
// or simply ({"a": 1}) | is_object
// if !({"a": 1} | is_object) {...}
show "is_string('hello'):" is_string("hello")
// or simply "hello" | is_string
// if !("hello" | is_string) {...}
show "is_number(42):" is_number(42)
// or simply 42 | is_number
// if !(42 | is_number) {...}
show "is_bool(true):" is_bool(true)
// or simply true | is_bool
// if !(true | is_bool) {...}
show "is_null(null):" is_null(null)
// or simply (null) | is_null
// if !(null | is_null) {...}