/* 
  Example 29: Tool Piping and Composition

  Demonstrates:
    1. Chaining functions together using the pipe operator (|).
    2. Passing data sequentially through multiple functions. 
*/

fn addTen(val) {
  return val + 10
}

fn multiplyByTwo(val) {
  return val * 2
}

fn formatResult(val) {
  return "Final result: " + str(val)
}

show "=== Piping values through functions ==="

/* 
  5 goes into addTen(5) -> 15
  15 goes into multiplyByTwo(15) -> 30
  30 goes into formatResult(30) -> "Final result: 30"
*/
let output = 5 | addTen | multiplyByTwo | formatResult
show output

/* 
  Rule of Thumb:
    - Use | for data pipelines: arrays, strings, objects, or multi-step transformations (data | filter | map | show).
    - Use standard syntax () for math, boolean logic (!, &&, ||), comparisons (==, !=), and inline checks.
  
  If using | for math, boolean logic, or comparisons, wrap the expression in parentheses to avoid ambiguity.
  Example: 
    (5 | addTen) > 10 is valid, but 5 | addTen > 10 is ambiguous and will throw an error.
    if !("text" | is_number) {...} is valid, but "text" | !is_number {...} will trigger a 'Not a function' error.

*/