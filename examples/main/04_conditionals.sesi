// Conditionals
allow "std/terminal" in with { color }

let age: num = 25
if age >= 18 {
  show color("You are an adult", "green")
} else {
  show color("You are a minor", "yellow")
}

// Complex conditions
let score: num = 85
if score >= 90 {
  show color("Grade: A", "green", "bold")
} else if score >= 80 {
  show color("Grade: B", "blue")
} else if score >= 70 {
  show color("Grade: C", "yellow")
} else {
  show color("Grade: F", "red", "bold")
}