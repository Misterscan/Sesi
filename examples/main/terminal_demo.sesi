/*
  A compact showcase of std/terminal for ANSI-compatible terminals.

  Usage:
    sesi examples/main/terminal_demo.sesi
*/

allow "std/terminal" in as Term
allow "std/time" in as Time

Term.clear()
Term.title("Sesi terminal showcase")
Term.hideCursor()

// Styled text can be piped into show just like color().
1 | Term.cursor(1)
show " S E S I   T E R M I N A L " | Term.background("blue") | Term.style(["bold", "brightWhite"])

1 | Term.cursor(3)
show "ANSI controls, colors, and cursor tools" | Term.style(["dim", "cyan"])

// Use eraseLine() before replacing a temporary status message.
1 | Term.cursor(5)
Term.write("Starting terminal services...")
250 | Time.sleep
1 | Term.cursor(5)
Term.eraseLine()
1 | Term.cursor(5)
show "✓ Terminal services ready" | Term.style(["bold", "brightGreen"])

1 | Term.cursor(7)
show "  HEALTHY  " | Term.background("green") | Term.style("bold")
show "  true color  " | Term.rgb(108, 92, 231)
show "  styled output  " | Term.style(["underline", "brightCyan"])

let dimensions = Term.size()
let sizeSummary = "Terminal size: " + dimensions.columns + " columns × " + dimensions.rows + " rows"
1 | Term.cursor(9)
show sizeSummary | Term.color("gray")

// Save a position, draw a separate status line, then return below it.
Term.saveCursor()
1 | Term.cursor(12)
show "Tip: use Term.move(x, y) for relative cursor movement." | Term.color("yellow")
Term.restoreCursor()
Term.move(0, 3)
show "Ready to build." | Term.style(["bold", "brightMagenta"])

Term.showCursor()
