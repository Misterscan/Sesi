/*
  A visually rich terminal UI demo using Sesi and Term module.
  Demonstrates: styling, cursor movement, and timed events.
  
  Usage:
    sesi examples/main/terminal_demo.sesi
*/

allow "std/terminal" in as Term
allow "std/time" in as Time

// Clear the screen to start fresh
Term.clear()

// Move cursor to top left
1 | Term.cursor(1)
show "⚡ Sesi Terminal UI Engine" | Term.color("cyan")

1 | Term.cursor(3)
show "Loading system modules..." | Term.color("yellow")

1000 | Time.sleep

1 | Term.cursor(4)
show "[OK] File system ready" | Term.color("green")

500 | Time.sleep

1 | Term.cursor(5)
show "[OK] Network initialized" | Term.color("green")

1 | Term.cursor(7)
show "Ready for commands." | Term.color("white")

// Optional: you can combine with input
1 | Term.cursor(9)
let cmd = "admin@sesi> " | input | Term.color("magenta")

1 | Term.cursor(11)
show "You executed:" cmd | Term.color("bold")
