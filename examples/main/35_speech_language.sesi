/*
  Example 35: Speech and Transcription

  Uses OpenAI or Gemini for transcription and the operating-system voice for speech.

Usage:
  sesi examples/main/35_speech_language.sesi
  sesi examples/main/35_speech_language.sesi --ai 

  Set OPENAI_API_KEY for transcription and GEMINI_API_KEY for AI speech.
*/
allow "helpers/safe" in as safe
allow "std/terminal" in with {color}

let tts = "Text to speak: " | input

if tts != "" && (args[0] != "ai" || args[0] == null) {
  show "Text to speak:" tts
  tts | speech
} else if tts != "" && args[0] == "ai" {
  let audio = tts | speech("Kore", "gemini-2.5-flash-preview-tts")
  let audioPath = "audio_text.wav"
  audioPath | safe.saveMedia(audio)
  let transcript = ""

  try {
    transcript = audioPath | from_speech
  } catch (e) {
    show color("Error transcribing audio: " + str(e), "red")
  }
  audioPath | safe.remove

  if is_null(transcript) || trim(transcript) == "" || includes(transcript, "Error:") {
    show color("No transcription was produced.", "yellow")
  } else {
    show "Transcribed text:" transcript
    transcript | speech
  }
}