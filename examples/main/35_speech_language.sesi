/*
  Example 35: Speech, Transcription, and Translation

  Uses Whisper for transcription, the translate package for translation, and
  the operating-system voice for speech.

Usage:
  sesi examples/main/35_speech_language.sesi
  sesi examples/main/35_speech_language.sesi --ai 

  Note: This example requires CMake to be installed for the `from_speech()` function to work.
*/
allow "shell-automation" in with {brew_install}

fn getOS() {return trim(js("console.log(require('os').platform())"))}
let platform = getOS()

allow "std/terminal" in with {color}

let tts = input("Text to speak: ")
let fromLang = input("Source language (default: en): ")
if is_null(fromLang) || fromLang == "" {fromLang = "en"}
let toLang = input("Target language (default: es): ")
print ""
if is_null(toLang) || toLang == "" {toLang = "es"}

// Check if CMake is installed
let cmakeFound = trim(js("const cp=require('child_process');const p=require('os').platform();try{cp.execFileSync(p==='win32'?'where.exe':'which',['cmake'],{stdio:['ignore','pipe','ignore']});console.log('yes')}catch(e){console.log('no')}"))
let installCMake = ""

if cmakeFound == "yes" {
  print color("CMake is already installed.\n", "green")
} else if platform == "darwin" {
  let brewFound = trim(js("const cp=require('child_process');try{cp.execFileSync('which',['brew'],{stdio:['ignore','pipe','ignore']});console.log('yes')}catch(e){console.log('no')}"))
  if brewFound == "yes" {
    print color("CMake is not installed. It is required for the 'from_speech()' demonstration.", "yellow")
    // Prompt user to install CMake via Homebrew
    installCMake = input(color("Allow Sesi to install CMake with Homebrew? (y/n): ", "yellow"))
  } else {
    print color("CMake is not installed. Install Homebrew from https://brew.sh, then run: brew install cmake", "yellow")
  }
} else if platform == "win32" {
  print color("CMake is not installed. Install it from https://cmake.org/download/ or run: winget install Kitware.CMake", "yellow")
} else {
  print color("CMake is not installed. Install it with your system package manager before using from_speech().", "yellow")
}

if trim(installCMake) == "y" {
  try { // Install CMake via Homebrew
      brew_install("cmake")
      print color("CMake installed successfully.", "green")
  } catch (e) {
      print color("Error installing CMake: " + str(e), "red")
  }
}
if trim(installCMake) == "n" {print color("Skipping 'from_speech()' demonstration.", "yellow")}

// Check if the user wants to use AI for translation
if tts != "" && (args[0] != "ai" || args[0] == null) {
  print "Original language transcribed (" fromLang "):" tts
  speech(tts)

  tts = translate(tts, toLang, fromLang)
  print "Translated language transcribed (" toLang "):" tts
  speech(tts, "Mónica")
  
} else if tts != "" && args[0] == "ai" { // Use AI for translation
  let audio = speech(tts, "Kore", "gemini-2.5-flash-preview-tts")
  write_file("audio_text.wav", audio, "base64")
  let audioPath = "audio_text.wav"
  let transcript = ""

  try {
    transcript = from_speech(audioPath, toLang) 
    // Clean up common subtitle timestamps in Whisper transcription output
    if contains(transcript, "[") && contains(transcript, "-->") {transcript = js("const t=" + to_json(transcript) + ";console.log(t.replace(/\\[\\d{2}:\\d{2}:\\d{2}\\.\\d{3}\\s*-->\\s*\\d{2}:\\d{2}:\\d{2}\\.\\d{3}\\]/g,'').trim())")}
  } catch (e) {
    print color("Error transcribing audio: " + str(e), "red")
  }
  trash(audioPath, true); trash("audio_text.wav.txt", true)

  // If transcription fails or is empty, fallback to original text for translation
  if is_null(transcript) || trim(transcript) == "" || includes(transcript, "Error:") {
    print color("Fallback: Using original text for translation.", "yellow")
    print "Original language (" fromLang ") transcribed:" tts
    speech(tts)
    
    tts = translate(tts, toLang, fromLang)

    // Speak the translated text in the target language
    print "Translated language (" toLang ") transcribed:" tts
    if platform == "darwin" {
      if toLang == "es" {speech(tts, "Mónica")}
      if toLang == "fr" {speech(tts, "Amélie")}
      if toLang == "de" {speech(tts, "Anna")}
      if toLang == "it" {speech(tts, "Alice")}
      if toLang == "ja" {speech(tts, "Kyoko")}
      if toLang == "ko" {speech(tts, "Yuna")}
      if toLang == "zh" {speech(tts, "Mei")}
      if toLang == "en" {speech(tts)}
    } else if platform == "win32" {
      speech(tts)
    }
  } else { // Run translation and speech synthesis if transcription is successful
    let translated = translate(transcript, toLang, fromLang)
    print "Original language(" fromLang ") transcribed:" transcript
    speech(tts)

    print "Translated language (" toLang ") transcribed:" translated
    if platform == "darwin" {
      if toLang == "es" {speech(translated, "Mónica")}
      if toLang == "fr" {speech(translated, "Amélie")}
      if toLang == "de" {speech(translated, "Anna")}
      if toLang == "it" {speech(translated, "Alice")}
      if toLang == "ja" {speech(translated, "Kyoko")}
      if toLang == "ko" {speech(translated, "Yuna")}
      if toLang == "zh" {speech(translated, "Mei")}
      if toLang == "en" {speech(translated)}
    } else if platform == "win32" {
      speech(translated)
    }
  }
}