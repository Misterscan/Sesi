// Variables and basic operations
allow "std/terminal" in with { color }

let x = 10
let y = 20
let z = x + y

// You can also explicitly state the type
let a: number = 10
let b: string = "20"
let c: any = a + b + ", a number and string cannot be added together without converting the type first!"

show color("x = ", "yellow") color(str(x), "cyan")
show color("y = ", "yellow") color(str(y), "cyan")
show color("sum = ", "green") color(str(z), "bold")
show color("c = ", "green") color(str(c), "yellow")

// Reassignment
x = 30
show color("x updated:", "magenta") color(str(x), "cyan")