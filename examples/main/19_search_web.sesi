/* 
  Example 19: Search the Web with Sesi
    Use web_get()
*/
allow "std/terminal" in with { color }
allow "helpers/safe" in with { json }

try {
    let q = "Coding"
    prompt url {"http://api.duckduckgo.com/?q=" q "&format=json"}
    let content = url | web_get
    let data = content | from_json
    show color("Downloaded: ", "cyan") url
    show color("Saving results to search_results.json", "yellow")
    "search_results" | json(data)
    show color("Saved result to search_results.json", "green", "bold")
} catch (err) {
    show "Error: " err
}

