/* 
  Example 19: Search the Web with Sesi
    Use web_get()
*/
allow "std/terminal" in with { color }

try {
    let q = "Coding"
    prompt url {"http://api.duckduckgo.com/?q=" q "&format=json"}
    let content = url | web_get
    let data = content | from_json
    print color("Downloaded: ", "cyan") url
    print color("Saving results to search_results.json", "yellow")
    "search_results.json" | write_file(data | to_json)
    print color("Saved result to search_results.json", "green", "bold")
} catch (err) {
    print "Error: " err
}

