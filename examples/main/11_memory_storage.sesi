// You can use memory to store variables throughout your script without redeclaring it
allow "std/terminal" in with { color }
allow "helpers/safe" in with { json }

memory database {"name: string, age: number, role: string"}

database = {"name": "John", "age": 30, "role": "developer"}
show color("Name:", "cyan") database["name"]
show color("Age:", "cyan") str(database["age"])
show color("Role:", "cyan") database["role"]
try {
  "data" | json(database)
  show color("Database saved!", "green", "bold")
} catch(error) {
  show "Error:" error
}

let new_info = {"name": "Jane", "age": 25, "role": "designer"}
let merged = database
for key in new_info | keys {
  merged[key] = new_info[key]
}
database = merged
show "Name:" database["name"]
show "Age:" database["age"]
show "Role:" database["role"]
try {
  "data" | json(database)
  show "Database updated!"
} catch(error) {
  show "Error:" error
}

