// Loops
allow "std/terminal" in with { color }

show color("While loop:", "magenta")
let i = 0
while i < 5 {
  show color(str(i), "cyan")
  i = i + 1
}

show color("For loop (range):", "magenta")
for j = 0 to 5 {
  show "Iteration:" color(str(j), "yellow")
}

show color("For loop (array):", "magenta")
let arr = [10, 20, 30, 40]
for item in arr {
  show "Item:" color(str(item), "green")
}