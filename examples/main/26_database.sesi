/*
  Example 26: Embedded Document Database

  Usage:
    - sesi examples/main/26_database.sesi -l 
*/

allow "std/db" in with {db_open}
allow "std/terminal" in with { color }

show color("Initializing Sesi Database (local.db)...", "magenta")
let db = "local.db" | db_open
let items = "items" | db.collection

// Clear any existing items for a clean demo
items.delete({})

show "Inserting documents..."
let item1 = {"name": "Widget A", "stock": 100, "category": "hardware"} | items.insert
let item2 = {"name": "Widget B", "stock": 150, "category": "hardware"} | items.insert
let item3 = {"name": "Gadget C", "stock": 50, "category": "electronics"} | items.insert

show "Inserted item 1 with ID:" item1._id

show "Finding all items..."
let allItems = items.find()
show "Total items:" len(allItems)

show "Finding hardware items..."
let hardware = {"category": "hardware"} | items.find()
show "Found hardware items:" len(hardware)

show "Updating stock for Widget A..."
let updated = {"name": "Widget A"} | items.update({"stock": 120})
show "Updated count:" updated

show "Deleting Gadget C..."
let deleted = {"name": "Gadget C"} | items.delete
show "Deleted count:" deleted

show "Final list of items:"
let remaining = items.find()
for it in remaining {
  show "- Name:" it.name " | Stock:" it.stock " | Category:" it.category
}

show "Demo completed."