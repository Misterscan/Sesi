/* 
  Example 24: HTTP Handler
  Dynamic request handler for HTTP server
*/

allow "std/time" in with {sleep}

/**
  Handle incoming HTTP requests and return appropriate responses.

  Supports the following endpoints:
  - `/`: Returns a welcome HTML page.
  - `/api/info`: Returns information about the Sesi environment.
  - `/api/echo`: Echoes back query parameters, headers, and request method.
  
  Parameters:
  - req: The HTTP request object.

  Returns:
  An HTTP response object.
*/
export fn handleRequest(req) {
  show "Received request on path:" req.path "with method:" req.method

  if req.path == "/" {
    return {
      status: 200,
      headers: {
        "Content-Type": "text/html"
      },
      body: "<h1>Welcome to Sesi Native HTTP Server!</h1><p>Try visiting <a href='/api/info'>/api/info</a> or <a href='/api/echo?name=Sesi'>/api/echo?name=Sesi</a></p>"
    }
  }

  if req.path == "/api/info" {
    return {
      status: 200,
      body: {
        language: "Sesi",
        version: "1.9.0",
        features: ["async/await", "native HTTP server", "structured output", "tool calls", "live reload"]
      }
    }
  }

  if req.path == "/api/echo" {
    let name = "Guest"
    let msg = "Hello, " + name
    if req.query.name {
      name = req.query.name
    }
    return {
      status: 200,
      body: {
        message: msg,
        method: req.method,
        query: req.query,
        headers: req.headers
      }
    }
  }

  return {
    status: 404,
    body: "Page not found"
  }
}
