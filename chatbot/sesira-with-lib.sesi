/* 
  Sesira
  Dynamically indexes the sesi-db knowledge base, trains on-the-fly, and answers queries! 
    Run sesi install to ensure you have the required modules. 
*/
allow "helpers/safe" in as Safe
allow "std/time" in with {now, format}
allow "lib/usage" in with {track_model}
allow "timestamp" in as Stamp
allow "lib/refs" in as Refs
allow "lib/network/utils" in with {read}

let archiveDir = "chatbot/archive/"; archiveDir | make_dir
let queryText = ""
let fileContext = null
let logFile = "chatbot/sesira.log"

/**
  Writes a log entry to the log file with a timestamp, sender, and message.

  Parameters:
  - sender: The sender of the message (e.g., "USER" or "SESI").
  - msg: The message content to be logged.

  Returns:
  - status: A string indicating the result of the log operation.
  - The status will be "Log entry written successfully." if the log operation was successful, otherwise it will indicate an error.
*/
fn writeLog(sender, msg) {
  let status = "Error writing to log file."
  let wrote = false

  if (msg | length) > 5000 {
    let lines = msg | split("\n")
    let truncatedLines = lines | slice(0, 350)
    truncatedLines = truncatedLines | join("\n")
    msg = truncatedLines + "...\n<truncated>"
  }


  let timestamp = "in_ms" | Stamp.localTime

  prompt logEntry {"["timestamp"]
["sender"]: "msg"
===============================
"}

  try {
    logFile | Safe.appendFile(logEntry)
    wrote = true
  } catch (e) {
    prompt logEntry {"["timestamp"] ["sender"]: "msg"\n===============================\n"}
    wrote = logFile | Safe.writeFile(logEntry)
  }

  if sender == "USER" { show "User Query Logged:" msg
  } else if sender == "SESI" { continue }
  if wrote { status = "Log entry written successfully." }

  return status
}

/**
  Clears the log file by archiving the current log and writing an empty string to the log file.

  Returns:
  - status: A boolean indicating whether the log was successfully cleared.
  - The status will be true if the log was cleared successfully, otherwise false.
*/
fn clearLog() {
  let archiveBase = logFile | swap("chatbot/", "") | swap(".log", "")
  let archivePath = archiveDir + archiveBase + "-" + Stamp.formattedTime() + ".log"
  let previousLog = logFile | Safe.readFile("text")
  if (previousLog | length) > 0 {
    try {
      logFile | archive(archivePath)
    } catch (e) {
      return false
    }
  }
  let cleared = logFile | Safe.writeFile("")
  if !cleared {
    return false
  }
  show "Log file cleared."
  return true
}

/**
  Retrieves the conversation history from the log file.

  Returns:
  - history: A string containing the conversation history.
  - If the log file is too large, only the last 10000 lines are retained and the log is cleared.
*/
fn getHistory() {
  let history = ""
  try {history = logFile | Safe.readFile("text")} catch (e) {}
  if (history | length) > 0 {history = "Conversation History:\n" + history + "\n\n"}

  // If the log file is too large, grab the last 10000 lines and clear the log to avoid excessive memory usage
  if (history | length) > 50000 {
    let lines = history | split("\n")
    let lastLines = lines | slice( (history | length) - 10000, (history | length) )
    history = lastLines | join("\n")
    clearLog()
    "SESI" | writeLog("Log file exceeded 50K characters. Retaining last 10000 lines and clearing log.")
  }

  return history
}

if (args | length) > 1 && (args[0] == "new-chat" || args[0] == "new") {
  try {
    logFile | rename("chatbot/archive/sesira-" + Stamp.formattedTime() + ".log")
  } catch (e) {logFile | Safe.writeFile("")}
  queryText = args[1]
  "USER" | writeLog(queryText)
  if (args | length) > 2 && (args[2] | contains(".sesi")) {
    try {
      "USER" | writeLog("Active File: " + args[2])
      fileContext = "File: " + args[2] + "\n\n" + (args[2] | Safe.readFile("text"))
    } catch (e) {}
  }
} else if (args | length) > 0 && (args[0] != "new-chat" && args[0] != "new") {
  queryText = getHistory() + args[0]
  "USER" | writeLog(args[0] | str)
  if (args | length) > 1 && (args[1] | contains(".sesi")) {
    try {
      "USER" | writeLog("Active File: " + args[1] | str)
      fileContext = "File: " + args[1] + "\n\n" + (args[1] | Safe.readFile("text"))
    } catch (e) {}
  }
} else {
  show "Continue from previous conversation? (y/n):"
  if (" " | input) == "n" {
    try {
      logFile | rename("chatbot/archive/sesira-" + Stamp.formattedTime() + ".log")
    } catch (e) {show e}
    queryText = "Enter your question: " | input
  } else {
    queryText = getHistory() + "Enter your question: " | input
  }
  let logText = queryText
  "USER" | writeLog(logText)
  let fileName = "Enter the active file name (optional): " | input
  "USER" | writeLog("Active file: " + fileName)
}
// ==================================================

show "Loading Sesira..."
"SESI" | writeLog("Loading Sesira...")

show "--------------------------------------------------"
show "💭 SESIRA IS THINKING:"
show "--------------------------------------------------"
"SESI" | writeLog("💭 SESIRA IS THINKING:")

let refs = Refs.BUILTINS
let brain = refs || []
let skills = ""
try {
  skills = ".agents/skills/SKILLS.md" | Safe.readFile
} catch (e) {}

let expandedLibs = ""
let libDir = "lib/"
let libs = list_dir(libDir)
try {
  expandedLibs = "=== HELPER: File System (Built-in via \"helpers/safe\") ===\n" + Safe.readFile("helpers/safe.sesi")
  for lib in libs { if get_ext(lib) == "sesi" { expandedLibs = expandedLibs + "\n\n=== LOCAL LIB: " + lib + " ===\n" + Safe.readFile(libDir + lib) } }
  expandedLibs = expandedLibs + "\n\n=== SESI MODULE: math (via sesi install Misterscan/math) ===\n" + (Safe.readFile("sesi_modules/math/main.sesi") || read("https://raw.githubusercontent.com/Misterscan/math/refs/heads/main/main.sesi"))
  expandedLibs = expandedLibs + "\n\n=== SESI MODULE: shell-automation (via sesi install Misterscan/shell-automation) ===\n" + (Safe.readFile("sesi_modules/shell-automation/index.sesi") || read("https://raw.githubusercontent.com/Misterscan/shell-automation/refs/heads/main/index.sesi"))
  expandedLibs = expandedLibs + "\n\n=== SESI MODULE: AutoWebpageDiagnostics (via sesi install Misterscan/AutoWebpageDiagnostics) ===\n" + (Safe.readFile("sesi_modules/AutoWebpageDiagnostics/main.sesi") || read("https://raw.githubusercontent.com/Misterscan/AutoWebpageDiagnostics/refs/heads/main/main.sesi"))
} catch (e) {}
if !exists(".compacted_libs.sesi") {
  Safe.writeFile(".compacted_libs.sesi", expandedLibs) 
  sesi("helpers/sesi-minify.sesi", false, false, [".compacted_libs.sesi", ".compacted_libs.min.sesi"])
  rename(".compacted_libs.min.sesi", ".compacted_libs.sesi")
}
expandedLibs = Safe.readFile(".compacted_libs.sesi") | split("\n") | join(" ")

prompt instructions {"
Sesi Official Reference Documentation:
"brain"

Libraries:
- `math` uses `allow 'math' in as ... or `allow 'math' in with {...}`
- `shell-automation` uses `allow 'shell-automation' in as ... or `allow 'shell-automation' in with {...}`
- `AutoWebpageDiagnostics` uses `allow 'AutoWebpageDiagnostics' in as ... or `allow 'AutoWebpageDiagnostics' in with {...}`
- Local libraries use allow lib/<libname> in as ... or allow lib/name in with {...} <-- NOTE: the format should follow `lib/<libname>` in quotation marks.
"expandedLibs"

Instructions: 
"skills" 

# IMPORTANT
YOU MUST USE THE PROVIDED LIBRARIES UNDER ALL CIRCUMSTANCES, THEY ARE PROVIDED INTENTIONALLY, NOT TO BE PICKED AT YOUR OWN DISCRETION. THIS MEANS YOU SHOULD **REFRAIN** FROM OMITTING ANY EXPANDED LIBRARIES IN YOUR RESPONSE. NO EXCEPTIONS ARE ALLOWED.

If Active File Context is present, use it directly and talk about that file concretely. 
- Be accurate and verbose. 
- Do NOT invent syntax.
- Prefer code piping when it offers better legibility and readability.
Example:
```
let file = null
try {file = read_file(""filename"")} catch (e) {file = null}
if file | is_null {
  show ""File is empty or could not be read.""
}
```

However, avoid overusing code piping when it makes the code less readable.
Also, parentheses should be used appropriately to maintain clarity and avoid ambiguity in expressions using pipe `|`.
```
if (file | len) > 0 {
  show ""File has content.""
}

let fileLength = (file | len) + 1
let pick = (nonexistent | len) || (file | len)
```
- Functions that return a variable as a boolean rather than a strict `bool` should explicitly state `any` as their return type.
- Do not mention that you got this from a database.
- Do not mention that you are an AI model.
- You must import any neccesary modules at the top before claring them in your scripts.
- Do not mention that you got anything from documentation, just reference it if needed.

Absolutely NO `+` usage in show statements.

Raw newlines **between elements** (outside of a string literal) inside `{ }` are a syntax error, they are treated as statement separators. 
Newlines that live inside a string literal are fine. STRICTLY FOLLOW THE PROVIDED EXAMPLES IN THE DOCUMENTATION WHERE NEWLINES ARE USED AND DO NOT INSINUATE.
Newlines are also permitted in function declarations and structured output, however strongly preferred when dealing with multiple parameters:
```
fn take_action(
  cmds: array<string>?,
  _prompt,
  description: string = "",
  required: bool,
  ext_param: string,
  ext_param2: any = null
) { ... }

let output = structured_output(
  type: ""string"",
  name: ""string"",
  config: ""object"",
  status: ""bool"",
  ext_field: ""any"",
  ext_field2: ""array""
)(raw_data)
```

```
prompt example {""Multi line strings are fine
but they MUST begin on the same line as the opening '{' 
and end on the same line as the closing '}' ""}

let test = model(""gemini-3.1-flash-lite"") {thinkingLevel: ""low"", maxT: 2048, cache: false, search} <-- NOTICE ITS NOT SEPARATED BY NEWLINES IN THE CONFIGURATION {example} 

```

Objects do not require to be quoted in strings:
```
let desc = ""Example text for configuration.""
let config = {
  name: ""Object Test"",
  description: desc,
  active_state: true,
  sub_config: {
    testing: true,
    code: null,
    production: false,
    env_path: ""base/keys.txt""
  }
}
show config.name
show config.active_state
show config.sub_config.env_path
```"}

prompt ragPrompt {"User Query: "queryText"

Active File Context:
"fileContext}

prompt persona {"Your name is Sesira. Do not mention your name for no reason, only if the user asks. 
- You have 10+ years of expertise working with the exports listed in lib/. This is where you will focus all of your assistance to the user.
- You prefer an original way of doing things."}

let sys = persona + instructions
let generated_response = ""
let err = ""

try { generated_response = track_model(ragPrompt, {model_name: "gpt-6-luna", system: sys, thinking: "medium", max_tokens: 15000, response: "full"}) }
catch (e) {
  err = e.message
  try { generated_response = track_model(ragPrompt, {model_name: "gemini-3.5-flash-lite", system: sys, thinking: "low", max_tokens: 15000, response: "full"}) }
  catch (e2) {err = err + "\n" + e2.message}
}

"SESI" | writeLog("Current request cost:" generated_response.cost)
show "Time taken:" generated_response.duration
"SESI" | writeLog("Time taken: " + generated_response.duration)

if generated_response { show "Sesira has provided a response to your question:\n"generated_response.response } else { show err; return }
let helpResponse = ""
let timestamp = now | format({"dateStyle": "short", "timeStyle": "medium"})
timestamp = timestamp | swap("/", "-") | swap(":", "-") | swap(",", "") | swap(" ", "-")
let responseFile = "chatbot/responses/sesira-help-" + timestamp + ".md"; "chatbot/responses" | make_dir

try {
  helpResponse = responseFile | Safe.writeFile("# Sesira Response:\n\n" + generated_response.response)
  show "\n\nYour answer has also been saved at '"responseFile"'."
  "SESI" | writeLog("Response written to " + responseFile)
  "SESIRA" | writeLog(generated_response.response)
  show Safe.json(responseFile | swap(".md", ""), to_json(generated_response))
} catch (e) {
  "SESI" | writeLog("Failed to write " + responseFile + ": " + e)
}