/* 
  Sesira
  Dynamically indexes the sesi-db knowledge base, trains on-the-fly, and answers queries! 
    Run sesi install to ensure you have the required modules. 
*/
allow "shell-automation" in as shell
allow "helpers/safe" in as Safe
allow "std/time" in with {now, format}
allow "timestamp" in as Stamp
allow "math" in as Math

/* 
  ==================================================
  💬 1. CHOOSE YOUR ADVANCED TECHNICAL QUERY HERE!
  (Test it with custom phrases containing our keywords!) 
*/
let archiveDir = "chatbot/archive/"; archiveDir | make_dir
let queryText = ""
let fileContext = ""
let logFile = "chatbot/sesira.log"

fn writeLog(sender, msg) {
  let status = "Error writing to log file."
  let wrote = false

  if (msg | length) > 5000 {
    let lines = msg | split("\n")
    let truncatedLines = lines | slice(0, 250)
    msg = truncatedLines | join("\n") + "\n... [TRUNCATED]"
  }

  let timestamp = "in_ms" | Stamp.localTime

  prompt logEntry {"["timestamp"]
["sender"]: "msg"
===============================
"}

  try {
    logFile | Safe.appendFile(logEntry)
    wrote = true
  } catch (e) {
    prompt logEntry {"["timestamp"] ["sender"]: "msg"\n===============================\n"}
    wrote = logFile | Safe.writeFile(logEntry)
  }

  if sender == "USER" {show "User Query Logged:" msg
  } else if sender == "SESI" {
    if msg | contains("----------------------------------") {show "Sesi Response Logged."
    } else {
      show "Sesi Response Logged:\n" msg
    }
  }
  if wrote { status = "Log entry written successfully." }

  return status
}

fn clearLog() {
  let archiveBase = logFile | swap("chatbot/", "") | swap(".log", "")
  let archivePath = archiveDir + archiveBase + "-" + Stamp.formattedTime() + ".log"
  let previousLog = logFile | Safe.readFile("text")
  if (previousLog | length) > 0 {
    try {
      logFile | archive(archivePath)
    } catch (e) {
      return false
    }
  }
  let cleared = logFile | Safe.writeFile("")
  if !cleared {
    return false
  }
  show "Log file cleared."
  return true
}

fn getHistory() {
  let history = ""
  try {history = logFile | Safe.readFile("text")} catch (e) {}
  if (history | length) > 0 {history = "Conversation History:\n" + history + "\n\n"}

  // If the log file is too large, grab the last 10000 lines and clear the log to avoid excessive memory usage
  if (history | length) > 50000 {
    let lines = history | split("\n")
    let lastLines = lines | slice( (history | length) - 10000, (history | length) )
    history = lastLines | join("\n")
    clearLog()
    "SESI" | writeLog("Log file exceeded 50K characters. Retaining last 10000 lines and clearing log.")
  }

  return history
}

if (args | length) > 1 && (args[0] == "new-chat" || args[0] == "new") {
  try {
    logFile | rename("chatbot/archive/sesira-" + Stamp.formattedTime() + ".log")
  } catch (e) {logFile | Safe.writeFile("")}
  queryText = args[1]
  "USER" | writeLog(queryText)
  if (args | length) > 2 && (args[2] | contains(".sesi")) {
    try {
      "USER" | writeLog("Active File: " + args[2])
      fileContext = "File: " + args[2] + "\n\n" + (args[2] | Safe.readFile("text"))
    } catch (e) {}
  }
} else if (args | length) > 0 && (args[0] != "new-chat" && args[0] != "new") {
  queryText = getHistory() + args[0]
  "USER" | writeLog(args[0] | str)
  if (args | length) > 1 && (args[1] | contains(".sesi")) {
    try {
      "USER" | writeLog("Active File: " + args[1] | str)
      fileContext = "File: " + args[1] + "\n\n" + (args[1] | Safe.readFile("text"))
    } catch (e) {}
  }
} else {
  show "Continue from previous conversation? (y/n):"
  if (" " | input) == "n" {
    try {
      logFile | rename("chatbot/archive/sesira-" + Stamp.formattedTime() + ".log")
    } catch (e) {show e}
    queryText = "Enter your question: " | input
  } else {
    queryText = getHistory() + "Enter your question: " | input
  }
  let logText = queryText
  "USER" | writeLog(logText)
  let fileName = "Enter the active file name (optional): " | input
  "USER" | writeLog("Active file: " + fileName)
}
// ==================================================

show "Loading Sesira..."
"SESI" | writeLog("Loading Sesira...")

// Sigmoid math activation
fn activate(x) {
  return Math.sigmoid(x)
}

// Sigmoid derivative for backpropagation
fn derivative(y) {
  return Math.dsigmoid(y)
}

/* 
  Current Sesi Bag-of-Words Vocabulary Vectorizer
  Must stay identical to the trainer vocabulary so saved weights remain compatible.
*/
let vocabulary = [
  "let", "const", "fn", "if", "else", "while", "for", "in", "return", "break", "continue", "try", "catch", "finally", "true", "false", "null", "show", "prompt", "make", "model", "image", "convert", "async", "await", "structured_output", "tool_call", "memory", "import", "from", "export", "to", "allow", "with",
  "number", "string", "array", "object", "any", "media", "audio", "text", "doc", "video", "PI", "E", "INFINITY", "NaN",
  "debug", "input", "args", "len", "type", "str", "to_json", "from_json", "speech", "from_speech", "translate", "exp", "trunc", "num", "float", "bool", "range", "push", "append", "pop", "keys", "values", "join", "split", "regex", "tokenize", "count_tokens", "estimate_tokens", "estimate_cost", "model_usage", "to_upper", "to_lower", "trim", "slice", "swap", "contains", "locate",
  "matrix_dot", "matrix_transpose", "matrix_add", "matrix_sub", "matrix_mul_elements", "matrix_scale", "matrix_sigmoid", "matrix_dsigmoid", "matrix_sum_rows", "matrix_mse",
  "read_file", "write_file", "append_file", "write_image", "open_file", "open", "list_dir", "make_dir", "rename", "archive", "trash", "spawn", "exec", "ffmpeg", "gif", "sesi", "python", "js", "html", "time", "random", "env", "memory_search", "memory_trim", "set_alias", "error_type", "raise_error", "define_tool", "list_tools", "web_get", "web_send", "multi_req", "workflow", "listen", "api", "retry", "map", "filter", "reduce", "find", "live",
  "create_app", "get", "post", "put", "delete", "patch", "head", "use", "db_open", "launch", "newPage", "goto", "content", "screenshot", "pdf", "click", "fill", "press", "inner_text", "attribute", "evaluate", "wait_for_selector", "wait_for_timeout",
  "play", "beep", "synth", "save", "load", "kick", "snare", "hat", "sequence", "midi", "render", "comp", "mix", "sf2", "chord", "scale", "transpose", "duration", "bar",
  "circle", "rect", "line", "pixel", "pixel_grid", "save_svg", "save_png", "ellipse", "polygon", "path", "gradient", "style", "raw",
  "name", "arity", "is_function", "is_array", "is_object", "is_string", "is_number", "is_bool", "is_null", "length", "starts_with", "ends_with", "index_of", "repeat", "includes", "reverse", "sort", "unique", "flatten",
  "sin", "cos", "tan", "sqrt", "floor", "ceil", "abs", "pow", "log", "now", "sleep", "format", "parse", "stringify", "encode", "decode", "clear", "cursor", "color"
]

fn vectorize(text) {
  let vec = []
  let k = 0
  while k < (vocabulary | length) {
    vec | push(0.0)
    k = k + 1
  }
  
  let normalized_text = text
  let delimiters = ["\n", "\t", "\r", "(", ")", "{", "}", "[", "]", ";", ",", "\"", "'", ".", ":", "=", "!", "<", ">", "+", "-", "*", "/", "%", "|"]
  for delimiter in delimiters {
    normalized_text = normalized_text | swap(delimiter, " ")
  }
  let words = normalized_text | split(" ")

  let i = 0
  while i < (words | length) {
    let tok = words[i]
    let vocab_idx = vocabulary | index_of(tok)
    if vocab_idx >= 0 { vec[vocab_idx] = 1.0 }
    i = i + 1
  }
  return vec
}

let trained_model_path = "sesi-db/trained_brain.json"
let has_trained_model = false
let weights = []
let biases = []
let database = []
let num_classes = 0

try {
  let raw = trained_model_path | Safe.readFile
  let brain = raw | from_json
  weights = brain["weights"]
  biases = brain["biases"]
  database = brain["database"]
  num_classes = database | length
  has_trained_model = true
} catch (e) {}

  let query_vec = queryText | vectorize
  
  // Forward propagation on user query across all dynamic classes
  let outputs = []
  let j = 0
  while j < num_classes {
    let sum = 0.0
    let w_row = weights[j]
    let k = 0
    while k < (vocabulary | length) {
      sum = sum + (query_vec[k] * w_row[k])
      k = k + 1
    }
    let o = sum + biases[j] | activate
    outputs | push(o)
    j = j + 1
  }
  
  // Determine class index with highest score
  let best_class = 0
  let max_score = -1.0
  let j = 0
  while j < num_classes {
    if outputs[j] > max_score {
      max_score = outputs[j]
      best_class = j
    }
    j = j + 1
  }

  // 7. Output Dynamic Recommendation with Confidence Thresholding
  show "--------------------------------------------------"
  show "💭 SESIRA IS THINKING:"
  show "--------------------------------------------------"
  "SESI" | writeLog("----------------------------------\n💭 SESIRA IS THINKING:\n--------------------------------------------------")
  if max_score < 0.40 {
    show "   Please ask again."
    "SESI" | writeLog("Low confidence routing. Asked user to retry.")
  } else {
    let rec = database[best_class]
    let docs_list = "getting-started" | Safe.getFiles
    let sesiDocs = ""
    for f_name in docs_list {
      try {
        let doc_content = "getting-started/" + f_name | Safe.readFile
        let builtins_content = "docs/BUILTINS.md" | Safe.readFile  
        sesiDocs = sesiDocs + "\n\n=== DOCUMENT: BUILTINS.md ===\n" + builtins_content
        sesiDocs = sesiDocs + "\n\n=== DOCUMENT: " + f_name + " ===\n" + doc_content
        
      } catch (e) {}
    }
    
    let skills = ""
    try {
      skills = ".agents/skills/SKILLS.md" | Safe.readFile
    } catch (e) {}
    try {
      skills = "docs/SKILLS.md" | Safe.readFile
    } catch (e) {}

    let expandedLibs = ""
    try {
      expandedLibs = "=== LIB: File System (Built-in via \"helpers/safe\") ===\n" + Safe.readFile("helpers/safe.sesi")
      expandedLibs = expandedLibs + "\n\n=== LIB: Math (via sesi install Misterscan/math) ===\n" + Safe.readFile("sesi_modules/math/main.sesi")
      expandedLibs = expandedLibs + "\n\n=== LIB: Shell (via sesi install Misterscan/shell-automation) ===\n" + Safe.readFile("sesi_modules/shell-automation/index.sesi")
      expandedLibs = expandedLibs + "\n\n=== LIB: Web Diagnostics (via sesi install Misterscan/AutoWebpageDiagnostics) ===\n" + Safe.readFile("sesi_modules/AutoWebpageDiagnostics/main.sesi")
    } catch (e) {}

    prompt instructions {"
    Sesi Official Reference Documentation:
    "sesiDocs"

    Expanded Libraries:
    - `math` uses `allow 'math' in as ... or `allow 'math' in with {...}`
    - `helpers/safe` uses `allow 'helpers/safe' in as ... or `allow 'helpers/safe' in with {...}`
    - `shell-automation` uses `allow 'shell-automation' in as ... or `allow 'shell-automation' in with {...}`
    - `AutoWebpageDiagnostics` uses `allow 'AutoWebpageDiagnostics' in as ... or `allow 'AutoWebpageDiagnostics' in with {...}`
    "expandedLibs"
    
    Instructions: 
    "skills" 
    
    If Active File Context is present, use it directly and talk about that file concretely. 
    - Be accurate and verbose. 
    - Do NOT invent syntax. 
    - Use the correct style for multi-line comments in your scripts and examples only:
    ```
    /*
      Multi-line
      Comment

        Use indentation to show structure.

      List:
        - item 1
        - item 2
        - item 3
    */
    ``` 
    - Do not mention that you got this from a database.
    - Do not mention that you are an AI model.
    - Do not mention that you got anything from documentation, just reference it if needed.
    - Do not ask follow up questions. 
    - You are not in an interactive chat session with the user. 
    
    # CRITICAL: 
    Unless the User Query explicitly names them, you are FORBIDDEN from using or mentioning in your code examples or explanation:
    - model()
    - image()
    - workflow()
    
    **THE USER IS FREE TO USE THESE AT THEIR DISCRETION, ONLY YOU ARE FORBIDDEN FROM USING THEM. DO NOT MENTION THIS RULE. DO NOT TELL THE USER THAT THIS IS A RESTRICTION OR THAT ITS NOT AVAILABLE.**
    Instead, show how to solve the user's query programmatically using native Sesi primitives (such as variables, loops, functions, lists, and standard file/HTTP/JSON/math builtins).

    Absolutely NO `+` usage in show statements.

    Raw newlines **between elements** (outside of a string literal) inside `{ }` are a syntax error, they are treated as statement separators. 
    Newlines that live inside a string literal are fine.

    ```
    prompt example {""Multi line strings are fine
    but they MUST begin on the same line as the opening '{' 
    and end on the same line as the closing '}' ""}
    ```
    
    Matched Context from Sesi DB:
    Summary: " rec["summary"] "
    Key Rules: " rec["key_rules"]}

    prompt ragPrompt {"User Query: "queryText"
    
    Active File Context:
    "fileContext}

    prompt persona {"Your name is Sesira. Do not mention your name for no reason, only if the user asks. 
    - You are an expert in Sesi and very efficient at coding. 
    - You prefer an original way of doing things."}

    let sys = persona + instructions
    let generated_response = ""

    if !("OPENAI_API_KEY" | shell.env_get | is_null){
      try {
        generated_response = model("gpt-5.6-terra") {system: sys, thinkingLevel: "medium", max_tokens: 4096} {ragPrompt}
      } catch (e) {generated_response = model("gemini-3.6-flash") {system: sys, thinkingLevel: "low", max_tokens: 4096} {ragPrompt}}
    } else {
      generated_response = model("gemini-3.6-flash") {system: sys, thinkingLevel: "low", max_tokens: 4096} {ragPrompt}
    }
    
    let helpResponse = false
    let timestamp = now | format({"dateStyle": "short", "timeStyle": "medium"})
    timestamp = timestamp | swap("/", "-") | swap(":", "-") | swap(",", "") | swap(" ", "-")
    let responseFile = "chatbot/responses/sesira-help-" + timestamp + ".md"; "chatbot/responses" | make_dir
    
    try {
      helpResponse = responseFile | Safe.writeFile("# Sesira Response:\n\n" + generated_response)
      "SESI" | writeLog("Response written to " + responseFile)
      "SESIRA" | writeLog(generated_response)
    } catch (e) {
      "SESI" | writeLog("Failed to write " + responseFile + ": " + e)
    }
    show "Sesira has provided a response to your question:\n"generated_response"\n\nYour answer has also been saved at '" responseFile "'."
  }