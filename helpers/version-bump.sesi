/*
    VERSION BUMP SCRIPT

    Purpose: Automatically updates version numbers across the project.

    - Must be run in the root directory of the repository.
    - Prompts for the version to replace (FROM) and the new version (TO).
    - Searches and replaces in three locations:
        1. All .js files in the /bin directory (compiled outputs).
        2. All .md files in the /docs directory (documentation).
        3. All .md and .sesi files in the root directory (READMEs).

Usage:
    npm run version:bump
    sesi helpers/version-bump.sesi --custom // Prompts for custom FROM and TO values
*/
allow "safe" in with Safe
allow "std/terminal" in with {color}

fn isFile(fileName) {
    let hasExt = includes(fileName, ".")
    let isBinJS = ends_with(fileName, ".js")
    let isMD = ends_with(fileName, ".md")
    let isSesi = ends_with(fileName, ".sesi")
    if hasExt && (isBinJS || isMD || isSesi) {
        return true
    } else {
        return false
    }
}

let sesiBin = Safe.read("bin/sesi.js")

let docsDir = Safe.getFiles("docs")
let docsFiles = []
for file in docsDir {
    if isFile(file) {
        file = "docs/" + file
        push(docsFiles, file)
    }
}

let rootDir = Safe.getFiles(".")
let rootFiles = []
for file in rootDir {
    if isFile(file) {
        push(rootFiles, file)
    }
}

let exampleDir = Safe.getFiles("examples/main")
let exampleFiles = []
for file in exampleDir {
    if isFile(file) {
        file = "examples/main/" + file
        push(exampleFiles, file)
    }
}

let gettingStartedDir = Safe.getFiles("getting-started")
let gettingStartedFiles = []
for file in gettingStartedDir {
    if isFile(file) {
        file = "getting-started/" + file
        push(gettingStartedFiles, file)
    }
}

print "docsFiles:
" color(docsFiles, "cyan")"

rootFiles:
" color(rootFiles, "cyan")"

exampleFiles:
" color(exampleFiles, "cyan")"

gettingStartedFiles:
" color(gettingStartedFiles, "cyan")"
"

fn getVersionFromFile(fileName) {
    let fileContents = Safe.read(fileName)
    let lines = split(fileContents, "\n")
    let version = ""
    for line in lines {
        let cleanLine = trim(line)
        if starts_with(cleanLine, '"version"') {
            let parts = split(cleanLine, ":")
            if len(parts) > 1 {
                let v = parts[1]
                v = swap(v, '"', '')
                v = swap(v, ',', '')
                version = trim(v)
            }
            break
        }
    }
    return version
}

let pkgJSON = "package.json"
let editorsPkgJSON = "editors/vscode/package.json"
let v = getVersionFromFile(pkgJSON)

print "Current version:" color(v, "green")"
"
let fromVar = v
let toVar = ""
let customSwap = args[0]
if customSwap == "--custom" {
    fromVar = input("Enter version/text to swap from: ")
    toVar = input("Enter version/text to swap to: ")
} else {
    toVar = input("Enter version to swap to: ")
}
print "
================
" color("Starting swap...", "green")"
================
"

let getPkgJSON = Safe.read(pkgJSON)
let newPkgJSON = swap(getPkgJSON, v, toVar)
Safe.write(pkgJSON, newPkgJSON)
print color("Swapped "+v+" to "+toVar+" in "+pkgJSON, "green")"
"
if getVersionFromFile(editorsPkgJSON) == v {
    getPkgJSON = Safe.read(editorsPkgJSON)
    newPkgJSON = swap(getPkgJSON, v, toVar)
    Safe.write(editorsPkgJSON, newPkgJSON)
    print color("Swapped "+v+" to "+toVar+" in "+editorsPkgJSON, "green")"\n"
}

fn swapTag(file) {print color("Swapped "+fromVar+" to "+toVar+" in "+file, "green")"\n"}
fn skipTag(file) {print color("Skipping file:", "yellow")file}

try {
    let file = "bin/sesi.js"
    let contents = sesiBin
    let newContents = ""
    if contains(contents, fromVar) {
        newContents = swap(contents, fromVar, toVar)
        Safe.write(file, newContents)
        swapTag(file)
    } else {
        skipTag(file)
        print "Reason:" file "already up to date."
        print ""
    }
} catch(e) {
    print "An error occured:" color(str(e), "red")
}

for file in docsFiles {
    try {
        let contents = Safe.read(file)
        let newContents = ""
        if contains(contents, fromVar) {
            newContents = swap(contents, fromVar, toVar)
            Safe.write(file, newContents)
            swapTag(file)
        } else {
            skipTag(file)
            print "Reason:" file "already up to date."
            print ""
        }
    } catch(e) {
        print "An error occured:" color(str(e), "red")
    }
}

for file in rootFiles {
    try {
        let contents = Safe.read(file)
        let newContents = ""
        if contains(contents, fromVar) {
            newContents = swap(contents, fromVar, toVar)
            Safe.write(file, newContents)
            swapTag(file)
        } else {
            skipTag(file)
            print "Reason:" file "already up to date or doesn't contain" fromVar "at all."
            print ""
        }
    } catch(e) {
        print "An error occured:" color(str(e), "red")
    }
}

for file in exampleFiles {
    try {
        let contents = Safe.read(file)
        let newContents = ""
        if contains(contents, fromVar) {
            newContents = swap(contents, fromVar, toVar)
            Safe.write(file, newContents)
            swapTag(file)
        } else {
            skipTag(file)
            print "Reason:" file "already up to date or doesn't contain" fromVar "at all."
            print ""
        }
    } catch(e) {
        print "An error occured:" color(str(e), "red")
    }
}

for file in gettingStartedFiles {
    try {
        let contents = Safe.read(file)
        let newContents = ""
        if contains(contents, fromVar) {
            newContents = swap(contents, fromVar, toVar)
            Safe.write(file, newContents)
            swapTag(file)
        } else {
            skipTag(file)
            print "Reason:" file "already up to date or doesn't contain" fromVar "at all."
            print ""
        }
    } catch(e) {
        print "An error occured:" color(str(e), "red")
    }
}