/*
    VERSION BUMP SCRIPT

    Purpose: Automatically updates version numbers across the project.

    - Must be run in the root directory of the repository.
    - Prompts for the version to replace (FROM) and the new version (TO).
    - Searches and replaces in a few locations:
        1. bin/sesi.js (Sesi binary).
        2. All .md files in the /docs directory (documentation).
        3. All .md and .sesi files in the root directory (READMEs).
        4. All .md files in the /examples/main directory (example documentation).
        5. All .md files in the /getting-started directory (getting started guides).
        6. package.json and editors/vscode/package.json (version metadata).
        7. chatbot/index.html (version metadata).
        8. SesiInstaller.wxs (version metadata).
        9. src/pm.ts (version metadata).

Usage:
    npm run version:bump
    sesi helpers/version-bump.sesi --custom // Prompts for custom FROM and TO values
*/
allow"safe"in as Safe;allow"std/terminal"in with{color}
/*
  Checks if a given file is a valid file for version bumping.
  Valid files are those with extensions `.js`, `.md`, or `.sesi`.

  Parameters:
  - fileName: The name of the file to check.
  
  Returns:
  bool: true if the file is valid for version bumping, false otherwise.
*/
fn isFile(fileName){let hasExt=includes(fileName,".");let isBinJS=ends_with(fileName,".js");let isMD=ends_with(fileName,".md");let isSesi=ends_with(fileName,".sesi");if hasExt&&(isBinJS||isMD||isSesi){return true}else{return false}}let sesiBin=Safe.read("bin/sesi.js");let docsDir=Safe.getFiles("docs");let docsFiles=[];for file in docsDir{if isFile(file){file="docs/"+file;push(docsFiles,file)}}let rootDir=Safe.getFiles(".");let rootFiles=[];for file in rootDir{if isFile(file){push(rootFiles,file)}}let exampleDir=Safe.getFiles("examples/main");let exampleFiles=[];for file in exampleDir{if isFile(file){file="examples/main/"+file;push(exampleFiles,file)}}let gettingStartedDir=Safe.getFiles("getting-started");let gettingStartedFiles=[];for file in gettingStartedDir{if isFile(file){file="getting-started/"+file;push(gettingStartedFiles,file)}}show"docsFiles:
"color(docsFiles,"cyan")"

rootFiles:
"color(rootFiles,"cyan")"

exampleFiles:
"color(exampleFiles,"cyan")"

gettingStartedFiles:
"color(gettingStartedFiles,"cyan")"
";
/**
  Extracts the version string from a given file.
  The file is expected to contain a line with the format `"version": "x.y.z"`.

  Parameters:
  - fileName: The name of the file to extract the version from.

  Returns:
  string: The extracted version string, or an empty string if not found.
*/
fn getVersionFromFile(fileName){let fileContents=Safe.read(fileName);let lines=split(fileContents,"\n");let version="";for line in lines{let cleanLine=trim(line);if starts_with(cleanLine,'"version"'){let parts=split(cleanLine,":");if len(parts)>1{let v=parts[1];v=swap(v,'"','');v=swap(v,',','');version=trim(v)}break}}return version}let pkgJSON="package.json";let editorsPkgJSON="editors/vscode/package.json";let v=getVersionFromFile(pkgJSON);show"Current version:"color(v,"green")"
";let fromVar=v;let toVar="";let customSwap=args[0];if customSwap=="--custom"{fromVar=input("Enter version/text to swap from: ");toVar=input("Enter version/text to swap to: ")}else{toVar=input("Enter version to swap to: ")}show"
================
"color("Starting swap...","green")"
================
";let getPkgJSON=Safe.read(pkgJSON);let newPkgJSON=swap(getPkgJSON,v,toVar);Safe.write(pkgJSON,newPkgJSON);show color("Swapped "+v+" to "+toVar+" in "+pkgJSON,"green")"
";if getVersionFromFile(editorsPkgJSON)==v{getPkgJSON=Safe.read(editorsPkgJSON);newPkgJSON=swap(getPkgJSON,v,toVar);Safe.write(editorsPkgJSON,newPkgJSON);show color("Swapped "+v+" to "+toVar+" in "+editorsPkgJSON,"green")"\n"}
/**
  Shows a message indicating that a file was successfully swapped during the version bump process.

  Parameters:
  - file: The name of the file that was swapped.
*/
fn swapTag(file){show color("Swapped "+fromVar+" to "+toVar+" in "+file,"green")"\n"}
/**
  Shows a message indicating that a file was skipped during the version bump process.

  Parameters:
  - file: The name of the file that was skipped.
*/
fn skipTag(file){show color("Skipping file:","yellow")file}try{let file="bin/sesi.js";let contents=sesiBin;let newContents="";if contains(contents,fromVar){newContents=swap(contents,fromVar,toVar);Safe.write(file,newContents);swapTag(file)}else{skipTag(file);show"Reason:"file"already up to date.";show""}}catch(e){show"An error occured:"color(str(e),"red")}try{let file="chatbot/index.html";let contents=Safe.read(file);let newContents="";if contains(contents,fromVar){newContents=swap(contents,fromVar,toVar);Safe.write(file,newContents);swapTag(file)}else{skipTag(file);show"Reason:"file"already up to date.";show""}}catch(e){show"An error occured:"color(str(e),"red")}try{let file="SesiInstaller.wxs";let contents=Safe.read(file);let newContents="";if contains(contents,fromVar){newContents=swap(contents,fromVar,toVar);Safe.write(file,newContents);swapTag(file)}else{skipTag(file);show"Reason:"file"already up to date.";show""}}catch(e){show"An error occured:"color(str(e),"red")}try{let file="src/pm.ts";let contents=Safe.read(file);let newContents="";if contains(contents,fromVar){newContents=swap(contents,fromVar,toVar);Safe.write(file,newContents);swapTag(file)}else{skipTag(file);show"Reason:"file"already up to date.";show""}}catch(e){show"An error occured:"color(str(e),"red")}for file in docsFiles{try{let contents=Safe.read(file);let newContents="";if contains(contents,fromVar){newContents=swap(contents,fromVar,toVar);Safe.write(file,newContents);swapTag(file)}else{skipTag(file);show"Reason:"file"already up to date.";show""}}catch(e){show"An error occured:"color(str(e),"red")}}for file in rootFiles{try{let contents=Safe.read(file);let newContents="";if contains(contents,fromVar){newContents=swap(contents,fromVar,toVar);Safe.write(file,newContents);swapTag(file)}else{skipTag(file);show"Reason:"file"already up to date or doesn't contain"fromVar"at all.";show""}}catch(e){show"An error occured:"color(str(e),"red")}}for file in exampleFiles{try{let contents=Safe.read(file);let newContents="";if contains(contents,fromVar){newContents=swap(contents,fromVar,toVar);Safe.write(file,newContents);swapTag(file)}else{skipTag(file);show"Reason:"file"already up to date or doesn't contain"fromVar"at all.";show""}}catch(e){show"An error occured:"color(str(e),"red")}}for file in gettingStartedFiles{try{let contents=Safe.read(file);let newContents="";if contains(contents,fromVar){newContents=swap(contents,fromVar,toVar);Safe.write(file,newContents);swapTag(file)}else{skipTag(file);show"Reason:"file"already up to date or doesn't contain"fromVar"at all.";show""}}catch(e){show"An error occured:"color(str(e),"red")}}