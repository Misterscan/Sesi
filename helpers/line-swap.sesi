/*
    Line-by-line text swap helper for files.

    Reads a file, iterates every line, and replaces all occurrences
    matching a regular-expression pattern with a replacement string.
    Optionally limits replacements to a line range or reports a dry run.

Usage:
    sesi helpers/line-swap.sesi <path> <pattern> <replacement>
    sesi helpers/line-swap.sesi <path> <pattern> <replacement> dry-run
    sesi helpers/line-swap.sesi <path> <pattern> <replacement> lines <start> <end>
    sesi helpers/line-swap.sesi <path> <pattern> <replacement> flags <flags>
    sesi helpers/line-swap.sesi <path> <pattern> <replacement> backup
    sesi helpers/line-swap.sesi help

Examples:
    sesi helpers/line-swap.sesi src/main.sesi "let debug = true" "let debug = false"
    sesi helpers/line-swap.sesi README.md "v[0-9]+\\.[0-9]+" "v2.0" dry-run
    sesi helpers/line-swap.sesi app.sesi "\\bold_fn\\b" "new_fn" lines 10 50
    sesi helpers/line-swap.sesi routes.sesi "\\bGET /v1/" "POST /v2/" flags i
*/
allow "safe" in with safe

fn show_help() {
  print "line-swap.sesi — line-by-line text swap helper"
  print ""
  print "Usage:"
  print "  sesi helpers/line-swap.sesi <path> <pattern> <replacement> [options]"
  print ""
  print "Options:"
  print "  pattern        JavaScript-compatible regular expression"
  print "  replacement    Supports capture references such as $1 and $<name>"
  print "  dry-run        Preview changes without writing to disk"
  print "  lines N M      Only swap within line range N to M (1-indexed, inclusive)"
  print "  backup         Archive the original file before overwriting"
  print "  flags VALUE    Regex flags such as i, m, or s; global replacement is always enabled"
  print ""
  print "Examples:"
  print "  sesi helpers/line-swap.sesi src/main.sesi \"let debug = true\" \"let debug = false\""
  print "  sesi helpers/line-swap.sesi README.md \"v[0-9]+\\.[0-9]+\" \"v2.0\" dry-run"
  print "  sesi helpers/line-swap.sesi app.sesi \"\\bold_fn\\b\" \"new_fn\" lines 10 50"
  print "  sesi helpers/line-swap.sesi routes.sesi \"\\bGET /v1/\" \"POST /v2/\" flags i"
}

fn parse_options() {
  let options = {
    "dry_run": false,
    "backup": false,
    "flags": "g",
    "line_start": null,
    "line_end": null
  }

  let i = 3
  while i < len(args) {
    let key = args[i]

    if key == "--dry-run" || key == "dry-run" {
      options["dry_run"] = true
      i = i + 1
    } else if key == "--flags" || key == "flags" {
      if i + 1 < len(args) && regex("^[dgimsuvy]+$", args[i + 1], {"mode": "test"}) {
        options["flags"] = args[i + 1]
        i = i + 2
      } else {
        print "Missing or invalid regex flags"
        i = i + 1
      }
    } else if key == "--backup" || key == "backup" {
      options["backup"] = true
      i = i + 1
    } else if key == "--lines" || key == "lines" {
      if i + 2 < len(args) {
        options["line_start"] = num(args[i + 1])
        options["line_end"] = num(args[i + 2])
        i = i + 3
      } else {
        print "Missing values for lines <start> <end>"
        i = i + 1
      }
    } else {
      print "Ignoring unknown option:" key
      i = i + 1
    }
  }

  return options
}

fn in_range(line_number: num, options) -> bool {
  if options["line_start"] == null {
    return true
  }

  if line_number < options["line_start"] {
    return false
  }

  if options["line_end"] != null {
    if line_number > options["line_end"] {
      return false
    }
  }

  return true
}

fn read_text(path: str) {
  try {
    return safe.read(path)
  } catch (err) {
    print "Read failed for" path ":" err
    return null
  }
}

fn write_text(path: str, text: str) -> bool {
  try {
    safe.write(path, text)
    return true
  } catch (err) {
    print "Write failed for" path ":" err
    return false
  }
}

fn run_swap(path: str, pattern: str, replacement: str, options) {
  let text = read_text(path)

  if text == null {
    return null
  }

  let lines = split(text, "
")

  let updated_lines = []
  let swap_count = 0
  let line_number = 1

  for line in lines {
    if in_range(line_number, options) {
      let matches = regex(pattern, line, {"mode": "match", "flags": options["flags"], "limit": 1})

      if len(matches) > 0 {
        let flags = options["flags"]
        if !contains(flags, "g") {
          flags = flags + "g"
        }
        let new_line = regex(pattern, line, {"mode": "replace", "flags": flags, "replacement": replacement})

        if new_line == line {
          push(updated_lines, line)
        } else {
          push(updated_lines, new_line)

          if options["dry_run"] {
            print "[line " line_number "] -" line
            print "[line " line_number "] +" new_line
          }

          swap_count = swap_count + 1
        }
      } else {
        push(updated_lines, line)
      }
    } else {
      push(updated_lines, line)
    }

    line_number = line_number + 1
  }

  if swap_count == 0 {
    print "No matches found for pattern:" pattern
    return null
  }

  print "Lines matched:" swap_count

  if options["dry_run"] {
    print "[dry-run] No changes written to" path
    return null
  }

  if options["backup"] {
    try {
      archive(path)
      print "Backup saved for" path
    } catch (err) {
      print "Backup failed:" err
    }
  }

  let result = join(updated_lines, "
")

  let ok = write_text(path, result)

  if ok {
    print "Done. Saved:" path
  }
}

if len(args) == 0 {
  show_help()
} else if args[0] == "help" {
  show_help()
} else if len(args) < 3 {
  print "Missing arguments."
  show_help()
} else {
  let path = args[0]
  let from_text = args[1]
  let to_text = args[2]
  let options = parse_options()

  run_swap(path, from_text, to_text, options)
}
