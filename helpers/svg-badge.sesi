/**
  Generates a two-part SVG badge with a label and a colored value.

  Usage:
    sesi helpers/svg-badge.sesi <label> <value> <color> <output>

  Example:
    sesi helpers/svg-badge.sesi Sesi passing "#22c55e" badge.svg
*/
allow"std/draw"in as Draw;let HEIGHT=28;let RADIUS=7;let PADDING=10;let VALUE_INSET=23;let FONT="system-ui, -apple-system, sans-serif";fn show_help(){show"Usage:";show"  sesi helpers/svg-badge.sesi <label> <value> <color> <output>";show"";show"Example:";show"  sesi helpers/svg-badge.sesi Sesi passing \"#22c55e\" badge.svg"}fn estimate_text_width(text:str)->num{let width=0;for glyph in split(text,""){if contains(" ilI.,:;!|'’",glyph){width=width+4}else if contains("abcdefghjknopqrstuvxyz0123456789-+_/()",glyph){width=width+8}else if contains("ABCDEFGHJKLNOPQRSTUVXYZ",glyph){width=width+10}else{width=width+14}}return width}
// Draw.text escapes its content. Raw SVG titles and paint values need escaping here.
fn escape_xml(text:str)->str{let escaped=join(split(text,"&"),"&amp;");escaped=join(split(escaped,"<"),"&lt;");escaped=join(split(escaped,">"),"&gt;");return join(split(escaped,"\""),"&quot;")}fn render_badge(label:str,value:str,color:str)->num{let label_width=estimate_text_width(label)+PADDING*2;let width=label_width+VALUE_INSET+estimate_text_width(value)+PADDING;let seam=str(label_width/width*100)+"%";let accent=escape_xml(color);Draw.clear();Draw.gradient("linear","surface",[{offset:"0%",color:"#253142"},{offset:"100%",color:"#141c29"}],{x1:"0%",y1:"0%",x2:"0%",y2:"100%"});
// A hard stop confines the tint to the value panel, leaving both outside corners rounded.
Draw.gradient("linear","tint",[{offset:seam,color:accent,opacity:0},{offset:seam,color:accent,opacity:0.27},{offset:"100%",color:accent,opacity:0.15}],{x1:"0%",y1:"0%",x2:"100%",y2:"0%"});Draw.raw("<title>"+escape_xml(label+": "+value)+"</title>");Draw.rect(0,0,width,HEIGHT,"url(#surface)",{rx:RADIUS});Draw.rect(0,0,width,HEIGHT,"url(#tint)",{rx:RADIUS});Draw.line(label_width,1,label_width,HEIGHT-1,"#ffffff",{"stroke-opacity":0.16});Draw.rect(0.5,0.5,width-1,HEIGHT-1,"none",{rx:RADIUS-0.5,stroke:"#ffffff","stroke-opacity":0.19});Draw.circle(label_width+11,HEIGHT/2,3.5,accent,{stroke:"#ffffff","stroke-opacity":0.44,"stroke-width":1});Draw.text(label_width/2,18.5,label,13,"#dbe5f1",{"font-family":FONT,"font-weight":"550","text-anchor":"middle"});Draw.text(label_width+VALUE_INSET,18.5,value,13,"#ffffff",{"font-family":FONT,"font-weight":"700"});return width}if len(args)<4{show_help()}else{let label=args[0];let value=args[1];let color=args[2];let output=args[3];try{let width=render_badge(label,value,color);Draw.save_svg(output,width,HEIGHT);show"Badge written:"output;show"Label:"label;show"Value:"value;show"Color:"color;show"Size:"width"x"HEIGHT}catch(err){show"Could not generate badge:"err}}