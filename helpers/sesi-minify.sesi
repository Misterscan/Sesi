/*
  Token-aware Sesi source minifier.

  Usage:
    sesi helpers/sesi-minify.sesi input.sesi [output.sesi]

  With no output path, input.sesi becomes input.min.sesi. The input is
  never overwritten. Strings and newlines inside strings are preserved.
*/

fn is_letter(char){return char!=""&&contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_",char)}fn is_digit(char){return char!=""&&contains("0123456789",char)}fn is_word_char(char){return is_letter(char)||is_digit(char)||char=="$"}fn needs_space(left,right){if left==""{return false}let tail=slice(left,len(left)-1);let head=slice(right,0,1);if is_word_char(tail)&&is_word_char(head){return true}if is_digit(tail)&&head=="."{return true}if tail=="."&&is_digit(head){return true}let pair=tail+head;let joined=["==","!=","<=",">=","<>","->","?.","||","&&","//","/*","*/"];for operator in joined{if pair==operator{return true}}return false}export fn minify_sesi(source:string)->string{let chars=split(source,"");let tokens=[];let i=0;while i<len(chars){let char=chars[i];let next="";if i+1<len(chars){next=chars[i+1]}if char==" "||char=="\t"||char=="\r"{i=i+1;continue}if char=="\n"{if len(tokens)>0&&tokens[len(tokens)-1]!="\n"{push(tokens,"\n")}i=i+1;continue}if char=="/"&&next=="/"{let comment="//";i=i+2;while i<len(chars)&&chars[i]!="\n"{comment=comment+chars[i];i=i+1}push(tokens,comment);continue}if char=="/"&&next=="*"{let comment="/*";i=i+2;while i<len(chars){let current=chars[i];comment=comment+current;i=i+1;if current=="*"&&i<len(chars)&&chars[i]=="/"{comment=comment+"/";i=i+1;break}}push(tokens,comment);continue}let token=char;if char=="\""||char=="'"{let quote=char;i=i+1;let escaped=false;while i<len(chars){let current=chars[i];token=token+current;i=i+1;if escaped{escaped=false}else if current=="\\"{escaped=true}else if current==quote{break}}}else if is_letter(char)||char=="$"{i=i+1;while i<len(chars)&&is_word_char(chars[i]){token=token+chars[i];i=i+1}}else if is_digit(char){i=i+1;while i<len(chars)&&is_digit(chars[i]){token=token+chars[i];i=i+1}if i+1<len(chars)&&chars[i]=="."&&is_digit(chars[i+1]){token=token+".";i=i+1;while i<len(chars)&&is_digit(chars[i]){token=token+chars[i];i=i+1}}}else{let pair=char+next;let two_char=["==","!=","<=",">=","<>","->","?.","||","&&"];for operator in two_char{if pair==operator{token=pair;break}}i=i+len(token)}push(tokens,token)}let output=[];let contexts=[];let previous="";let before_previous="";let pending_newline=false;let last_paren_owner="";let closed_brace_kind="";let expects_block=false;let after_doc_comment=false;for token in tokens{if starts_with(token,"/*")||starts_with(token,"//"){if pending_newline&&len(output)>0{if previous!="}"&&previous!="{"&&previous!=";"{push(output,";")}push(output,"\n")}push(output,token);push(output,"\n");previous="";before_previous="";pending_newline=false;after_doc_comment=true;continue}if token=="\n"{if after_doc_comment{after_doc_comment=false;continue}pending_newline=true;continue}after_doc_comment=false;if token==";"&&previous=="}"&&(len(contexts)==0||contexts[len(contexts)-1].kind=="block"){pending_newline=false;continue}let inside_expression=false;if len(contexts)>0&&contexts[len(contexts)-1].kind!="block"{inside_expression=true}if pending_newline&&len(output)>0{let separator=true;if inside_expression||previous=="{"||previous==";"||token=="}"||token=="{"{separator=false}if token=="else"||token=="catch"||token=="finally"{separator=false}if previous=="}"&&!inside_expression{separator=false}if separator{push(output,";")}else if needs_space(previous,token){push(output," ")}}else if needs_space(previous,token){push(output," ")}pending_newline=false;push(output,token);if token=="("{let owner=previous;if before_previous=="fn"{owner="fn"}push(contexts,{"kind":"paren","owner":owner})}else if token=="["{push(contexts,{"kind":"bracket","owner":""})}else if token=="{"{let kind="block";if previous=="="||previous==":"||previous==","||previous=="("||previous=="["||previous=="return"||previous=="with"||previous=="import"{kind="object"}if before_previous=="prompt"||(previous=="}"&&closed_brace_kind=="object"){kind="prompt"}if previous==")"&&last_paren_owner!="fn"&&last_paren_owner!="if"&&last_paren_owner!="while"&&last_paren_owner!="for"&&last_paren_owner!="catch"{kind="object"}if expects_block{kind="block"}expects_block=false;push(contexts,{"kind":kind,"owner":""})}else if token==")"||token=="]"||token=="}"{if len(contexts)>0{let closed=pop(contexts);if token==")"{last_paren_owner=closed.owner}if token=="}"{closed_brace_kind=closed.kind}}}if token=="fn"||token=="if"||token=="while"||token=="for"||token=="try"||token=="catch"||token=="finally"||token=="else"{expects_block=true}before_previous=previous;previous=token}return join(output,"")}if len(args)==0||args[0]=="--help"||args[0]=="-h"{show"Usage: sesi helpers/sesi-minify.sesi input.sesi [output.sesi]"}else{let input_path=args[0];let output_path="";if len(args)>1{output_path=args[1]}else if ends_with(input_path,".sesi"){output_path=slice(input_path,0,len(input_path)-5)+".min.sesi"}else{show"Input must be a .sesi file"}if output_path!=""{if input_path==output_path{show"Output path must differ from input path"}else{try{let source=read_file(input_path);let result=minify_sesi(source);if write_file(output_path,result){show"Saved"output_path"("len(source)"->"len(result)"characters )"}}catch(error){show"Minify failed:"error}}}}