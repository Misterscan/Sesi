/**
  Analyzes Sesi module imports and exports a dependency diagram.

  Usage:
    sesi helpers/dependency-graph.sesi <entry_file> [svg <file>] [json <file>] [all]
    sesi helpers/dependency-graph.sesi usage
*/
allow"safe"in as Safe;allow"std/draw"in as Draw;let CARD_WIDTH=252;let CARD_HEIGHT=56;let COLUMN_GAP=100;let ROW_STEP=78;let MARGIN=32;let BODY_TOP=130;let FONT="system-ui, -apple-system, sans-serif";let MONO="ui-monospace, Menlo, Consolas, monospace";let IMPORT_COLOR="#79a7cf";let CYCLE_COLOR="#ff9c86";fn show_help(){show"Sesi Dependency Graph Analyzer";show"";show"Usage:";show"  sesi helpers/dependency-graph.sesi <entry_file> [options]";show"";show"Options:";show"  svg <file>   Write an SVG diagram (default: dependency-graph.svg)";show"  json <file>  Write JSON adjacency data (.json is added if omitted)";show"  all          Include Sesi standard library modules (std/*)";show"  usage       Show this help menu";show"";show"Example:";show"  sesi helpers/dependency-graph.sesi helpers/readme-banner.sesi all svg graph.svg json graph.json"}export fn get_dirname(path:string)->string{let parts=split(path,"/");if len(parts)<=1{return"."}let dir=join(slice(parts,0,len(parts)-1),"/");if dir==""{return"/"}return dir}export fn join_paths(dir:string,file:string)->string{if starts_with(file,"/")||dir=="."||dir==""{return file}if ends_with(dir,"/"){return dir+file}return dir+"/"+file}export fn normalize_path(path:string)->string{let absolute=starts_with(path,"/");let clean=[];for part in split(path,"/"){if part==".."{if len(clean)>0&&clean[len(clean)-1]!=".."{clean=slice(clean,0,len(clean)-1)}else if!absolute{push(clean,part)}}else if part!="."&&part!=""{push(clean,part)}}let result=join(clean,"/");if absolute{return"/"+result}if result==""{return"."}return result}fn read_env(name:string)->string{try{let value=env(name);if value!=null{return trim(value)}}catch(err){return""}return""}fn module_exists(path:string)->bool{try{return Safe.fileExists(path)}catch(err){
// A configured search directory may be outside the CLI's allowed paths.
return false}}fn resolve_path(source:string,importing_file:string)->string{let has_extension=ends_with(source,".sesi");let filename=source;if!has_extension{filename=source+".sesi"}let search_dirs=[get_dirname(importing_file),".","sesi_modules"];let search_path=read_env("SESI_PATH");if search_path!=""&&search_path!="%SESI_PATH%"&&search_path!="$SESI_PATH"{let separator=":";if contains(search_path,";"){separator=";"}for dir in split(search_path,separator){if dir!=""{push(search_dirs,dir)}}}let home=read_env("HOME");if home==""{home=read_env("USERPROFILE")}if home!=""&&home!="%USERPROFILE%"&&home!="$HOME"{push(search_dirs,join_paths(home,".sesi/lib"))}for dir in search_dirs{let candidate=normalize_path(join_paths(dir,filename));if module_exists(candidate){return candidate}if!has_extension{let folder=normalize_path(join_paths(dir,source));for entry in["index.sesi","main.sesi"]{let entry_path=join_paths(folder,entry);if module_exists(entry_path){return entry_path}}}}return normalize_path(join_paths(get_dirname(importing_file),filename))}
// Consume comments and string literals so code examples inside either cannot create edges.
let module_gap="(?:\\s|//[^\\n]*|/\\*[\\s\\S]*?\\*/)*";let quoted_module="\"(?:[^\"\\\\]|\\\\[\\s\\S])*\"|'(?:[^'\\\\]|\\\\[\\s\\S])*'";let module_prefix="(?:allow\\b"+module_gap+"|import\\b"+module_gap+"(?:[A-Za-z_][\\w]*|\\{[^}]*\\})"+module_gap+"from\\b"+module_gap+")";let module_pattern="//[^\\n]*|/\\*[\\s\\S]*?(?:\\*/|$)|(?<![\\w.])"+module_prefix+"("+quoted_module+")|"+quoted_module;fn decode_path(literal:string)->string{let path="";let escapes={n:"\n",t:"\t",r:"\r"}let chars=split(literal,"");let i=1;while i<len(chars)-1{let ch=chars[i];if ch=="\\"{i=i+1;ch=chars[i];if escapes[ch]!=null{ch=escapes[ch]}}path=path+ch;i=i+1}return path}fn find_modules(content:string){let sources=[];let matches=regex(module_pattern,content,{limit:len(content)+1});for item in matches{let literal=item["captures"][0];if literal!=null{push(sources,decode_path(literal))}}return sources}export fn extract_module(line:string)->any{let modules=find_modules(line);if len(modules)>0{return modules[0]}return null}let graph={}let missing={}fn scan_graph(entry:string,include_all:bool){let pending=[{path:entry,parent:null}];let queued={}queued[entry]=true;let i=0;while i<len(pending){let item=pending[i];let path=item["path"];i=i+1;let content=null;let attempts=0;while content==null&&attempts<2{try{content=read_file(path)}catch(err){attempts=attempts+1}}let deps=[];graph[path]=deps;if content==null{missing[path]=true;if item["parent"]==null{show"Module file not found or unreadable:"path}else{let origin="(imported by "+item["parent"]+")";show"Module file not found or unreadable:"path origin}}else{for source in find_modules(content){let is_std=starts_with(source,"std/");if!is_std||include_all{let dep=source;if!is_std{dep=resolve_path(source,path);if queued[dep]==null{queued[dep]=true;push(pending,{path:dep,parent:path})}}if!includes(deps,dep){push(deps,dep)}}}}}}
// The tree and the cycle detector share a traversal. Expand each module once.
let tree_state={}let cycle_edges={}fn show_tree(node:string,prefix:string,is_last:bool){let connector="├── ";let padding="│   ";if is_last{connector="└── ";padding="    "}let line=prefix+connector+node;if tree_state[node]=="active"{show line"(circular)";return null}if tree_state[node]=="done"{show line"(shared)";return null}if missing[node]!=null{line=line+" (unreadable)"}show line;tree_state[node]="active";let deps=graph[node];if deps!=null{let i=0;while i<len(deps){let dep=deps[i];if tree_state[dep]=="active"{if cycle_edges[node]==null{cycle_edges[node]={}}cycle_edges[node][dep]=true}show_tree(dep,prefix+padding,i==len(deps)-1);i=i+1}}tree_state[node]="done"}fn is_cycle_edge(source:string,target:string)->bool{return cycle_edges[source]!=null&&cycle_edges[source][target]==true}fn build_layout(entry:string){let layers=[[entry]];let nodes=[entry];let positions={}positions[entry]={depth:0,row:0}let imports=0;let returns=0;let index=0;
// Breadth-first order puts each module at its shortest distance from the entry file.
while index<len(nodes){let node=nodes[index];let depth=positions[node]["depth"];let deps=graph[node];if deps!=null{for dep in deps{imports=imports+1;if positions[dep]==null{let next_depth=depth+1;if len(layers)<=next_depth{push(layers,[])}positions[dep]={depth:next_depth,row:len(layers[next_depth])}push(layers[next_depth],dep);push(nodes,dep)}else if positions[dep]["depth"]<depth{returns=returns+1}}}index=index+1}let tallest=1;for layer in layers{if len(layer)>tallest{tallest=len(layer)}}let width=MARGIN*2+len(layers)*CARD_WIDTH+(len(layers)-1)*COLUMN_GAP+48;if width<680{width=680}let first_x=MARGIN;if len(layers)==1{first_x=(width-CARD_WIDTH)/2}let body_top=BODY_TOP+returns*10;for node in nodes{let position=positions[node];let depth=position["depth"];position["x"]=first_x+depth*(CARD_WIDTH+COLUMN_GAP);position["y"]=body_top+(tallest-len(layers[depth]))*ROW_STEP/2+position["row"]*ROW_STEP}let height=body_top+(tallest-1)*ROW_STEP+CARD_HEIGHT+MARGIN;return{nodes:nodes,positions:positions,width:width,height:height,imports:imports}}fn escape_xml(text:string)->string{let escaped=join(split(text,"&"),"&amp;");escaped=join(split(escaped,"<"),"&lt;");return join(split(escaped,">"),"&gt;")}fn shorten(text:string,limit:num)->string{
// Some fallback glyphs occupy two monospace columns.
if regex("[^\\x00-\\xFF]",text,{mode:"test"}){limit=floor(limit/2)}if len(text)<=limit{return text}let chars=regex(".",text,{flags:"su",limit:len(text)+1});if len(chars)<=limit{return text}let leading=floor(limit/2);let trailing=limit-leading-1;return slice(text,0,chars[leading]["index"])+"…"+slice(text,chars[len(chars)-trailing]["index"])}fn counted(count:num,noun:string)->string{if count==1{return"1 "+noun}return str(count)+" "+noun+"s"}fn draw_header(layout){let width=layout["width"];let height=layout["height"];Draw.gradient("linear","surface",[{offset:"0%",color:"#172840"},{offset:"100%",color:"#0b1423"}],{x1:"0%",y1:"0%",x2:"54%",y2:"100%"});Draw.rect(0,0,width,height,"url(#surface)",{rx:18});Draw.rect(0.5,0.5,width-1,height-1,"none",{rx:17.5,stroke:"#435776"});Draw.text(MARGIN,49,"Dependency graph",26,"#f0f6ff",{"font-family":FONT,"font-weight":"700"});let stats=counted(len(layout["nodes"]),"module")+"  ·  "+counted(layout["imports"],"import");Draw.text(MARGIN,76,stats,13,"#afc1d9",{"font-family":FONT});Draw.line(width-252,46,width-226,46,IMPORT_COLOR,{"stroke-width":1.6,"marker-end":"url(#import-arrow)"});Draw.text(width-214,50,"Import",12,"#d7e6f8",{"font-family":FONT});Draw.line(width-153,46,width-127,46,CYCLE_COLOR,{"stroke-width":1.6,"stroke-dasharray":"4 3","marker-end":"url(#cycle-arrow)"});Draw.text(width-115,50,"Cycle back edge",12,"#d7e6f8",{"font-family":FONT});Draw.line(MARGIN,98,width-MARGIN,98,"#415671")}fn draw_node(node:string,position,entry:string){let x=position["x"];let y=position["y"];let surface="#17263b";let line="#546d8c";let accent="#a1c6ef";let parts=split(node,"/");let name=parts[len(parts)-1];let context=get_dirname(node);if node==entry{surface="#153737";line="#5abca6";accent="#94ebd3";context="Entry · "+context}else if starts_with(node,"std/"){surface="#262640";line="#7972a7";accent="#c7bfff";context="Standard library"}if missing[node]!=null{line="#bf8267";accent="#ffc1a6";context="Unreadable · "+context}Draw.raw("<g><title>"+escape_xml(node)+"</title>");Draw.rect(x,y,CARD_WIDTH,CARD_HEIGHT,surface,{rx:10,stroke:line});Draw.rect(x+10,y+14,3,28,accent,{rx:1.5});Draw.text(x+24,y+24,shorten(name,25),14,"#f2f6ff",{"font-family":MONO,"font-weight":"600"});Draw.text(x+24,y+43,shorten(context,32),11,accent,{"font-family":MONO});Draw.raw("</g>")}fn point(x:num,y:num)->string{return str(x)+" "+str(y)}fn draw_edge(source,target,circular:bool,lane:num){let sx=source["x"];let sy=source["y"]+CARD_HEIGHT/2;let tx=target["x"];let ty=target["y"]+CARD_HEIGHT/2;let path="";if source["depth"]<target["depth"]{let start=sx+CARD_WIDTH+2;let end=tx-3;let bend=(start+end)/2;path="M "+point(start,sy)+" C "+point(bend,sy)+" "+point(bend,ty)+" "+point(end,ty)}else if source["depth"]==target["depth"]{let start=sx+CARD_WIDTH+2;let bend=start+18+(lane%4)*7;let port_offset=8;if source["row"]==target["row"]{port_offset=15}path="M "+point(start,sy-port_offset)+" H "+str(bend)+" V "+str(ty+port_offset)+" H "+str(start+1)}else{let source_gutter=sx-23;let target_gutter=tx+CARD_WIDTH+24;let lane_y=BODY_TOP-12+lane*10;path="M "+point(sx-2,sy)+" H "+str(source_gutter)+" V "+str(lane_y)+" H "+str(target_gutter)+" V "+str(ty-9)+" H "+str(tx+CARD_WIDTH+3)}let attrs={stroke:IMPORT_COLOR,"stroke-width":1.5,"stroke-linejoin":"round","marker-end":"url(#import-arrow)"}if circular{attrs["stroke"]=CYCLE_COLOR;attrs["stroke-width"]=1.8;attrs["stroke-dasharray"]="5 4";attrs["marker-end"]="url(#cycle-arrow)"}Draw.path(path,"none",attrs)}fn render_graph(entry:string,layout){Draw.clear();Draw.raw("<title>Dependency graph for "+escape_xml(entry)+"</title>");Draw.raw("<defs>
    <marker id=\"import-arrow\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\"><path d=\"M 0 0 L 8 4 L 0 8 Z\" fill=\""+IMPORT_COLOR+"\" /></marker>
    <marker id=\"cycle-arrow\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\"><path d=\"M 0 0 L 8 4 L 0 8 Z\" fill=\""+CYCLE_COLOR+"\" /></marker>
  </defs>");draw_header(layout);let positions=layout["positions"];let return_lane=0;let same_layer_lane=0;for node in layout["nodes"]{let deps=graph[node];if deps!=null{let source=positions[node];for dep in deps{let target=positions[dep];let lane=0;if source["depth"]>target["depth"]{lane=return_lane;return_lane=return_lane+1}else if source["depth"]==target["depth"]{lane=same_layer_lane;same_layer_lane=same_layer_lane+1}draw_edge(source,target,is_cycle_edge(node,dep),lane)}}}for node in layout["nodes"]{draw_node(node,positions[node],entry)}}fn run_graph(){let entry=normalize_path(args[0]);let svg_file="dependency-graph.svg";let json_file=null;let include_all=false;let i=1;while i<len(args){let option=args[i];if option=="--svg"||option=="svg"||option=="--json"||option=="json"{if i+1>=len(args){show"Missing value for"option}else{if option=="--svg"||option=="svg"{svg_file=args[i+1]}else{json_file=args[i+1]}i=i+1}}else if option=="--all"||option=="all"{include_all=true}else{show"Unknown option:"option}i=i+1}show"Scanning dependencies from"entry;scan_graph(entry,include_all);show"";show"Dependency tree";show_tree(entry,"",true);let layout=build_layout(entry);render_graph(entry,layout);try{Draw.save_svg(svg_file,layout["width"],layout["height"]);show"SVG dependency graph saved to"svg_file}catch(err){show"Could not write SVG:"err}if json_file!=null{if!ends_with(json_file,".json"){json_file=json_file+".json"}show Safe.write(json_file,to_json(graph))}}if len(args)>0{if args[0]=="usage"||args[0]=="--help"||args[0]=="help"{show_help()}else{run_graph()}}