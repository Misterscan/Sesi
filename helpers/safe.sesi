}

/**
  Appends content to a file.

  Parameters:
  - path: File to update.
  - content: Text to append.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  addToFile("report.txt", "Summary\n")
  ```
*/
export fn addToFile(path: string, content: string) -> any {
