/*
    Safe File Access
   Resilient file operations wrapped in try-catch blocks with retry logic to prevent crashes.
*/

allow "std/time" in with Time

// Resilience Helper: Safe file read with retry logic
export fn readFile(path: string, mode: string) -> string {
  let result = ""
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      if mode == "" || is_null(mode) {
        mode = "text"
      }
      result = read_file(path, mode)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  return result
}

// Resilience Helper: Safe file write with retry logic
export fn writeFile(path: string, content: string) -> bool {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      write_file(path, content)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  return success
}

