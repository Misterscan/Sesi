/**
  Builds and optionally saves a complete HTML document.

  Parameters:
  - title: Page title and default output filename source.
  - content: Markup placed inside the document body.
  - head: Additional markup inserted into the head.
  - css: Empty string, a stylesheet filename, or CSS content.
  - language: HTML language attribute, defaulting to `"en"`.
  - save: Whether to save the generated page; when `false`, returns the HTML string.

  Returns:
  - The saved-file result when `save` is `true`, otherwise the generated HTML string.

  Example:
  ```sesi
  let page = HTML("Welcome", "<h1>Hello</h1>", "", "", "en", false)
  write_file("welcome.html", page)
  ```

  Notes:
  - CSS content is written to `style.css` and linked into the page.
  - When saving, the title is converted into a lowercase underscore-separated filename.
*/
export fn HTML(title: string, content: string, head: string, css: any = "", language: string = "en", save: bool = true) -> any {
  if css == "" || is_null(css) {
    css = ""
  } else if css == "style.css" {
    css = "<link rel=\"stylesheet\" href=\"style.css\">"
  } else {
    "style.css" | write(css)
    css = "<link rel=\"stylesheet\" href=\"style.css\">"
  }

  if head == "" || is_null(head) {
    head = ""
  } else {
    head = head + "\n"
  }

  let config = {
    "title": title,
    "head": head + css + "\n",
    "lang": language
  }

  let webpage = html(content, config)

  if save == false {
    return webpage
  } else {
    let filename = title | to_lower | swap(" ", "_") | trim
    return write(filename + ".html", webpage)
  }
}

/**
  Writes quick web content to an `.html` file.

  Parameters:
  - filename: Base filename without its extension.
  - content: HTML content to write.

  Returns:
  - The result of the write operation.

  Example:
