/**
  Writes content to a `.tsv` file.

  Parameters:
  - filename: Base filename without its extension.
  - content: TSV content to write.

  Returns:
  - The result of the write operation.

  Example:
  ```sesi
  tsv("scores", "name\tscore\nAda\t98")
  ```
*/
export fn tsv(filename: string, content: any) -> any {
