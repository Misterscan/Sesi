// Resilience Helper: Safe file delete with retry logic
export fn remove(path: string) -> string {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      trash(path, true)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  if success == true {
    return "Successfully deleted " + path
  } else {
    return "Failed to delete " + path
  }
}

