}

/**
  Moves or renames a path with retry handling.

  Parameters:
  - path: Current file or directory path.
  - dest: Destination path.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  show moveFile("old.txt", "new.txt")
  ```
*/
export fn moveFile(path: string, dest: string) -> string {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      rename(path, dest)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  if success == true {
    return "Successfully moved " + path + " to " + dest
  } else {
    return "Failed to move " + path + " to " + dest
  }
}

/**
  Moves a path to a new destination.

  Parameters:
  - path: Current path.
  - dest: Destination path.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  relocate("source.txt", "archive/source.txt")
  ```
*/
export fn relocate(path: string, dest: string) -> any {
  return moveFile(path, dest)
}

/**
  Renames or moves a path using descriptive naming.

  Parameters:
  - path: Current path.
  - newName: New filename or destination path.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  changeName("draft.txt", "final.txt")
  ```
*/
export fn changeName(path: string, newName: string) -> any {
  return moveFile(path, newName)
