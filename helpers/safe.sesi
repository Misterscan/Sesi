/**
  Moves a path to a destination using an alternate alias.

  Parameters:
  - path: Current path.
  - dest: Destination path.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  relocateTo("file.txt", "backup/file.txt")
  ```
*/
export fn relocateTo(path: string, dest: string) -> any {
  return moveFile(path, dest)
}

/**
  Permanently removes a file or directory with retry handling.

  Parameters:
  - path: File or directory to remove.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  show remove("temporary.txt")
  ```

  Notes:
  - Removal uses `trash(path, true)` and is permanent.
*/
export fn remove(path: string) -> string {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      trash(path, true)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  if success == true {
    return "Successfully deleted " + path
  } else {
    return "Failed to delete " + path
  }
}

/**
  Deletes a file or directory.

  Parameters:
  - path: Path to delete.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  delete("old-data.json")
  ```
*/
export fn delete(path: string) -> any {
  return remove(path)
}

/**
  Deletes a file.

  Parameters:
  - path: File path to delete.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  deleteFile("unused.txt")
  ```
*/
export fn deleteFile(path: string) -> any {
  return remove(path)
}

/**
  Deletes a directory and its contents.

  Parameters:
  - path: Directory path to delete.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  deleteDir("temporary")
  ```
*/
export fn deleteDir(path: string) -> any {
