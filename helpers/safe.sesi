  - The result of the write operation.

  Example:
  ```sesi
  txt("readme", "Plain text documentation")
  ```
*/
export fn txt(filename: string, content: string) -> any {
  return write(filename + ".txt", content)
}

/**
  Writes content to a Markdown file.

  Parameters:
  - filename: Base filename without its extension.
  - content: Markdown content to write.

  Returns:
  - The result of the write operation.

  Example:
  ```sesi
  md("guide", "# Sesi Guide")
  ```
*/
export fn md(filename: string, content: string) -> any {
  return write(filename + ".md", content)
}

/**
  Serializes content when necessary and writes a `.json` file.

  Parameters:
  - filename: Base filename without its extension.
  - content: JSON text or a Sesi value to serialize.

  Returns:
  - The result of the write operation.

  Example:
  ```sesi
  json("config", {"enabled": true, "retries": 3})
  ```

  Notes:
  - Strings containing braces are treated as already serialized JSON.
*/
export fn json(filename: string, content: any) -> any {
  if is_string(content) && contains(content, "{") && contains(content, "}") {
    return write(filename + ".json", content)
  } else {
    return write(filename + ".json", content | to_json)
  }
}

/**
  Writes content to a `.yaml` file.

  Parameters:
  - filename: Base filename without its extension.
  - content: YAML-compatible content.

  Returns:
  - The result of the write operation.

  Example:
  ```sesi
  yaml("settings", "enabled: true")
  ```
*/
export fn yaml(filename: string, content: any) -> any {
  return write(filename + ".yaml", content)
}

/**
  Appends a line of content to a `.log` file.

  Parameters:
  - filename: Base filename without its extension.
  - content: Log message to append.

  Returns:
  - The result of the append operation.

  Example:
  ```sesi
  log("application", "Server started")
  ```
*/
export fn log(filename: string, content: string) -> any {
  return addTo(filename + ".log", "\n" + content)
}

/**
  Writes content to a `.csv` file.

  Parameters:
  - filename: Base filename without its extension.
  - content: CSV content to write.

  Returns:
  - The result of the write operation.

  Example:
  ```sesi
  csv("users", "name,role\nAda,admin")
