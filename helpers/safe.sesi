}

/**
  Checks whether a directory contains no entries.

  Parameters:
  - path: Directory path to inspect.

  Returns:
  - `true` when the directory is empty; otherwise `false`.

  Example:
  ```sesi
  if emptyDirCheck("staging") { show "Staging is empty" }
  ```

  Notes:
  - Failed directory access is reported as `false`.
*/
export fn emptyDirCheck(path: string) -> bool {
  let attempts = 0
  while attempts < 3 {
    try {
      return len(list_dir(path)) == 0
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  return false
}

/**
  Checks whether a directory is empty.

  Parameters:
  - path: Directory path to inspect.

  Returns:
  - `true` when empty; otherwise `false`.

  Example:
  ```sesi
  show isEmpty("cache")
  ```
*/
export fn isEmpty(path: string) -> any {
  return emptyDirCheck(path)
}

/**
  Provides a directory-specific alias for checking emptiness.

  Parameters:
  - path: Directory path to inspect.

  Returns:
  - `true` when empty; otherwise `false`.

  Example:
  ```sesi
  if isEmptyDir("temporary") { show "No files found" }
  ```
*/
export fn isEmptyDir(path: string) -> any {
  return emptyDirCheck(path)
}

/**
  Removes and recreates a directory.

  Parameters:
  - path: Directory path to clear.

  Returns:
  - A message confirming that the directory was cleared or describing failure.

  Example:
  ```sesi
  show clearDir("build")
  ```

  Notes:
  - Existing contents are permanently removed.
*/
export fn clearDir(path: string) -> string {
  remove(path)
  make_dir(path)

  if path | isEmpty {
    return path + " cleared!"
  } else {
    return "Failed to clear directory: " + path
  }
}

