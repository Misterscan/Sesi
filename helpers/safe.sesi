/**
  Appends text to a file with retry handling.

  Parameters:
  - path: File to append to.
  - content: Text to append.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  show appendFile("activity.log", "Task completed\n")
  ```
*/
export fn appendFile(path: string, content: string) -> string {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      append_file(path, content)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  if success == true {
    return "Successfully appended to " + path
  } else {
    return "Failed to append file to " + path
  }
}

/**
  Appends content using the `appendFile` implementation.

  Parameters:
  - path: File to update.
  - content: Text to append.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  addContent("notes.txt", "New note\n")
  ```
*/
export fn addContent(path: string, content: string) -> any {
  return appendFile(path, content)
}

/**
  Appends content to the bottom of a file.

  Parameters:
  - path: File to update.
  - content: Text to append.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  addToBottom("log.txt", "Finished\n")
  ```
*/
export fn addToBottom(path: string, content: string) -> any {
