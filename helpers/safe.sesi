  - path: Current path.
  - newName: Replacement name or destination path.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  changeTo("old.log", "new.log")
  ```
*/
export fn changeTo(path: string, newName: string) -> any {
  return moveFile(path, newName)
}

/**
  Moves a path to a destination.

