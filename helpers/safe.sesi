// Resilience Helper: Safe file move with retry logic
export fn moveFile(path: string, dest: string) -> bool {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      rename(path, dest)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  return success
}