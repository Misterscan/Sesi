/**
  Safe File Access
  Resilient file operations wrapped in try-catch blocks with retry logic to prevent crashes.

  This module provides safe and resilient file operations, including reading, writing, and checking file existence, with built-in retry logic to handle transient errors gracefully.
*/

allow "std/time" in as Time

/**
  Extracts the lowercase file extension from a path.

  Parameters:
  - path: File or directory path to inspect.

  Returns:
  - The extension without its leading dot, or a descriptive message when no extension is available.

  Example:
  ```sesi
  let extension = getExtension("photo.JPG")
  show extension
  ```

  Notes:
  - Compound extensions such as `tar.gz` are preserved.
*/
export fn getExtension(path: str) -> str {
  try {
    let ext = get_ext(path)
    if ext == "" || is_null(ext) {
      return "No extension found"
    }
    return ext
  } catch (err) {
    return "Error getting extension: " + err | str
  }
}

/**
  Extracts a file extension using the `getExtension` implementation.

  Parameters:
  - path: File path to inspect.

  Returns:
  - The lowercase extension or a descriptive result when it cannot be determined.

  Example:
  ```sesi
  let extension = getExt("archive.tar.gz")
  show extension
  ```
*/
export fn getExt(path: str) -> str {
  return getExtension(path)
}

/**
  Provides a descriptive alias for `getExtension`.

  Parameters:
  - path: File path to inspect.

  Returns:
  - The lowercase file extension or a descriptive result when unavailable.

  Example:
  ```sesi
  show getFileExtension("document.pdf")
  ```
*/
export fn getFileExtension(path: str) -> str {
  return getExtension(path)
}

/**
  Provides an alternative name for retrieving a file extension.

  Parameters:
  - path: File path to inspect.

  Returns:
  - The lowercase extension without a leading dot.

  Example:
  ```sesi
  let extension = getFileExt("image.png")
  show extension
  ```
*/
export fn getFileExt(path: str) -> str {
  return getExtension(path)
}

/**
  Determines the file type from the extension in a path.

  Parameters:
  - path: File path whose extension should be identified.

  Returns:
  - The lowercase extension or a descriptive message when no extension exists.

  Example:
  ```sesi
  show getFileType("report.csv")
  ```
*/
export fn getFileType(path: str) -> str {
  return getExtension(path)
}

/**
  Provides a short alias for `getExtension`.

  Parameters:
  - path: File path to inspect.

  Returns:
  - The lowercase file extension or a descriptive result when unavailable.

  Example:
  ```sesi
  show extension("video.mp4")
  ```
*/
export fn extension(path: str) -> str {
  return getExtension(path)
}

/**
  Provides a concise alias for retrieving a file extension.

  Parameters:
  - path: File path to inspect.

  Returns:
  - The lowercase file extension or a descriptive result when unavailable.

  Example:
  ```sesi
  show ext("backup.tar.gz")
  ```
*/
export fn ext(path: str) -> str {
  return getExtension(path)
}

/**
  Reads a file with retry handling for transient failures.

  Parameters:
  - path: Path of the file to read.
  - mode: Read mode, normally `"text"` or `"base64"`.

  Returns:
  - The file contents as a string, or an empty string after all attempts fail.

  Example:
  ```sesi
  let content = readFile("notes.txt")
  show content
  ```

  Notes:
  - The operation is attempted up to three times.
  - A short delay is inserted between failed attempts.
*/
export fn readFile(path: string, mode: string = "text") -> string {
  let result = ""
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      if mode == "" || is_null(mode) {
        mode = "text"
      }
      result = read_file(path, mode)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  return result
}

/**
  Reads a file through the resilient `readFile` implementation.

  Parameters:
  - path: Path of the file to read.

  Returns:
  - The file contents as text, or an empty string if reading fails.

  Example:
  ```sesi
  show read("README.md")
  ```
*/
export fn read(path: string) -> string {
  return readFile(path)
}

/**
  Retrieves file contents using the safe read operation.

  Parameters:
  - path: Path of the file to read.

  Returns:
  - The file contents as text, or an empty string if reading fails.

  Example:
  ```sesi
  let content = getContent("config.txt")
  show content
  ```
*/
export fn getContent(path: string) -> string {
  return readFile(path)
}

/**
  Reads a file with an optional content mode.

  Parameters:
  - path: Path of the file to read.
  - mode: Read mode, such as `"text"` or `"base64"`.

  Returns:
  - The file contents as a string, or an empty string after failed attempts.

  Example:
  ```sesi
  let encoded = contents("logo.png", "base64")
  show len(encoded)
  ```
*/
export fn contents(path: string, mode: string = "text") -> string {
  if mode == "" || is_null(mode) {
    mode = "text"
  }
  return readFile(path, mode)
}

/**
  Views file contents using resilient file reading.

  Parameters:
  - path: Path of the file to read.
  - mode: Read mode, such as `"text"` or `"base64"`.

  Returns:
  - The file contents as a string.

  Example:
  ```sesi
  show view("data.txt")
  ```
*/
export fn view(path: string, mode: string = "text") -> string {
  if mode == "" || is_null(mode) {
    mode = "text"
  }
  return readFile(path, mode)
}

/**
  Reads a file using the default text mode.

  Parameters:
  - path: Path of the file to read.

  Returns:
  - The file contents as text, or an empty string if reading fails.

  Example:
  ```sesi
  let document = viewFile("document.md")
  show document
  ```
*/
export fn viewFile(path: string) -> string {
  return readFile(path)
}

/**
  Reads a media file as Base64 data.

  Parameters:
  - path: Path of the media file to read.

  Returns:
  - Base64-encoded file contents.

  Example:
  ```sesi
  let img = viewMedia("photo.png")
  write_file("photo-copy.png", img, "base64")
  ```

  Notes:
  - This function is intended for binary media files.
*/
export fn viewMedia(path: string) -> string {
  return readFile(path, "base64")
}

/**
  Reads a file and prepends its filename to the content.

  Parameters:
  - path: Path of the file to read.

  Returns:
  - A string containing the filename and file contents.

  Example:
  ```sesi
  let promptText = fromFile("notes.txt")
  show promptText
  ```
*/
export fn fromFile(path: string) -> string {
  return "Filename: " + path + "\nContent: " + read(path)
}

/**
  Reads multiple files and labels each result with its filename.

  Parameters:
  - paths: Array of file paths to read.

  Returns:
  - An array of labeled content strings in the same order as `paths`.

  Example:
  ```sesi
  let documents = fromFiles(["a.txt", "b.txt"])
  for document in documents { show document }
  ```
*/
export fn fromFiles(paths: array) -> array<string> {
  let contents = []
  for path in paths {
    push(contents, "Filename: " + path + "\nContents: " + readFile(path))
  }
  return contents
}

/**
  Checks whether a file exists.

  Parameters:
  - path: File path to check.

  Returns:
  - `true` when the file exists; otherwise `false`.

  Example:
  ```sesi
  if fileExists("config.json") { show "Configuration found" }
  ```
*/
export fn fileExists(path: string) -> bool {
  return exists(path)
}

/**
  Checks whether a file or path exists using `fileExists`.

  Parameters:
  - path: Path to verify.

  Returns:
  - `true` when the path exists; otherwise `false`.

  Example:
  ```sesi
  show pathExists("README.md")
  ```
*/
export fn pathExists(path: string) -> bool {
  return fileExists(path)
}

/**
  Verifies that a file exists.

  Parameters:
  - path: File path to verify.

  Returns:
  - `true` when the file exists; otherwise `false`.

  Example:
  ```sesi
  if verifyFile("input.txt") { show "Ready to read" }
  ```
*/
export fn verifyFile(path: string) -> bool {
  return fileExists(path)
}

/**
  Verifies that a path exists using the path-oriented alias.

  Parameters:
  - path: Path to verify.

  Returns:
  - `true` when the path exists; otherwise `false`.

  Example:
  ```sesi
  show verifyPath("assets")
  ```
*/
export fn verifyPath(path: string) -> bool {
  return pathExists(path)
}

/**
  Provides a short alias for checking file existence.

  Parameters:
  - path: Path to check.

  Returns:
  - `true` if the path exists; otherwise `false`.

  Example:
  ```sesi
  if verify("data.json") { show "Data available" }
  ```
*/
export fn verify(path: string) -> bool {
  return fileExists(path)
}

/**
  Writes text or Base64 content with retry handling.

  Parameters:
  - path: Destination file path.
  - content: Text or Base64 content to write.
  - mode: Write mode, normally `"text"` or `"base64"`.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  let result = writeFile("output.txt", "Hello, Sesi!")
  show result
  ```

  Notes:
  - Common media extensions automatically select Base64 mode.
  - The operation is attempted up to three times.
*/
export fn writeFile(path: string, content: string, mode: string = "text") -> string {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      if mode == "" || is_null(mode) {
        mode = "text"
      }
      if ends_with(path, ".mp4") || ends_with(path, ".mp3") || ends_with(path, ".png") || ends_with(path, ".jpg") || ends_with(path, ".gif") || ends_with(path, ".webp") || ends_with(path, ".svg") || ends_with(path, ".heic") || ends_with(path, ".heif") || ends_with(path, ".tiff") || ends_with(path, ".bmp") || ends_with(path, ".mov") || ends_with(path, ".jpeg") || ends_with(path, ".webm") || ends_with(path, ".wav") || ends_with(path, ".m4a") || ends_with(path, ".ogg") || ends_with(path, ".flac") || ends_with(path, ".opus") || ends_with(path, ".aac") {
        mode = "base64"
      } else {
        mode = mode
      }
      write_file(path, content, mode)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  if success == true {
    return "File written successfully at " + path
  } else {
    return "Failed to write file to " + path
  }
}

/**
  Writes a file through the resilient `writeFile` implementation.

  Parameters:
  - path: Destination file path.
  - content: Content to write.
  - mode: Encoding mode for the write operation.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  show write("result.txt", "Completed")
  ```
*/
export fn write(path: string, content: string, mode: string = "text") -> any {
  return writeFile(path, content, mode)
}

/**
  Writes content to a file, creating it when necessary.

  Parameters:
  - path: Destination file path.
  - content: Content to write.
  - mode: Write mode, such as `"text"` or `"base64"`.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  let result = overwrite("settings.json", to_json({"ready": true}))
  show result
  ```

  Notes:
  - Despite the name, the function creates the file when it does not exist.
*/
export fn overwrite(path: string, content: string, mode: string = "text") -> any {
  if fileExists(path) {
    return writeFile(path, content, mode)
  } else {
    show "No file to overwrite. Creating new file at" path "."
    return writeFile(path, content, mode)
  }
}

/**
  Creates a file or replaces its contents.

  Parameters:
  - path: Destination file path.
  - content: Initial content.
  - mode: Write mode.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  show makeFile("empty.txt")
  ```
*/
export fn makeFile(path: string, content: string = "", mode: string = "text") -> any {
  return writeFile(path, content, mode)
}

/**
  Creates a file only when it does not already exist.

  Parameters:
  - path: Destination file path.
  - content: Initial content.
  - mode: Write mode.

  Returns:
  - `false` when the file already exists; otherwise the write result.

  Example:
  ```sesi
  let created = newFile("new.txt", "Initial content")
  show created
  ```
*/
export fn newFile(path: string, content: string = "", mode: string = "text") -> any {
  if fileExists(path) {
    show "File already exists at" path "."
    return false
  }
  return writeFile(path, content, mode)
}

/**
  Creates a file only when it is absent.

  Parameters:
  - path: Destination file path.
  - content: Initial content.
  - mode: Write mode.

  Returns:
  - `false` if the file exists; otherwise a write result.

  Example:
  ```sesi
  show makeNewFile("draft.md", "# Draft")
  ```
*/
export fn makeNewFile(path: string, content: string = "", mode: string = "text") -> any {
  if fileExists(path) {
    show "File already exists at" path "."
    return false
  }
  return writeFile(path, content, mode)
}

/**
  Creates a file without modifying an existing file.

  Parameters:
  - path: Destination file path.
  - content: Initial content.
  - mode: Write mode.

  Returns:
  - `false` when the file exists; otherwise the write result.

  Example:
  ```sesi
  createFile("log.txt", "Started")
  ```
*/
export fn createFile(path: string, content: string = "", mode: string = "text") -> any {
  if fileExists(path) {
    show "File already exists at" path "."
    return false
  }
  return writeFile(path, content, mode)
}

/**
  Provides a short alias for creating a new file.

  Parameters:
  - path: Destination file path.
  - content: Initial content.
  - mode: Write mode.

  Returns:
  - `false` if the file exists; otherwise the write result.

  Example:
  ```sesi
  new("sample.txt", "Sample")
  ```
*/
export fn new(path: string, content: string = "", mode: string = "text") -> any {
  if fileExists(path) {
    show "File already exists at" path "."
    return false
  }
  return writeFile(path, content, mode)
}

/**
  Replaces an existing file by moving it to trash before writing.

  Parameters:
  - path: Destination file path.
  - content: New file content.
  - mode: Write mode.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  show freshFile("cache.txt", "Regenerated")
  ```

  Notes:
  - Existing files are permanently removed through `trash(path, true)`.
*/
export fn freshFile(path: string, content: string = "", mode: string = "text") -> any {
  if fileExists(path) {
    try {
      trash(path)
    } catch (err) {
      return "Failed to delete existing file at " + path + "."
    }
  }
  return writeFile(path, content, mode)
}

/**
  Provides a short alias for `freshFile`.

  Parameters:
  - path: Destination file path.
  - content: New file content.
  - mode: Write mode.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  fresh("output.txt", "Replacement")
  ```
*/
export fn fresh(path: string, content: string = "", mode: string = "text") -> any {
  return freshFile(path, content, mode)
}

/**
  Writes Base64 image data with retry handling.

  Parameters:
  - path: Destination image path.
  - content: Base64-encoded image content.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  let img = read_file("source.png", "base64")
  show writeImage("copy.png", img)
  ```
*/
export fn writeImage(path: string, content: string) -> string {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      write_image(path, content)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  if success == true {
    return "Image saved successfully at " + path
  } else {
    return "Failed to save image to " + path
  }
}

/**
  Creates a new Base64 media file.

  Parameters:
  - path: Destination media path.
  - content: Base64-encoded media content.

  Returns:
  - The result of the file creation operation.

  Example:
  ```sesi
  saveMedia("audio.wav", audioData)
  ```
*/
export fn saveMedia(path: string, content: string) -> any {
