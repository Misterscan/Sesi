}

/**
  Provides a concise alias for appending content.

  Parameters:
  - path: File to update.
  - content: Text to append.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  addTo("output.txt", "Additional line\n")
  ```
*/
export fn addTo(path: string, content: string) -> any {
