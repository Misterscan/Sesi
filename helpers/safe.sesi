/**
  Checks whether a directory exists.

  Parameters:
  - path: Directory path to check.

  Returns:
  - `true` when the directory exists; otherwise `false`.

  Example:
  ```sesi
  if dirExists("reports") { show "Reports directory exists" }
  ```
*/
export fn dirExists(path: string) -> bool {
  return verifyPath(path)
}

/**
  Checks whether a folder exists.

  Parameters:
  - path: Folder path to check.

  Returns:
  - `true` when the folder can be listed; otherwise `false`.

  Example:
  ```sesi
  show folderExists("assets")
  ```
*/
export fn folderExists(path: string) -> any {
  return dirExists(path)
}

/**
  Checks whether a directory exists.

  Parameters:
  - path: Directory path to check.

  Returns:
  - `true` when the directory exists and is accessible; otherwise `false`.

  Example:
  ```sesi
  show directoryExists("data")
  ```
*/
export fn directoryExists(path: string) -> any {
  return dirExists(path)
}

/**
  Determines whether a path refers to a folder.

  Parameters:
  - path: Path to inspect.

  Returns:
  - `true` for an accessible directory; otherwise `false`.

  Example:
  ```sesi
  if isFolder("documents") { show "Folder detected" }
  ```

  Notes:
  - Missing paths and paths that cannot be read return `false`.
*/
export fn isFolder(path: string) -> bool {
  // If it's a file, return false. If it's a directory, return true. If it doesn't exist, return false.
  try {
    read(path)
  } catch (err) {
    return false
  }
  return dirExists(path)
}

/**
  Creates a directory safely.

  Parameters:
  - path: Directory path to create.

  Returns:
  - A success message or a string representation of the caught error.

  Example:
  ```sesi
  show makeDir("reports/2026")
  ```

  Notes:
  - Parent directories are created recursively by the underlying builtin.
*/
export fn makeDir(path: string) -> any {
  try {
    make_dir(path)
    return "Directory created at " + path
  } catch (err) {
    return err | str
  }
}

