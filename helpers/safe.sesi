}

/**
  Permanently removes a path using an emphatic alias.

  Parameters:
  - path: File or directory to remove.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  nuke("cache")
  ```
*/
export fn nuke(path: string) -> any {
  return remove(path)
}

