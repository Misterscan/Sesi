  Writes a temporary Base64-encoded media file.

  Parameters:
  - filename: Base filename without its extension.
  - content: Base64-encoded media data.
  - ext: Media extension to use.

  Returns:
  - The result of the write operation.

  Example:
  ```sesi
  tempMedia("preview", imageData, "png")
  ```

  Notes:
  - The resulting temporary media file will be named as `<filename>_temp.<ext>`.
  - The content is expected to be Base64-encoded.
*/
export fn tempMedia(filename: string, content: string, ext: string) {
  return write(filename + "_temp." + ext, content, "base64")
}

/**
  Creates a temporary folder and scaffolds empty files inside it.

  Parameters:
  - name: Name of the temporary subfolder under `temp/`.
  - files: Array of relative filenames to create.

  Returns:
  - `true` when all files are created successfully; otherwise `false`.

  Example:
  ```sesi
  let created = tempFolder("demo", ["input.txt", "output.txt"])
  show created
  ```

  Notes:
  - The resulting directory is `temp/<name>/`.
  - File paths should be relative names rather than absolute paths.
*/
export fn tempFolder(name: string, files: array<string>) -> bool {
  let dir = "temp/" + name + "/"
  createFolder(dir)

  for file in files {
    try {
      write(dir + file, "")
      show "Scaffolded" file "in" dir
    } catch (e) {
      show "Failed to write" file "to" dir ":" e.message
      return false
    }
  }

  return true
}