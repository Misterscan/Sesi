/**
  Archives a file into the `.backup` directory.

  Parameters:
  - path: File path to archive.

  Returns:
  - A success or failure message containing the generated backup path.

  Example:
  ```sesi
  show archiveFile("report.txt")
  ```

  Notes:
  - The archive name includes the original path and a timestamp.
*/
export fn archiveFile(path: string) -> string {
  let success = false
  let attempts = 0
  let archiveName = path + "_" + time() | to_lower | swap(" ", "-")
  while !success && attempts < 3 {
    try {
      archive(path, ".backup/" + archiveName + ".backup.txt")
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  if success == true {
    return "Successfully archived " + path + "to /.backup/" + archiveName + ".backup.txt"
  } else {
    return "Failed to archive " + path
  }
}

/**
  Archives a file using the `archiveFile` implementation.

  Parameters:
  - path: File path to back up.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  backupFile("important.txt")
  ```
*/
export fn backupFile(path: string) -> any {
  return archiveFile(path)
}

/**
  Provides a short alias for backing up a file.

  Parameters:
  - path: File path to back up.

  Returns:
  - A success or failure message.

  Example:
  ```sesi
  backup("config.json")
  ```
*/
export fn backup(path: string) -> any {
  return archiveFile(path)
}

