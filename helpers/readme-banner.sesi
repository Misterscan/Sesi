/*
    Generates a styled SVG banner for README files.

    Produces a wide gradient banner with a title, optional tagline,
    and optional accent dot. Writes the SVG to disk and can inject
    it into a README automatically.

Usage:
    sesi helpers/readme-banner.sesi <title> <output>
    sesi helpers/readme-banner.sesi <title> <output> tagline "A short description"
    sesi helpers/readme-banner.sesi <title> <output> theme <name>
    sesi helpers/readme-banner.sesi <title> <output> inject <readme>
    sesi helpers/readme-banner.sesi help

Themes:
    midnight   Deep purple-to-navy (default)
    ocean      Teal-to-deep-blue
    ember      Dark orange-to-crimson
    forest     Deep green-to-teal
    slate      Charcoal-to-steel
    aurora     Cool cyan-to-emerald
    sunset     Warm amber-to-rose
    rose       Velvet pink-to-magenta
    violet     Rich purple-to-violet
    citrus     Bright lime-to-gold

Examples:
    sesi helpers/readme-banner.sesi "MySideProject" img/banner.svg
    sesi helpers/readme-banner.sesi "Sesi" img/banner.svg tagline "A Concise, Legible Language" theme ocean
    sesi helpers/readme-banner.sesi "MyApp" img/banner.svg theme ember inject README.md
*/

allow "std/draw" in with Draw

let W = 860
let H = 180

fn show_help() {
  print "readme-banner.sesi — README SVG banner generator"
  print ""
  print "Usage:"
  print "  sesi helpers/readme-banner.sesi <title> <output>"
  print "  sesi helpers/readme-banner.sesi <title> <output> tagline <text>"
  print "  sesi helpers/readme-banner.sesi <title> <output> theme <name>"
  print "  sesi helpers/readme-banner.sesi <title> <output> inject <readme>"
  print ""
  print "Themes: midnight (default), ocean, ember, forest, slate, aurora, sunset, rose, violet, citrus"
  print ""
  print "Examples:"
  print "  sesi helpers/readme-banner.sesi \"MySideProject\" img/banner.svg"
  print "  sesi helpers/readme-banner.sesi \"Sesi\" img/banner.svg tagline \"A Concise Language\" theme ocean"
  print "  sesi helpers/readme-banner.sesi \"MyApp\" img/banner.svg theme ember inject README.md"
}

fn parse_options() {
  let options = {
    "tagline": null,
    "theme": "midnight",
    "inject": null
  }

  let i = 2
  while i < len(args) {
    let key = args[i]

    if key == "--tagline" || key == "tagline" {
      if i + 1 < len(args) {
        options["tagline"] = args[i + 1]
        i = i + 2
      } else {
        print "Missing value for tagline"
        i = i + 1
      }
    } else if key == "--theme" || key == "theme" {
      if i + 1 < len(args) {
        options["theme"] = args[i + 1]
        i = i + 2
      } else {
        print "Missing value for theme"
        i = i + 1
      }
    } else if key == "--inject" || key == "inject" {
      if i + 1 < len(args) {
        options["inject"] = args[i + 1]
        i = i + 2
      } else {
        print "Missing value for inject"
        i = i + 1
      }
    } else {
      print "Ignoring unknown option:" key
      i = i + 1
    }
  }

  return options
}

fn get_theme(name: str) {
  if name == "ocean" {
    return {
      "from": "#061826",
      "mid": "#0b4f6c",
      "to": "#01baef",
      "accent": "#20bf6b",
      "tagline": "#a5f3fc",
      "pattern": "grid"
    }
  }

  if name == "ember" {
    return {
      "from": "#260300",
      "mid": "#7f1d1d",
      "to": "#c2410c",
      "accent": "#f97316",
      "tagline": "#ffedd5",
      "pattern": "circles"
    }
  }

  if name == "forest" {
    return {
      "from": "#022c22",
      "mid": "#065f46",
      "to": "#047857",
      "accent": "#34d399",
      "tagline": "#a7f3d0",
      "pattern": "dots"
    }
  }

  if name == "slate" {
    return {
      "from": "#020617",
      "mid": "#1e293b",
      "to": "#475569",
      "accent": "#38bdf8",
      "tagline": "#e2e8f0",
      "pattern": "grid"
    }
  }

  if name == "aurora" {
    return {
      "from": "#031d1d",
      "mid": "#0e7490",
      "to": "#059669",
      "accent": "#2dd4bf",
      "tagline": "#99f6e4",
      "pattern": "circles"
    }
  }

  if name == "sunset" {
    return {
      "from": "#2a0813",
      "mid": "#9a1c38",
      "to": "#ea580c",
      "accent": "#f97316",
      "tagline": "#ffedd5",
      "pattern": "grid"
    }
  }

  if name == "rose" {
    return {
      "from": "#310a21",
      "mid": "#831843",
      "to": "#e11d48",
      "accent": "#fb7185",
      "tagline": "#ffe4e6",
      "pattern": "circles"
    }
  }

  if name == "violet" {
    return {
      "from": "#180828",
      "mid": "#581c87",
      "to": "#7e22ce",
      "accent": "#a855f7",
      "tagline": "#f3e8ff",
      "pattern": "dots"
    }
  }

  if name == "citrus" {
    return {
      "from": "#142206",
      "mid": "#3f6212",
      "to": "#65a30d",
      "accent": "#84cc16",
      "tagline": "#ecfccb",
      "pattern": "grid"
    }
  }

  // default: midnight
  return {
    "from": "#0f0c29",
    "mid": "#302b63",
    "to": "#24243e",
    "accent": "#a5b4fc",
    "tagline": "#c4b5fd",
    "pattern": "dots"
  }
}

fn get_title_font_size(title: str) -> num {
  let length = len(title)
  if length > 30 {
    return 38
  }
  if length > 20 {
    return 44
  }
  return 52
}

fn draw_pattern(pattern: str, color: str) {
  if pattern == "dots" {
    let x = 40
    while x < W - 40 {
      let y = 40
      while y < H - 40 {
        Draw.circle(x, y, 1.5, color, {"opacity": "0.15"})
        y = y + 24
      }
      x = x + 24
    }
  } else if pattern == "grid" {
    let x = 40
    while x < W - 40 {
      Draw.line(x, 24, x, H - 24, color, {"stroke-width": 1, "opacity": "0.08"})
      x = x + 32
    }
    let y = 24
    while y < H - 24 {
      Draw.line(40, y, W - 40, y, color, {"stroke-width": 1, "opacity": "0.08"})
      y = y + 24
    }
  } else if pattern == "circles" {
    Draw.circle(100, H / 2, 80, color, {"opacity": "0.04"})
    Draw.circle(W - 100, H / 2, 80, color, {"opacity": "0.04"})
    Draw.circle(W / 2, H / 2, 120, color, {"opacity": "0.03"})
  }
}

fn draw_banner(title: str, output: str, options) {
  let theme = get_theme(options["theme"])
  let has_tagline = options["tagline"] != null
  let font_size = get_title_font_size(title)

  Draw.clear()

  // Background gradient left to right
  Draw.gradient("linear", "bg", [
    {"offset": "0%", "color": theme["from"]},
    {"offset": "50%", "color": theme["mid"]},
    {"offset": "100%", "color": theme["to"]}
  ], {"x1": "0%", "y1": "0%", "x2": "100%", "y2": "0%"})

  // Base background
  Draw.rect(0, 0, W, H, "url(#bg)", {"rx": 14, "ry": 14})

  // Optional theme pattern
  if theme["pattern"] != null {
    draw_pattern(theme["pattern"], theme["accent"])
  }

  // Decorative panel and accents
  Draw.rect(24, 24, W - 48, H - 48, "rgba(255,255,255,0.06)", {"rx": 14, "ry": 14})
  Draw.rect(40, 36, 6, H - 72, theme["accent"], {"rx": 3, "ry": 3})
  Draw.rect(W - 120, 36, 80, 6, theme["accent"], {"rx": 3, "ry": 3})
  Draw.rect(W - 86, 36, 46, 46, "rgba(255,255,255,0.12)", {"rx": 10, "ry": 10})

  // Title
  let title_y = H / 2 + 18
  if has_tagline {
    title_y = H / 2 - 8
  }

  Draw.text(W / 2, title_y, title, font_size, "#ffffff", {"text-anchor": "middle", "font-family": "system-ui, -apple-system, sans-serif", "font-weight": "700"})

  // Tagline
  if has_tagline {
    Draw.text(W / 2, title_y + 34, options["tagline"], 18, theme["tagline"], {"text-anchor": "middle", "font-family": "system-ui, -apple-system, sans-serif", "font-weight": "400"})
  }

  Draw.save_svg(output, W, H)
  print "Banner written:" output
  print "Title:" title
  if has_tagline {
    print "Tagline:" options["tagline"]
  }
  print "Theme:" options["theme"]
  print "Size:" W "x" H
}

fn inject_banner(readme: str, output: str) {
  try {
    let content = read_file(readme)
    let tag = "<img src=\"" + output + "\" alt=\"banner\" width=\"100%\" />"
    let marker = "<!-- banner -->"

    if contains(content, marker) {
      // Replace between markers
      let parts = split(content, marker)
      if len(parts) >= 3 {
        let updated = parts[0] + marker + "
" + tag + "
" + marker + parts[2]
        write_file(readme, updated)
        print "Injected banner between <!-- banner --> markers in" readme
        return null
      }
    }

    // No marker — prepend to file
    let updated = "<div align=\"center\">
" + tag + "
</div>

" + content
    write_file(readme, updated)
    print "Prepended banner to" readme
  } catch (err) {
    print "Inject failed:" err
  }
}

if len(args) == 0 {
  show_help()
} else if args[0] == "help" {
  show_help()
} else if len(args) < 2 {
  print "Missing arguments."
  show_help()
} else {
  let title = args[0]
  let output = args[1]
  let options = parse_options()

  try {
    draw_banner(title, output, options)

    if options["inject"] != null {
      inject_banner(options["inject"], output)
    }
  } catch (err) {
    print "Banner generation failed:" err
  }
}
