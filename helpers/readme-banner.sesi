/*
    Generates a styled SVG banner for README files.

    Produces a wide gradient banner with a title, optional tagline,
    and theme-specific artwork. Writes the SVG to disk and can inject
    it into a README automatically.

Usage:
    sesi helpers/readme-banner.sesi <title> <output>
    sesi helpers/readme-banner.sesi <title> <output> tagline "A short description"
    sesi helpers/readme-banner.sesi <title> <output> theme <name>
    sesi helpers/readme-banner.sesi <title> <output> inject <readme>
    sesi helpers/readme-banner.sesi help

Themes:
    midnight   Indigo orbit (default)
    ocean      Blue and teal waves
    ember      Copper and crimson flame
    forest     Emerald evergreen peaks
    slate      Steel-blue isometric grid
    aurora     Mint and cyan ribbons
    sunset     Amber sun over a rose horizon
    rose       Blush-pink rosette
    violet     Lavender crystal facets
    citrus     Lime and gold citrus slice

Examples:
    sesi helpers/readme-banner.sesi "MySideProject" img/banner.svg
    sesi helpers/readme-banner.sesi "Sesi" img/banner.svg tagline "A Concise, Legible Language" theme ocean
    sesi helpers/readme-banner.sesi "MyApp" img/banner.svg theme ember inject README.md
*/
allow"safe"in as Safe;allow"std/draw"in as Draw;let W=860;let H=216;let TEXT_X=54;let TEXT_WIDTH=536;fn show_help(){show"readme-banner.sesi — README SVG banner generator";show"";show"Usage:";show"  sesi helpers/readme-banner.sesi <title> <output>";show"  sesi helpers/readme-banner.sesi <title> <output> tagline <text>";show"  sesi helpers/readme-banner.sesi <title> <output> theme <name>";show"  sesi helpers/readme-banner.sesi <title> <output> inject <readme>";show"";show"Themes: midnight (default), ocean, ember, forest, slate, aurora, sunset, rose, violet, citrus";show"";show"Examples:";show"  sesi helpers/readme-banner.sesi \"MySideProject\" img/banner.svg";show"  sesi helpers/readme-banner.sesi \"Sesi\" img/banner.svg tagline \"A Concise Language\" theme ocean";show"  sesi helpers/readme-banner.sesi \"MyApp\" img/banner.svg theme ember inject README.md"}fn parse_options(){let options={"tagline":null,"theme":"midnight","inject":null}let i=2;while i<len(args){let key=args[i];if key=="--tagline"||key=="tagline"{if i+1<len(args){options["tagline"]=args[i+1];i=i+2}else{show"Missing value for tagline";i=i+1}}else if key=="--theme"||key=="theme"{if i+1<len(args){options["theme"]=args[i+1];i=i+2}else{show"Missing value for theme";i=i+1}}else if key=="--inject"||key=="inject"{if i+1<len(args){options["inject"]=args[i+1];i=i+2}else{show"Missing value for inject";i=i+1}}else{show"Ignoring unknown option:"key;i=i+1}}return options}
// Both artwork paths use the same 144 × 118 coordinate space.
let themes={midnight:{base:"#100e27",edge:"#282657",accent:"#a8b5ff",highlight:"#ddd0ff",tagline:"#d0cef0",motif:"M 101 59 A 29 29 0 1 1 43 59 A 29 29 0 1 1 101 59 Z M 25 82 C 5 63 112 16 126 36 C 141 56 44 102 25 82",detail:"M 39 20 v 12 m -6 -6 h 12 M 112 82 v 16 m -8 -8 h 16 M 65 103 h 14 M 72 96 v 14"},ocean:{base:"#071c30",edge:"#104663",accent:"#58d9ed",highlight:"#a5fcee",tagline:"#bae9f4",motif:"M 12 60 Q 27 60 40 47 T 69 47 T 99 47 T 132 47 M 12 77 Q 27 77 40 64 T 69 64 T 99 64 T 132 64 M 12 94 Q 27 94 40 81 T 69 81 T 99 81 T 132 81",detail:"M 12 43 Q 27 43 40 30 T 69 30 T 99 30 T 132 30 M 24 105 H 120"},ember:{base:"#251116",edge:"#67271c",accent:"#ff965a",highlight:"#ffcf94",tagline:"#f8d5c1",motif:"M 72 105 C 44 105 32 87 36 68 C 39 53 51 45 53 31 Q 67 36 68 55 C 82 40 85 28 80 13 C 102 28 111 51 109 73 C 107 92 94 105 72 105 Z M 72 105 C 52 96 60 78 75 65 C 74 80 93 88 72 105 Z",detail:"M 24 47 l -4 -9 M 119 57 l 8 -6 M 104 19 l -3 -8 M 123 87 h 9"},forest:{base:"#0c211a",edge:"#1c4937",accent:"#72d9a1",highlight:"#cbf6b1",tagline:"#c7ebd5",motif:"M 18 91 L 57 26 L 91 91 Z M 73 60 L 93 37 L 126 91 H 91 M 43 50 L 51 59 L 58 50 L 66 59 L 72 54",detail:"M 12 102 H 132 M 22 51 V 70 M 16 62 L 22 53 L 28 62 M 112 45 V 63 M 107 54 L 112 46 L 117 54 M 88 22 H 102"},slate:{base:"#111c29",edge:"#33485d",accent:"#8ec0e0",highlight:"#d8efff",tagline:"#cfdeec",motif:"M 72 16 L 121 44 V 78 L 72 106 L 23 78 V 44 Z M 23 44 L 72 72 L 121 44 M 72 72 V 106 M 47 30 L 97 58 V 92 M 97 30 L 47 58 V 92",detail:"M 72 27 L 105 46 L 72 65 L 39 46 Z M 12 53 V 70 M 132 53 V 70 M 63 112 H 81"},aurora:{base:"#082127",edge:"#165052",accent:"#7af5ba",highlight:"#a9ddff",tagline:"#c5f0eb",motif:"M 12 85 C 34 89 37 38 59 35 S 79 75 101 60 Q 119 48 132 23 M 12 98 C 34 102 44 49 62 49 S 85 87 106 70 Q 121 58 132 41",detail:"M 20 42 h 12 m -6 -6 v 12 M 89 23 h 14 m -7 -7 v 14 M 101 96 h 12 m -6 -6 v 12"},sunset:{base:"#30162e",edge:"#6b3849",accent:"#ffae79",highlight:"#ffe4a0",tagline:"#f8d6dc",motif:"M 39 68 A 33 33 0 0 1 105 68 M 12 68 H 132 M 26 81 H 118 M 43 94 H 101 M 59 106 H 85",detail:"M 51 43 H 93 M 44 55 H 100 M 72 16 V 25 M 31 33 L 37 39 M 113 33 L 107 39"},rose:{base:"#2d1426",edge:"#653051",accent:"#ffa3c4",highlight:"#ffe0e8",tagline:"#f5d3e4",motif:"M 72 59 C 36 46 50 14 72 16 C 94 14 108 46 72 59 C 85 23 117 37 115 59 C 117 81 85 95 72 59 C 108 72 94 104 72 102 C 50 104 36 72 72 59 C 59 95 27 81 29 59 C 27 37 59 23 72 59 Z",detail:"M 38 25 L 30 17 M 106 25 L 114 17 M 38 93 L 30 101 M 106 93 L 114 101 M 64 59 H 80"},violet:{base:"#20132e",edge:"#4c2970",accent:"#c49efa",highlight:"#efd8ff",tagline:"#e2d2f5",motif:"M 72 13 L 109 46 L 99 83 L 72 105 L 45 83 L 35 46 Z M 72 13 L 91 46 L 72 105 L 53 46 Z M 35 46 H 109 M 45 83 L 91 46 M 99 83 L 53 46",detail:"M 22 33 v 18 m -9 -9 h 18 M 122 66 v 18 m -9 -9 h 18 M 106 23 h 10 m -5 -5 v 10"},citrus:{base:"#1c2513",edge:"#3c5123",accent:"#c1ed76",highlight:"#fff0a0",tagline:"#e6edc1",motif:"M 117 59 A 45 45 0 1 1 27 59 A 45 45 0 1 1 117 59 Z M 106 59 A 34 34 0 1 1 38 59 A 34 34 0 1 1 106 59 Z M 72 25 V 93 M 38 59 H 106 M 48 35 L 96 83 M 96 35 L 48 83",detail:"M 15 73 v 12 m -6 -6 h 12 M 125 33 v 16 m -8 -8 h 16 M 108 102 l 7 -7"}}fn draw_artwork(theme){Draw.rect(622,26,212,164,theme["base"],{rx:16,"fill-opacity":0.36,stroke:theme["accent"],"stroke-opacity":0.3});Draw.circle(728,108,64,"none",{stroke:theme["accent"],"stroke-opacity":0.16,"stroke-dasharray":"2 5"});Draw.path(theme["detail"],"none",{transform:"translate(656 49)",stroke:theme["accent"],"stroke-width":1.5,opacity:0.58,"stroke-linecap":"round"});Draw.path(theme["motif"],"none",{transform:"translate(656 49)",stroke:"url(#accent)","stroke-width":2.5,"stroke-linecap":"round","stroke-linejoin":"round"})}fn draw_fitted_text(content:str,baseline:num,preferred_size:num,min_size:num,color:str,weight:str){
// Estimate widths for the system font stack, allowing extra room for wide glyphs.
let units=0;for glyph in split(content,""){if contains(" ilI.,:;!|'’",glyph){units=units+0.36}else if contains("abcdefghjknopqrstuvxyz0123456789ABCDEFGHJKLNOPQRSTUVXYZ-_/()",glyph){units=units+0.78}else{units=units+1.12}}let size=preferred_size;if units*preferred_size>TEXT_WIDTH{size=floor(TEXT_WIDTH/units)}let attrs={"font-family":"system-ui, -apple-system, sans-serif","font-weight":weight}let x=TEXT_X;if size<min_size{size=min_size;
// Scale from the left margin so long lines fit in SVG renderers without textLength support.
let scale=TEXT_WIDTH/(units*size);attrs["transform"]="translate("+str(TEXT_X)+" 0) scale("+str(scale)+" 1)";x=0}Draw.text(x,baseline,content,size,color,attrs)}fn draw_banner(title:str,output:str,options){let theme=themes[options["theme"]]||themes["midnight"];let has_tagline=options["tagline"]!=null&&trim(options["tagline"])!="";Draw.clear();Draw.gradient("linear","bg",[{offset:"0%",color:theme["base"]},{offset:"32%",color:theme["base"]},{offset:"100%",color:theme["edge"]}],{x1:"0%",y1:"100%",x2:"100%",y2:"0%"});Draw.gradient("radial","glow",[{offset:"0%",color:theme["accent"],opacity:0.25},{offset:"100%",color:theme["accent"],opacity:0}],{cx:"87%",cy:"25%",r:"55%"});Draw.gradient("linear","accent",[{offset:"0%",color:theme["highlight"]},{offset:"100%",color:theme["accent"]}],{x1:"0%",y1:"0%",x2:"100%",y2:"100%"});Draw.rect(0,0,W,H,"url(#bg)",{rx:20});Draw.rect(0,0,W,H,"url(#glow)",{rx:20});Draw.rect(0.5,0.5,W-1,H-1,"none",{rx:19.5,stroke:theme["accent"],"stroke-opacity":0.32});draw_artwork(theme);if has_tagline{Draw.rect(TEXT_X,53,54,4,"url(#accent)",{rx:2});draw_fitted_text(title,117,62,32,"#ffffff","750");draw_fitted_text(options["tagline"],153,22,16,theme["tagline"],"450")}else{Draw.rect(TEXT_X,69,54,4,"url(#accent)",{rx:2});draw_fitted_text(title,136,62,32,"#ffffff","750")}Draw.save_svg(output,W,H);show"Banner written:"output;show"Title:"title;if has_tagline{show"Tagline:"options["tagline"]}show"Theme:"options["theme"];show"Size:"W"x"H}fn inject_banner(readme:str,output:str){try{let content=Safe.read(readme);let tag="<img src=\""+output+"\" alt=\"banner\" width=\"100%\" />";let marker="<!-- banner -->";if contains(content,marker){
// Replace between markers
let parts=split(content,marker);if len(parts)>=3{let updated=parts[0]+marker+"
"+tag+"
"+marker+parts[2];Safe.write(readme,updated);show"Injected banner between <!-- banner --> markers in"readme;return null}}
// No marker — prepend to file
let updated="<div align=\"center\">
"+tag+"
</div>

"+content;Safe.write(readme,updated);show"Prepended banner to"readme}catch(err){show"Inject failed:"err}}if len(args)==0{show_help()}else if args[0]=="help"{show_help()}else if len(args)<2{show"Missing arguments.";show_help()}else{let title=args[0];let output=args[1];let options=parse_options();try{draw_banner(title,output,options);if options["inject"]!=null{inject_banner(options["inject"],output)}}catch(err){show"Banner generation failed:"err}}