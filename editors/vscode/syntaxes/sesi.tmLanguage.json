{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sesi",
  "scopeName": "source.sesi",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#brackets"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sesi",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sesi",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sesi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sesi",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.sesi",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sesi",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.sesi",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.sesi",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sesi",
          "match": "\\b(if|else|while|for|in|to|return|break|continue|try|catch|finally|async|await|allow|as|with)\\b"
        },
        {
          "name": "constant.other.property.sesi",
          "match": "\\b(temperature|temp|max_tokens|maxTokens|maxT|top_p|top_k|thinkingLevel|thinking|cache|search|ratio|aspectRatio|size|output_type|file_type|max_retries|stream|stop|seed|summary|tags|base_path|response|title|version|description|browser|editor|viewer|image_viewer|mode)\\b"
        },
        {
          "name": "keyword.declaration.sesi",
          "match": "\\b(let|fn|make|import|from|export)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.sesi",
          "match": "\\b(number|string|bool|null|array|object|any)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.type.sesi",
            "match": "\\b(number|string|bool|null|array|object|any)\\b"
        },
        {
          "name": "constant.language.sesi",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "constant.language.context.sesi",
          "match": "\\b(media|audio|text|doc|video(?!\\s*\\())\\b"
        },
        {
          "name": "constant.other.math.sesi",
          "match": "\\b(PI|E|INFINITY|NaN)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.reasoning.sesi",
          "match": "\\b(set_alias|model|image|workflow)\\b"
        },
        {
          "name": "support.function.builtin.general.sesi",
          "match": "\\b(show|memory|memory_search|memory_trim|prompt|structured_output|tool_call|define_tool|web_send|web_get|list_tools|error_type|raise_error|multi_req|args|len|range|type|str|num|float|bool|keys|values|push|append|pop|join|split|regex|tokenize|count_tokens|estimate_tokens|estimate_cost|model_usage|gif|video|ffmpeg|matrix_dot|matrix_transpose|matrix_add|matrix_sub|matrix_mul_elements|matrix_scale|matrix_sigmoid|matrix_dsigmoid|matrix_sum_rows|matrix_mse|to_upper|to_lower|trim|slice|swap|contains|locate|map|filter|reduce|find|retry|lazy|force|timeout|profile|profile_start|profile_end|profile_report|encrypt|decrypt|read_file|write_file|append_file|write_image|open|open_file|convert|encode|decode|list_dir|make_dir|rename|archive|zip|exists|get_ext|trash|spawn|exec|run|sesi|python|js|html|time|env|random|exp|trunc|sin|cos|tan|sqrt|floor|ceil|abs|pow|log|now|sleep|format|to_json|from_json|speech|from_speech|translate|listen|api|create_app|get|post|put|delete|patch|head|use|live|db_open|launch|newPage|goto|content|screenshot|pdf|click|fill|type|press|inner_text|attribute|evaluate|wait_for_selector|wait_for_timeout|input|play|beep|synth|save|load|kick|snare|hat|sequence|midi|render|comp|mix|sf2|chord|scale|transpose|duration|bar|clear|cursor|color|circle|rect|line|pixel|pixel_grid|text|save_svg|save_png|ellipse|polygon|path|gradient|style|raw|name|arity|is_function|is_array|is_object|is_string|is_number|is_bool|is_null|length|starts_with|ends_with|index_of|repeat|includes|reverse|sort|unique|flatten)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.sesi",
          "match": "->"
        },
        {
          "name": "keyword.operator.logical.sesi",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.comparison.sesi",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.sesi",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.sesi",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "meta.brace.round.sesi",
          "match": "\\(|\\)"
        },
        {
          "name": "meta.brace.square.sesi",
          "match": "\\[|\\]"
        },
        {
          "name": "meta.brace.curly.sesi",
          "match": "\\{|\\}"
        }
      ]
    }
  }
}
