/*
  accessible_page.sesi
  Generates an accessible HTML webpage using helpers/accessibility.sesi.
  Applies ARIA attributes, skip links, live regions, and contrast/motion
  preferences derived from the Accessibility template.

  Run: npm run sesi main/accessible_page.sesi
*/
allow "helpers/safe" in with { HTML }
allow "helpers/accessibility" in with { Accessibility }

let a11y = Accessibility({
  "language": "en",
  "reduced_motion": true,
  "high_contrast": false,
  "screen_reader": true,
  "text_scale": 1.1
})

let prefs      = a11y.preferences()
let skip       = a11y.skip_link("#main", "Skip to main content")
let heroImg    = a11y.image_attributes("A glowing abstract representation of the Sesi language")
let statusNote = a11y.live_region("Page loaded successfully", "polite")
let alertNote  = a11y.live_region("Critical update available", "assertive")
let nameCtrl   = a11y.control("Your name", "name-hint", true)
let emailCtrl  = a11y.control("Email address", "email-hint", true)

// Build CSS motion preference rule from user settings
let motionCss = ""
if prefs.reduced_motion {
  motionCss = "*, *::before, *::after { animation: none !important; transition: none !important; }"
}

// Build high-contrast override
let contrastCss = ""
if prefs.high_contrast {
  contrastCss = "body { background: #000; color: #fff; } a { color: #ff0; }"
}

// Base font scale
let fontScale = str(prefs.text_scale)

prompt css {"  :root { font-size: calc(16px * "fontScale"); }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  "motionCss"
  "contrastCss"

  body {
    font-family: 'Inter', system-ui, sans-serif;
    background: #0d0d1a;
    color: #e0e0f5;
    line-height: 1.7;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    background: #7c3aed;
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 0 0 8px 8px;
    font-weight: 700;
    z-index: 9999;
    transition: top 0.2s;
  }
  .skip-link:focus { top: 0; }

  header {
    background: #13132a;
    border-bottom: 1px solid #2a2a4a;
    padding: 1rem 2rem;
  }

  nav { display: flex; gap: 2rem; }
  nav a {
    color: #a78bfa;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }
  nav a:hover, nav a:focus { color: #c4b5fd; text-decoration: underline; }

  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  h1 { font-size: 2.6rem; font-weight: 800; color: #c4b5fd; margin-bottom: 1rem; }
  h2 { font-size: 1.6rem; font-weight: 700; color: #a78bfa; margin-bottom: 1rem; }

  ul[role='list'] { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  ul[role='list'] li {
    background: #1a1a35;
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    border-left: 3px solid #7c3aed;
  }

  .live-region {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .live-region.polite  { background: #1e3a5f; border-left: 4px solid #3b82f6; }
  .live-region.assertive { background: #3b1f1f; border-left: 4px solid #ef4444; }

  form { display: flex; flex-direction: column; gap: 1.5rem; }

  .field { display: flex; flex-direction: column; gap: 0.4rem; }
  label { font-weight: 600; color: #c4b5fd; }
  .hint { font-size: 0.85rem; color: #8888bb; }

  input {
    background: #1a1a35;
    border: 1px solid #3a3a6a;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: #e0e0f5;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  input:focus {
    border-color: #7c3aed;
    box-shadow: 0 0 0 3px rgba(124,58,237,0.35);
  }

  button[type='submit'] {
    align-self: flex-start;
    background: #7c3aed;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.85rem 2rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
  }
  button[type='submit']:hover { background: #6d28d9; }
  button[type='submit']:focus {
    outline: 3px solid #a78bfa;
    outline-offset: 3px;
  }
  button[type='submit']:active { transform: scale(0.97); }

  footer {
    text-align: center;
    padding: 2rem;
    color: #555588;
    font-size: 0.875rem;
    border-top: 1px solid #2a2a4a;
  }
"}

prompt header {"<meta name='description' content='An accessible webpage generated by a Sesi script using helpers/accessibility.sesi.' />
<link rel='preconnect' href='https://fonts.googleapis.com' />
<link href='https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap' rel='stylesheet' />"}

prompt body {"<a href='"skip.href"' class='skip-link'>"skip.text"</a>

<header role='banner'>
  <nav aria-label='Primary navigation'>
    <a href='#main'>Home</a>
    <a href='#features'>Features</a>
    <a href='#contact'>Contact</a>
  </nav>
</header>

<main id='main' tabindex='-1'>

  <section aria-labelledby='hero-heading'>
    <h1 id='hero-heading'>Built for Everyone</h1>
    <p>A demonstration of accessible web output generated entirely by a Sesi script.</p>
    <img
      src='https://placehold.co/800x400/1a1a2e/e0e0ff?text=Sesi+Accessible+Page'
      alt='"heroImg.alt"'
      aria-hidden='"heroImg["aria-hidden"]"'
      width='800'
      height='400'
      style='width:100%;border-radius:12px;'
    />
  </section>

  <section id='features' aria-labelledby='features-heading'>
    <h2 id='features-heading'>Accessibility Features Active</h2>
    <ul role='list'>
      <li>Language: <strong>"prefs.language"</strong></li>
      <li>Reduced motion: <strong>"str(prefs.reduced_motion)"</strong></li>
      <li>High contrast: <strong>"str(prefs.high_contrast)"</strong></li>
      <li>Screen reader mode: <strong>"str(prefs.screen_reader)"</strong></li>
      <li>Text scale: <strong>"str(prefs.text_scale)"</strong></li>
    </ul>
  </section>

  <section id='status-regions' aria-labelledby='status-heading'>
    <h2 id='status-heading'>Live Regions</h2>

    <div
      role='"statusNote.role"'
      aria-live='"statusNote.aria-live"'
      aria-atomic='"statusNote["aria-atomic"]"'
      class='live-region polite'
    >"statusNote.text"</div>

    <div
      role='"alertNote.role"'
      aria-live='"alertNote["aria-live"]"'
      aria-atomic='"alertNote["aria-atomic"]"'
      class='live-region assertive'
    >"alertNote.text"</div>
  </section>

  <section id='contact' aria-labelledby='contact-heading'>
    <h2 id='contact-heading'>Contact Form</h2>
    <form novalidate>
      <div class='field'>
        <label for='name-field'>Name</label>
        <span id='name-hint' class='hint'>Enter your full name</span>
        <input
          id='name-field'
          type='text'
          aria-label='"nameCtrl["aria-label"]"'
          aria-required='"nameCtrl["aria-required"]"'
          aria-describedby='""name-hint""'
        />
      </div>

      <div class='field'>
        <label for='email-field'>Email</label>
        <span id='email-hint' class='hint'>We will never share your email</span>
        <input
          id='email-field'
          type='email'
          aria-label='"emailCtrl["aria-label"]"'
          aria-required='"emailCtrl["aria-required"]"'
          aria-describedby='""email-hint""'
        />
      </div>

      <button type='submit'>Send Message</button>
    </form>
  </section>

</main>

<footer role='contentinfo'>
  <p>Generated by Sesi &middot; Accessible by design</p>
</footer>"}

let lang = prefs.language

show HTML("Sesi Accessible Page", body, header, css, lang)