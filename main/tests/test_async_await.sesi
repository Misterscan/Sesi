async fn getGreeting(name) {
  show "Inside async function for:" name
  return "Hello, " + name
}

show "=== Testing Async Call ==="
let p = getGreeting("Alice")
show "Type of p is:" type(p)
show "Value of p is:" p

show "=== Testing Await ==="
let result = await p
show "Awaited result:" result

async fn calculate(a, b) {
  return a * b
}

let p1 = calculate(5, 6)
let p2 = calculate(10, 20)

show "=== Awaiting multiple promises ==="
show "p1 resolved:" await p1
show "p2 resolved:" await p2

async fn runTask1() {
  return "Task 1 complete"
}

async fn runTask2() {
  return "Task 2 complete"
}

show "=== Testing multi_req with async fn ==="
let results = multi_req([runTask1, runTask2])
show "multi_req results:" results

