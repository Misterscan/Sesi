// Sesi Akai MPC Standard Library Demo
// Demonstrates track sequencing, 16 Levels, Note Repeat, Choke Groups, and Vintage Mode.

allow "std/mpc" in as MPC

show "--- 🎛️ Sesi std/mpc: Akai MPC Production Engine ---"

// 1. Create a 2-bar 92 BPM boom-bap sequence with classic 58% Roger Linn swing
let seq = MPC.sequence("Golden Era Boom Bap", 2, 92, "4/4")
seq.set_swing(58)
seq.set_vintage("mpc60") // 12-bit punchy vintage converter emulation
show "Created Sequence:" seq.name "| BPM:" seq.bpm "| Swing:" seq.swing "%"

// 2. Setup 16-pad Drum Kit
let kit = MPC.drum_kit("Akai MPC 3000 Drums")
kit.set_pad(1, {sound: "kick", tune: -1, level: 1.0})
kit.set_pad(2, {sound: "rimshot", level: 0.85})
kit.set_pad(3, {sound: "snare", tune: 1, level: 0.95})
kit.set_pad(4, {sound: "clap", level: 0.8})
kit.set_pad(5, {sound: "hat", mute_group: 1, level: 0.75})
kit.set_pad(7, {sound: "open_hat", mute_group: 1, level: 0.85}) // Choked by Pad 5!
kit.set_pad(13, {sound: "808", tune: -3, level: 0.9})
show "Kit Initialized with Choke Group (Pad 5 chokes Pad 7)"

// 3. Program Drum Track using Akai MPC step patterns
let drum_track = seq.add_track("Drums", "drum", kit)
drum_track.pattern(1, "x...x...x...x...") // Kick drum
drum_track.pattern(3, "....x.......x...") // Snare on 2 and 4
drum_track.pattern(5, "x.x.x.x.x.x.x.x.") // 16th hats with 58% swing
drum_track.pattern(7, "..x.......x.....") // Open hats (cut off by closed hats)

// 4. Demonstrate 16 Levels mode (tuning 808 sub across 16 pads)
let sub_pad = kit.get_pad(13)
let bass_16 = MPC.sixteen_levels(sub_pad, "tune")
show "16 Levels: Generated" len(bass_16) "chromatic tuned pad layers"

// 5. Demonstrate Note Repeat (trap hi-hat roll)
let rolls = MPC.note_repeat(5, "1/32", 1, {ramp: "crescendo", accent: 4})
show "Note Repeat: Generated" len(rolls) "quantized repeat events with crescendo"

// 6. Render sequence in-memory to verify DSP pipeline
let sample = seq.render_wav("memory")
show "✓ Audio successfully synthesized in memory:" len(sample.samples) "stereo samples"

// 7. Export files
seq.render_wav("golden_era_beat.wav")
seq.render_midi("golden_era_beat.mid")

show "✓ Output generated:"
show " - golden_era_beat.wav (44.1kHz Stereo 16-bit WAV with MPC60 vintage coloration)"
show " - golden_era_beat.mid (Standard MIDI File Type 1 with Roger Linn swing timing)"
show "--- MPC Demonstration Complete ---"
