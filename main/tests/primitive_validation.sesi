// Systems Primitive Validation Script
show "--- Sesi Primitive Validation ---"

// 1. to_json test
let data = {"key": "value", "items": [1, 2, 3]}
let json = to_json(data)
show "to_json output:"
show json

// 2. Side-effect function test (No return)
let state = "initial"
fn update_state(new_val) {state = new_val}
show "State before:" state
update_state("updated")
show "State after:" state

// 3. Sequential string test (No +)
show "Final Status:" "Validation Complete"