{
  "name": "@misterscan/sesi",
  "version": "1.8.0",
  "description": "Sesi: A Concise, Legible Programming Language",
  "main": "dist/index.js",
  "bin": {
    "sesi": "bin/sesi.js"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "examples/main",
    "examples/optional",
    "sesi-db",
    "main/tests",
    ".agents",
    "chatbot",
    ".github",
    "helpers",
    "tutorial",
    "example.js",
    "example-ai.js",
    "examples.sesi",
    "scaffold.sesi",
    "getting-started",
    "sf2"
  ],
  "scripts": {
    "lint": "sesi bin/lint.sesi",
    "build": "tsc",
    "commit:message": "sesi -l helpers/commit-message.sesi --staged",
    "debug": "SESI_DEBUG=1 sesi",
    "repl": "sesi",
    "dev": "dotenvx run -- npm run build --watch",
    "test": "sesi tests/run.sesi",
    "test:watch": "tsx watch tests/basic.test.ts",
    "sesi": "sesi",
    "sesi:local": "sesi -l",
    "sesi:dry": "sesi -c",
    "sesi:eval": "sesi -e",
    "sesi:parse": "sesi -r",
    "sesi:encrypt": "sesi -enc",
    "sesi:decrypt": "sesi -dec",
    "local-ai": "sesi -l local_ai.sesi",
    "studio": "sesi -t -l sesi-studio/studio.sesi",
    "studio:css": "sesi -l sesi-studio/customize_css.sesi",
    "studio:css:pack": "sesi -l sesi-studio/theme-packager.sesi pack",
    "studio:css:unpack": "sesi -l sesi-studio/theme-packager.sesi unpack",
    "studio:css:validate": "sesi -l sesi-studio/theme-packager.sesi validate",
    "studio:ext:pack": "sesi -l sesi-studio/extension-packager.sesi pack",
    "studio:ext:unpack": "sesi -l sesi-studio/extension-packager.sesi unpack",
    "studio:ext:validate": "sesi -l sesi-studio/extension-packager.sesi validate",
    "sesira": "sesi chatbot/sesira.sesi",
    "build:exe": "tsc && node ./scripts/build-binaries.mjs",
    "msi:eula": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& 'C:\\Program Files\\WiX Toolset v7.0\\bin\\wix.exe' eula accept wix7\"",
    "build:msi": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& 'C:\\Program Files\\WiX Toolset v7.0\\bin\\wix.exe' build .\\SesiInstaller.wxs -o .\\SesiInstaller.msi\"",
    "build:installer": "npm run build:exe && npm run msi:eula && npm run build:msi",
    "build:mac:pkg": "node ./scripts/build-macos-pkg.mjs",
    "build:mac:installer": "npm run build:exe && npm run build:mac:pkg",
    "extension:package": "cd editors/vscode && npx @vscode/vsce package",
    "example": "node --no-deprecation example.js",
    "example:ai": "node --no-deprecation example-ai.js",
    "examples": "sesi -l examples.sesi",
    "tutorial": "sesi -l tutorial/interactive_web_tutorial.sesi",
    "tutorial:cli": "sesi -l tutorial/tutorial.sesi",
    "upload": "npm run build && npm publish --access public",
    "version:bump": "sesi -l helpers/version-bump.sesi"
  },
  "keywords": [
    "sesi",
    "programming-language",
    "workflow-automation",
    "concise",
    "legible",
    "ast-interpreter",
    "misterscan",
    "cli"
  ],
  "author": "Misterscan",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.20.1",
    "@dotenvx/dotenvx-armor": "0.56.1",
    "@dotenvx/dotenvx-ops": "0.56.1",
    "@google/genai": "2.16.0",
    "@huggingface/transformers": "4.2.0",
    "blessed": "^0.1.81",
    "html-to-text": "10.0.0",
    "image-size": "^2.0.2",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "5.2.3",
    "marked": "18.0.9",
    "nodejs-whisper": "^0.3.1",
    "openai": "7.4.0",
    "playwright": "1.62.1",
    "translate": "3.1.0",
    "turndown": "7.2.4",
    "whisper-cli": "^1.4.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "26.2.0",
    "@types/turndown": "^5.0.6",
    "globals": "^17.9.0",
    "rcedit": "^5.0.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@fastify/ajv-compiler": "^4.0.5",
    "@fastify/fast-json-stringify-compiler": "^5.0.0",
    "fastify": "^5.11.2",
    "fast-uri": "^3.1.5",
    "find-my-way": "^9.7.0",
    "onnxruntime-node": "^1.27.0",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "@google/genai@2.16.0": true,
    "esbuild@0.28.1": true,
    "onnxruntime-node@1.27.0": true,
    "protobufjs@7.6.5": true,
    "sharp@0.35.3": true
  }
}
