{
  "name": "@misterscan/sesi",
  "version": "1.7.5",
  "description": "Sesi: A Concise, Legible Programming Language",
  "main": "dist/index.js",
  "bin": {
    "sesi": "bin/sesi.js"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "examples/main",
    "examples/optional",
    "sesi-db",
    "main/tests",
    ".agents",
    "chatbot",
    ".github",
    "helpers",
    "tutorial",
    "example.js",
    "example-ai.js",
    "examples.sesi",
    "scaffold.sesi",
    "getting-started",
    "sf2"
  ],
  "scripts": {
    "lint": "sesi --cli bin/lint.sesi",
    "build": "tsc",
    "commit:message": "sesi --cli -l helpers/commit-message.sesi --staged",
    "debug": "SESI_DEBUG=1 sesi --cli",
    "repl": "sesi",
    "dev": "dotenvx run -- npm run build --watch",
    "test": "tsx tests/basic.test.ts && tsx tests/module.test.ts && tsx tests/cache.test.ts && tsx tests/http.test.ts && tsx tests/workflow.test.ts && tsx tests/security.test.ts && tsx tests/v2_features.test.ts && tsx tests/openai_gpt_runtime.test.ts && tsx tests/gemini_runtime.test.ts && tsx tests/local_model_runtime.test.ts && tsx tests/token_cost.test.ts && tsx tests/conversion.test.ts && tsx tests/package_runtime.test.ts",
    "test:watch": "tsx watch tests/basic.test.ts",
    "sesi": "sesi --cli",
    "sesi:local": "sesi --cli -l",
    "sesi:dry": "sesi --cli -c",
    "sesi:eval": "sesi --cli -e",
    "sesi:parse": "sesi --cli -r",
    "sesi:encrypt": "sesi --cli -enc",
    "sesi:decrypt": "sesi --cli -dec",
    "local-ai": "sesi --cli -l local_ai.sesi",
    "studio": "sesi --cli -t -l sesi-studio/studio.sesi",
    "studio:css": "sesi --cli -l sesi-studio/customize_css.sesi",
    "studio:css:pack": "sesi --cli -l sesi-studio/theme-packager.sesi pack",
    "studio:css:unpack": "sesi --cli -l sesi-studio/theme-packager.sesi unpack",
    "studio:css:validate": "sesi --cli -l sesi-studio/theme-packager.sesi validate",
    "studio:ext:pack": "sesi --cli -l sesi-studio/extension-packager.sesi pack",
    "studio:ext:unpack": "sesi --cli -l sesi-studio/extension-packager.sesi unpack",
    "studio:ext:validate": "sesi --cli -l sesi-studio/extension-packager.sesi validate",
    "copilot": "sesi --cli chatbot/sesi_db_chatbot.sesi",
    "build:exe": "tsc && node ./scripts/build-binaries.mjs",
    "msi:eula": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& 'C:\\Program Files\\WiX Toolset v7.0\\bin\\wix.exe' eula accept wix7\"",
    "build:msi": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& 'C:\\Program Files\\WiX Toolset v7.0\\bin\\wix.exe' build .\\SesiInstaller.wxs -o .\\SesiInstaller.msi\"",
    "build:installer": "npm run build:exe && npm run msi:eula && npm run build:msi",
    "build:mac:pkg": "node ./scripts/build-macos-pkg.mjs",
    "build:mac:installer": "npm run build:exe && npm run build:mac:pkg",
    "extension:package": "cd editors/vscode && npx @vscode/vsce package",
    "example": "node --no-deprecation example.js",
    "example:ai": "node --no-deprecation example-ai.js",
    "examples": "sesi --cli -l examples.sesi",
    "tutorial": "sesi --cli -l tutorial/interactive_web_tutorial.sesi",
    "tutorial:cli": "sesi --cli -l tutorial/tutorial.sesi",
    "upload": "npm run build && npm publish --access public",
    "version:bump": "sesi --cli -l helpers/version-bump.sesi"
  },
  "keywords": [
    "sesi",
    "programming-language",
    "workflow-automation",
    "concise",
    "legible",
    "ast-interpreter",
    "misterscan",
    "cli"
  ],
  "author": "Misterscan",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.19.1",
    "@dotenvx/dotenvx-armor": "0.56.1",
    "@dotenvx/dotenvx-ops": "0.56.1",
    "@google/genai": "2.15.0",
    "@huggingface/transformers": "^4.2.0",
    "blessed": "^0.1.81",
    "html-to-text": "10.0.0",
    "image-size": "^2.0.2",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "5.2.3",
    "marked": "18.0.7",
    "nodejs-whisper": "^0.3.0",
    "openai": "7.3.0",
    "playwright": "1.62.1",
    "translate": "3.1.0",
    "turndown": "7.2.4",
    "whisper-cli": "^1.2.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/turndown": "^5.0.6",
    "globals": "^17.8.0",
    "rcedit": "^5.0.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "@google/genai@2.15.0": true,
    "esbuild@0.28.1": true,
    "onnxruntime-node@1.24.3": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true
  }
}
