{
  "name": "@misterscan/sesi",
  "version": "1.9.2",
  "description": "Sesi: A Concise, Legible Programming Language",
  "main": "dist/index.js",
  "workspaces": [
    "packages/sesi-game"
  ],
  "bin": {
    "sesi": "bin/sesi.js"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "lib",
    "sesi-icons",
    "examples/main",
    "examples/optional",
    "examples/ui",
    "main/tests",
    ".agents",
    "chatbot",
    ".github",
    "helpers",
    "tutorial",
    "example.js",
    "example-ai.js",
    "examples.sesi",
    "migrate.sesi",
    "local-ai.sesi",
    "timestamp.sesi",
    "theory.sesi",
    "getting-started",
    "sf2"
  ],
  "scripts": {
    "postinstall": "node bin/sesi.js install",
    "lint": "node bin/sesi.js bin/lint.sesi",
    "build": "tsc",
    "migrate": "node bin/sesi.js migrate.sesi run",
    "migrate:dry": "node bin/sesi.js migrate.sesi --preview",
    "commit:message": "node bin/sesi.js -l helpers/commit-message.sesi --staged",
    "debug": "SESI_DEBUG=1 node bin/sesi.js",
    "repl": "node bin/sesi.js",
    "dev": "dotenvx run -- npm run build --watch",
    "test": "node bin/sesi.js tests/run.sesi",
    "test:watch": "tsx watch tests/basic.test.ts",
    "test:game": "node scripts/run-game-tests.cjs",
    "sesi": "node bin/sesi.js",
    "sesi:build": "node bin/sesi.js build",
    "sesi:local": "node bin/sesi.js -l",
    "sesi:dry": "node bin/sesi.js -c",
    "sesi:eval": "node bin/sesi.js -l -e",
    "sesi:parse": "node bin/sesi.js -r",
    "sesi:encrypt": "node bin/sesi.js -enc",
    "sesi:decrypt": "node bin/sesi.js -dec",
    "local-ai": "node bin/sesi.js -l local_ai.sesi",
    "studio": "node bin/sesi.js -t -l sesi-studio/studio.sesi",
    "studio:css": "node bin/sesi.js -l sesi-studio/customize_css.sesi",
    "studio:css:pack": "node bin/sesi.js -l sesi-studio/theme-packager.sesi pack",
    "studio:css:unpack": "node bin/sesi.js -l sesi-studio/theme-packager.sesi unpack",
    "studio:css:validate": "node bin/sesi.js -l sesi-studio/theme-packager.sesi validate",
    "studio:ext:pack": "node bin/sesi.js -l sesi-studio/extension-packager.sesi pack",
    "studio:ext:unpack": "node bin/sesi.js -l sesi-studio/extension-packager.sesi unpack",
    "studio:ext:validate": "node bin/sesi.js -l sesi-studio/extension-packager.sesi validate",
    "sesira": "node bin/sesi.js -l chatbot/sesira.sesi",
    "build:exe": "tsc && node ./scripts/build-binaries.mjs",
    "msi:eula": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& 'C:\\Program Files\\WiX Toolset v7.0\\bin\\wix.exe' eula accept wix7\"",
    "build:msi": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& 'C:\\Program Files\\WiX Toolset v7.0\\bin\\wix.exe' build .\\SesiInstaller.wxs -o .\\SesiInstaller.msi\"",
    "build:installer": "npm run build:exe && npm run msi:eula && npm run build:msi",
    "build:mac:pkg": "node ./scripts/build-macos-pkg.mjs",
    "build:mac:installer": "npm run build:exe && npm run build:mac:pkg",
    "extension:package": "cd editors/vscode && vsce package",
    "example": "node --no-deprecation example.js",
    "example:ai": "node --no-deprecation example-ai.js",
    "examples": "node bin/sesi.js -l examples.sesi",
    "tutorial": "node bin/sesi.js -l tutorial/interactive_web_tutorial.sesi",
    "tutorial:cli": "node bin/sesi.js -l tutorial/tutorial.sesi",
    "upload": "npm run build && npm publish --access public",
    "version:bump": "node bin/sesi.js -l helpers/version-bump.sesi"
  },
  "keywords": [
    "sesi",
    "programming-language",
    "workflow-automation",
    "concise",
    "legible",
    "ast-interpreter",
    "babylonjs",
    "desktop-games",
    "misterscan",
    "cli"
  ],
  "author": "Misterscan",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.38.2",
    "@dotenvx/dotenvx-armor": "0.56.1",
    "@dotenvx/dotenvx-ops": "0.56.1",
    "@google/genai": "3.6.1",
    "@huggingface/transformers": "4.3.2",
    "@vscode/vsce": "4.1.1",
    "adm-zip": "0.6.1",
    "esbuild": "0.28.2",
    "html-to-text": "10.0.1",
    "image-size": "2.1.0",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "5.5.0",
    "marked": "18.3.0",
    "openai": "7.64.0",
    "playwright": "1.65.1",
    "turndown": "7.2.5",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "26.6.10",
    "@types/turndown": "^5.0.6",
    "globals": "17.14.0",
    "rcedit": "^5.0.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@fastify/ajv-compiler": "^4.0.5",
    "@fastify/busboy": "^3.2.2",
    "@fastify/fast-json-stringify-compiler": "^5.0.0",
    "brace-expansion@>=4 <6": "^5.0.12",
    "fastify": "^5.12.5",
    "fast-uri": "^4.2.3",
    "body-parser": "^2.4.0",
    "@azure/msal-node": "^7.1.1",
    "find-my-way": "^9.7.0",
    "onnxruntime-node": "^1.29.0",
    "proxy-addr": "^2.0.8",
    "sharp": "^0.35.5",
    "undici@6": "6.29.1",
    "undici@7": "7.30.1",
    "undici@8": "8.12.3",
    "deepmerge-ts": "8.0.2",
    "qs": "6.17.1",
    "@electron/packager": "20.3.0",
    "@electron/asar": "4.3.1",
    "systeminformation": "5.33.19",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@google/genai@3.6.1": true,
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.29.0": true,
    "protobufjs@7.6.5": true,
    "sharp@0.35.5": true,
    "@vscode/vsce-sign@2.1.1": true,
    "keytar@7.9.0": true
  }
}
