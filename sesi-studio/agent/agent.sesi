allow "std/time" in with Time
allow "ai_agent" in with Agent
allow "std/browser" in with {launch}
allow "helpers/safe" in with Safe
allow "tools" in with Tools
allow "shell-automation" in with {run_sesi}

set_alias("copilot", "gemini-3.5-flash-lite")
set_alias("search", "gemini-3-flash-preview")

let active_browser = null
let active_page = null
let exec_in_project = Tools.exec_in_project
let current_ws_client = null
let current_confirm_response = "pending"
let permission_error = ""

export fn set_ws_client(client) {
  current_ws_client = client
}

export fn clear_ws_client() {
  current_ws_client = null
  current_confirm_response = "pending"
}

export fn receive_confirmation(response) {
  current_confirm_response = response
}

export fn send_agent_chunk(chunk) {
  if current_ws_client != null {
    try {
      current_ws_client.send(to_json({"type": "chat_chunk", "chunk": chunk}))
      return true
    } catch (err) {}
  }
  return false
}

export fn ask_user_permission(prompt_msg) {
  if current_ws_client == null {
    return "The Studio WebSocket is disconnected, so no permission dialog can be shown."
  }

  current_confirm_response = "pending"
  try {
    current_ws_client.send(to_json({"type": "prompt_confirm", "msg": prompt_msg}))
  } catch(e) {
    return "The Studio WebSocket disconnected before the permission dialog could be shown."
  }

  while current_confirm_response == "pending" {
    try {
      Time.sleep(200)
    } catch(e) {}
  }
  let res = current_confirm_response
  current_confirm_response = "pending"
  if res == "yes" {
    return true
  }
  return false
}
export fn read(args) {
  let path = args["path"]
  if path == null {
    path = args["filename"]
  }
  if path == null {
    return "Error: missing 'path' or 'filename' argument"
  }
  let permission = ask_user_permission("Sesi Studio Agent is trying to read file " + path + ". Is this okay?")
  if permission != true {
    if permission != false {
      return "Error: " + permission
    }
    return "Error: User rejected read request."
  }
  return Safe.readFile(path)
}

export fn write(args) {
  let path = args["path"]
  if path == null {
    path = args["filename"]
  }
  let content = args["content"]
  if path == null || content == null {
    return "Error: missing 'path' or 'content' argument"
  }
  let permission = ask_user_permission("Sesi Studio Agent is trying to write to file " + path + ". Is this okay?")
  if permission != true {
    if permission != false {
      return "Error: " + permission
    }
    return "Error: User rejected write request."
  }
  Safe.writeFile(path, content)
  return "Successfully wrote to file " + path
}

export fn list(args) {
  let path = args["path"]
  if path == null || path == "" {
    path = "."
  }
  try {
    let items = Safe.getFiles(path)
    let out = ""
    for item in items {
      out = out + item + "\n"
    }
    return out
  } catch(e) {
    return "Error listing directory: " + str(e)
  }
}

export fn searchGoogle(args) {
  let query = args["query"]
  if query == null {
    return "Error: missing 'query' argument"
  }
  try {
    let search_results = model("search"){temperature: 0.1, thinkingLevel: "low", search: true, cache: false, max_tokens: 1024}{query}
    return search_results
  } catch(e) {
    return "Error searching Google: " + str(e)
  }
}

export fn runScript(args) {
  let script_name = args["script_name"]
  let args_str = args["args_str"]
  if script_name == null {
    return "Error: missing 'script_name' argument"
  }
  if args_str == null {
    args_str = ""
  }
  let permission = ask_user_permission("Sesi Studio Agent is trying to run helper script: " + script_name + ". Is this okay?")
  if permission != true {
    if permission != false {
      return "Error: " + permission
    }
    return "Error: User rejected run request."
  }
  try {
    let clean_script = join(split(script_name, ".."), "")
    let helper_path = "helpers/" + clean_script
    let cmd = "node bin/sesi.js -l " + helper_path + " " + args_str
    let output = exec_in_project(cmd)
    return output
  } catch(e) {
    return "Error running helper script: " + str(e)
  }
}

export fn evaluate(args) {
  let code = args["code"]
  if code == null || code == "" {
    return "Error: missing 'code' argument"
  }
  let permission = ask_user_permission("Sesi Studio Agent is trying to eval code. Is this okay?")
  if permission != true {
    if permission != false {
      return "Error: " + permission
    }
    return "Error: User rejected eval request."
  }
  let final_code = code
  if contains(code, ".sesi") && !contains(code, " ") && !contains(code, "\n") {
    try {
      final_code = read_file(code)
    } catch(read_e) {}
  }
  try {
    let temp_file = "sesi-studio/temp_eval.sesi"
    Safe.writeFile(temp_file, final_code)
    let output = run_sesi(temp_file, true)
    Safe.remove(temp_file)
    return output
  } catch(e) {
    return "Error evaluating Sesi code: " + str(e)
  }
}


export fn generateImage(args) {
  let user_prompt = args["prompt"]
  let ratio = args["aspect_ratio"]
  let path = args["output_path"]

  if user_prompt == null {
    return "Error: missing 'prompt' argument"
  }
  if ratio == null || ratio == "" {
    ratio = "1:1"
  }
  if path == null || path == "" {
    path = "generated_image.png"
  }

  try {
    let subagent_system = "You are an expert prompt engineering agent for image generation models. Your job is to take a simple image request and refine it into a highly detailed, descriptive, and artistic prompt. Your output must be a single refined prompt string. Do not include any other conversational filler or explanations."

    let subagent = Agent.create({
      "model": "copilot",
      "system": subagent_system,
      "thinkingLevel": "low",
      "cache": false,
      "max_tokens": 1024
    })

    let refined_prompt = Agent.chat(subagent, "Expand this image request: " + user_prompt)
    if refined_prompt == null || refined_prompt == "" {
      refined_prompt = user_prompt
    }

    let imageData = image("gemini-3.1-flash-image") {ratio: ratio, size: "1K"} {refined_prompt}
    let success = Safe.writeImage(path, imageData)
    if success {
      return "Subagent successfully generated and saved image. Refined prompt used: '" + refined_prompt + "'. Saved path: '" + path + "'"
    } else {
      return "Subagent failed to write image to " + path
    }
  } catch(e) {
    return "Subagent image generation error: " + str(e)
  }
}

export fn drawPicture(args) {
  let user_prompt = args["prompt"]
  let path = args["output_path"]
  let ratio = args["aspect_ratio"]
  let refs = []
  let example = Safe.readFile("examples/main/pixel_placeholder_icon_detailed.sesi")
  let docs = Safe.readFile("getting-started/VARIABLES.md")
  docs = docs +"\n"+ Safe.readFile("getting-started/FUNCTIONS.md")
  push(refs, example)
  push(refs, docs)
  refs = to_json(refs)

  if user_prompt == null {
    return "Error: missing 'prompt' argument"
  }
  if path == null || path == "" {
    path = "agent_picture.png"
  }

  try {
    let subagent_system = "You are an expert prompt engineering agent for pixel drawing AI agents. This is not related to pixel art style, the AI agent will be drawing this image pixel by pixel, be reasonable. Your job is to take a simple image request and refine it into a detailed and descriptive prompt. Your output must be a single refined prompt string. Do not include any other conversational filler or explanations."

    let subagent = Agent.create({
      "model": "copilot",
      "system": subagent_system,
      "thinkingLevel": "medium",
      "cache": true,
      "max_tokens": 1024
    })

    let refined_prompt = Agent.chat(subagent, "Expand this image request: " + user_prompt)
    if refined_prompt == null || refined_prompt == "" {
      refined_prompt = user_prompt
    } else {
      print "Refined prompt:" refined_prompt
    }
    path = swap(path, ".png", "")
    path = path + "-drawing.png"
    prompt sys {"Create a PNG image with a Sesi script based on the following references: "refs"
    
    IMPORTANT: ALL `||` and `&&` STATEMENTS MUST BE ON THE SAME LINE, NEWLINES ARE NOT ALLOWED."}

    let imageData = ""
    if !is_null(env("OPENAI_API_KEY")) {
      imageData = model("gpt-5.6-terra") {system: sys, thinking: "medium", cache: true} {user_prompt "
      Aspect Ratio: "ratio"
      Save it to: "path}
    } else {
      imageData = model("gemini-3.5-flash-lite") {system: sys, thinking: "high", temp: 0.7, cache: true, max_tokens: 8192} {user_prompt "
      Aspect Ratio: "ratio"
      Save it to: "path}
    }

    if contains(imageData, "/*") {
      imageData = "/*" + split(imageData, "/*")[1]
    } else if !contains(imageData, "/*") && contains(imageData, "allow \"std/draw\" in with Draw") {
      imageData = "allow \"std/draw\" in with Draw\n" + split(imageData, "allow \"std/draw\" in with Draw")[1]
    }
    
    imageData = swap(imageData, "```sesi", "")
    imageData = trim(split(imageData, "```", "")[0])
    path = swap(path, ".png", ".sesi")
    Safe.writeFile(path, imageData)
    
    let success = true
    let sesi_result = run_sesi(path, false, true)
    sesi_result = split(sesi_result, "\n")[0]
    if sesi_result == null || sesi_result == "" || (contains(sesi_result, "Expected") || contains(sesi_result, "EOF") || contains(sesi_result, "Unexpected")) {
      print "Sesi script check failed. Result:" sesi_result "
      Try to fix the script for any errors and rerun the script manually."
      success = false
    } else if sesi_result == "✓ Syntax and Compilation valid" {
      run_sesi(path)
    }

    if success == true {
      // Clean up the temporary Sesi script file after successful generation
      Safe.remove(path)
      return "Successfully generated and saved image. Saved path: '" + path + "'"
    } else {
      path = swap(path, ".sesi", ".png")
      return "Failed to save image to " + path
    }
  } catch(e) {
    return "Image generation error: " + str(e)
  }
}

export fn browser(args) {
  let url = args["url"]
  if url == null {
    return "Error: missing 'url' argument"
  }
  try {
    if active_browser == null {
      active_browser = launch({"headless": true})
    }
    if active_page == null {
      active_page = active_browser.newPage()
    }
    active_page.goto(url)
    let title = active_page.title()
    return "Successfully navigated to " + url + " (Title: " + title + ")"
  } catch(e) {
    return "Error navigating to page: " + str(e)
  }
}

export fn click(args) {
  let selector = args["selector"]
  if selector == null {
    return "Error: missing 'selector' argument"
  }
  if active_page == null {
    return "Error: browser is not open. Call browser_goto first."
  }
  try {
    active_page.click(selector)
    return "Clicked selector: " + selector
  } catch(e) {
    return "Error clicking selector: " + str(e)
  }
}

export fn fill(args) {
  let selector = args["selector"]
  let value = args["value"]
  if selector == null || value == null {
    return "Error: missing 'selector' or 'value' argument"
  }
  if active_page == null {
    return "Error: browser is not open. Call browser_goto first."
  }
  try {
    active_page.fill(selector, value)
    return "Filled selector: " + selector + " with value"
  } catch(e) {
    return "Error filling selector: " + str(e)
  }
}

export fn screenshot(args) {
  let path = args["path"]
  if path == null {
    path = "browser_screenshot.png"
  }
  if active_page == null {
    return "Error: browser is not open. Call browser_goto first."
  }
  try {
    active_page.screenshot({"path": path, "fullPage": true})
    return "Screenshot saved to: " + path
  } catch(e) {
    return "Error taking screenshot: " + str(e)
  }
}

export fn grabContent(args) {
  if args == null {}
  if active_page == null {
    return "Error: browser is not open. Call browser_goto first."
  }
  try {
    let text = active_page.inner_text("body")
    return text
  } catch(e) {
    try {
      return active_page.content()
    } catch(err) {
      return "Error getting page content: " + str(e)
    }
  }
}

export fn closeBrowser(args) {
  if args == null {}
  try {
    if active_page != null {
      active_page.close()
      active_page = null
    }
    if active_browser != null {
      active_browser.close()
      active_browser = null
    }
    return "Browser closed successfully."
  } catch(e) {
    return "Error closing browser: " + str(e)
  }
}

export let global_tools = {
  "read_file": read,
  "write_file": write,
  "list_directory": list,
  "search_google": searchGoogle,
  "run_helper_script": runScript,
  "eval_sesi_code": evaluate,
  "call_image_subagent": generateImage,
  "draw_picture": drawPicture,
  "browser_goto": browser,
  "browser_click": click,
  "browser_fill": fill,
  "browser_screenshot": screenshot,
  "browser_get_content": grabContent,
  "browser_close": closeBrowser
}

export let copilot_tools = {
    "read_file": read,
    "write_file": write,
    "list_directory": list,
    "search_google": searchGoogle,
    "run_helper_script": runScript,
    "eval_sesi_code": evaluate,
    "call_image_subagent": generateImage,
    "draw_picture": drawPicture
}
