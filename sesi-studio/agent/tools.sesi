allow "helpers/safe" in with Safe
allow "shell-automation" in with {run_command}

export let SESI_ROOT = ""

SESI_ROOT = run_command("cd")
SESI_ROOT = split(SESI_ROOT, "\r")[0]
SESI_ROOT = split(SESI_ROOT, "\n")[0]

if SESI_ROOT == "" {
  try {
    SESI_ROOT = env("PWD")
  } catch (e) {}
}

let requested_project_root = env("SESI_STUDIO_PROJECT_ROOT")
if requested_project_root != null && requested_project_root != "" {
  SESI_ROOT = requested_project_root
}

export let PROJECT_ROOT = SESI_ROOT

export let IS_WINDOWS = false
if len(split(SESI_ROOT, "\\")) > 1 || len(split(SESI_ROOT, ":")) > 1 {
  IS_WINDOWS = true
}

export fn exec_node(args) {
  if IS_WINDOWS {
    try {
      return run_command("cmd.exe /c node " + args)
    } catch (e) {
      try {
        return run_command("node " + args)
      } catch (e2) {
        return run_command("node.exe " + args)
      }
    }
  } else {
    try {
      return run_command("node " + args)
    } catch (e) {
      return run_command("node.exe " + args)
    }
  }
}

export fn exec_in_project(cmd) {
  if PROJECT_ROOT != "" && PROJECT_ROOT != "." {

    /*
      Basic attempt to change directory before running command.
      Handles most POSIX environments and Windows cmd.exe basics.
    */
    let safeExec = ""
    safeExec = run_command("cd \"" + PROJECT_ROOT + "\" && " + cmd)
    return safeExec
  }

  return run_command(cmd)
}

export let current_ws_client = null
let permission_error = ""
export fn set_ws_client(client) {
  current_ws_client = client
}

export fn clear_ws_client() {
  current_ws_client = null
  current_confirm_response = "pending"
}

export fn request_confirmation(prompt_msg) {
  if current_ws_client == null {
    permission_error = "The Studio WebSocket is disconnected, so no permission dialog can be shown."
    return false
  }
  permission_error = ""
  current_confirm_response = "pending"
  try {
    current_ws_client.send(to_json({"type": "prompt_confirm", "msg": prompt_msg}))
    return true
  } catch (err) {
    permission_error = "The Studio WebSocket disconnected before the permission dialog could be shown."
    return false
  }
}

export fn last_permission_error() {
  return permission_error
}

export fn receive_confirmation(response) {
  current_confirm_response = response
}

export fn confirmation_response() {
  return current_confirm_response
}

export fn reset_confirmation() {
  current_confirm_response = "pending"
}

export fn send_agent_chunk(chunk) {
  if current_ws_client != null {
    try {
      current_ws_client.send(to_json({"type": "chat_chunk", "chunk": chunk}))
      return true
    } catch(err_c) {}
  }
  return false
}

export fn on_agent_chunk(chunk) {
  return send_agent_chunk(chunk)
}
export let current_confirm_response = "pending"

// Passphrase generation and retrieval
let pass = ""
fn randomPass() {
  let chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
  let count = 0
  let chars_len = len(chars)
  while count < 16 {
    let rand_val = random() * chars_len
    let parts = split(str(rand_val), ".")
    let idx = num(parts[0])
    pass = pass + slice(chars, idx, idx + 1)
    count = count + 1
  }
  Safe.writeFile("sesi-studio/.sesi_studio_password.txt", pass)
  return pass
}

pass = Safe.readFile("sesi-studio/.sesi_studio_password.txt")
if pass == null || pass == "" || pass == "nullnullnullnullnullnullnullnullnullnullnullnullnullnullnullnull" {
  pass = randomPass()
}

export let pass = pass