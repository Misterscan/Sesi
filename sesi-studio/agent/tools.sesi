/**
  Sesi Studio Agent tools module.

  Provides utility functions for executing commands, managing the WebSocket client,
  handling user permissions, and generating random passphrases.
*/

allow "helpers/safe" in as Safe
allow "shell-automation" in with {run_command}

// Sesi Studio Root Path
export let SESI_ROOT = ""

SESI_ROOT = run_command("cd")
SESI_ROOT = split(SESI_ROOT, "\r")[0]
SESI_ROOT = split(SESI_ROOT, "\n")[0]

if SESI_ROOT == "" {
  try {
    SESI_ROOT = env("PWD")
  } catch (e) {}
}

// Requested Project Root Override
let requested_project_root = env("SESI_STUDIO_PROJECT_ROOT")
if requested_project_root != null && requested_project_root != "" {
  SESI_ROOT = requested_project_root
}

// Final Project Root Assignment
export let PROJECT_ROOT = SESI_ROOT

// Determine if the environment is Windows-based
export let IS_WINDOWS = false
if len(split(SESI_ROOT, "\\")) > 1 || len(split(SESI_ROOT, ":")) > 1 {
  IS_WINDOWS = true
}

/**
  Execute a Node.js command in the current environment.

Parameters:
 - `args`: The arguments to pass to the Node.js command.

Returns:
 The result of the executed command.
*/
export fn exec_node(args) {
  if IS_WINDOWS {
    try {
      return run_command("cmd.exe /c node " + args)
    } catch (e) {
      try {
        return run_command("node " + args)
      } catch (e2) {
        return run_command("node.exe " + args)
      }
    }
  } else {
    try {
      return run_command("node " + args)
    } catch (e) {
      return run_command("node.exe " + args)
    }
  }
}

/**
  Execute a command in the context of the project root.

Parameters:
 - `cmd`: The command to execute.

Returns:
 The result of the executed command.
*/
export fn exec_in_project(cmd) {
  if PROJECT_ROOT != "" && PROJECT_ROOT != "." {

    /*
      Basic attempt to change directory before running command.
      Handles most POSIX environments and Windows cmd.exe basics.
    */
    let safeExec = ""
    safeExec = run_command("cd \"" + PROJECT_ROOT + "\" && " + cmd)
    return safeExec
  }

  return run_command(cmd)
}

// Get the current WebSocket client.
export let current_ws_client = null
let permission_error = ""

// Set the current WebSocket client.
export fn set_ws_client(client) {
  current_ws_client = client
}

// Clear the current WebSocket client.
export fn clear_ws_client() {
  current_ws_client = null
  current_confirm_response = "pending"
}

/**
  Request user confirmation via the WebSocket client.

Parameters:
 - `prompt_msg`: The message to display in the confirmation dialog.

Returns:
 `true` if the confirmation request was successfully sent, `false` otherwise.
*/
export fn request_confirmation(prompt_msg) {
  if current_ws_client == null {
    permission_error = "The Studio WebSocket is disconnected, so no permission dialog can be shown."
    return false
  }
  permission_error = ""
  current_confirm_response = "pending"
  try {
    current_ws_client.send(to_json({"type": "prompt_confirm", "msg": prompt_msg}))
    return true
  } catch (err) {
    permission_error = "The Studio WebSocket disconnected before the permission dialog could be shown."
    return false
  }
}

// Get the last permission error message.
export fn last_permission_error() {
  return permission_error
}

// Receive the user's confirmation response.
export fn receive_confirmation(response) {
  current_confirm_response = response
}

// Get the current confirmation response.
export fn confirmation_response() {
  return current_confirm_response
}

// Reset the confirmation response to pending.
export fn reset_confirmation() {
  current_confirm_response = "pending"
}

/**
  Send a chunk of data to the agent via the WebSocket client.

Parameters:
 - `chunk`: The data chunk to send.

Returns:
 `true` if the chunk was successfully sent, `false` otherwise.
*/
export fn send_agent_chunk(chunk) {
  if current_ws_client != null {
    try {
      current_ws_client.send(to_json({"type": "chat_chunk", "chunk": chunk}))
      return true
    } catch(err_c) {}
  }
  return false
}

/**
  Handle incoming agent data chunks.

Parameters:
 - `chunk`: The data chunk received from the agent.

Returns:
 The result of sending the chunk via `send_agent_chunk`.
*/
export fn on_agent_chunk(chunk) {
  return send_agent_chunk(chunk)
}
export let current_confirm_response = "pending"

// Passphrase generation and retrieval

// Generated passphrase for the agent.
let password = ""
// Generate a random passphrase if none exists.
fn randomPass() {
  let chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
  let count = 0
  let chars_len = len(chars)
  while count < 16 {
    let rand_val = random() * chars_len
    let parts = split(str(rand_val), ".")
    let idx = num(parts[0])
    password = password + slice(chars, idx, idx + 1)
    count = count + 1
  }
  Safe.writeFile("sesi-studio/.sesi_studio_password.txt", password)
  return password
}

password = Safe.readFile("sesi-studio/.sesi_studio_password.txt")
if password == null || password == "" || password == "nullnullnullnullnullnullnullnullnullnullnullnullnullnullnullnull" {
  password = randomPass()
}

// Generated passphrase for Sesi Studio.
export let pass = password