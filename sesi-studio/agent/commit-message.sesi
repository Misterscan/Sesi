/*
    commit-message.sesi
    Git commit message generator.
    
Usage:
    sesi -l helpers/commit-message.sesi
    sesi -l helpers/commit-message.sesi staged
    sesi -l helpers/commit-message.sesi unstaged
    sesi -l helpers/commit-message.sesi all
    sesi -l helpers/commit-message.sesi staged --write commit_message.txt
*/
allow "helpers/safe" in with safe

let project_root = ""
try {
  project_root = env("SESI_STUDIO_PROJECT_ROOT")
} catch (err) {}
if project_root == null || project_root == "" {
  try {
    project_root = env("PWD")
  } catch (err) {}
}

fn show_help() {
  print "Usage:"
  print "  sesi -l helpers/commit-message.sesi"
  print "  sesi -l helpers/commit-message.sesi staged"
  print "  sesi -l helpers/commit-message.sesi unstaged"
  print "  sesi -l helpers/commit-message.sesi all"
  print "  sesi -l helpers/commit-message.sesi staged write commit_message.txt"
  print ""
  print "Modes:"
  print "  staged    Use git diff --cached"
  print "  unstaged  Use git diff"
  print "  all       Use staged and unstaged diffs"
  print ""
  print "Default:"
  print "  staged"
}

fn parse_options() {
  let options = {
    "mode": "staged",
    "write": null,
    "help": false
  }

  let i = 0
  while i < len(args) {
    let arg = args[i]

    if arg == "--help" || arg == "help" {
      options["help"] = true
      i = i + 1
    } else if arg == "--staged" || arg == "staged" {
      options["mode"] = "staged"
      i = i + 1
    } else if arg == "--unstaged" || arg == "unstaged" {
      options["mode"] = "unstaged"
      i = i + 1
    } else if arg == "--all" || arg == "all" {
      options["mode"] = "all"
      i = i + 1
    } else if arg == "--write" || arg == "write" {
      if i + 1 < len(args) {
        options["write"] = args[i + 1]
        i = i + 2
      } else {
        print "Missing value for write"
        i = i + 1
      }
    } else {
      print "Ignoring unknown option:" arg
      i = i + 1
    }
  }

  return options
}

fn run_git(command: str) -> str {
  try {
    if project_root != null && project_root != "" {
      return exec("cd \"" + project_root + "\" && " + command)
    }
    return exec(command)
  } catch (err) {
    print "Git command failed:" command
    print err
    return ""
  }
}

fn read_git_diff(command: str, temp_path: str) -> str {
  try {
    safe.remove(temp_path)
  } catch (cleanup_err) {}

  try {
    let diff_command = command + " --output=\"" + temp_path + "\""
    if project_root != null && project_root != "" {
      diff_command = "cd \"" + project_root + "\" && " + diff_command
    }
    exec(diff_command)
    let full_diff = safe.read(temp_path)
    try {
      safe.remove(temp_path)
    } catch (cleanup_err) {}

    let max_chars = 120000
    if len(full_diff) > max_chars {
      return trunc(full_diff, max_chars) + "\n\n[Diff truncated for commit-message generation.]"
    }
    return full_diff
  } catch (err) {
    print "Git diff command failed:" command
    print err
    try {
      safe.remove(temp_path)
    } catch (cleanup_err) {}
    return ""
  }
}

fn get_diff(mode: str) {
  let temp_prefix = ""
  if project_root != null && project_root != "" {
    temp_prefix = project_root + "/"
  }
  let data = {
    "mode": mode,
    "status": "",
    "stat": "",
    "diff": ""
  }

  data["status"] = run_git("git status --short")

  if mode == "staged" {
    data["stat"] = run_git("git diff --cached --stat")
    data["diff"] = read_git_diff("git diff --cached", temp_prefix + ".sesi_commit_message_staged.diff")
  } else if mode == "unstaged" {
    data["stat"] = run_git("git diff --stat")
    data["diff"] = read_git_diff("git diff", temp_prefix + ".sesi_commit_message_unstaged.diff")
  } else if mode == "all" {
    let staged_stat = run_git("git diff --cached --stat")
    let unstaged_stat = run_git("git diff --stat")
    let staged_diff = read_git_diff("git diff --cached", temp_prefix + ".sesi_commit_message_staged.diff")
    let unstaged_diff = read_git_diff("git diff", temp_prefix + ".sesi_commit_message_unstaged.diff")

    data["stat"] = "STAGED:
" + staged_stat + "
UNSTAGED:
" + unstaged_stat

    data["diff"] = "STAGED DIFF:
" + staged_diff + "
UNSTAGED DIFF:
" + unstaged_diff
  }

  return data
}

fn has_changes(data) -> bool {
  if len(trim(data["diff"])) > 0 {
    return true
  }

  return false
}

fn generate_commit_message(data) -> str {
  prompt request {"You are generating a git commit message.

Rules:
- Return only the commit message.
- Use Conventional Commit format.
- Use one concise subject line.
- Add a blank line and 3-7 bullet points only if the diff needs explanation.
  If under 3 files changed, max 3 bullet points. If 3-10 files changed, max 5 bullet points. If over 10 files changed, max 7 bullet points. All depending on the diff.
- Prefer these types when appropriate: feat, fix, refactor, docs, test, chore, build, ci, perf.
- Keep the subject under 72 characters.
- Do not invent changes not shown in the diff.
- Do not wrap the response in markdown.

Mode: " data["mode"] "

Git status:
" data["status"] "

Diff stat:
" data["stat"] "

Diff:
" data["diff"]}

  let message = model("gemini-3.1-flash-lite") {thinkingLevel: "minimal", max_tokens: 300} {request}
  return trim(message)
}

fn write_output(path: str, message: str) {
  try {
    safe.write(path, message)
    print "Commit message written:" path
  } catch (err) {
    print "Could not write commit message:" err
  }
}

let options = parse_options()

if options["help"] {
  show_help()
} else {
  let data = get_diff(options["mode"])

  if !has_changes(data) {
    print "No diff found for mode:" options["mode"]
    print "Try unstaged or all if your changes are not staged."
  } else {
    let message = generate_commit_message(data)

    print message

    if options["write"] != null {
      write_output(options["write"], message)
    }
  }
}