/**
  Renders bar, line, scatter, and pie charts to SVG or PNG.

  Run `sesi lib/graphics/chart.sesi` from the repository root
  to write the sample images in the current working directory.
*/

allow "std/draw" in as Draw
allow "std/math" in as Math

// Default colors cycle by data index. Missing values keep their original index.
let PALETTE = ["#2868d7", "#138470", "#a34bc2", "#c75c22", "#197b9d", "#b43e65", "#877215"]
let FONT = "system-ui, -apple-system, sans-serif"

/**
  Resolves the canvas dimensions, appearance, and output format.

  Parameters:
  - `path`: Output path. A `.png` extension selects PNG regardless of case.
  - `options`: Optional dimensions, colors, title, and format override.
  - `pie`: Use the larger minimum dimensions for pie charts.

  Returns:
  - The style object shared by the chart renderers.
*/
fn chart_style(path, options, pie = false) {
  let min_width = 240
  let min_height = 200
  if pie {
    min_width = 280
    min_height = 220
  }
  return {
    width: Math.round(Math.max(min_width, options.width || 800)),
    height: Math.round(Math.max(min_height, options.height || 450)),
    png: options.format == "png" || ends_with(to_lower(path), ".png"),
    background: options.background || "#ffffff",
    foreground: options.foreground || "#334155",
    grid: options.grid_color || "#dce5ef",
    title: options.title
  }
}

/**
  Returns the color for a zero-based data index. Uses the supplied `options.colors`
  palette when it contains entries and wraps at the end of the palette.
*/
fn color_at(index, options) {
  let colors = options.colors
  if colors == null || len(colors) == 0 {
    colors = PALETTE
  }
  return colors[index % len(colors)]
}

fn finite(value) -> bool {
  return is_number(value) && value - value == 0
}

/**
  Draws a line between the two coordinate pairs. SVG uses the supplied stroke
  width in pixels. PNG approximates a thicker stroke with a second pixel line.
*/
fn chart_line(x1, y1, x2, y2, color, png, width = 1) {
  if png {
    Draw.pixel_line(x1, y1, x2, y2, color)
    if width > 1 {
      if Math.abs(x2 - x1) >= Math.abs(y2 - y1) {
        Draw.pixel_line(x1, y1 + 1, x2, y2 + 1, color)
      } else {
        Draw.pixel_line(x1 + 1, y1, x2 + 1, y2, color)
      }
    }
  } else {
    Draw.line(x1, y1, x2, y2, color, {"stroke-width": width, "stroke-linecap": "round"})
  }
}

/**
  Draws a filled rectangle at the top-left coordinate. PNG rounds both edges
  before computing the pixel dimensions. SVG supports an optional corner radius.
*/
fn chart_rect(x, y, width, height, color, png, radius = 0) {
  if width > 0 && height > 0 {
    if png {
      let w = Math.round(x + width) - Math.round(x)
      let h = Math.round(y + height) - Math.round(y)
      if w > 0 && h > 0 {
        Draw.pixel_rect(Math.round(x), Math.round(y), w, h, color)
      }
    } else {
      Draw.rect(x, y, width, height, color, {rx: radius})
    }
  }
}

/** Draws a filled circle centered at `x` and `y` in the selected format. */
fn chart_circle(x, y, radius, color, png) {
  if png {
    Draw.pixel_circle(x, y, radius, color)
  } else {
    Draw.circle(x, y, radius, color)
  }
}

fn glyph_width(char, size) {
  if contains(" ilI.,:;!|'’", char) {
    return size * 0.32
  }
  if contains("mwMW@%&", char) {
    return size * 0.92
  }
  if regex("[^\\x00-\\xFF]", char, {mode: "test"}) {
    return size
  }
  return size * 0.61
}

fn text_width(text, size) {
  let width = 0
  for char in split(text, "") {
    width = width + glyph_width(char, size)
  }
  return width
}

/** Fits a label on one line, adding an ellipsis if its estimated width exceeds the available space. */
fn fit_text(text, size, max_width) {
  let line = join(split(str(text), "\n"), " ")
  if text_width(line, size) <= max_width {
    return line
  }
  if max_width < size {
    return ""
  }

  let output = ""
  let width = size
  let chars = regex(".", line, {flags: "u", limit: len(line) + 1})
  for char in chars {
    let glyph = char["match"]
    width = width + glyph_width(glyph, size)
    if width > max_width {
      return trim(output) + "…"
    }
    output = output + glyph
  }
  return output
}

/**
  Draws text at the `x` anchor and `y` baseline. The font size is in pixels.
  PNG estimates text width for alignment and offsets the raster line origin
  to match the SVG baseline.
*/
fn chart_text(x, y, text, style, size, anchor = "start", bold = false) {
  let value = str(text)
  if style.png {
    let width = text_width(value, size)
    if anchor == "middle" {
      x = x - width / 2
    } else if anchor == "end" {
      x = x - width
    }
    let face = "light"
    if bold { face = "sans" }
    Draw.pixel_text(x, y - size, value, style.foreground, size / 7, face)
  } else {
    let weight = 450
    if bold { weight = 700 }
    Draw.text(x, y, value, size, style.foreground, {
      "font-family": FONT, "font-weight": weight, "text-anchor": anchor
    })
  }
}

fn escape_xml(text) {
  let escaped = join(split(text, "&"), "&amp;")
  escaped = join(split(escaped, "<"), "&lt;")
  return join(split(escaped, ">"), "&gt;")
}

fn start_detail(text, png) {
  if !png { Draw.raw("<g><title>" + escape_xml(text) + "</title>") }
}

fn end_detail(png) {
  if !png { Draw.raw("</g>") }
}

/**
  Clears the drawing buffers and draws the background and optional title.
  Painting the raster background first lets text blend into the chart canvas.
*/
fn begin_chart(style) {
  Draw.clear()
  if !style.png {
    if style.title {
      Draw.raw("<title>" + escape_xml(str(style.title)) + "</title>")
    }
  }
  chart_rect(0, 0, style.width, style.height, style.background, style.png)
  if style.title {
    chart_text(24, 35, fit_text(style.title, 23, style.width - 48), style, 23, "start", true)
    chart_line(24, 49, style.width - 24, 49, style.grid, style.png)
  }
}

/**
  Saves the chart to `path` using the format and dimensions in `style`.
  Retries a failed write once, clears the buffers, and returns the saved path.
*/
fn end_chart(path, style) {
  let attempts = 0
  while attempts < 2 {
    try {
      if style.png {
        Draw.save_png(path, style.width, style.height, style.background)
      } else {
        Draw.save_svg(path, style.width, style.height)
      }
      Draw.clear()
      return path
    } catch (err) {
      attempts = attempts + 1
      if attempts == 2 {
        Draw.clear()
        raise_error(err.type, err.message)
      }
    }
  }
}

fn plot_top(style) {
  if style.title { return 72 }
  return 26
}

/**
  Finds evenly spaced ticks with a decimal step, extending the bounds
  to the nearest ticks. Equal bounds get a visible range around the value.
*/
fn nice_axis(low, high, target) {
  let divisor = 1
  let shift = 0
  let magnitude = Math.max(Math.abs(low), Math.abs(high))
  if magnitude > 0 && (magnitude < Math.pow(10, -120) || magnitude > Math.pow(10, 120)) {
    shift = Math.max(-323, Math.floor(Math.log10(magnitude)))
    divisor = Math.pow(10, shift)
    low = low / divisor
    high = high / divisor
  }
  if low == high {
    if low == 0 {
      high = 1
    } else {
      let padding = Math.abs(low) * 0.15
      high = high + padding
      low = low - padding
    }
  } else {
    let minimum_span = Math.max(Math.abs(low), Math.abs(high)) / Math.pow(10, 12)
    if high - low < minimum_span {
      low = low - minimum_span
      high = high + minimum_span
    }
  }
  let rough = (high - low) / target
  let power = Math.pow(10, Math.floor(Math.log10(rough)))
  let step = 10 * power
  for multiple in [1, 2, 2.5, 5] {
    if rough <= multiple * power {
      step = multiple * power
      break
    }
  }

  let first = Math.floor(low / step)
  let last = Math.ceil(high / step)
  return {min: first * step, max: last * step, first: first, last: last, step: step, divisor: divisor, shift: shift}
}

fn axis_fraction(value, axis) {
  return (value / axis.divisor - axis.min) / (axis.max - axis.min)
}

fn axis_text(index, axis) {
  if index == 0 { return "0" }
  let scaled = index * axis.step
  let exponent = Math.floor(Math.log10(Math.abs(scaled)))
  let shift = axis.shift || 0
  let display_exponent = exponent + shift
  if display_exponent >= 7 || display_exponent < -4 {
    let digits = Math.max(0, Math.min(14, Math.ceil(exponent - Math.log10(axis.step)) + 1))
    let precision = Math.pow(10, digits)
    let normalized = scaled / Math.pow(10, exponent)
    return str(Math.round(normalized * precision) / precision) + "e" + str(display_exponent)
  }
  let value = scaled * axis.divisor
  let step = axis.step * axis.divisor
  let digits = Math.max(0, Math.ceil(-Math.log10(step)) + 1)
  let precision = Math.pow(10, digits)
  return str(Math.round(value * precision) / precision)
}

fn plot_frame(style, y_axis) {
  let left = 45
  for tick = y_axis.first to y_axis.last + 1 {
    left = Math.max(left, text_width(axis_text(tick, y_axis), 11) + 29)
  }
  return {left: Math.round(left), right: style.width - 25, top: plot_top(style), bottom: style.height - 44}
}

/**
  Draws Y-axis grid lines and tick labels. When `x_axis` is supplied, also draws
  numeric X-axis ticks. Category charts position their own X-axis labels.
*/
fn draw_axes(frame, y_axis, x_axis, style) {
  let plot_height = frame.bottom - frame.top
  for tick = y_axis.first to y_axis.last + 1 {
    let y = frame.bottom - (tick - y_axis.first) / (y_axis.last - y_axis.first) * plot_height
    let line_color = style.grid
    if tick == 0 { line_color = style.foreground }
    chart_line(frame.left, y, frame.right, y, line_color, style.png)
    chart_text(frame.left - 12, y + 4, axis_text(tick, y_axis), style, 11, "end")
  }

  chart_line(frame.left, frame.top, frame.left, frame.bottom, style.grid, style.png)
  if x_axis != null {
    for tick = x_axis.first to x_axis.last + 1 {
      let x = frame.left + (tick - x_axis.first) / (x_axis.last - x_axis.first) * (frame.right - frame.left)
      chart_line(x, frame.top, x, frame.bottom, style.grid, style.png)
      chart_text(x, frame.bottom + 22, axis_text(tick, x_axis), style, 11, "middle")
    }
  }
}

fn label_at(labels, index) {
  let label = labels[index]
  if label == null { return str(index + 1) }
  return str(label)
}

fn draw_empty(frame, style, message) {
  chart_text((frame.left + frame.right) / 2, (frame.top + frame.bottom) / 2, message, style, 13, "middle")
}

fn draw_categories(labels, count, frame, style) {
  let plot_width = frame.right - frame.left
  let step = plot_width / count
  let slots = Math.min(count, Math.max(1, Math.floor(plot_width / 76)))
  let spacing = plot_width / slots
  for slot = 0 to slots {
    let index = Math.floor(count / 2)
    if slots > 1 { index = Math.round(slot * (count - 1) / (slots - 1)) }
    let label = labels[index]
    if label != null {
      let x = frame.left + step * (index + 0.5)
      let available = Math.min(spacing - 9, Math.min(2 * (style.width - x - 5), 2 * (x - 5)))
      start_detail(str(label), style.png)
      chart_text(x, frame.bottom + 23, fit_text(label, 11, available), style, 11, "middle")
      end_detail(style.png)
    }
  }
}

/**
  Shared renderer for bar and line charts. Fits the Y scale to the finite values
  and zero, spaces data by its original index, and labels as many categories
  as the plot width permits.
*/
fn plot_chart(kind, labels, values, path, options) {
  let style = chart_style(path, options)
  let low = 0
  let high = 0
  let valid = 0
  for value in values {
    if finite(value) {
      low = Math.min(low, value)
      high = Math.max(high, value)
      valid = valid + 1
    }
  }

  let axis = nice_axis(low, high, Math.max(2, Math.floor((style.height - plot_top(style) - 44) / 48)))
  let frame = plot_frame(style, axis)
  begin_chart(style)
  draw_axes(frame, axis, null, style)
  if valid == 0 {
    draw_empty(frame, style, "No data")
    return end_chart(path, style)
  }

  let plot_height = frame.bottom - frame.top
  let step = (frame.right - frame.left) / len(values)
  let zero = frame.bottom - axis_fraction(0, axis) * plot_height
  let bar_width = Math.min(84, step * 0.7)
  let previous = null
  let markers = []
  for i = 0 to len(values) {
    let value = values[i]
    if finite(value) {
      let x = frame.left + step * (i + 0.5)
      let y = frame.bottom - axis_fraction(value, axis) * plot_height
      let detail = label_at(labels, i) + ": " + str(value)
      if kind == "bar" {
        start_detail(detail, style.png)
        let bar_height = Math.abs(zero - y)
        chart_rect(x - bar_width / 2, Math.min(y, zero), bar_width, bar_height, color_at(i, options), style.png, Math.min(4, bar_height / 2))
        end_detail(style.png)
      } else {
        if previous != null {
          chart_line(previous.x, previous.y, x, y, options.line_color || color_at(0, options), style.png, 2.5)
        }
        previous = {x: x, y: y, detail: detail}
        push(markers, previous)
      }
    } else {
      previous = null
    }
  }

  for marker in markers {
    start_detail(marker.detail, style.png)
    chart_circle(marker.x, marker.y, 5, style.background, style.png)
    chart_circle(marker.x, marker.y, 3.5, options.point_color || color_at(0, options), style.png)
    end_detail(style.png)
  }
  draw_categories(labels, len(values), frame, style)
  return end_chart(path, style)
}

/**
  Generates a vertical bar chart with a shared zero baseline.

  Parameters:
  - `labels`: Category labels in the same order as the values.
  - `values`: Numeric values. Nonfinite and nonnumeric entries are skipped.
  - `path`: Output destination, usually ending in `.svg` or `.png`.
  - `options`: Optional `title`, `width`, `height`, `background`, `foreground`,
    `grid_color`, `colors`, and `format`. Use `format: "png"` to force PNG.

  Returns:
  - The saved file path.

  Example:
  ```sesi
  let file = bar_chart(["Q1", "Q2", "Q3", "Q4"], [120, 190, 300, 250], "sales.svg", {
    title: "Quarterly Sales",
    width: 800,
    height: 400
  })
  show "Saved bar chart:" file
  ```
*/
export fn bar_chart(labels, values, path, options = null) {
  return plot_chart("bar", labels, values, path, options)
}

/**
  Generates a line chart with markers at each valid value.

  Parameters:
  - `labels`: Category or time labels in the same order as the values.
  - `values`: Numeric values. Missing, nonnumeric, or nonfinite entries break the line.
  - `path`: Output destination, usually ending in `.svg` or `.png`.
  - `options`: The options accepted by `bar_chart`, plus `line_color` and `point_color`.

  Returns:
  - The saved file path.

  Example:
  ```sesi
  let file = line_chart(["Jan", "Feb", "Mar", "Apr"], [10, 22, 18, 35], "trend.png", {
    title: "Monthly Growth",
    line_color: "#2563eb"
  })
  show "Saved line chart:" file
  ```
*/
export fn line_chart(labels, values, path, options = null) {
  return plot_chart("line", labels, values, path, options)
}

/**
  Generates a scatter plot with independent numeric X and Y scales.

  Parameters:
  - `points`: Objects with numeric `x` and `y` coordinates and an optional `color`.
    Points with invalid coordinates are skipped. Uncolored points use the chart palette.
  - `path`: Output destination, usually ending in `.svg` or `.png`.
  - `options`: The options accepted by `bar_chart`, plus `point_radius` in pixels.

  Returns:
  - The saved file path.

  Example:
  ```sesi
  let data = [
    {x: 5, y: 12, color: "#e11d48"},
    {x: 10, y: 24},
    {x: 15, y: 19}
  ]
  let file = scatter_chart(data, "scatter.svg", {title: "Correlation Analysis"})
  show "Saved scatter plot:" file
  ```
*/
export fn scatter_chart(points, path, options = null) {
  let style = chart_style(path, options)
  let clean = []
  let x_min = 0
  let x_max = 1
  let y_min = 0
  let y_max = 1
  for i = 0 to len(points) {
    let point = points[i]
    if finite(point.x) && finite(point.y) {
      if len(clean) == 0 {
        x_min = point.x
        x_max = point.x
        y_min = point.y
        y_max = point.y
      }
      x_min = Math.min(x_min, point.x)
      x_max = Math.max(x_max, point.x)
      y_min = Math.min(y_min, point.y)
      y_max = Math.max(y_max, point.y)
      push(clean, {x: point.x, y: point.y, color: point.color || color_at(i, options)})
    }
  }

  let y_axis = nice_axis(y_min, y_max, Math.max(2, Math.floor((style.height - plot_top(style) - 44) / 48)))
  let frame = plot_frame(style, y_axis)
  let x_axis = nice_axis(x_min, x_max, Math.max(2, Math.floor((frame.right - frame.left) / 82)))
  begin_chart(style)
  draw_axes(frame, y_axis, x_axis, style)

  for point in clean {
    let x = frame.left + axis_fraction(point.x, x_axis) * (frame.right - frame.left)
    let y = frame.bottom - axis_fraction(point.y, y_axis) * (frame.bottom - frame.top)
    let detail = "(" + str(point.x) + ", " + str(point.y) + ")"
    start_detail(detail, style.png)
    chart_circle(x, y, options.point_radius || 5, point.color, style.png)
    end_detail(style.png)
  }
  if len(clean) == 0 { draw_empty(frame, style, "No data") }
  return end_chart(path, style)
}

fn percent_text(share) {
  if share > 0 && share < 0.001 { return "<0.1%" }
  return str(Math.round(share * 1000) / 10) + "%"
}

fn draw_slice(cx, cy, radius, angle, span, color, png) {
  let next = angle + span
  let x1 = cx + radius * Math.cos(angle)
  let y1 = cy + radius * Math.sin(angle)
  let x2 = cx + radius * Math.cos(next)
  let y2 = cy + radius * Math.sin(next)
  let large = 0
  if span > Math.PI { large = 1 }
  let arc = "M " + str(cx) + " " + str(cy) + " L " + str(x1) + " " + str(y1)
  arc = arc + " A " + str(radius) + " " + str(radius) + " 0 " + str(large) + " 1 " + str(x2) + " " + str(y2) + " Z"
  if png {
    Draw.pixel_path(arc, color)
  } else {
    Draw.path(arc, color)
  }
}

/**
  Generates a pie chart with a color legend and percentage labels.

  Parameters:
  - `labels`: Slice labels in the same order as the values. Missing labels use
    their one-based index.
  - `values`: Numeric weights or counts. Only positive finite values contribute.
  - `path`: Output destination, usually ending in `.svg` or `.png`.
  - `options`: The options accepted by `bar_chart`.

  Returns:
  - The saved file path.

  Example:
  ```sesi
  let file = pie_chart(["Frontend", "Backend", "DevOps"], [40, 45, 15], "distribution.svg", {
    title: "Resource Allocation"
  })
  show "Saved pie chart:" file
  ```

  Notes:
  - SVG draws vector arcs. PNG rasterizes the same arc paths.
  - Compact charts move the legend under the pie and grow vertically when
    necessary to keep every legend entry visible.
*/
export fn pie_chart(labels, values, path, options = null) {
  let style = chart_style(path, options, true)
  let top = plot_top(style)
  let largest = 0
  for value in values {
    if finite(value) && value > largest { largest = value }
  }
  if largest == 0 {
    begin_chart(style)
    draw_empty({left: 0, right: style.width, top: top, bottom: style.height}, style, "No positive values")
    return end_chart(path, style)
  }

  let slices = []
  let total = 0
  for i = 0 to len(values) {
    let value = values[i]
    if finite(value) && value > 0 {
      let weight = value / largest
      total = total + weight
      push(slices, {weight: weight, label: label_at(labels, i), color: color_at(i, options)})
    }
  }

  let columns = 1
  let cell_width = style.width * 0.4
  let legend_x = style.width * 0.55
  let legend_top = (style.height + top - len(slices) * 26) / 2
  let cx = (legend_x + 14) / 2
  let cy = (style.height + top - 20) / 2
  let radius = Math.min((legend_x - 47) / 2, (style.height - top - 44) / 2)
  if style.width < 490 || legend_top < top {
    columns = Math.max(1, Math.floor((style.width - 40) / 184))
    let rows = Math.ceil(len(slices) / columns)
    style.height = Math.max(style.height, top + 146 + rows * 26)
    cell_width = (style.width - 40) / columns
    legend_x = 20
    legend_top = style.height - rows * 26 - 16
    cx = style.width / 2
    cy = (top + legend_top - 12) / 2
    radius = Math.min((style.width - 48) / 2, (legend_top - top - 32) / 2)
  }

  begin_chart(style)
  let angle = -Math.PI / 2
  for i = 0 to len(slices) {
    let slice_data = slices[i]
    let share = slice_data.weight / total
    let span = share * Math.PI * 2
    let percent = percent_text(share)
    let detail = slice_data.label + ": " + percent
    start_detail(detail, style.png)
    if span >= Math.PI * 2 - 0.000000000001 {
      chart_circle(cx, cy, radius, slice_data.color, style.png)
    } else if span > 0 {
      draw_slice(cx, cy, radius, angle, span, slice_data.color, style.png)
    }
    end_detail(style.png)
    angle = angle + span

    let x = legend_x + (i % columns) * cell_width
    let y = legend_top + Math.floor(i / columns) * 26 + 17
    let percent_x = x + cell_width - 8
    let label_width = cell_width - 35 - text_width(percent, 12)
    start_detail(detail, style.png)
    chart_circle(x + 5, y - 4, 4.5, slice_data.color, style.png)
    chart_text(x + 17, y, fit_text(slice_data.label, 12, label_width), style, 12)
    chart_text(percent_x, y, percent, style, 12, "end", true)
    end_detail(style.png)
  }
  return end_chart(path, style)
}

/**
  Generates eight sample charts in the current working directory, one SVG
  and one PNG for each chart type.

  Parameters:
  - None.

  Example:
  ```sh
  sesi lib/graphics/chart.sesi
  ```
*/
fn testall() {
  show bar_chart(["A", "B", "C", "D"], [30, 70, 45, 55], "test_chart.png", {
    title: "Test Bar Chart",
    width: 600,
    height: 400,
    background: "#ffffff",
    foreground: "#000000"
  })
  show bar_chart(["A", "B", "C", "D"], [30, 70, 45, 55], "test_chart.svg", {
    title: "Test Bar Chart",
    width: 600,
    height: 400,
    background: "#ffffff",
    foreground: "#000000"
  })
