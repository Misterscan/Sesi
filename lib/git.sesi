/**
  Utility functions for safely running Git commands and handling errors.
  These functions include pushing, pulling, cloning, checking out branches, and merging, all with safety checks for shell control characters.
*/

/**
  Safely run a shell command and handle errors.

  Parameters:
  - `cmd`: The shell command to run.

  Returns:
  - The output of the command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = saferun("echo Hello, World!")
  show output // Hello, World!
  ```

  Notes:
  - This function uses a try-catch block to safely execute shell commands.
  - If the command fails, the error message is returned instead of throwing an exception.
*/
fn saferun(cmd: string) -> string {
    try {
        return run(cmd)
    } catch (e) {
        show "Error running command:" cmd "
        " e
        return e | str
    }
}

/**
  Safely quote a Git argument and reject shell control characters.

  Parameters:
  - `value`: The argument value to quote and validate.

  Returns:
  - The safely quoted argument.

  Example:
  ```sesi
  let quoted = git_arg("safe_argument")
  show quoted // "safe_argument"
  ```

  Notes:
  - This function uses a regular expression to detect shell control characters.
  - If any unsafe characters are found, an error is raised.
  - The argument is safely quoted for use in Git commands.
*/
fn git_arg(value: string) -> string {
    if regex("[&|<>^%!\"\\r\\n]", value, {"mode": "match", "flags": "g"}) != [] {
        raise_error("UnsafeGitArgument", "Git arguments cannot contain shell control characters")
    }
    return "\"" + value + "\""
}

/**
  Safely run a Git command and handle errors.

  Parameters:
  - `cmd`: The Git command to run.

  Returns:
  - The output of the Git command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git("status")
  show output
  ```

  Notes:
  - This function uses the `saferun` function to execute Git commands safely.
  - If the Git command contains unsafe shell control characters, an error is raised.
  - The Git command is safely  executed using the `saferun` function.
*/
export fn git(cmd: string) -> string {
    if regex("[&|<>^%!\\r\\n]", cmd, {"mode": "match", "flags": "g"}) != [] {
        raise_error("UnsafeGitCommand", "Git commands cannot contain shell control characters")
    }
    let git_cmd = "git " + cmd
    return saferun(git_cmd)
}

/**
  Safely clone a Git repository into a specific directory.

  Parameters:
  - `repo`: The URL of the Git repository to clone.
  - `dir`: The target directory to clone the repository into.

  Returns:
  - The output of the Git clone command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git_clone("https://github.com/user/repo.git", "target_dir")
  show output
  ```

  Notes:
  - Clone means to create a copy of the specified Git repository in the target directory.
*/
export fn git_clone(repo: string, dir: string) -> string {
    let cmd = "clone " + git_arg(repo) + " " + git_arg(dir)
    return git(cmd)
}

/**
  Safely checkout a specific Git branch.

  Parameters:
  - `branch`: The name of the branch to checkout.

  Returns:
  - The output of the Git checkout command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git_checkout("feature-branch")
  show output
  ```
  Notes:
  - Checkout means to switch to the specified branch in the Git repository.
*/
export fn git_checkout(branch: string) -> string {
    let cmd = "checkout " + git_arg(branch)
    return git(cmd)
}

/**
  Safely create and checkout a new Git branch.

  Parameters:
  - `branch`: The name of the new branch to create and checkout.

  Returns:
  - The output of the Git checkout -b command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git_checkout_new("new-feature-branch")
  show output
  ```

  Notes:
  - This function creates a new branch and switches to it immediately.
*/
export fn git_checkout_new(branch: string) -> string {
    let cmd = "checkout -b " + git_arg(branch)
    return git(cmd)
}

/**
  Safely merge a specific Git branch into the current branch.

  Parameters:
  - `branch`: The name of the branch to merge.

  Returns:
  - The output of the Git merge command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git_merge("feature-branch")
  show output
  ```

  Notes:
  - Merge means to integrate changes from the specified branch into the current branch.
*/
export fn git_merge(branch: string) -> string {
    let cmd = "merge " + git_arg(branch)
    return git(cmd)
}

/**
  Safely merge a specific Git branch into the current branch with no fast-forward.

  Parameters:
  - `branch`: The name of the branch to merge.

  Returns:
  - The output of the Git merge --no-ff command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git_merge_no_ff("feature-branch")
  show output
  ```

  Notes:
  - The `--no-ff` option ensures that the merge is always recorded as a separate commit, even if it could be fast-forwarded.
*/
export fn git_merge_no_ff(branch: string) -> string {
    let cmd = "merge --no-ff " + git_arg(branch)
    return git(cmd)
}

/**
  Safely merge a specific Git branch into the current branch with a squash commit.

  Parameters:
  - `branch`: The name of the branch to merge.

  Returns:
  - The output of the Git merge --squash command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git_merge_squash("feature-branch")
  show output
  ```

  Notes:
  - The `--squash` option combines all changes from the specified branch into a single commit on the current branch.
*/
export fn git_merge_squash(branch: string) -> string {
    let cmd = "merge --squash " + git_arg(branch)
    return git(cmd)
}

/**
  Safely abort an ongoing Git merge.

  Returns:
  - The output of the Git merge --abort command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git_merge_abort()
  show output
  ```

  Notes:
  - The `--abort` option cancels the ongoing merge and returns the repository to its previous state.
*/
export fn git_merge_abort() -> string {
    let cmd = "merge --abort"
    return git(cmd)
}

/**
  Safely rebase the current branch onto a specific Git branch.

  Parameters:
  - `branch`: The name of the branch to rebase onto.

  Returns:
  - The output of the Git rebase command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git_rebase("feature-branch")
  show output
  ```

  Notes:
  - The `git rebase` command reapplies commits from the current branch onto the specified branch, allowing for a cleaner commit history.
*/
export fn git_rebase(branch: string) -> string {
    let cmd = "rebase " + git_arg(branch)
    return git(cmd)
}

/**
  Safely abort an ongoing Git rebase.

  Returns:
  - The output of the Git rebase --abort command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git_rebase_abort()
  show output
  ```

  Notes:
  - The `--abort` option cancels the ongoing rebase and returns the repository to its previous state.
*/
export fn git_rebase_abort() -> string {
    let cmd = "rebase --abort"
    return git(cmd)
}

/**
  Continue an ongoing Git rebase after resolving conflicts.

  Returns:
  - The output of the Git rebase --continue command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git_rebase_continue()
  show output
  ```

  Notes:
  - The `--continue` option resumes the rebase process after conflicts have been resolved.
*/
export fn git_rebase_continue() -> string {
    let cmd = "rebase --continue"
    return git(cmd)
}

/**
  Skip the current patch during an ongoing Git rebase.

  Returns:
  - The output of the Git rebase --skip command if it succeeds, otherwise the error message.

  Example:
  ```sesi
  let output = git_rebase_skip()
  show output
  ```

  Notes:
  - The `--skip` option skips the current patch and continues the rebase process.
*/
export fn git_rebase_skip() -> string {
    let cmd = "rebase --skip"
    return git(cmd)
}

/**
  Pull the latest changes from the remote repository.

  Returns:
  - The output of the Git pull command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_pull()
  show output
  ```

  Notes:
  - The `git pull` command fetches changes from the remote repository and merges them into the current branch.
*/
export fn git_pull() -> string {
    let cmd = "pull"
    return git(cmd)
}

/**
  Pull the latest changes from the remote repository and rebase the current branch.

  Returns:
  - The output of the Git pull --rebase command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_pull_rebase()
  show output
  ```

  Notes:
  - The `--rebase` option rebases the current branch on top of the upstream branch after fetching.
*/
export fn git_pull_rebase() -> string {
    let cmd = "pull --rebase"
    return git(cmd)
}

/**
  Pull the latest changes from the remote repository, rebase the current branch, and automatically stash local changes.

  Returns:
  - The output of the Git pull --rebase --autostash command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_pull_rebase_autostash()
  show output
  ```

  Notes:
  - The `--autostash` option automatically stashes local changes before rebasing and applies them afterward.
*/
export fn git_pull_rebase_autostash() -> string {
    let cmd = "pull --rebase --autostash"
    return git(cmd)
}

/**
  Fetch the latest changes from the remote repository.

  Returns:
  - The output of the Git fetch command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_fetch()
  show output
  ```

  Notes:
  - The `git fetch` command retrieves changes from the remote repository without merging them into the current branch.
*/
export fn git_fetch() -> string {
    let cmd = "fetch"
    return git(cmd)
}

/**
  Fetch all branches from the remote repository.

  Returns:
  - The output of the Git fetch --all command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_fetch_all()
  show output
  ```

  Notes:
  - The `--all` option fetches all branches from the remote repository.
*/
export fn git_fetch_all() -> string {
    let cmd = "fetch --all"
    return git(cmd)
}

/**
  Fetch the latest changes from the remote repository and prune deleted branches.

  Returns:
  - The output of the Git fetch --prune command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_fetch_prune()
  show output
  ```

  Notes:
  - The `--prune` option removes any remote-tracking references that no longer exist on the remote.
*/
export fn git_fetch_prune() -> string {
    let cmd = "fetch --prune"
    return git(cmd)
}

/**
  Fetch all branches from the remote repository and prune deleted branches.

  Returns:
  - The output of the Git fetch --all --prune command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_fetch_all_prune()
  show output
  ```

  Notes:
  - The `--all` option fetches all branches from the remote repository.
  - The `--prune` option removes any remote-tracking references that no longer exist on the remote.
*/
export fn git_fetch_all_prune() -> string {
    let cmd = "fetch --all --prune"
    return git(cmd)
}

/**
  Fetch the latest changes from the remote repository, prune deleted branches, and fetch tags.

  Returns:
  - The output of the Git fetch --prune --tags command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_fetch_prune_tags()
  show output
  ```

  Notes:
  - The `--prune` option removes any remote-tracking references that no longer exist on the remote.
  - The `--tags` option fetches all tags from the remote repository.
*/
export fn git_fetch_prune_tags() -> string {
    let cmd = "fetch --prune --tags"
    return git(cmd)
}

/**
  Fetch all branches from the remote repository, prune deleted branches, and fetch tags.

  Returns:
  - The output of the Git fetch --all --prune --tags command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_fetch_all_prune_tags()
  show output
  ```

  Notes:
  - The `--all` option fetches all branches from the remote repository.
  - The `--prune` option removes any remote-tracking references that no longer exist on the remote.
  - The `--tags` option fetches all tags from the remote repository.
*/
export fn git_fetch_all_prune_tags() -> string {
    let cmd = "fetch --all --prune --tags"
    return git(cmd)
}

/**
  Fetch tags from the remote repository.

  Returns:
  - The output of the Git fetch --tags command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_fetch_tags()
  show output
  ```

  Notes:
  - The `--tags` option fetches all tags from the remote repository.
*/
export fn git_fetch_tags() -> string {
    let cmd = "fetch --tags"
    return git(cmd)
}

/**
  Fetch all branches and tags from the remote repository.

  Returns:
  - The output of the Git fetch --all --tags command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_fetch_all_tags()
  show output
  ```

  Notes:
  - The `--all` option fetches all branches from the remote repository.
  - The `--tags` option fetches all tags from the remote repository.
*/
export fn git_fetch_all_tags() -> string {
    let cmd = "fetch --all --tags"
    return git(cmd)
}

/**
  Push the current branch to the remote repository.

  Returns:
  - The output of the Git push command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_push()
  show output
  ```

  Notes:
  - The `git push` command pushes the current branch to the remote repository.
*/
export fn git_push() -> string {
    let cmd = "push"
    return git(cmd)
}

/**
  Force push the current branch to the remote repository.

  Returns:
  - The output of the Git push --force command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_push_force()
  show output
  ```

  Notes:
  - The `--force` option forces the push to the remote repository, potentially overwriting changes.
*/
export fn git_push_force() -> string {
    let cmd = "push --force"
    return git(cmd)
}

/**
  Force push the current branch to the remote repository with lease.

  Returns:
  - The output of the Git push --force-with-lease command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_push_force_with_lease()
  show output
  ```

  Notes:
  - The `--force-with-lease` option forces the push to the remote repository only if the remote branch has not been updated, preventing accidental overwrites.
*/
export fn git_push_force_with_lease() -> string {
    let cmd = "push --force-with-lease"
    return git(cmd)
}

/**
  Push the current branch to the remote repository and set the upstream branch.

  Parameters:
  - `branch`: The name of the branch to push and set as upstream.

  Returns:
  - The output of the Git push --set-upstream origin <branch> command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_push_set_upstream("main")
  show output
  ```

  Notes:
  - The `--set-upstream` option sets the upstream branch for the current branch.
*/
export fn git_push_set_upstream(branch: string) -> string {
    let cmd = "push --set-upstream origin " + git_arg(branch)
    return git(cmd)
}

/**
  Push all tags to the remote repository.

  Returns:
  - The output of the Git push --tags command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_push_tags()
  show output
  ```

  Notes:
  - The `--tags` option pushes all tags to the remote repository.
*/
export fn git_push_tags() -> string {
    let cmd = "push --tags"
    return git(cmd)
}

/**
  Push all branches to the remote repository.

  Returns:
  - The output of the Git push --all command if it succeeds, otherwise the error message.

  Example:

  ```sesi
  let output = git_push_all()
  show output
  ```

  Notes:
  - The `--all` option pushes all branches to the remote repository.
*/
export fn git_push_all() -> string {
    let cmd = "push --all"
    return git(cmd)
}

