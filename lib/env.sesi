/**
  Environment configuration and utility functions for managing environment variables.

  This module provides default development settings and helper functions for reading,
  listing, loading, copying, setting, changing, clearing, and validating environment
  variables. It also provides utilities for working with local `.env` files.

  Notes:
  - Environment variables are read through Sesi's `env()` built-in function.
  - File-based helpers expect `.env` files to use `KEY=VALUE` entries.
  - Environment-variable changes made through shell commands may depend on the operating system and process environment behavior.
*/
allow "os" in as os
/**
  Default local development port used by development tools and local services.

  Example:
  ```sesi
  show DEV_PORT
  let url = LOCAL_HOST
  show "Development server:" url
  ```

  Notes:
  - This value is a mutable exported variable and can be reassigned by importing code when a different local port is required.
  - Contains the numeric development port `8080`.
*/
export let DEV_PORT = 8080
/**
  Default local host URL associated with the development port.


  Example:
  ```sesi
  show LOCAL_HOST
  let health_url = LOCAL_HOST + "health"
  show health_url
  ```

  Notes:
  - The URL includes a trailing slash to facilitate concatenation with relative paths.
  - Contains the string `"http://localhost:8080/"`.
*/
export let LOCAL_HOST = "http://localhost:" + str(DEV_PORT) + "/"
/**
  Dummy API key intended for local tests, examples, and development fixtures.

  Example:
  ```sesi
  let test_key = DUMMY_KEY
  show "Using test key:" test_key
  ```

  Notes:
  - This value is not a real credential and must not be used for production access.
  - Contains the string `"dummy-key"`.
*/
export let DUMMY_KEY = "dummy-key"
/**
  Default folder used for temporary local development files.

  Example:
  ```sesi
  let output = DEV_FOLDER + "result.txt"
  write_file(output, "Development result")
  show output
  ```

  Notes:
  - Contains the string `"temp/dev/"`.
  - The module creates this directory during initialization with `make_dir()` if it does not already exist.
  - The trailing slash is part of the default value and can be useful when concatenating child paths.
*/
export let DEV_FOLDER = "temp/dev/"
if !exists(DEV_FOLDER) { make_dir(DEV_FOLDER) }
/**
  Default host name used by local development utilities and generated metadata.

  Example:
  ```sesi
  show "Host:" HOST_NAME
  ```

  Notes:
  - Contains the string `"Sesi Lang"`.
  - This is a descriptive configuration value and does not change the operating system host name.
*/
export let HOST_NAME = "Sesi Lang"
/**
  Default operating system host name.

  Example:
  ```sesi
  show "OS Host:" OS_HOST
  ```

  Notes:
  - Contains the string value of the operating system host name and is read from the environment..
*/
export let OS_HOST = os.hostname() || $HOSTNAME
/**
  Default user-agent string used to identify requests made by local utilities.

  Example:
  ```sesi
  let headers = {"User-Agent": USER_AGENT}
  let response = web_get(LOCAL_HOST, headers)
  show response
  ```

  Notes:
  - The value is only a default identifier. Network functions must be given the headers explicitly when a custom user agent is required.
  - Contains the string `"SesiDo-Agent"`.
*/
export let USER_AGENT = "SesiDo-Agent"
/**
  Get the value of an environment variable by name.

  Parameters:
  - `key`: The name of the environment variable to retrieve.
  - `defaultVar`: The fallback value returned when `key` is not defined. Defaults to `null`.

  Returns:
  - The environment-variable value as a string when the variable exists.
  - `defaultVar` when the variable is not defined.

  Example:
  ```sesi
  let port = GET("PORT", str(DEV_PORT))
  let api_key = GET("API_KEY", DUMMY_KEY)
  show "Port:" port
  show "API key:" api_key
  ```

  Notes:
  - An environment variable set to an empty string is returned as an empty string, because it is still defined.
  - The declared return type is `string`, but the fallback may be another value when a non-string default is supplied.
*/
export fn GET(key: string, defaultVar = null) -> string {
  key = key | trim
  let result = $key || defaultVar
  return result
}
/**
  Return all available environment-variable names as a JSON string.

  Parameters:
  - None.

  Returns:
  - A JSON-encoded string containing an array of environment-variable names.

  Example:
  ```sesi
  let names_json = GET_ALL()
  show names_json
  write_file(DEV_FOLDER + "environment_keys.json", names_json)
  ```

  Notes:
  - The result is a JSON string rather than a native array.
  - Use `from_json()` when a Sesi array is needed for further processing.
*/
export fn GET_ALL() {
  let all = env()
  return all | keys | to_json
}
/**
  Read an environment-variable value from a folder's `.env` file.

  Parameters:
  - `key`: The environment-variable name to search for.
  - `folder`: The directory containing the `.env` file.

  Returns:
  - The text after the first `=` on the matching line.
  - `null` when no matching variable is found.

  Example:
  ```sesi
  let database_url = GET_FROM("DATABASE_URL", ".")
  if database_url == null {
    show "DATABASE_URL was not found in the local .env file"
  } else {
    show "Database URL:" database_url
  }
  ```

  Notes:
  - The function reads `<folder>/.env`.
  - Lines beginning with `#` are ignored.
  - Matching is based on whether a line starts with `key`; therefore, callers should use precise variable names to avoid unintended prefix matches.
  - The `.env` file must be readable or the underlying file error may be thrown.
*/
export fn GET_FROM(key: string, folder: string) -> string {
  let envFile = read_file(folder + "/.env")
  let env = ""
  envFile = split(envFile, "\n")
  for envs in envFile {
    if envs | starts_with("#") { continue }
    if envs | starts_with(key) {
      env = envs | split("=")
      return env[1]
    }
  }
}
/**
  Parse the raw string contents of an environment (.env) file into a key-value object.

  Parameters:
  - `path`: The path of the `.env` file to parse.

  Returns:
  - An object containing the extracted key-value pairs as strings.

  Example:
  ```sesi
  let parsed = PARSE("path/to/.env")
  show parsed.PORT
  show parsed.DB_NAME
  ```

  Notes:
  - Empty lines and lines starting with `#` are ignored as comments.
  - Leading and trailing whitespace is trimmed from both keys and values.
  - If a value is enclosed in matching single (`'`) or double (`"`) quotes, the quotes are stripped automatically.
  - For lines containing multiple `=` characters, the first `=` acts as the delimiter, and the remainder forms the value.
*/
export fn PARSE(path = ".env") -> object {
  let values = {}
  let content = read_file(path)
  for line in split(content, "\n") {
    let text = trim(line)
    if text == "" { continue }
    if split(text, "")[0] == "#" { continue }
    let parts = split(text, "=")
    if len(parts) < 2 { continue }
    let key = trim(parts[0])
    if key == "" { continue }
    let value = trim(join(slice(parts, 1, len(parts)), "="))
    let chars = split(value, "")
    if len(chars) >= 2 {
      let first = chars[0]
      let last = chars[len(chars) - 1]
      if (first == "\"" && last == "\"") || (first == "'" && last == "'") { value = join(slice(chars, 1, len(chars) - 1), "") }
    }
    values[key] = value
  }
  return values
}
/**
  Load, merge, and validate environment variables from a file path and process environment.

  Parameters:
  - `path`: The file system path to the `.env` file to read.
  - `schema`: An object defining schema validation rules, types, defaults, and constraints.

  Returns:
  - An object representing the loaded configuration status with the following shape:
    - `valid`: A boolean indicating whether loading and schema validation succeeded.
    - `config`: An object containing the resolved, type-converted configuration values.
    - `errors`: An array of error strings captured during file reading or schema validation.

  Example:
  ```sesi
  let schema = {
    PORT: {type: "number", default: 8080},
    API_KEY: {type: "string", required: true},
    LOG_LEVEL: {type: "string", choices: ["debug", "info", "warn", "error"], default: "info"}
  }

  let env = LOAD(".env", schema)
  if env.valid {
    show "Server port:" env.config.PORT
  } else {
    show "Failed to load environment:" env.errors
  }
  ```

  Notes:
  - Process-level environment variables (retrieved via `env()`) override values parsed from the `.env` file.
  - If the target `.env` file does not exist, the function proceeds with process environment variables and schema defaults without throwing an error.
  - Any file read failure is caught and appended to the `errors` array.
*/
export fn LOAD(path: string, schema: object) -> object {
  let values = {}
  let errors = []
  if exists(path) {
    try { values = PARSE(read_file(path)) }
    catch (err) { push(errors, "Could not read " + path + ": " + str(err)) }
  }
  for key in keys(schema) {
    let override = env(key)
    if override != null { values[key] = override }
  }
  let result = VALIDATE(values, schema)
  for error in result.errors { push(errors, error) }
  return {valid: len(errors) == 0, config: result.config, errors: errors}
}
/**
  Copy the current process value of an environment variable into a folder's `.env` file.

  Parameters:
  - `key`: The environment-variable name to read and append.
  - `folder`: The destination directory containing or receiving `.env`.

  Returns:
  - `true` when the value is appended successfully.
  - `false` when the append operation fails.

  Example:
  ```sesi
  let copied = COPY_TO("API_KEY", DEV_FOLDER)
  if copied {
    show "Environment value copied successfully"
  } else {
    show "Environment value could not be copied"
  }
  ```

  Notes:
  - The function reads the value with `GET(key)`.
  - A new line containing `key=value` is appended to the destination `.env` file.
  - The destination file is created by `append_file()` when it does not exist.
  - Existing entries with the same key are not replaced, so repeated calls may create duplicate entries.
  - The function prints a status message and suppresses append errors by returning `false`.
*/
export fn COPY_TO(key: string, folder: string) -> bool {
  let var = GET(key)
  try {
    if folder | ends_with("/") {
      append_file(folder + ".env", "\n" + key + "=" + var)
      show "Copied" key "to" folder ".env"
      return true
    } else {
      append_file(folder + "/.env", "\n" + key + "=" + var)
      show "Copied" key "to" folder "/.env"
      return true
    }
  } catch (e) {
    show "Failed to copy" key "to" folder ":" e.message
    return false
  }
}
/**
  Set an environment variable through a shell export command.

  Parameters:
  - `key`: The name of the environment variable to set.
  - `variable`: The string value to assign to the variable.

  Returns:
  - `true` when the shell command completes without throwing.
  - `false` when command execution fails.

  Example:
  ```sesi
  let changed = SET("APP_MODE", "development")
  if changed {
    show "APP_MODE was set"
  }
  ```

  Notes:
  - The implementation uses `run()` with an `export` command, so behavior is platform-dependent.
  - A child-shell export may not modify the parent Sesi process environment.
  - Values containing quotes or shell metacharacters may require additional escaping before being passed to this function.
  - The function prints either a success or failure message.
*/
export fn SET(key: string, variable: string) -> bool {
  try {
    run("export " + key + "=\"" + variable  + "\"")
    show "Set environment variable:" key "=" variable
    return true
  } catch (e) {
    show "Failed to set environment variable:" key "\n" e.message
    return false
  }
}
/**
  Change an existing environment variable to a new value.

  Parameters:
  - `key`: The name of the environment variable to change.
  - `newVar`: The replacement string value.

  Returns:
  - `true` when the existing variable is successfully passed to `SET()`.
  - `false` when the variable does not exist or setting the new value fails.

  Example:
  ```sesi
  let updated = CHANGE("APP_MODE", "testing")
  if updated {
    show "APP_MODE changed successfully"
  }
  ```

  Notes:
  - The function first checks the variable with `GET()`.
  - A variable with a `null` value or empty string is treated as missing.
  - The original and replacement values are displayed before the update.
  - The actual update behavior follows the platform-dependent behavior of `SET()`.
*/
export fn CHANGE(key: string, newVar: string) -> bool {
  let currentVar = GET(key)
  if currentVar == null || currentVar == "" {
    show "Environment variable not found for:" key
    return false
  } else { show "Changing environment variable:" key "=" currentVar "->" newVar }
  return SET(key, newVar)
}
/**
  Clear an environment variable after interactive confirmation.

  Parameters:
  - `key`: The name of the environment variable to clear.

  Returns:
  - `true` when the user confirms with `y` and the variable is set to an empty string.
  - `false` when the user declines or `SET()` fails.

  Example:
  ```sesi
  let cleared = CLEAR("TEMP_TOKEN")
  if cleared {
    show "TEMP_TOKEN was cleared"
  } else {
    show "TEMP_TOKEN was not cleared"
  }
  ```

  Notes:
  - The function prompts the user for confirmation.
  - Input is trimmed and converted to lowercase before comparison.
  - Only the exact response `y` confirms the operation.
  - Clearing sets the value to `""`; it does not remove the variable definition.
*/
export fn CLEAR(key: string) -> bool {
  let confirm = input("Are you sure you want to clear env var for " + key + " ? (y/n): ") | trim | to_lower
  if confirm == "y" { return SET(key, "") } else { return false }
}
/**
  Validate and convert environment-variable values against a structured schema.

  Parameters:
  - `values`: An object containing parsed environment variable key-value pairs.
  - `schema`: An object defining schema rules, types, defaults, and constraints for each expected key.

  Returns:
  - An object representing the validation result with the following shape:
    - `valid`: A boolean indicating whether all validations passed without errors.
    - `config`: An object containing the successfully parsed, casted, and defaulted configuration values.
    - `errors`: An array of strings detailing each validation failure encountered.

  Example:
  ```sesi
  let raw = {PORT: "8080", DEBUG: "true"}
  let schema = {
    PORT: {type: "number", required: true},
    DEBUG: {type: "bool", default: false},
    ENV: {type: "string", choices: ["development", "production"], default: "development"}
  }

  let result = VALIDATE(raw, schema)
  if result.valid {
    show "Configuration valid:" result.config
  } else {
    show "Validation errors:" result.errors
  }
  ```

  Notes:
  - Supported schema `type` values are `"string"`, `"number"`, `"bool"` (or `"boolean"`), and `"json"`.
  - Supports `required: true` to enforce non-empty presence when no default is specified.
  - Supports `default` to supply fallback values for missing keys.
  - Supports `choices` as an array of allowed values to enforce enum-like restrictions.
  - Supports `allowEmpty: true` to allow empty string values without triggering missing-value rules.
*/
export fn VALIDATE(values: object, schema: object) -> object {
  let config = {}
  let errors = []
  for key in keys(schema) {
    let rule = schema[key]
    let value = values[key]
    if value == null || (value == "" && rule.allowEmpty != true) {
      if contains(keys(rule), "default") { value = rule.default
      } else if rule.required == true {
        push(errors, key + " is required")
        continue
      } else { continue }
    }
    let converted = value
    let type = rule.type || "string"
    if type == "number" {
      converted = num(value)
      if converted == null || converted != converted {
        push(errors, key + " must be a number")
        continue
      }
    } else if type == "bool" || type == "boolean" {
      if value == true || value == "true" || value == "1" { converted = true
      } else if value == false || value == "false" || value == "0" { converted = false
      } else {
        push(errors, key + " must be a boolean")
        continue
      }
    } else if type == "json" {
      try { converted = from_json(str(value)) }
      catch (err) {
        push(errors, key + " must contain valid JSON")
        continue
      }
    } else if type == "string" { converted = str(value)
    } else {
      push(errors, key + " has an unsupported type: " + str(type))
      continue
    }
    if contains(keys(rule), "choices") && !contains(rule.choices, converted) {
      push(errors, key + " must be one of: " + join(rule.choices, ", "))
      continue
    }
    config[key] = converted
  }
  return {valid: len(errors) == 0, config: config, errors: errors}
}
/**
  Check for a required environment variable and optionally display a custom message.

  Parameters:
  - `key`: The name of the required environment variable.
  - `message`: Optional text to display when the variable is missing. Defaults to `null`.

  Returns:
  - `true` when the required variable exists.
  - `false` when the variable is missing.

  Example:
  ```sesi
  let configured = CHECK_REQUIRED(
    "GEMINI_API_KEY",
    "Set GEMINI_API_KEY before starting the application."
  )

  if configured {
    show "Configuration is ready"
  }
  ```

  Notes:
  - When `message` is `null`, the function displays a default message containing the missing variable name.
  - This function reports the problem and returns `false`; it does not throw an error.
*/
export fn CHECK_REQUIRED(key: string, message: string = null) -> bool {
  let currentVar = GET(key)
  if currentVar == null || currentVar == "" {
    if message != null { show message
    } else { show "Required environment variable missing:" key }
      return false
    }
  return true
}