    }
    let out = filename + "." + ext

    TERM.success("Image generated and saved as '" + out + "'")
    show "Time taken:" imgResponse.duration
    if config {
        return {
            configuration: imgResponse.config_used,
            original_request: promptText,
            enhanced_request: imgPrompt.response,
            cost: imgResponse.cost,
            duration: imgResponse.duration,
            filename: out,
            extension: ext,
            base64: imgResponse.image_data,
            complete_log: imgResponse
        }
    }
    if raw_data {
        return {
            filename: out,
            base64: imgResponse.image_data
        }
    }
    return out
}

/**
  Generates high-resolution images using advanced models and robust fallbacks.

  Parameters:
  - promptText: Text prompt for image creation.
  - size: Resolution or size specification (default "4K").
  - ratio: Aspect ratio (default "1:1").
  - filename: Base filename for output (default "generated_image").
  - ext: File extension (default "png").
  - config: Boolean indicating if configuration details should be returned (default false).
  - raw_data: Boolean indicating if raw image data should be returned (default false).

  Returns:
  - Either:
    - A string representing the saved image filename.
    - An object containing configuration details if `config` is true.
    - An object containing raw image data if `raw_data` is true.

  Example:
  ```sesi
  let img = genImageMax("Epic mountain landscape", "4K", "16:9", "mountain", "png")
  show img
  ```

  Notes:
  - Attempts generation using `gpt-6-luna` and `gpt-image-2`, falling back to `gemini-3.5-flash-lite` and `gemini-3-pro-image`.
  - The `config` parameter allows retrieval of detailed generation metadata, including the raw image data in base64 format.
  - The `raw_data` parameter allows retrieval of the raw image data in base64 format.
*/
export fn genImageMax(promptText: string, size: string = "4K", ratio: string = "1:1", filename: string = "generated_image", ext: string = "png", config = false, raw_data = false) -> any {
    if ratio == "1:1" { ratio = "square"}
    if ratio == "16:9" { ratio = "landscape"}
    if ratio == "9:16" { ratio = "portrait"}
    if ratio == "4:3" { ratio = "wide"}
    if ratio == "3:4" { ratio = "standard"}
    else {
        TERM.warning("Unknown ratio specified. Defaulting to 1:1.")
        ratio = "square"
    }
    prompt promptEngineer {"You are an experienced prompt engineer. You transform user input into a detailed and descriptive prompt for image generation. Do not mention the size or ratio in the prompt, as those will be handled separately."}
    let imgPrompt = ""
    try {
        imgPrompt = track_model(promptText + "\nJust return the prompt without any additional explanations or comments.", {
                model_name: "gpt-6-luna",
                system: promptEngineer,
                thinking: "medium",
                max_tokens: 1024
            }
        )
    } catch (err) {
        TERM.warning(err.message)
        TERM.warning("Retrying with a more capable model...")
        imgPrompt = track_model(promptText + "\nJust return the prompt without any additional explanations or comments.", {
                model_name: "gemini-3.5-flash-lite",
                system: promptEngineer,
                thinking: "medium",
                max_tokens: 1024
            }
        )
    }
    let good2go = imgPrompt.response
    if good2go == "" || good2go == null { good2go = promptText }

    TERM.info("Generating image with the following prompt: " + good2go)
    let imgResponse = ""
    try {
        imgResponse = track_image(good2go | trim, {
                model_name: "gpt-image-2.5-sunburst",
                size: size,
                ratio: ratio,
                thinking: "high",
                response: "full"
            }
        )
    } catch (err) {
        TERM.warning(err.message)
        TERM.warning("Retrying with a more capable model...")
        imgResponse = track_image(good2go | trim, {
                model_name: "gemini-3-pro-image",
                size: size,
                ratio: ratio,
                thinking: "high",
                response: "full"
            }
        )
    }

    if ext == "" || ext == "png" {
        write_image(filename + ".png", imgResponse.image_data)
    } else {
        write_image(filename + "." + ext, imgResponse.image_data)
    }
    let out = filename + "." + ext

    TERM.success("Image generated and saved as '" + out + "'")
    show "Time taken:" imgResponse.duration
    if config {
        return {
            configuration: imgResponse.config_used,
            original_request: promptText,
            enhanced_request: imgPrompt.response,
            cost: imgResponse.cost,
            duration: imgResponse.duration,
            filename: out,
            extension: ext,
            base64: imgResponse.image_data,
            complete_log: imgResponse
        }
    }
    if raw_data {
        return {
            filename: out,
            base64: imgResponse.image_data
        }
    }
    return out
}

/**
  Generates an image from a text prompt using GPT models and saves it as a file.

  Parameters:
  - promptText: Description of the image to generate.
  - size: Image size (default "2K").
  - ratio: Aspect ratio (default "1:1").
  - filename: Base filename for saving (default "generated_image").
  - ext: File extension (default "png").
  - config: Boolean indicating if configuration details should be returned (default false).
  - raw_data: Boolean indicating if raw image data should be returned (default false).

  Returns:
  - Either:
    - A string representing the saved image filename.
    - An object containing configuration details if `config` is true.
    - An object containing raw image data if `raw_data` is true.

  Example:
  ```sesi
  let img = genImageGPT("A live broadcast set in the 1980s", "2K", "16:9", "80s_broadcast", "png")
  show img
  ```

  Notes:
  - If the GPT model fails to generate a prompt, the original `promptText` will be used.
  - If the image generation fails, the function will return the error message instead of the filename.
  - The `config` parameter allows retrieval of detailed generation metadata, including the raw image data in base64 format.
  - The `raw_data` parameter allows retrieval of the raw image data in base64 format.
*/
export fn genImageGPT(promptText: string, size: string = "2K", ratio: string = "1:1", filename: string = "generated_image", ext: string = "png", config = false, raw_data = false) -> any {
    if ratio == "1:1" { ratio = "square"}
    if ratio == "16:9" { ratio = "landscape"}
    if ratio == "9:16" { ratio = "portrait"}
    if ratio == "4:3" { ratio = "wide"}
    if ratio == "3:4" { ratio = "standard"}
    else {
        TERM.warning("Unknown ratio specified. Defaulting to 1:1.")
        ratio = "square"
    }
    prompt promptEngineer {"You are an experienced prompt engineer. You transform user input into a detailed and descriptive prompt for image generation. Do not mention the size or ratio in the prompt, as those will be handled separately."}
    let imgPrompt = ""
    try {
        imgPrompt = track_model(promptText + "\nJust return the prompt without any additional explanations or comments.", {
                model_name: "gpt-6-luna",
                system: promptEngineer,
                thinking: "medium",
                max_tokens: 1024
            }
        )
    } catch (err) { TERM.warning(err.message + "\nUsing original prompt instead.") }
    let good2go = imgPrompt.response
    if good2go == "" || good2go == null { good2go = promptText }

    TERM.info("Generating image with the following prompt: " + good2go)
    let imgResponse = ""
    try {
        imgResponse = track_image(good2go | trim, {
                model_name: "gpt-image-2.6-flare",
                size: size,
                ratio: ratio,
                response: "full"
            }
        )
    } catch (err) {
        TERM.error(err.message)
        return err.message
    }
    try {
        if ext == "" || ext == "png" {
            write_image(filename + ".png", imgResponse.image_data)
        } else {
            write_image(filename + "." + ext, imgResponse.image_data)
        }
    } catch (err) {
        TERM.error(err.message)
        return err.message
    }

    let out = filename + "." + ext

    TERM.success("Image generated and saved as '" + out + "'")
    show "Time taken:" imgResponse.duration
    if config {
        return {
            configuration: imgResponse.config_used,
            original_request: promptText,
            enhanced_request: imgPrompt.response,
            cost: imgResponse.cost,
            duration: imgResponse.duration,
            filename: out,
            extension: ext,
            base64: imgResponse.image_data,
            complete_log: imgResponse
        }
    }
    if raw_data {
        return {
            filename: out,
            base64: imgResponse.image_data
        }
    }
    return out
}

/**
  Edits an existing image based on a text prompt and saves the result as a base64 encoded file.

  Parameters:
  - imgPath: Path to the image to edit.
  - promptText: Description of the edits to apply.
  - size: Desired image size (default "2K").
  - ratio: Desired image aspect ratio (default "1:1").
  - filename: Base filename for saving (default "edited_image").
  - ext: File extension (default "png").
  - config: Whether to return detailed configuration and cost information (default false).
  - raw_data: Whether to return only the raw image data (default false).

  Returns:
  - Either:
    - A string representing the saved image filename.
    - An object containing detailed configuration and cost information if `config` is true.
    - An object containing only the raw image data if `raw_data` is true.

  Example:
  ```sesi
  let img = editImageGPT("input.png", "Add a sunset background", "2K", "16:9", "sunset_background", "png")
  show img
  ```

  Notes:
  - Uses `gpt-6-luna` for prompt generation and `gpt-image-2.5-sunburst` for image editing.
  - If `config` is true, the returned object will include detailed information about the image generation process, including the original and enhanced prompts, cost, duration, and file extensions.
  - If `raw_data` is true, the returned object will contain only the raw image data in base64 format.
*/
export fn editImageGPT(imgPath: string, promptText: string, size: string = "2K", ratio: string = "1:1", filename: string = "edited_image", ext: string = "png", config = false, raw_data = false) -> any {
    if ratio == "1:1" { ratio = "square"}
    if ratio == "16:9" { ratio = "landscape"}
    if ratio == "9:16" { ratio = "portrait"}
    if ratio == "4:3" { ratio = "wide"}
    if ratio == "3:4" { ratio = "standard"}
    else {
        TERM.warning("Unknown ratio specified. Defaulting to 1:1.")
        ratio = "square"
    }
    prompt promptEngineer {"You are an experienced prompt engineer. You transform user input into a detailed and descriptive prompt for image editing. Do not mention the size or ratio in the prompt, as those will be handled separately."}
    let imgPrompt = ""
    try {
        imgPrompt = track_model(promptText + "\nJust return the prompt without any additional explanations or comments.", {
                model_name: "gpt-6-luna",
                system: promptEngineer,
                thinking: "medium",
                max_tokens: 1024,
                images: [imgPath],
                response: "full"
            }
        )
    } catch (err) { TERM.warning(err.message + "\nUsing original prompt instead.") }
    let good2go = imgPrompt.response
    if good2go == "" || good2go == null { good2go = promptText }

    TERM.info("Editing image with the following prompt: " + good2go)
    let imgResponse = ""
    try {
        imgResponse = track_image(good2go | trim, {
                model_name: "gpt-image-2.5-sunburst",
                size: size,
                ratio: ratio,
                thinking: "medium",
                response: "full",
                images: [imgPath]
            }
        )
    } catch (err) {
        TERM.error(err.message)
        return err.message
    }

    if ext == "" || ext == "png" {
        write_image(filename + ".png", imgResponse.image_data)
    } else {
        write_image(filename + "." + ext, imgResponse.image_data)
    }

    let out = filename + "." + ext

    TERM.success("Image generated and saved as '" + out + "'")
    show "Time taken:" imgResponse.duration
    if config {
        return {
            configuration: imgResponse.config_used,
            original_request: promptText,
            enhanced_request: imgPrompt.response,
            cost: imgResponse.cost,
            duration: imgResponse.duration,
            original_image: imgPath,
            edited_image: out,
            original_extension: get_ext(imgPath),
            output_extension: ext,
            base64: imgResponse.image_data,
            complete_log: imgResponse
        }
    }
    if raw_data {
        return {
            original_filename: imgPath,
            output_filename: out,
            base64: imgResponse.image_data
        }
    }
    return out
}

/**
  Generates a video from a text prompt and saves it as a base64 encoded file.

  Parameters:
  - promptText: Description of the video to generate.
  - timeLen: Duration in seconds. Accepts: `4`, `6`, and `8` (default 8).
  - resolution: Aspect ratio or resolution (default "16:9").
  - filename: Base filename for saving (default "generated_video").
  - ext: File extension (default "mp4").

  Returns:
  - A string representing the saved video filename.

  Example:
  ```sesi
  let vid = genVideo("Waves crashing on a beach", 5, "16:9", "waves", "mp4")
  show vid
  ```

  Notes:
  - Uses `gemini-3.5-flash-lite` for prompt generation and `gemini-omni-1.1-flash` for video rendering.
*/
export fn genVideo(promptText: string, timeLen: number = 8, resolution: string = "16:9", filename: string = "generated_video", ext: string = "mp4") -> string {
    prompt promptEngineer {"You are an experienced prompt engineer. You transform user input into a detailed and descriptive prompt for video generation."}
    let vidPrompt = model("gemini-3.5-flash-lite") {system: promptEngineer, thinking: "medium", maxT: 1024} {promptText} | trim
    show "Total cost for this request:" model_usage().total_cost_usd

    TERM.info("Generating video with the following prompt: " + vidPrompt)

    if timeLen | is_null || timeLen <= 0 {
        timeLen = 8
    }
    let videoResponse = video("gemini-omni-1.1-flash") {duration: timeLen, ratio: resolution} {vidPrompt}

    if ext == "" || ext == "mp4" {
        write_file(filename + ".mp4", videoResponse, "base64")
    } else {
        write_file(filename + "." + ext, videoResponse, "base64")
    }

    TERM.success("Video generated and saved as '" + filename + "." + ext + "'")
    return filename + "." + ext
}

/**
  Generates a lightweight video preview from a text prompt.

  Parameters:
  - promptText: Description for video generation.
  - timeLen: Duration in seconds. Accepts: `4`, `6`, and `8` (default 4).
  - resolution: Aspect ratio (default "16:9").
  - filename: Base filename for output (default "generated_video").
  - ext: File extension (default "mp4").

  Returns:
  - A string representing the saved video filename.

  Example:
  ```sesi
  let vid = genVideoLite("Spinning globe", 4, "16:9", "globe", "mp4")
  show vid
  ```

  Notes:
  - Uses `gemini-2.5-flash-lite` for prompt engineering and `veo-3.1-lite-generate-preview` for video creation.
*/
export fn genVideoLite(promptText: string, timeLen: number = 4, resolution: string = "16:9", filename: string = "generated_video", ext: string = "mp4") -> string {
    prompt promptEngineer {"You are an experienced prompt engineer. You transform user input into a detailed and descriptive prompt for video generation."}
    let vidPrompt = model("gemini-2.5-flash-lite") {system: promptEngineer, thinking: "medium", maxT: 500} {promptText"
    Just return the prompt without any additional explanations or comments."} | trim
    show "Total cost for this request:" model_usage().total_cost_usd

    TERM.info("Generating video with the following prompt: " + vidPrompt)

    if timeLen | is_null || timeLen <= 0 { timeLen = 4 }
    let videoResponse = video("veo-3.1-lite-generate-preview") {duration: timeLen, ratio: resolution} {vidPrompt}

    if ext == "" || ext == "mp4" {
        write_file(filename + ".mp4", videoResponse, "base64")
    } else {
        write_file(filename + "." + ext, videoResponse, "base64")
    }

    TERM.success("Video generated and saved as '" + filename + "." + ext + "'")
    return filename + "." + ext
}

/**
  Generates JSON data based on a user prompt.

  Parameters:
  - promptText: Description or structure requirements for the JSON data.
  - modelName: Optional. The name of the AI model to use (default "gpt-6-luna").
  - config: Optional. If true, returns detailed configuration and cost information (default false).

  Returns:
  - A string containing the generated JSON, or an object with detailed configuration and cost information if `config` is true.

  Example:
  ```sesi
  let jData = genJSON("List three planets with their radii")
  show jData
  ```
*/
export fn genJSON(promptText: string, modelName, config = false) -> string? | any {
    if !modelName { modelName = "gpt-6-luna" }
    let r = ""
    prompt sys {"You are a professional and organized software developer. You are tasked with generating JSON data based on user input."}
    prompt makeJSON {"Generate JSON data for the following prompt: "promptText} 
    try {
        r = track_model(makeJSON, {
                model_name: modelName,
                system: sys,
                thinking: "medium",
                response: "full"
            }
        )
    } catch (e) { TERM.error(e.message) }
    if r.response == "" || r.response == null {
        show "Error: Model response came back empty, try again later."
        return "Error: Model response came back empty, try again later."
    }
    let cleanJSON = r.response | cleanAIResponse
    show "Time taken:" r.duration
    if config {
        return {
            configuration: r.config_used,
            request: promptText,
            JSON: cleanJSON,
            cost: r.cost,
            duration: r.duration,
            complete_log: r
        }
    }
    return cleanJSON
}

/**
  Generates YAML data based on a user prompt with model fallback support.

  Parameters:
  - promptText: Description or structure requirements for the YAML data.
  - modelName: Optional. The name of the AI model to use (default "gpt-6-luna").
  - config: Optional. If true, returns detailed configuration and cost information (default false).

  Returns:
  - A string containing the generated YAML data or an object with detailed configuration and cost information if `config` is true, or an error message if empty.

  Example:
  ```sesi
  let yml = genYAML("Docker compose config for a Node.js app")
  show yml
  ```
*/
export fn genYAML(promptText: string, modelName, config = false) -> any {
    if !modelName { modelName = "gpt-6-luna" }
    prompt sys {"You are a professional and organized software developer. You are tasked with generating YAML data based on user input."}
    prompt makeYAML {"Generate YAML data for the following prompt: "promptText}
    let yaml = ""
    try { yaml = track_model(makeYAML, {
                model_name: modelName,
                system: sys,
                thinking: "medium",
                response: "full"
            }
        )
    } catch (e) { TERM.error(e.message) }
    if yaml.response == "" || yaml.response == null {
        show "Error: Model response came back empty, try again later."
        return "Error: Model response came back empty, try again later."
    }
    let cleanYAML = yaml.response | cleanAIResponse
    show "Time taken:" yaml.duration
    if config {
        return {
            configuration: yaml.config_used,
            request: promptText,
            YAML: cleanYAML,
            cost: yaml.cost,
            duration: yaml.duration,
            complete_log: yaml
        }
    }
    return cleanYAML
}

