/**
  Provides utility functions for interacting with AI models, processing AI responses, and performing web searches.

  This module includes functions for cleaning AI responses, sending prompts to local AI models, finding URLs in text, and performing online searches.
  These functions aim to simplify the process of working with AI-generated content and integrating it into various applications.
*/
allow "helpers/html-minify" in with {minify_html}
allow "helpers/safe" in as Safe
allow "misc" in with {generateGitIgnore, getLines}
allow "string" in with {
    toPascal, toKebab,
    substring,
}
allow "timestamp" in with {
    formattedTime, localTime,
    getDate
}
allow "refs" in as DOCS
allow "ansi" in as TERM

let _ = DOCS.getBUILTINS()
_ = _ + "\n" + DOCS.getVARIABLES()
_ = _ + "\n" + DOCS.getFUNCTIONS()
_ = _ + "\n" + DOCS.getMAKE()
_ = _ + "\n" + DOCS.getHOW_TO()
_ = _ + "\n" + DOCS.getGUIDE()

/**
  Cleans an AI model response by extracting content from markdown code blocks or trimming raw text.

  Parameters:
  - responseText: The raw string response from an AI model.

  Returns:
  - A cleaned string containing the extracted code or trimmed response text.

  Example:
  ```sesi
  let cleaned = cleanAIResponse("```javascript\nconsole.log('hi');\n```")
  show cleaned
  ```

  Notes:
  - Automatically falls back to returning the trimmed raw response if no markdown code blocks are found.
*/
export fn cleanAIResponse(responseText: string) -> string {
    let preClean = regex("```[a-zA-Z]*\\n([\\s\\S]*?)\\n```", responseText, {"mode": "match", "flags": "g"})

    // Fall back to raw response if no code blocks exist
    if len(preClean) == 0 {
        return trim(responseText)
    }

    let cleanedText = ""
    for arr in preClean {
        cleanedText = cleanedText + arr.match + "\n"
    }

    cleanedText = regex("```[a-zA-Z]*\\n|\\n```", cleanedText, {"mode": "replace", "replacement": "", "flags": "g"})
    return trim(cleanedText)
}

/**
  Sends a prompt to the local AI model with predefined thinking and token limits.

  Parameters:
  - promptText: The text prompt to send to the local model.

  Returns:
  - A string containing the model's response.

  Example:
  ```sesi
  let resp = local("Explain recursion")
  show resp
  ```

  Notes:
  - Configured with medium thinking and a maximum of 500 tokens.
*/
export fn local(promptText: string) -> string {
    return model("local") {thinking: "medium", maxT: 500} {promptText}
}

/**
  Finds and extracts the first valid HTTP or HTTPS URL from a search results string.

  Parameters:
  - searchResults: A block of text containing search results or lines of text.

  Returns:
  - A string containing the first discovered URL, or an empty string if none found.

  Example:
  ```sesi
  let url = findURL("Check out https://example.com for details.")
  show url
  ```

  Notes:
  - Preserves query parameters and paths associated with the URL.
*/
fn findURL(searchResults: string) -> string {
    let lines = split(searchResults, "\n")
    for line in lines {
        if regex("https?://[\\w.-]+", line, {"mode": "match", "flags": "g"}) != [] {
            // Extract the first URL found in the line and preserve the whole URL, including any query parameters
            let urlMatch = regex("https?://[\\w.-]+(?:/[\\w./?=&%+-]*)?", line, {"mode": "match", "flags": "g"})
            if urlMatch != [] {
                return urlMatch[0]
            }
        }
    }
    return ""
}

/**
  Performs an online web search using an AI model and appends formatted source URLs to the results.

  Parameters:
  - query: The search query string.

  Returns:
  - A string containing the model's findings followed by a formatted list of sources.

  Example:
  ```sesi
  let info = onlineSearch("Latest developments in AI")
  show info
  ```

  Notes:
  - Uses the `gemini-3.5-flash-lite` model with web search capability enabled.
*/
export fn onlineSearch(query: string) -> string {
    prompt searchInstructions {"You have access to a search tool that can retrieve information from the web. Use this tool to find relevant information based on the user's query. Provide your findings, and include links to the sources."}
    let results =  model("gemini-3.5-flash-lite") {system: searchInstructions, search, maxT: 1024} {"Search for the following query: " query"
    Return only the relevant information and links to the sources."}
    let urlCheck = ""
    let URLs = []
    let extracted = results | split("\n")

    // Extract URLs from the search results and store them in the URLs array
    for lines in extracted {
        urlCheck = findURL(lines)
        if urlCheck != "" {
            push(URLs, urlCheck.match)
        }
    }

    if (URLs | length) > 0 {
        let URL = URLs | join("\n")

        // Clean up the results by removing any trailing "Source" or "Sources" sections, as well as any content after a "[" character
        if results | contains("Source") || results | contains("source") {
            results = split(results, "Source")[0] | trim
        } else if results | contains("SOURCE") {
            results = split(results, "SOURCE")[0] | trim
        } else if results | contains("Sources") || results | contains("sources") {
            results = split(results, "Sources")[0] | trim
        } else if results | contains("SOURCES") {
            results = split(results, "SOURCES")[0] | trim
        } else if results | contains("[") {
            results = split(results, "[")[0] | trim
        }
        results = results + "\n\nSource(s):\n" + URL
        return results
    } else {
        return results
    }
}

/**
  Evaluates mathematical expressions or breaks down word problems step-by-step.

  Parameters:
  - promptText: The math expression or word problem to calculate. Can be any type.

  Returns:
  - A string containing the calculated result or step-by-step breakdown.

  Example:
  ```sesi
  let ans = calculate("45 * 12 / 3")
  show ans
  ```

  Notes:
  - Uses the `gemini-3.5-flash-lite` model configured with a calculator persona.
*/
export fn calculate(promptText: any) -> string {
    prompt calculator {"You are a reliable and accurate calculator. You are tasked with performing calculations based on user input.
    If the input is a mathematical expression, evaluate it and provide the number only.
    If the input is a word problem or a question that requires calculations, break down the problem step by step and provide the final answer."}
    return model("gemini-3.5-flash-lite") {system: calculator, thinking: "medium"} {"Calculate the following: " promptText | str}
}

/**
  Reviews content for potential issues, improvements, and best practices.

  Parameters:
  - promptText: The content or data to review.

  Returns:
  - A string containing the analyst's review and recommendations.

  Example:
  ```sesi
  let feedback = review("let x = [1, 2, 3];")
  show feedback
  ```

  Notes:
  - Uses the `gemini-3.6-flash` model with low thinking level.
*/
export fn review(promptText: string) -> string {
    prompt sys {"You are a professional and observant analyst. You are tasked with reviewing data based on user input."}
    prompt reviewPrompt {"Review the following content for potential issues, improvements, and best practices: "promptText}
    return model("gemini-3.6-flash") {system: sys, thinking: "low"} {reviewPrompt}
}

/**
  Breaks down complex concepts into simple, easy-to-understand explanations.

  Parameters:
  - promptText: The concept, term, or text to explain.

  Returns:
  - A detailed explanation string.

  Example:
  ```sesi
  let explanation = explain("Quantum entanglement")
  show explanation
  ```

  Notes:
  - Uses the `gemini-3.5-flash-lite` model with medium thinking.
*/
export fn explain(promptText: string) -> string {
    prompt explainer {"You break down complex concepts into simple, easy-to-understand explanations. You are tasked with explaining the following prompt in detail."}
    return model("gemini-3.5-flash-lite") {system: explainer, thinking: "medium"} {"Explain the following in detail: " promptText}
}

/**
  Summarizes text content in a clear and concise manner while understanding intent and nuance.

  Parameters:
  - promptText: The text to summarize.

  Returns:
  - A summary string.

  Example:
  ```sesi
  let summary = summarize(longArticleText)
  show summary
  ```

  Notes:
  - Uses the `gemini-3.5-flash-lite` model with medium thinking.
*/
export fn summarize(promptText: string) -> string {
    prompt summarizer {"You are a professional summarizer that understands intent and nuance. You are tasked with summarizing the following prompt in a clear and concise manner."}
    return model("gemini-3.5-flash-lite") {system: summarizer, thinking: "medium"} {"Summarize the following: " promptText}
}

/**
  Compares and contrasts two items, providing similarities, differences, and notable points in a structured format.

  Parameters:
  - a: First item or text to compare.
  - b: Second item or text to compare.

  Returns:
  - A string containing a table or structured comparison analysis.

  Example:
  ```sesi
  let comparison = compare("Python", "JavaScript")
  show comparison
  ```

  Notes:
  - Uses the `gemini-3.5-flash-lite` model with medium thinking.
*/
export fn compare(a: string, b: string) -> string {
    prompt comparer {"You have an innate ability to compare and contrast different pieces of information. You are tasked with comparing the following two items and providing a detailed analysis of their similarities, differences, and any notable points."}
    return model("gemini-3.5-flash-lite") {system: comparer, thinking: "medium"} {"Compare the following:
    A: " a "

    B: " b"

    Return a table or structured format that clearly outlines the similarities, differences, and notable points between the two items."}
}

/**
  Generates a list of insightful questions based on the provided prompt.

  Parameters:
  - promptText: The source text or topic to generate questions from.

  Returns:
  - A string listing the generated questions.

  Example:
  ```sesi
  let qList = generateQuestions("The history of space exploration")
  show qList
  ```

  Notes:
  - Returns only the question list without extraneous explanations.
*/
export fn generateQuestions(promptText: string) -> string {
    prompt questionGenerator {"You are an inquisitive and insightful individual. You are tasked with generating a list of questions based on the following prompt."}
    return model("gemini-3.5-flash-lite") {system: questionGenerator, thinking: "medium"} {"Generate questions based on the following: " promptText "
    Return only the list of questions without any additional explanations or comments."}
}

/**
  Generates creative ideas, names, concepts, and suggestions based on input.

  Parameters:
  - promptText: The topic or goal to inspire ideas around.

  Returns:
  - A JSON object string or native Sesi object containing fields: 'ideas', 'names', 'concepts', and 'suggestions'.

  Example:
  ```sesi
  let ideas = inspire("A coffee shop for programmers")
  show ideas
  ```

  Notes:
  - Cleans AI response and parses structured JSON output.
  - Uses search tool to ground inspirations in real-world context.
*/
export fn inspire(promptText: string, returnType: any = "JSON") -> object | string {
    prompt inspirer {"You are a creative and inspiring individual. You are tasked with providing useful ideas, interesting names, thorough concepts, and creative suggestions based on the following prompt."}
    let resp = structured_output({ideas: string, names: string, concepts: string, suggestions: string})
    (model("gemini-3.5-flash-lite") {system: inspirer, thinking: "medium", search} {"
    Provide inspiration based on the following: "promptText".
    Each should contain 3-4 sentences
    If a field doesn't require an entry, simply leave it empty."})
    let i = resp.ideas | split(". ")
    let n = resp.names | split(". ")
    let c = resp.concepts | split(". ")
    let s = resp.suggestions | split(". ")
    if returnType == "JSON" { return {"ideas": i, "names": n, "concepts": c, "suggestions": s} | to_json
    } else if returnType == "object" { return {"ideas": i, "names": n, "concepts": c, "suggestions": s} }
}

/**
  Enhances a prompt to be more effective and detailed while preserving its exact intent.

  Parameters:
  - promptText: The raw prompt text to improve.

  Returns:
  - An improved prompt string.

  Example:
  ```sesi
  let betterPrompt = improvePrompt("write a web scraper")
  show betterPrompt
  ```

  Notes:
  - Attempts generation using `gpt-5.6-terra` first, falling back to `gemini-3.5-flash-lite`.
*/
export fn improvePrompt(promptText: string) -> string {
    prompt promptEngineer {"You are an experienced prompt engineer. You are well versed in creating effective and detailed prompts while preserving the exact intent."}
    prompt improve {"Enhance the following prompt: "promptText"
    Return only the improved prompt without any additional explanations or comments."}
    let resp = ""
    try {
        resp = model("gpt-5.6-terra") {system: promptEngineer, thinking: "medium"} {improve}
    } catch (err) {
        TERM.warning(err.message)
        TERM.warning("Retrying with a more capable model...")
        resp = model("gemini-3.5-flash-lite") {system: promptEngineer, thinking: "medium"} {improve}
    }
    return resp
}

/**
  Generates metadata for the provided image(s) using an AI model.

  Parameters:
  - imageRef: A reference to the image or an array of images for which metadata should be generated.

  Returns:
  - A string containing the generated metadata for the provided image(s).
  - If the model fails to generate metadata, an error message will be returned.

  Example:
  ```sesi
  let metadata = getMetadata("image.png")
  show "Generated metadata:" metadata
  ```

  Notes:
  - The function attempts to use the `gpt-5.6-luna` model first. If it fails, it falls back to the `gemini-3.5-flash-lite` model.
  - The generated metadata will describe the contents of the image in detail.
  - Ensure that the image file(s) exist and are accessible to avoid errors.
*/
export fn getMetadata(imageRef: string | array) -> string {
    let meta = ""
    prompt metadata {"You are an experienced Image Analyst specialized in analyzing images and generating detailed metadata describing their contents."}
    try {
        meta = model("gpt-5.6-luna") {system: metadata, images: imageRef} {""}
    } catch (e) {
        TERM.warning(e.message)
        TERM.warning("Retrying with a more capable model...")
        meta = model("gemini-3.5-flash-lite") {system: metadata, images: imageRef} {""}
    }
    if meta == "" {
        show "Error: Model response came back empty, make sure the image file(s) exists."
        return "Error: Model response came back empty, make sure the image file(s) exists."
    }
    return meta
}

/**
  Generates source code in a specified programming language based on a user prompt.

  Parameters:
  - promptText: Description or requirements of the code to generate.
  - language: The target programming language (default is "JavaScript").

  Returns:
  - A string containing the generated code.

  Example:
  ```sesi
  let code = genCode("Create a binary search tree", "Python")
  show code
  ```

  Notes:
  - Attempts generation with `gpt-5.6-terra`, falling back to `gemini-3.7-flash`.
*/
export fn genCode(promptText: string, language: string = "JavaScript") -> string {
    prompt sys {"# SESI REFERENCE (IF APPLICABLE):\n"_"\nYou are a professional and organized software developer. You are tasked with generating code based on user input."}
    prompt makeCode {"Generate code in "language" for the following prompt: "promptText"
    Return only the code without any additional explanations or comments."}
    let resp = ""
    try {
        resp = model("gpt-5.6-terra") {system: sys, thinking: "medium"} {makeCode} | cleanAIResponse
    } catch (err) {
        TERM.warning(err.message)
        TERM.warning("Retrying with a more capable model...")
        resp = model("gemini-3.7-flash") {system: sys, thinking: "medium"} {makeCode} | cleanAIResponse
    }
    return resp
}

/**
  Generates an image from a text prompt and saves it to disk.

  Parameters:
  - promptText: Text prompt describing the image to generate.
  - size: Resolution or size specification (default "1K").
  - ratio: Aspect ratio (default "1:1").
  - filename: Base filename for saving the output (default "generated_image").
  - ext: File extension (default "png").

  Returns:
  - A string representing the final saved file path.

  Example:
  ```sesi
  let img = genImage("A futuristic city at sunset", "2K", "16:9", "city", "png")
  show img
  ```

  Notes:
  - Uses `gemini-3-flash-preview` for prompt enhancement and `gemini-3.1-flash-image` for image generation.
*/
export fn genImage(promptText: string, size: string = "1K", ratio: string = "1:1", filename: string = "generated_image", ext: string = "png") -> string {
    prompt promptEngineer {"You are an experienced prompt engineer. You transform user input into a detailed and descriptive prompt for image generation."}
    let imgPrompt = model("gemini-3-flash-preview") {system: promptEngineer, thinking: "medium"} {promptText}
    imgPrompt = split(imgPrompt, ">")[1] | trim

    TERM.info("Generating image with the following prompt: " + imgPrompt)
    let imgResponse = image("gemini-3.1-flash-image") {size: size, ratio: ratio} {imgPrompt}

    if ext == "" || ext == "png" {
        write_image(filename + ".png", imgResponse)
    } else {
        write_image(filename + "." + ext, imgResponse)
    }

    TERM.success("Image generated and saved as '" + filename + "." + ext + "'")
    return filename + "." + ext
}

/**
  Generates an image quickly using lighter models and saves it to disk.

  Parameters:
  - promptText: Text prompt describing the image.
  - ratio: Aspect ratio (default "1:1").
  - filename: Base filename for saving (default "generated_image").
  - ext: File extension (default "png").

  Returns:
  - A string representing the saved file path.

  Example:
  ```sesi
  let img = genImageLite("A cute cat", "1:1", "cat", "png")
  show img
  ```

  Notes:
  - Uses `gemini-2.5-flash-lite` for prompt engineering and `gemini-3.1-flash-image` with 512 size.
*/
export fn genImageLite(promptText: string, ratio: string = "1:1", filename: string = "generated_image", ext: string = "png") -> string {
    prompt promptEngineer {"You are an experienced prompt engineer. You transform user input into a detailed and descriptive prompt for image generation."}
    let imgPrompt = model("gemini-2.5-flash-lite") {system: promptEngineer, thinking: "medium"} {promptText"
    Just return the prompt without any additional explanations or comments."}
    imgPrompt = imgPrompt | trim

    TERM.info("Generating image with the following prompt: " + imgPrompt)
    let imgResponse = image("gemini-3.1-flash-image") {size: "512", ratio: ratio} {imgPrompt}

    if ext == "" || ext == "png" {
        write_image(filename + ".png", imgResponse)
    } else {
        write_image(filename + "." + ext, imgResponse)
    }

    TERM.success("Image generated and saved as '" + filename + "." + ext + "'")
    return filename + "." + ext
}

/**
  Generates high-resolution images using advanced models and robust fallbacks.

  Parameters:
  - promptText: Text prompt for image creation.
  - size: Resolution or size specification (default "4K").
  - ratio: Aspect ratio (default "1:1").
  - filename: Base filename for output (default "generated_image").
  - ext: File extension (default "png").

  Returns:
  - A string representing the saved image filename.

  Example:
  ```sesi
  let img = genImageMax("Epic mountain landscape", "4K", "16:9", "mountain", "png")
  show img
  ```

  Notes:
  - Attempts generation using `gpt-5.6-luna` and `gpt-image-2`, falling back to `gemini-3.5-flash-lite` and `gemini-3-pro-image`.
*/
export fn genImageMax(promptText: string, size: string = "4K", ratio: string = "1:1", filename: string = "generated_image", ext: string = "png") -> string {
    prompt promptEngineer {"You are an experienced prompt engineer. You transform user input into a detailed and descriptive prompt for image generation. Do not mention the size or ratio in the prompt, as those will be handled separately."}
    let imgPrompt = ""
    try {
        imgPrompt = model("gpt-5.6-luna") {system: promptEngineer, thinking: "medium"} {promptText "
        Just return the prompt without any additional explanations or comments."}
    } catch (err) {
        TERM.warning(err.message)
        TERM.warning("Retrying with a more capable model...")
        imgPrompt = model("gemini-3.5-flash-lite") {system: promptEngineer, thinking: "medium"} {promptText "
        Just return the prompt without any additional explanations or comments."}
    }
    imgPrompt = imgPrompt | trim

    TERM.info("Generating image with the following prompt: " + imgPrompt)
    let imgResponse = ""
    try {
        imgResponse = image("gpt-image-2") {size: size, ratio: ratio} {imgPrompt}
    } catch (err) {
        TERM.warning(err.message)
        TERM.warning("Retrying with a more capable model...")
        imgResponse = image("gemini-3-pro-image") {size: size, ratio: ratio} {imgPrompt}
    }

    if ext == "" || ext == "png" {
        write_image(filename + ".png", imgResponse)
    } else {
        write_image(filename + "." + ext, imgResponse)
    }

    TERM.success("Image generated and saved as '" + filename + "." + ext + "'")
    return filename + "." + ext
}

/**
  Generates a video from a text prompt and saves it as a base64 encoded file.

  Parameters:
  - promptText: Description of the video to generate.
  - timeLen: Duration in seconds. Accepts: `4`, `6`, and `8` (default 8).
  - resolution: Aspect ratio or resolution (default "16:9").
  - filename: Base filename for saving (default "generated_video").
  - ext: File extension (default "mp4").

  Returns:
  - A string representing the saved video filename.

  Example:
  ```sesi
  let vid = genVideo("Waves crashing on a beach", 5, "16:9", "waves", "mp4")
  show vid
  ```

  Notes:
  - Uses `gemini-3-flash-preview` for prompt generation and `gemini-omni-flash` for video rendering.
*/
export fn genVideo(promptText: string, timeLen: number = 8, resolution: string = "16:9", filename: string = "generated_video", ext: string = "mp4") -> string {
    prompt promptEngineer {"You are an experienced prompt engineer. You transform user input into a detailed and descriptive prompt for video generation."}
    let vidPrompt = model("gemini-3-flash-preview") {system: promptEngineer, thinking: "medium", maxT: 1024} {promptText}
    vidPrompt = vidPrompt | trim

    TERM.info("Generating video with the following prompt: " + vidPrompt)

    if timeLen | is_null || timeLen <= 0 {
        timeLen = 8
    }
    let videoResponse = video("gemini-omni-flash") {duration: timeLen, ratio: resolution} {vidPrompt}

    if ext == "" || ext == "mp4" {
        write_file(filename + ".mp4", videoResponse, "base64")
    } else {
        write_file(filename + "." + ext, videoResponse, "base64")
    }

    TERM.success("Video generated and saved as '" + filename + "." + ext + "'")
    return filename + "." + ext
}

/**
  Generates a lightweight video preview from a text prompt.

  Parameters:
  - promptText: Description for video generation.
  - timeLen: Duration in seconds. Accepts: `4`, `6`, and `8` (default 4).
  - resolution: Aspect ratio (default "16:9").
  - filename: Base filename for output (default "generated_video").
  - ext: File extension (default "mp4").

  Returns:
  - A string representing the saved video filename.

  Example:
  ```sesi
  let vid = genVideoLite("Spinning globe", 4, "16:9", "globe", "mp4")
  show vid
  ```

  Notes:
  - Uses `gemini-2.5-flash-lite` for prompt engineering and `veo-3.1-lite-generate-preview` for video creation.
*/
export fn genVideoLite(promptText: string, timeLen: number = 4, resolution: string = "16:9", filename: string = "generated_video", ext: string = "mp4") -> string {
    prompt promptEngineer {"You are an experienced prompt engineer. You transform user input into a detailed and descriptive prompt for video generation."}
    let vidPrompt = model("gemini-2.5-flash-lite") {system: promptEngineer, thinking: "medium", maxT: 500} {promptText"
    Just return the prompt without any additional explanations or comments."}
    vidPrompt = vidPrompt | trim

    TERM.info("Generating video with the following prompt: " + vidPrompt)

    if timeLen | is_null || timeLen <= 0 { timeLen = 4 }
    let videoResponse = video("veo-3.1-lite-generate-preview") {duration: timeLen, ratio: resolution} {vidPrompt}

    if ext == "" || ext == "mp4" {
        write_file(filename + ".mp4", videoResponse, "base64")
    } else {
        write_file(filename + "." + ext, videoResponse, "base64")
    }

    TERM.success("Video generated and saved as '" + filename + "." + ext + "'")
    return filename + "." + ext
}

/**
  Generates JSON data based on a user prompt.

  Parameters:
  - promptText: Description or structure requirements for the JSON data.

  Returns:
  - A string containing the generated JSON.

  Example:
  ```sesi
  let jData = genJSON("List three planets with their radii")
  show jData
  ```

  Notes:
  - Uses the `gemini-3.1-flash-lite` model and cleans markdown response formatting.
*/
export fn genJSON(promptText: string) -> string {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating JSON data based on user input."}
    prompt makeJSON {"Generate JSON data for the following prompt: "promptText}
    return model("gemini-3.1-flash-lite") {system: sys, thinking: "medium"} {makeJSON} | cleanAIResponse
}

/**
  Generates YAML data based on a user prompt with model fallback support.

  Parameters:
  - promptText: Description or structure requirements for the YAML data.

  Returns:
  - A string containing the generated YAML data or an error message if empty.

  Example:
  ```sesi
  let yml = genYAML("Docker compose config for a Node.js app")
  show yml
  ```

  Notes:
  - Attempts generation using `gpt-5.6-terra`, falling back to `gemini-3.1-flash-lite`.
*/
export fn genYAML(promptText: string) -> string {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating YAML data based on user input."}
    prompt makeYAML {"Generate YAML data for the following prompt: "promptText}
    let yaml = ""
    try {
        yaml = model("gpt-5.6-terra") {system: sys, thinking: "medium"} {makeYAML} | cleanAIResponse
    } catch (e) {
        TERM.warning(e.message)
        TERM.warning("Retrying with a more capable model...")
        yaml = model("gemini-3.1-flash-lite") {system: sys, thinking: "medium"} {makeYAML} | cleanAIResponse
        
    }
    if yaml == "" {
        show "Error: Model response came back empty, try again later."
        return "Error: Model response came back empty, try again later."
    }
    return yaml
}

/**
  Generates BAML data based on a user prompt with model fallback support.

  Parameters:
  - promptText: Description or requirements for the BAML data.

  Returns:
  - A string containing the generated BAML content or an error message if empty.

  Example:
  ```sesi
  let baml = genBAML("Define a User schema")
  show baml
  ```

  Notes:
  - Attempts generation using `gpt-5.6-terra`, falling back to `gemini-3.1-flash-lite`.
*/
export fn genBAML(promptText: string) -> string {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating BAML data based on user input."}
    prompt makeBAML {"Generate BAML data for the following prompt: "promptText}
    let baml = ""
    try {
        baml = model("gpt-5.6-terra") {system: sys, thinking: "medium"} {makeBAML} | cleanAIResponse
    } catch (e) {
        TERM.warning(e.message)
        TERM.warning("Retrying with a more capable model...")
        baml = model("gemini-3.1-flash-lite") {system: sys, thinking: "medium"} {makeBAML} | cleanAIResponse
        
    }
    if baml == "" {
        show "Error: Model response came back empty, try again later."
        return "Error: Model response came back empty, try again later."
    }
    return baml
}

