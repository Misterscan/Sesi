// Templates

/**
  Represents an AI-assisted project scaffolding and file generation template.

  Fields:
  - directory: The target root directory for the project.
  - projectName: The PascalCased project name.
  - purpose: The core purpose or description of the project.
  - name: The author or creator name.
  - licenseType: The license type (defaults to MIT).

  Notes:
  - Provides methods to initialize configuration (`start`), create the directory structure (`scaffold`), and generate all standard project files (`createFiles`).
*/
export make AIProject {
    let directory = ""
    let projectName = ""
    let purpose = ""
    let name = ""
    let licenseType = ""

    // Initializes the AIProject instance with project metadata.
    //
    // Parameters:
    // - title: Project title/name.
    // - purpose: Purpose of the project.
    // - name: Author name.
    // - directory: Root target directory.
    // - licenseType: License type.
    //
    // Returns:
    // - None.
    //
    // Notes:
    // - Formats project name as PascalCase and directory as kebab-case. Default license is MIT.
    fn start(self, title: string = projectName, purpose: string, name: string,  directory: string, licenseType: string) {
        self.name = name
        self.projectName = title | toPascal
        self.purpose = purpose
        self.directory = directory | toKebab
        self.licenseType = licenseType
        if self.licenseType == "" || self.licenseType | is_null {
            self.licenseType = "MIT"
        }
    }

    // Creates the project directory on disk.
    //
    // Parameters:
    // - None (uses `self` instance state).
    //
    // Returns:
    // - None.
    //
    // Notes:
    // - Logs success or error messages via TERM.
    fn scaffold(self) {
        let projectPath = self.directory + "/" + self.projectName
        try {
            make_dir(projectPath)
            TERM.success("Project directory created at: " + projectPath)
        } catch (e) {
            TERM.error("Error creating project directory: " + e)
            return
        }
    }

    // Generates and writes all standard project documentation and configuration files.
    //
    // Parameters:
    // - None (uses `self` instance state).
    //
    // Returns:
    // - None.
    //
    // Notes:
    // - Automatically generates README, LICENSE, requirements.txt, .env.example, package.json, and a custom .gitignore using AI tools.
    fn createFiles(self) {
        let projectPath = self.directory + "/" + self.projectName
        let gitignore = ""

        try {// Generate project files
            TERM.info("Generating README...")
            let README = genReadMe(self.projectName, self.purpose, "", "", "")
            TERM.info("Generating LICENSE...")
            let LICENSE = genLicense(self.name, "2026", self.licenseType)
            TERM.info("Generating requirements.txt...")
            let requirements = genRequirements(self.purpose)
            TERM.info("Generating .env.example...")
            let envExample = genEnvExample(self.purpose)
            TERM.info("Generating package.json...")
            let pkgJSON = genPkgJSON(self.projectName, self.purpose, self.name)

            try {// Generate .gitignore file based on the project purpose
                TERM.info("Generating .gitignore file based on the project purpose...")
                // Tool for generating a .gitignore file based on the project purpose.
                define_tool("generateGitIgnore", generateGitIgnore, "Generate a .gitignore file for a project based on the provided contents.")
                // Use the AI model to generate the contents of the .gitignore file based on the project purpose and current workspace context.
                let generatedContents = model("gemini-3.5-flash-lite") {tools: generateGitIgnore, system: "You are a professional and organized software developer. You are tasked with generating a .gitignore file for a project."} {"
                Use the generateGitIgnore tool for a project with the following purpose:
                "self.purpose"

                Here's the current workspaace context:
                ==== README.md ====
                "README"
                ==== LICENSE ====
                "LICENSE"
                ==== requirements.txt ====
                "requirements"
                ==== .env.example ====
                "envExample"
                ==== package.json ====
                "pkgJSON} | cleanAIResponse | from_json

                let lines = generatedContents.arguments.custom_entries
                for line in lines {
                    gitignore = gitignore + line + "\n"
                }
            } catch (e1) {
                TERM.error("Error generating .gitignore file: " + e1)
                gitignore = ""
            }

            // Write the generated files to the project directory
            write_file(projectPath + "/README.md", README)
            write_file(projectPath + "/LICENSE", LICENSE)
            write_file(projectPath + "/.gitignore", gitignore)
            write_file(projectPath + "/requirements.txt", requirements)
            write_file(projectPath + "/.env.example", envExample)
            write_file(projectPath + "/package.json", pkgJSON)
            TERM.success("Project files created successfully.")
        } catch (e2) {
            TERM.error("Error creating project files: " + e2)
        }
    }
}

// Sesi Specific Helpers

/**
  Debugs the given Sesi code content and returns the debugged result. Provides detailed feedback and suggestions for improvement if any issues are found.

  Parameters:
  - content: The Sesi code content to be debugged. Can be a string containing the code or a file path to the Sesi source file.

  Returns:
  - A detailed review of the Sesi code, including any identified issues, suggestions for improvement, and the corrected code if applicable.

  Example:
  ```sesi
  let result = debugSesi("examples.sesi")
  show result
  ```

  Notes:
  - The function attempts to debug the Sesi code using the "gpt-5.6-terra" model first. If it fails, it falls back to the "gemini-3.7-flash" model.
  - Any errors encountered during the debugging process will be returned as error messages.
*/
export fn debugSesi(content: string) -> string {
    let c = ""
    let debugged = ""
    prompt fix {"# SESI REFERENCE: "_"\nYou are an expert in debugging Sesi code. You find syntax errors, bad practices, and hallucinated/mistaken code patterns in Sesi. If none of these issues are present, indicate that the code is correct. Otherwise, provide detailed feedback and suggestions for improvement.
    # SPECIFICALLY FOR YOU, NOT THE USER\nMODEL CONFIGURATION BLOCKS `{}` CANNOT BE SEPARATED BY NEWLINE. SAME GOES FOR OTHER BUILTINS THAT USE CURLY BRACES AND ANY OTHER SESI-SPECIFIC SYNTAX. THAT IS NOT VALID SESI. THAT IS JS/PYTHON/ETC. NOT SESI. YOU HAVE THE LITERAL EXAMPLES AND PROPER USAGE IN THE REFERENCE ABOVE. DO NOT INSINUATE OTHERWISE OR STUBBORNLY IGNORE THIS RULE WHEN WRITING SESI CODE AND OFFERING SUGGESTIONS."}
    TERM.info("Debugging Sesi code...")
    if (content | get_ext) == null { c = content } else if (content | get_ext) != null { c = read_file(content) }
    try {
        debugged = model("gpt-5.6-terra") {system: fix, thinkingLevel: "medium", cache: true, maxT: 10000} {c}
        TERM.success("Sesi code debugged successfully.")
    } catch (e) {
        try {
            debugged = model("gemini-3.7-flash") {system: fix, thinkingLevel: "medium", cache: true, maxT: 10000} {c}
            TERM.success("Sesi code debugged successfully.")
        } catch (e2) {
            return TERM.error("Error debugging Sesi code: " + e2.message)
        }
    }
    return debugged
}

/**
  Verifies and patches errors or issues in a Sesi source file using automated tooling.

  Parameters:
  - file: Path to the Sesi source file to check and patch.

  Returns:
  - A string containing the patched code or a message indicating no issues were found.

  Example:
  ```sesi
  let result = patchSesi("examples.sesi")
  show result
  ```

  Notes:
  - The function uses the "gemini-3.7-flash" model to verify and patch the Sesi code.
  - It relies on the "verify" and "view" tools to identify and understand issues in the Sesi file.
  - The function returns the corrected Sesi code or indicates if no issues were found.
*/
export fn patchSesi(file: string, modelName: string = "gemini") -> string {
    allow "shell-automation" in with {run_command}
    // Checks the correctness of a Sesi file by running it and returning the log output.
    //
    // Parameters:
    // - file: Path to the file to check.
    //
    // Returns:
    // - A string containing the log output of the check process.
    //
    // Notes:
    // - Trashes existing log files before running.
    // - Helper utility used by tools.    
    fn check(file: string) {
        let tmp = "tmp.sesi.chk.log"
        Safe.remove(tmp, true)
        let output = run_command("node bin/sesi.js -c " + file + " 2>&1 || true")
        Safe.log("tmp.sesi.chk", output)
        return read_file(tmp)
    }
    // Reads the content of the specified Sesi file.
    //
    // Parameters:
    // - file: Path to the file to read.
    //
    // Returns:
    // - A string containing the file contents.
    //
    // Notes:
    // - Helper utility used by tools.    
    fn read(file: string) {
        show "Reading" file "..."
        return Safe.read(file)
    }

    fn write(code: string) {
        show "Writing to" file ".patched"
        let written = Safe.write(file + ".patched", code)
        show written
        let backup = ".backup/" + time() + "_" + file
        show "Backup file saved to" backup
        if exists(file + ".patched") {
            archive(file, backup)
            rename(backup, file)
            show "File patched successfully.\n"
        } else {
            show "Failed to create patched file.\n"
        }
        return written
    }

    define_tool("verify", check, "Verifies the correctness of a Sesi file by checking for errors and issues.")
    define_tool("view", read, "Reads the content of a Sesi file.")
    define_tool("write_code", write, "Write the corrected Sesi code patch file and save to disk.")

    let s = ""
    let i = _ + "\n\nYou are an expert in verifying Sesi code for correctness and identifying errors."
    prompt patcher {i "
    Use the check tool to check the correctness of the Sesi file: "file"
    Call verify exactly once. If it reports errors or issues, call view exactly once to inspect the file, then write the corrected code with the write tool and return the corrected Sesi code.
    Do not call verify or view again. Return only the corrected code so the caller can execute it seperately. Do not wrap it in code blocks.
    Otherwise, return 'No issues found!' exactly.
    Do not provide any explanations or commentary."}

    if modelName == "gpt" {
        try {
            s = model("gpt-5.6-terra") {system: patcher, tools: [check, read], max_tool_calls: 7, thinkingLevel: "low", cache: false, maxT: 10000} {"Proceed."} | cleanAIResponse
        } catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            s = model("gemini-3.7-flash") {system: patcher, tools: [check, read], max_tool_calls: 7, thinkingLevel: "low", cache: false, maxT: 10000} {""} | cleanAIResponse
        }
    } else {
        s = model("gemini-3.7-flash") {system: patcher, tools: [check, read], max_tool_calls: 7, thinkingLevel: "low", cache: false, maxT: 10000} {""} | cleanAIResponse
    }
    
    if s == "No issues found!" {
        TERM.success(file + " has been checked and verified for errors, none found!")
        return s
    } else { 
        TERM.success(file + " has been patched!") 
        return file
    }
}

/**
  Patches all Sesi files in a directory or a list of files.

  Parameters:
  - dir: The path to the directory containing Sesi files to be patched. If null, the function will use the 'files' parameter.
  - files: An array of specific Sesi files to be patched. If null or empty, the function will use the 'dir' parameter.

  Returns:
  - None. The function patches the files in place and creates backup copies.

  Example:
  ```sesi
  patchAllSesi("/path/to/sesi/files")
  patchAllSesi(null, ["file1.sesi", "file2.sesi"])
  ```

  Notes:
  - The function will create a backup of each file before patching it.
  - If a file has already been patched, it will skip that file and continue with the next one.
  - This tool is especially helpful if updating versioned Sesi files across a project.
*/
export fn patchAllSesi(dir: string? = null, files: array<string>? = null) {
    if files != null {
        for file in files {
            show "Patching" file "\n"
            try {
                patchSesi(file)
            } catch {
                show "File already patched.\n"
                continue
            }
            
        }
    } else if dir != null {
        for file in list_dir(dir) {
            if ((dir + "/" + file | get_ext) == "sesi") {
                show "Patching" file "\n"
                try {
                    patchSesi(dir + "/" + file)
                } catch {
                    show "File already patched.\n"
                    continue
                }
            }
        }
    }
}

/**
  Automatically generates and applies documentation comments to a Sesi source file.

  Parameters:
  - file: Path to the target Sesi source file.

  Returns:
  - Result status of the documentation application (e.g., success message or error).

  Example:
  ```sesi
  autoDoc("src/main.sesi")
  ```

  Notes:
  - Uses AI models to generate detailed documentation based on Sesi reference guidelines and applies them back to the source file.
  - The function reads the contents of the specified Sesi source file and generates detailed documentation comments for all functions, variables (if applicable), and other relevant elements in the file.
  - The generated documentation follows the standard Sesi documentation format, including descriptions, parameters, return values, examples, and notes.
  - If the source file already contains documentation comments, they will be left untouched unless comments appear outdated.
  - If the returned code contains errors, it's passed to the patchSesi() function for automatic correction.
*/
export fn autoDoc(file: string, modelName: string = "gemini") -> any {
    let contents = read_file(file)
    // Generate function comments for the given source file
    prompt docQuery {"## SESI REFERENCE:
"_"

## TASK
Generate detailed function/make comments and documentation header for the source code supplied by the user. 

Format:

/**
  Detailed function comments for the source file. (DO NOT INCLUDE THE `fn ...` lines themselves, only the comments.)

  Include descriptions for all functions, their parameters, return values, example usage, and any relevant notes. eg.:

  Description of the function.
   
  Parameters:
  - param1: Description of the first parameter. <- THESE MUST BE HYPEN ITEMS
  - param2: Description of the second parameter. <- THESE MUST BE HYPEN ITEMS

  Returns:
  - Description of the return value. <- THIS MUST BE A HYPEN ITEM. If the function does not return a value, indicate it as `None.`.

  Example:
  ```sesi <- sesi code fence is automatically recognized by the system, you MUST include it.
  // Example usage of the function, exact usage depends on function and expected workflow builtin usages
  let result = exampleFunction(param1, param2)
  show result // or the expected function action to perform if not `show`
  write_file(\"output.sesi\", result) // Example of writing the result to a file. Refer to the attached SESI REFERENCE for other available functions and usage examples.
  ``` <- end of the sesi code fence
  Notes: <- (Optional, but reccomended for good pratice) Provide any additional information about the function. This includes expected return shapes, data types, and any other relevant details. This is a non-negotiable.
  - Any additional notes or important information about the function.

  // The following applies to variables/objects/arrays only (defined in `let` statements).
  Fields:
  - field1: Description of the first field.
  - field2: Description of the second field.

  Notes:
  - Any additional notes or important information about the variable/object/array.

  Output:
  - Description of the expected/final state of the variable/object/array.

  <-- IF THE FUNCTION IS NESTED WITHIN ANOTHER FUNCTION OR OBJECT LIKE A `MAKE` TEMPLATE, THE COMMENTS FOLLOW `/** ... * ... */`. USE `*` FOR EACH LINE OF COMMENT, INCLUDING NEWLINES.
  Example of nested function comments:
  /**
  * Description of the nested function.
  *
  * Parameters:
  * - param1: Description of the first parameter.
  * - param2: Description of the second parameter.
  *
  * Returns:
  * - Description of the return value. If the function does not return a value, indicate it as `None.`.
  *
  * - Notes:
  * - Any additional notes/important information.
  */
  <-- END OF NESTED FUNCTION COMMENTS -->
*/

# STRICT REQUIREMENTS:

YOU ARE NOT DEBUGGING CODE AT ALL.
DO NOT LEAVE ANY FUNCTIONS UNDOCUMENTED. THIS IS A NON-NEGOTIABLE.
DO NOT PRIORITIZE BREVITY, THESE COMMENTS ARE FOR THE USER TO UNDERSTAND HOW TO USE FUNCTIONS, MODULES, AND VARIABLES WHEN IMPORTED IN OTHER SCRIPTS OR USED WITHIN THE SAME SCRIPT.
YOU MUST FOLLOW THE FORMAT EXACTLY AS SHOWN ABOVE OTHERWISE THE PARSER WILL FAIL TO RECOGNIZE THE COMMENTS CORRECTLY.
    "}

    prompt verify {"
Apply each of the following function comments contained in `/**...*/` blocks to their respective functions (directly above) in the source code.
Do not wrap the final output in additional code blocks or comments.
    " docQuery}

    try {
        TERM.info("Generating documentation for " + file + " ...")
        let docs = ""
        if modelName == "gpt" {
            try {
                docs = model("gpt-5.6-terra") {system: docQuery, thinking: "medium", cache: false} {contents}
            } catch (e) {
                TERM.warning(e.message)
                TERM.warning("Retrying with a more capable model...")
                docs = model("gemini-3.7-flash") {system: docQuery, temp: 0.6, cache: true} {contents}
            }
        } else {
            docs = model("gemini-3.7-flash") {system: docQuery, temp: 0.6, cache: true} {contents}
        }
        
        TERM.info("Applying comments now...")
        let addedComments = model("gemini-3.5-flash-lite") {system: verify, thinkingLevel: "medium"} {docs"\n"contents}
        Safe.tempFile("sesi_test", addedComments, "sesi")
        Safe.archiveFile("sesi_test_temp.sesi")
        let parserCheck = patchSesi("sesi_test_temp.sesi")

        if parserCheck != "No issues found." {
            addedComments = read_file()
        } else if len(addedComments) > len(read_file(file)) {
            try {
                write_file(file, addedComments)
                TERM.success("Successfully applied!")
                return "Success!"
            } catch (e3) {
                TERM.error("Error applying comments to the source file: " + e3.message)
                return e3
            }
        }
        Safe.remove("sesi_test_temp.sesi", true)
    } catch (e) {
        TERM.error("Error generating documentation: " + e.message)
        return e
    }
}
// Alternate documenter
/**
  Reads a Sesi source file, generates idiomatic documentation comments
  for functions, object templates, and variable declarations, and writes
  the documented version back to disk.

  Parameters:
  - `filePath`: The relative or absolute path to the target `.sesi` file.

  Returns:
  - `true` if the file was documented and saved successfully, `false` otherwise.

  Example:
  ```sesi
  let success = autoDocumentFile("src/service.sesi")
  if success {
    show "Documentation completed successfully."
  }
  ```

  Notes:
  - Creates a safety backup of the original file via `archive()` before rewriting.
  - Cleans markdown fences if emitted by the model.
*/
fn autoDocumentFile(filePath: string) -> bool {
  if !exists(filePath) {
    show "Error: Target file does not exist at path:" filePath
    return false
  }

  show "Reading source file:" filePath
  let sourceCode = ""
  try {
    sourceCode = read_file(filePath)
  } catch (err) {
    show "Failed to read file:" err
    return false
  }

  if (sourceCode | len) == 0 {
    show "Warning: File is empty. Nothing to document."
    return false
  }

  // Backup the original file to .archive/
  try {
    archive(filePath, ".backup/" + filePath)
    show "Created backup in .archive/ for safety."
  } catch (err) {
    show "Notice: Could not create archive backup:" err
  }

  prompt docPrompt {"You are an expert Sesi documentation generator. Inspect the following Sesi source code and insert idiomatic multi-line documentation comments (/** ... */) directly above each undocumented function (fn), object template (make), and major variable declaration (let).

Formatting Rules:

1. For Functions ('fn' / 'async fn'):
/**
  Brief description of what the function performs.

  Parameters:
  - `param1`: Description of parameter.
  - `param2`: Description of parameter.

  Returns:
  - Description of the returned value.

  Example:
  ```sesi
  let res = functionName(...)
  ```
*/

2. For Object Templates ('make'):
/**
  Brief description of the template and its purpose.
*/

3. For Complex Variables ('let' with objects, arrays, or important states):
/**
  Description of the variable purpose.

  Fields / Elements:
  - `key1`: Explanation of field.

  Notes:
  - Additional information.
*/

4. For nested items within functions/make templates:
/**
*   Description
*
*   Paramaters:
*   -
*   -
*
*   Returns:
*   -
*
*   etc...
*/

Preserve all existing code logic, imports, whitespace, and existing valid doc comments.
Return ONLY the raw executable Sesi code. Do not wrap the response in markdown code blocks or code fences.

Source Code:
" sourceCode}

  show "Generating documentation comments..."
  let updatedCode = model("gemini-3.1-flash-lite") {temperature: 0.5} {docPrompt}

  if updatedCode | is_null || (updatedCode | len) == 0 {
    show "Failed to generate documentation from model."
    return false
  }

  // Strip accidental markdown fences if returned by the model
  let cleaned = updatedCode
  if cleaned | starts_with("```sesi") {
    cleaned = slice(cleaned, 7)
  } else if cleaned | starts_with("```") {
    cleaned = slice(cleaned, 3)
  }

  if cleaned | ends_with("```") {
    cleaned = slice(cleaned, 0, (cleaned | len) - 3)
  }

  cleaned = trim(cleaned)

  try {
    write_file(filePath, cleaned)
    show "Successfully updated and documented:" filePath
    return true
  } catch (err) {
    show "Failed to write documented code back to file:" err
    return false
  }
}