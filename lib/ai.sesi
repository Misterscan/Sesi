/**
  Parse a complete HTML document and validate its structural integrity.

  Parameters:
  - markup: The complete HTML document source to inspect.

  Returns:
  - An object containing `status` and `error`. The status is `"passed"` when the document has valid, balanced tags and an `<html>` root; otherwise it is `"failed"`.
  
  Example:
  ```sesi
  let result = parseHTML("<html><body><h1>Hello</h1></body></html>")
  show result["status"]
  ```
  
  Notes:
  - Quoted attribute values are supported.
  - HTML void elements such as `img`, `br`, `input`, and `meta` do not require closing tags.
  - Script and style contents are treated as raw content.
  - The function does not evaluate JavaScript or CSS.
*/
fn parseHTML(markup: string) -> object {
    let voidTags = ["area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr"]
    let stack = []
    let token = ""
    let quote = ""
    let insideTag = false
    let sawHTML = false
    let rawTag = ""
    let rawToken = ""

    for char in split(markup, "") {
        if rawTag != "" {
            if char == "<" {
                rawToken = "<"
            } else if rawToken != "" {
                rawToken = rawToken + char
                if char == ">" {
                    let rawTagName = regex("^</?\\s*|[\\s/>].*$", rawToken, {"mode": "replace", "replacement": "", "flags": "g"}) | to_lower
                    if (rawToken | starts_with("</")) && rawTagName == rawTag {
                        if (stack | length) == 0 || stack[(stack | length) - 1] != rawTag {
                            return {"status": "failed", "error": "Mismatched closing tag: " + rawTag}
                        }
                        stack | pop
                        rawTag = ""
                    }
                    rawToken = ""
                }
            }
        } else if insideTag {
            token = token + char
            if quote != "" {
                if char == quote {
                    quote = ""
                }
            } else if char == "\"" || char == "'" {
                quote = char
            } else if char == ">" {
                insideTag = false
                if !(token | starts_with("<!--")) && !(token | starts_with("<!")) && !(token | starts_with("<?")) {
                    let tagName = regex("^</?\\s*|[\\s/>].*$", token, {"mode": "replace", "replacement": "", "flags": "g"}) | to_lower
                    if token | starts_with("</") {
                        if (stack | length) == 0 || stack[(stack | length) - 1] != tagName {
                            return {"status": "failed", "error": "Mismatched closing tag: " + tagName}
                        }
                        stack | pop
                    } else if !(voidTags | includes(tagName)) && !(token | ends_with("/>")) {
                        stack | push(tagName)
                        if tagName == "html" {
                            sawHTML = true
                        }
                        if tagName == "script" || tagName == "style" {
                            rawTag = tagName
                        }
                    }
                }
                token = ""
            }
        } else if char == "<" {
            insideTag = true
            token = "<"
        }
    }

    if insideTag { return {"status": "failed", "error": "Unterminated HTML tag"} }
    if (stack | length) > 0 { return {"status": "failed", "error": "Unclosed HTML tag: " + stack[(stack | length) - 1]} }
    if !sawHTML { return {"status": "failed", "error": "Missing html document root"} } 

    return {"status": "passed", "error": ""} 
}

let generationRunId = str(random()) + "_" + formattedTime()
let timestamp = formattedTime()

/**
  Record the result of a website-generation step.

  Parameters:
  - stepName: Human-readable name of the generation step.
  - stepNumber: Numeric order of the step within the generation process.
  - modelName: Name of the AI model used for the step.
  - thinkingLevel: Reasoning level supplied to the model.
  - systemPrompt: System instruction provided to the model.
  - input: Prompt or source content sent to the model.
  - output: Generated output or error information to record.
  - expectsHTML: Whether the output should be validated as an HTML document. Defaultsto `true`.
  - executionStatus: Status of the step, such as `"completed"` or `"failed"`. Defaults to `"completed"`.

  Returns:
  - None.

  Example:
  ```sesi
  logSteps("draft", 1, "gemini-3-flash-preview", "medium", systemPrompt, userPrompt, htmlOutput)
  ```

  Notes:
  - Creates the `site_generation_logs` directory when necessary.
  - Stores one JSON log entry per generation step.
  - HTML output is cleaned and validated when `expectsHTML` is `true`.
  - Validation status is marked as failed when the output is empty, execution fails, or HTML parsing fails.
*/
fn logSteps(stepName: string, stepNumber: number, modelName: string, thinkingLevel: string, systemPrompt: string, input: string, output: any, expectsHTML: bool = true, executionStatus: string = "completed") {
    make_dir("site_generation_logs")
    let outputText = ""
    if type(output) == "string" {
        outputText = output
    } else {
        outputText = to_json(output)
    }
    let parseStatus = "not_applicable"
    let parseError = ""
    let validationStatus = "passed"


    if executionStatus != "completed" || (outputText | length) == 0 {
        validationStatus = "failed"
    }
    if expectsHTML {
        outputText = outputText | cleanAIResponse
        let parseResult = parseHTML(outputText)
        parseStatus = parseResult.status
        parseError = parseResult.error
        if parseStatus == "failed" {
            validationStatus = "failed"
        }
    }

    // Log the generation step details to a log file for future reference and debugging.
    let logEntry = {
        "run_id": generationRunId,
        "model": modelName,
        "thinking_level": thinkingLevel,
        "step": stepName,
        "step_number": stepNumber,
        "system_character_count": systemPrompt | length,
        "input_character_count": (systemPrompt | length) + (input | length),
        "output_character_count": outputText | length,
        "timestamp": getDate("name") + " at " + localTime(null, "en-US", "detailed"),
        "execution_status": executionStatus,
        "validation_status": validationStatus,
        "html_parse_status": parseStatus,
        "html_parse_error": parseError,
        "output": outputText
    }
    append_file("site_generation_logs/" + "step" + stepNumber + "_at_" + timestamp + ".log", to_json(logEntry) + "\n")
}

/**
  Execute one AI website-generation step with error handling, logging, and optional HTML validation.

  Parameters:
  - stepName: Human-readable name of the generation step.
  - stepNumber: Numeric order of the step within the generation process.
  - modelName: Name of the AI model to call.
  - thinkingLevel: Reasoning level passed to the model.
  - systemPrompt: System instruction for the model.
  - input: Prompt or source content supplied to the model.
  - expectsHTML: Whether the returned content should be checked as HTML. Defaults to `true`.

  Returns:
  - A string containing the cleaned model output.

  Example:
  ```sesi
  let res = runModelStep("draft", 1, "gemini-3-flash-preview", "medium", sysPrompt, promptInput)
  show res
  ```

  Notes:
  - The response is passed through `cleanAIResponse`.
  - Successful executions are recorded with `logSteps`.
  - Model failures are logged and rethrown as a `GenerationStepFailed` error.
*/
fn runModelStep(stepName: string, stepNumber: number, modelName: string, thinkingLevel: string, systemPrompt: string, input: string, expectsHTML: bool = true) -> string {
    try {
        // Run the AI model with the specified parameters and capture the output.
        let output = model(modelName) {system: systemPrompt, thinking: thinkingLevel, maxT: 10000} {input} | cleanAIResponse
        logSteps(stepName, stepNumber, modelName, thinkingLevel, systemPrompt, input, output, expectsHTML)
        return output
    } catch (error) {
        // Handle any errors that occur during the model execution.
        // Convert the error to a JSON string for logging and reporting.
        let errorText = to_json(error)
        logSteps(stepName, stepNumber, modelName, thinkingLevel, systemPrompt, input, errorText, false, "failed")
        raise_error("GenerationStepFailed", errorText)
        return ""
    }
}

/**
  Generates a fully structured, styled, and interactive HTML website through multi-step refinement.

  Parameters:
  - promptText: Initial prompt describing the desired website.
  - purpose: Specific purpose or goal of the website (default empty).
  - minify: Whether to minify the final HTML output (default false).

  Returns:
  - A string containing the final HTML/CSS/JS website code.

  Example:
  ```sesi
  let site = genHTML("Portfolio website", "Showcase my projects", true)
  write_file("index.html", site)
  ```

  Notes:
  - Generation Steps:
    1. Draft the initial website structure and content.
    2. Apply styling and visual design.
    3. Accessibility and semantic HTML validation.
    4. Optimize the website for performance and responsiveness.
    5. Enhance the website with additional features and improvements.
    6. Final review and quality assurance of the website.
    7. If necessary, iterate on previous steps to refine and improve the website based on feedback and evaluation.
    8. If set to true, minify and prepare the final version of the website for deployment.
*/
export fn genHTML(promptText: string, purpose: string = "", minify: bool = false) -> string {
    let dir = "drafts/"; make_dir(dir)
    let filename = promptText | trunc(20) | swap(" ", "_") | to_lower | trim

    // Save an intermediate HTML generation result to the drafts directory.
    //
    // Parameters:
    // - filename: Base name used to construct the draft output path.
    // - content: HTML content to save.
    // - stage: Numeric generation stage associated with the draft.
    // - step: Human-readable name of the generation step.
    //
    // Returns:
    // - `true` when the draft is saved successfully; otherwise, an error message.
    //
    // Notes:
    // - The output filename includes the stage, normalized step name, and source filename.
    // - File-writing errors are caught and reported through the terminal helper.
    fn saveDraft(filename: string, content: string, stage: number = 0, step: string) -> any {
        filename = dir + "step" + (stage | str) + "_" + (to_lower(step) | trim) + "_for_" + filename + "_draft.html"
        try {
            write_file(filename, content)
            TERM.success("Saved step " + stage + ": " + step)
            return true
        } catch (e) {
            TERM.error("Failed to save " + step + " draft at step " + stage)
            return e.message
        }
    }

    // Improve the initial prompt and purpose for better website generation.
    let improved = improvePrompt(
        "Website prompt: " + promptText + "
        Website purpose: " + purpose + "
        # IMPORTANT: Return the improved prompt and purpose as a JSON object with the fields 'prompt' and 'purpose'."
    ) | from_json
    promptText = improved["prompt"]
    purpose = improved["purpose"]
    // Define system prompts for different aspects of website generation
    prompt sys1 {"You are a product-oriented frontend architect."}
    prompt sys2 {"You are a senior UI/visual designer specializing in production CSS."}
    prompt sys3 {"You are an HTML semantics and accessibility specialist."}
    prompt sys4 {"You are a responsive frontend engineer specializing in mobile layouts."}
    prompt sys5 {"You are a senior vanilla JavaScript engineer focused on robust UI behavior."}
    prompt eval {"You are a frontend QA engineer. Find defects. Do not redesign."}
    prompt makeSite {"Draft a website for the following purpose: "purpose" and based on the following prompt: "promptText"
    Return only the HTML/CSS template code for the website without any additional explanations or comments."}

    // Generate the website in multiple steps, including drafting, styling, optimizing, enhancing interactivity, evaluating for defects, fixing defects if found, and minifying the final output.
    let logStep1 = "Step 1: Drafting the initial website structure and content based on the prompt...\n"
    TERM.info(logStep1)
    let step1 = runModelStep("draft", 1, "gemini-3-flash-preview", "medium", sys1, makeSite)
    saveDraft(filename, step1, 1, "Initial Draft")

    let logStep2 = "Step 2: Improving the CSS styling and JS logic...\n"
    TERM.info(logStep2)
    prompt step2Input {"Improve the CSS styling, enhance the layout, and ensure JS is functional:
    " step1 "
    Return only the improved HTML/CSS code without any additional explanations or comments."}

    let step2 = runModelStep("styling", 2, "gemini-3.7-flash", "medium", sys2, step2Input)
    saveDraft(filename, step2, 2, "CSS Enhancement")

    let logStep3 = "Step 3: Ensuring proper semantic tags and accessibility...\n"
    TERM.info(logStep3)
    prompt step3Input {"Ensure proper semantic tags without altering the existing design and functionality:
    " step2 "
    Return only the optimized HTML/CSS code without any additional explanations or comments. DO NOT REMOVE ANY EXISTING FUNCTIONALITY, CONTENT, OR DESIGN ELEMENTS."}

    let step3 = runModelStep("optimization", 3, "gemini-3.6-flash", "medium", sys3, step3Input)
    saveDraft(filename, step3, 3, "Semantics and Accessibility")

    let logStep4 = "Step 4: Ensuring the website is responsive and mobile-friendly...\n"
    TERM.info(logStep4)
    prompt step4Input {"Ensure the website is responsive and mobile-friendly without altering the existing design and functionality:
    " step3 "
    Return only the responsive and mobile-friendly HTML/CSS code without any additional explanations or comments."}

    let step4 = runModelStep("responsive", 4, "gemini-3.1-pro-preview", "medium", sys4, step4Input)
    saveDraft(filename, step4, 4, "Responsive Check")

    let finalLog = "Final Step: Adding or enhancing present JavaScript functionality and interactivity...\n"
    TERM.info(finalLog)
    prompt finalInput {"Add or enhance present JavaScript functionality and interactive elements:
    " step4 "
    Return only the final self-contained HTML/CSS/JS code for the website, without any additional explanations or comments."}

    let finalStep = runModelStep("interactivity", 5, "gemini-3.7-flash", "medium", sys5, finalInput)
    saveDraft(filename, finalStep, 5, "JS Functionality")

    let evalLog = "Evaluation Step: Reviewing the final website for any defects, issues, or areas of improvement...\n"
    TERM.info(evalLog)
    prompt evalInput {"Original purpose:
    " purpose "

    Original website request:
    " promptText "

    Inspect this implementation, do not rewrite it.

    Find:
    - broken functionality
    - semantic problems
    - accessibility problems
    - responsive issues
    - JS bugs
    - violations of original requirements

    Return a JSON object of the following structure. Use an empty string for every field with no defect:
    {
        \"broken\": string,
        \"semantic\": string,
        \"accessibility\": string,
        \"responsive\": string,
        \"js\": string,
        \"requirements\": string
    }
    " finalStep}

    // Run the evaluation step to review the final website for defects and issues.
    let evalRaw = runModelStep("evaluation", 6, "gemini-3.5-flash-lite", "medium", eval, evalInput, false)
    // Parse the evaluation output into a structured format.
    let evalStep = {}
    try {
        evalStep = structured_output({broken: string, semantic: string, accessibility: string, responsive: string, js: string, requirements: string})(evalRaw)
    } catch (error) {
        let errorText = to_json(error)
        logSteps("evaluation_parse", 6, "gemini-3.5-flash-lite", "medium", eval, evalInput, errorText, false, "failed")
        raise_error("EvaluationParseFailed", errorText)
    }

    // Check if any defects were found and handle accordingly.
    if evalStep.broken == "" && evalStep.semantic == "" && evalStep.accessibility == "" && evalStep.responsive == "" && evalStep.js == "" && evalStep.requirements == "" {
        TERM.success("No defects found in the final website implementation.")
    } else {
        TERM.warning("Detected errors, patching before final delivery...")
        prompt defectFixer {"You are a professional and organized software developer. You are tasked with fixing the following defects in this HTML code."}
        prompt fixedInput {"Bugs to patch:
        " to_json(evalStep) "
        Code to fix:
        " finalStep "
        Return only the fixed HTML/CSS/JS code without any additional explanations or commentse."}

        let fixedStep = runModelStep("defect_fix", 7, "gemini-3.7-flash", "medium", defectFixer, fixedInput)
        saveDraft(filename, fixedStep, 7, "Defect Revision")
        finalStep = fixedStep
    }

    if minify {
        let minifyLog = "Minification Step: Minifying the final HTML for optimal performance...\n"
        TERM.info(minifyLog)
        let minifiedStep = minify_html(finalStep)
        saveDraft(filename, minifiedStep, 8, "HTML Minification")
        finalStep = minifiedStep
    }

    TERM.success("Website generated!")
    return finalStep
}

/**
  Generates an HTML website quickly with a fast-track pass and automated defect patching.

  Parameters:
  - promptText: Prompt describing the website.
  - purpose: Purpose of the website (default empty).
  - minify: Whether to minify the final output (default false).

  Returns:
  - A string containing the resulting HTML code or an error message.

  Example:
  ```sesi
  let html = genHTMLFast("Landing page", "Sell widgets", true)
  ```

  Notes:
  - Generation Steps:
    1. Improve the prompt and purpose for better results.
    2. Generate the initial HTML based on the improved prompt and purpose.
    3. Evaluate the generated HTML for defects.
    4. Fix any detected defects.
    5. Minify the final HTML if the minify flag is set.
*/
export fn genHTMLFast(promptText: string, purpose: string = "", minify: bool = false) -> string {
    let dir = "drafts/"; make_dir(dir)
    let filename = promptText | trunc(20) | swap(" ", "_") | to_lower | trim
    filename = dir + filename + "_draft.html"
    prompt sys1 {"You are a product-oriented frontend architect."}
    prompt sys2 {"You are a senior UI/visual designer specializing in production CSS."}
    prompt evalSite {"You are a frontend QA engineer. Find defects. Do not redesign."}
    prompt makeSite {"Create a website for the following purpose: "purpose" and based on the following prompt: "promptText"
    Return only the HTML/CSS/JS code for the website without any additional explanations or comments."}
    prompt evalInput {"Original purpose:
    " purpose "

    Original website request:
    " promptText "

    Inspect this implementation, do not rewrite it.

    Find:
    - broken functionality
    - semantic problems
    - accessibility problems
    - responsive issues
    - JS bugs
    - violations of original requirements

    Return a JSON object of the following structure. Use an empty string for every field with no defect:
    {
        \"broken\": string,
        \"semantic\": string,
        \"accessibility\": string,
        \"responsive\": string,
        \"js\": string,
        \"requirements\": string
    }
    "}

    let pass1 = ""
    let review = ""
    let eval = ""
    let fixed = ""

    try {
        TERM.info("Enhancing prompt and purpose to best suit your needs...")
        let improved = improvePrompt(
        "Website prompt: " + promptText + "
        Website purpose: " + purpose + "
        # IMPORTANT: Return the improved prompt and purpose as a JSON object with the fields 'prompt' and 'purpose'."
    ) | from_json
        promptText = improved["prompt"]
        purpose = improved["purpose"]
        TERM.info("Generating HTML with prompt:
" + promptText + "
========
with the purpose to:
========
" + purpose + "
...")
        try {
            pass1 = model("gpt-5.6-terra") {system: sys1, thinking: "medium"} {makeSite} | cleanAIResponse
        } catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            pass1 = model("gemini-3-flash-preview") {system: sys1, thinking: "medium"} {makeSite} | cleanAIResponse
        }
        TERM.info("Enhancing CSS and making sure site is functional...\n")
        write_file(filename, pass1)
        review = model("gemini-3.7-flash") {system: sys2, thinking: "medium"} {"Enhance the following CSS and make sure the JS logic is functional rather than placeholder:
        " pass1 "

        Return only the complete code for the website without any additional explanations or comments."} | cleanAIResponse
        try {
            eval = model("gpt-5.6-luna") {system: evalSite, thinking: "medium"} {evalInput "Implementation:\n" pass1} | cleanAIResponse
        } catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            eval = model("gemini-3.5-flash-lite") {system: evalSite, thinking: "medium"} {evalInput "Implementation:\n" pass1} | cleanAIResponse
        }
        if eval.broken != "" || eval.semantic != "" || eval.accessibility != "" || eval.responsive != "" || eval.js != "" || eval.requirements != "" {
            TERM.warning("Detected errors, patching before final delivery...")
            prompt defectFixer {"You are a professional and organized software developer. You are tasked with fixing the following defects in this HTML code. Preserve semantics, accessibility, word usage/text, and responsive design. Do not redesign the website."}
            prompt fixedInput {"Bugs to patch:
            " to_json(eval) "
            Code to fix:
            " review "
            Return only the complete fixed code without any additional explanations or comments."}
            fixed = model("gemini-3.7-flash") {system: defectFixer, thinking: "medium"} {fixedInput} | cleanAIResponse
            review = fixed
        } else {
            TERM.success("No defects found in the final website implementation.")
        }
    } catch (e) {
        TERM.error(e.message)
        return "Error generating HTML: " + e.message
    }
    TERM.success("Successfully generated HTML!")

    if minify {
        return minify_html(review)
    }
    return review
}

/**
  Generates an HTML website quickly using reference files for context and guidance.

  Parameters:
   - promptText: The main prompt describing the website to generate.
   - purpose: The purpose of the website.
   - filenames: An array of reference file paths to include in the generation.
   - minify: Whether to minify the final HTML output (default: true).
  Returns:
  - A string containing the generated HTML code or an error message.

  Example:
  ```sesi
  let site = genHTMLFastWithRef("Portfolio", "Showcase work", ["style_guide.md"], true)
  ```

  Notes:
  - Incorporates file contents as reference context within system prompts.
*/
export fn genHTMLFastWithRef(promptText: string, purpose: string, filenames: array<string>, minify: bool = true) -> string {
    let contents = {}
    if filenames != null {
        for filename in filenames {
            let ext = get_ext(filename)
            contents[filename | swap("." + ext, "")] = read_file(filename)
            TERM.info("Adding reference from file: " + filename)
        }
    } else if !(filenames[0] | ends_with(".md")) {
        for file in filenames {
           contents = file
        }
    } else {
        return "Error: No reference files provided."
    }
    let dir = "drafts/"; make_dir(dir)
    let filename = promptText | trunc(20) | swap(" ", "_") | to_lower | trim
    filename = dir + filename + "_draft.html"
    prompt sys1 {"
    # REFERENCE:
    "contents"
    You are a product-oriented frontend architect."}
    prompt sys2 {"
    # REFERENCE:
    "contents"
    You are a senior UI/visual designer specializing in production CSS."}
    prompt makeSite {"Create a website for the following purpose: "purpose" and based on the following prompt: "promptText"

    # REFERENCE:
    "contents"

    Return only the HTML/CSS/JS code for the website without any additional explanations or comments."}
    prompt evalSite {"
    # REFERENCE:
    "contents"
    You are a frontend QA engineer. Find defects. Do not redesign."}
    prompt evalInput {"Original purpose:
    " purpose "

    Original website request:
    " promptText "

    Inspect this implementation, do not rewrite it.

    Find:
    - broken functionality
    - semantic problems
    - accessibility problems
    - responsive issues
    - JS bugs
    - violations of original requirements

    Return a JSON object of the following structure. Use an empty string for every field with no defect:
    {
        \"broken\": string,
        \"semantic\": string,
        \"accessibility\": string,
        \"responsive\": string,
        \"js\": string,
        \"requirements\": string
    }
    "}

    let pass1 = ""
    let review = ""
    let eval = ""
    let fixed = ""

    try {
        TERM.info("Enhancing prompt and purpose to best suit your needs...")
        let improved = improvePrompt(
            "Website prompt: " + promptText + "
            Website purpose: " + purpose + "
            # IMPORTANT: Return the improved prompt and purpose as a JSON object with the fields 'prompt' and 'purpose'."
        ) | from_json
        promptText = improved["prompt"]
        purpose = improved["purpose"]
        TERM.info("Generating HTML with prompt:
" + promptText + "
========
with the purpose to:
========
" + purpose + "
...
")
        try {
            pass1 = model("gpt-5.6-terra") {system: sys1, thinking: "medium"} {makeSite} | cleanAIResponse
        } catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            pass1 = model("gemini-3-flash-preview") {system: sys1, thinking: "medium"} {makeSite} | cleanAIResponse
        }
        TERM.info("Enhancing CSS and making sure site is functional...\n")
        write_file(filename, pass1)
        review = model("gemini-3.7-flash") {system: sys2, thinking: "medium"} {"Enhance the following CSS and make sure the JS logic is functional rather than placeholder:
        " pass1 "

        Return only the complete code for the website without any additional explanations or comments."} | cleanAIResponse
        try {
            eval = model("gpt-5.6-luna") {system: evalSite, thinking: "medium"} {evalInput "Implementation:\n" pass1} | cleanAIResponse
        } catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            eval = model("gemini-3.5-flash-lite") {system: evalSite, thinking: "medium"} {evalInput "Implementation:\n" pass1} | cleanAIResponse
        }
        if eval.broken != "" || eval.semantic != "" || eval.accessibility != "" || eval.responsive != "" || eval.js != "" || eval.requirements != "" {
            TERM.warn("Detected errors, patching before final delivery...")
            prompt defectFixer {"You are a professional and organized software developer. You are tasked with fixing the following defects in this HTML code. Preserve semantics, accessibility, word usage/text, and responsive design. Do not redesign the website."}
            prompt fixedInput {"Bugs to patch:
            " to_json(eval) "
            Code to fix:
            " review "
            Return only the complete fixed code without any additional explanations or comments."}
            fixed = model("gemini-3.7-flash") {system: defectFixer, thinking: "medium"} {fixedInput} | cleanAIResponse
            review = fixed
        } else {
            TERM.success("No defects found in the final website implementation.")
        }
    } catch (e) {
        TERM.error(e.message)
        return "Error generating HTML: " + e.message
    }
    TERM.success("Successfully generated HTML!")

    if minify {
        return minify_html(review)
    }
    return review
}

/**
  Generates a comprehensive, multi-step HTML website using reference files for contextual guidance.

  Parameters:
  - promptText: Prompt describing the website.
  - purpose: Purpose of the website.
  - filenames: Array of reference files.
  - minify: Whether to minify the final HTML (default true).

  Returns:
  - A string containing the final generated HTML website code.

  Example:
  ```sesi
  let site = genHTMLWithRef("Landing Page", "Lead gen", ["docs.md"], true)
  ```

  Notes:
  - Uses full iterative staging pipeline including drafting, styling, semantics, responsiveness, JS functionality, and evaluation with reference context.
*/
export fn genHTMLWithRef(promptText: string, purpose: string, filenames: array<string>, minify: bool = true) -> string {
    let contents = {}
    if filenames != null && (filenames[0] | ends_with(".md")) {
        for filename in filenames {
            let ext = get_ext(filename)
            contents[filename | swap("." + ext, "")] = read_file(filename)
            TERM.info("Adding reference from file: " + filename)
        }
    } else if !(filenames[0] | ends_with(".md")) {
        for file in filenames {
           contents = file
        }
    } else {
        return "Error: No reference files provided."
    }
    let dir = "drafts/"; make_dir(dir)
    let filename = promptText | trunc(20) | swap(" ", "_") | to_lower | trim

    // Save an intermediate HTML generation result to the drafts directory.
    //
    // Parameters:
    // - filename: Base name used to construct the draft output path.
    // - content: HTML content to save.
    // - stage: Numeric generation stage associated with the draft.
    // - step: Human-readable name of the generation step.
    //
    // Returns:
    // - `true` when the draft is saved successfully; otherwise, an error message.
    //
    // Notes:
    // - The output filename includes the stage, normalized step name, and source filename.
    // - File-writing errors are caught and reported through the terminal helper.
    fn saveDraft(filename: string, content: string, stage: number = 0, step: string) -> any {
        filename = dir + "step" + (stage | str) + "_" + (to_lower(step) | swap(" ", "_") | trim) + "_for_" + filename + "_draft.html"
        try {
            write_file(filename, content)
            TERM.success("Saved step " + stage + ": " + step)
            return true
        } catch (e) {
            TERM.error("Failed to save " + step + " draft at step " + stage)
            return e.message
        }
    }

    let improved = improvePrompt(
        "Website prompt: " + promptText + "
        Website purpose: " + purpose + "
        # IMPORTANT: Return the improved prompt and purpose as a JSON object with the fields 'prompt' and 'purpose'."
    ) | from_json
    promptText = improved["prompt"]
    purpose = improved["purpose"]
    // Define system prompts for different aspects of website generation
    prompt sys1 {"
    # REFERENCE:
    "contents"
    You are a product-oriented frontend architect."}
    prompt sys2 {"
    # REFERENCE:
    "contents"
    You are a senior UI/visual designer specializing in production CSS."}
    prompt sys3 {"
    # REFERENCE:
    "contents"
    You are an HTML semantics and accessibility specialist."}
    prompt sys4 {"
    # REFERENCE:
    "contents"
    You are a responsive frontend engineer specializing in mobile layouts."}
    prompt sys5 {"
    # REFERENCE:
    "contents"
    You are a senior vanilla JavaScript engineer focused on robust UI behavior."}
    prompt eval {"
    # REFERENCE:
    "contents"
    You are a frontend QA engineer. Find defects. Do not redesign."}
    prompt makeSite {"Draft a website for the following purpose: "purpose" and based on the following prompt: "promptText"

    # REFERENCE:
    "contents"

    Return only the HTML/CSS template code for the website without any additional explanations or comments."}

    // Generate the website in multiple steps, including drafting, styling, optimizing, enhancing interactivity, evaluating for defects, fixing defects if found, and minifying the final output.
    let logStep1 = "Step 1: Drafting the initial website structure and content based on the prompt...\n"
    TERM.info(logStep1)
    let step1 = runModelStep("draft", 1, "gemini-3-flash-preview", "medium", sys1, makeSite)
    saveDraft(filename, step1, 1, "Initial Draft")

    let logStep2 = "Step 2: Improving the CSS styling and JS logic...\n"
    TERM.info(logStep2)
    prompt step2Input {"Improve the CSS styling, enhance the layout, and ensure JS is functional:
    " step1 "
    Return only the improved HTML/CSS code without any additional explanations or comments."}

    let step2 = runModelStep("styling", 2, "gemini-3.7-flash", "medium", sys2, step2Input)
    saveDraft(filename, step2, 2, "CSS Enhancement")

    let logStep3 = "Step 3: Ensuring proper semantic tags...\n"
    TERM.info(logStep3)
    prompt step3Input {"Ensure proper semantic tags are applied without altering the existing design and functionality:
    " step2 "
    Return only the HTML/CSS code with the applied semantic tags without any additional explanations or comments. DO NOT REMOVE ANY EXISTING FUNCTIONALITY, CONTENT, OR DESIGN ELEMENTS."}

    let step3 = runModelStep("semantics", 3, "gemini-3.6-flash", "medium", sys3, step3Input)
    saveDraft(filename, step3, 3, "Semantics Tagging")

    let logStep4 = "Step 4: Ensuring the website is responsive and mobile-friendly...\n"
    TERM.info(logStep4)
    prompt step4Input {"Ensure the website is responsive and mobile-friendly without altering the existing design and functionality:
    " step3 "
    Return only the responsive and mobile-friendly HTML/CSS code without any additional explanations or comments."}

    let step4 = runModelStep("responsive", 4, "gemini-3.1-pro-preview", "medium", sys4, step4Input)
    saveDraft(filename, step4, 4, "Responsive Check")

    let finalLog = "Final Step: Adding or enhancing present JavaScript functionality and interactivity...\n"
    TERM.info(finalLog)
    prompt finalInput {"Add or enhance present JavaScript functionality and interactive elements:
    " step4 "
    Return only the final self-contained HTML/CSS/JS code for the website, without any additional explanations or comments."}

    let finalStep = runModelStep("interactivity", 5, "gemini-3.7-flash", "medium", sys5, finalInput)
    saveDraft(filename, finalStep, 5, "JS Functionality")

    let evalLog = "Evaluation Step: Reviewing the final website for any defects, issues, or areas of improvement...\n"
    TERM.info(evalLog)
    prompt evalInput {"
    Original purpose:
    " purpose "

    Original website request:
    " promptText "

    Inspect this implementation, do not rewrite it.

    Find:
    - broken functionality
    - semantic problems
    - accessibility problems
    - responsive issues
    - JS bugs
    - violations of original requirements
    - introduced undocumented content or features

    Return a JSON object of the following structure. Use an empty string for every field with no defect:
    {
        \"broken\": string,
        \"semantic\": string,
        \"accessibility\": string,
        \"responsive\": string,
        \"js\": string,
        \"requirements\": string
    }
    " finalStep}

    // Run the evaluation step to check for defects in the final website implementation.
    let evalRaw = runModelStep("evaluation", 6, "gemini-3.5-flash-lite", "medium", eval, evalInput, false)
    // Parse the raw evaluation output into a structured JSON object.
    let evalStep = {}
    try {
        evalStep = structured_output({broken: string, semantic: string, accessibility: string, responsive: string, js: string, requirements: string})(evalRaw)
    } catch (error) {
        let errorText = to_json(error)
        logSteps("evaluation_parse", 6, "gemini-3.5-flash-lite", "medium", eval, evalInput, errorText, false, "failed")
        raise_error("EvaluationParseFailed", errorText)
    }

    if evalStep.broken == "" && evalStep.semantic == "" && evalStep.accessibility == "" && evalStep.responsive == "" && evalStep.js == "" && evalStep.requirements == "" {
        TERM.success("No defects found in the final website implementation.")
    } else {
        TERM.warning("Detected errors, patching before final delivery...")
        prompt defectFixer {"You are a professional and organized software developer. You are tasked with fixing the following defects in this HTML code."}
        prompt fixedInput {"Bugs to patch:
        " to_json(evalStep) "
        Code to fix:
        " finalStep "
        Return only the fixed HTML/CSS/JS code without any additional explanations or commentse."}

        let fixedStep = runModelStep("defect_fix", 7, "gemini-3.7-flash", "medium", defectFixer, fixedInput)
        saveDraft(filename, fixedStep, 7, "Defect Revision")
        finalStep = fixedStep
    }

    if minify {
        let minifyLog = "Minification Step: Minifying the final HTML for optimal performance...\n"
        TERM.info(minifyLog)
        let minifiedStep = minify_html(finalStep)
        saveDraft(filename, minifiedStep, 8, "HTML Minification")
        finalStep = minifiedStep
    }
    TERM.success("Website generated!")
    return finalStep
}

/**
  Generates a package.json file string for a Node.js project.

  Parameters:
  - name: Name of the project.
  - description: Brief description of the package.
  - author: The author of the project.

  Returns:
  - A string containing the generated package.json contents.

  Example:
  ```sesi
  let pkg = genPkgJSON("my-tool", "A CLI utility", "Alice")
  show pkg
  ```

  Notes:
  - Uses `gemini-2.5-flash` to enhance the description and format JSON.
*/
export fn genPkgJSON(name: string, description: string, author: string) -> string {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating a package.json file for a Node.js project."}
    prompt makePkgJSON {"Generate a package.json file for a Node.js project with the following details:
- Name: "name"
- Description: "description" <- Improve this description to be more detailed and informative, yet concise.
- Author: "author"
- License: MIT"}

    let generatedPkg = model("gemini-2.5-flash") {system: sys} {makePkgJSON}
    return generatedPkg | cleanAIResponse
}

/**
  Generates a project README.md file based on provided project details.

  Parameters:
  - title: The title of the project.
  - description: A brief description of the project.
  - body: The main content of the README, providing an overview of the project, its features, and other relevant information.
  - installation: Instructions for installing the project.
  - usage: Instructions for using the project.
  Returns:
  - A string containing the generated markdown README content.

  Example:
  ```sesi
  let readme = genReadMe("MyLib", "A fast library", "Details...", "npm install mylib", "import mylib")
  show readme
  ```

  Notes:
  - Attempts generation using `gpt-5.6-terra`, falling back to `gemini-3.7-flash`.
*/
export fn genReadMe(title: string, description: string, body: string, installation: string, usage: string) -> string {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating a README.md file for a project."}
    prompt makeReadMe {"Generate a README.md file for a project with the following details:
- Title: "title"
- Description: "description" <- Improve this description to be more detailed and informative, yet concise.
- Body: "body" <- If the body is empty, generate a body that provides an overview of the project, its potential features, and any other relevant information. Otherwise, improve the body to be more detailed and informative.
- Installation: "installation" <- Verify that the installation instructions are clear and accurate/up to date. If they are not, provide improved installation instructions.
- Usage: "usage" <- Verify that the usage instructions are clear and accurate. If they are not, provide improved usage instructions.
"}

    let generatedReadMe = ""
    try {
        generatedReadMe = model("gpt-5.6-terra") {system: sys, search} {makeReadMe}
    } catch (e) {
        TERM.warning(e.message)
        TERM.warning("Retrying with a more capable model...")
        generatedReadMe = model("gemini-3.7-flash") {system: sys, search} {makeReadMe}
    }

    // Removes a trailing Markdown fenced code block from generated README content.
    //
    // Parameters:
    // - text: Generated README content to inspect.
    //
    // Returns:
    // - The README content with a terminal code block removed when one is present.
    //
    // Notes:
    // - Fenced blocks are detected using lines beginning with three backticks.
    // - Descriptive Markdown content outside the final code block is preserved.
    fn cleanCodeBlockAtEndOfFile(text: string) -> string {
        let lines = split(text, "\n")
        let cleanedLines = []
        let insideCodeBlock = false

        for line in lines {
            // Check for the start or end of a code block
            if regex("^```", line, {"mode": "match", "flags": "g"}) != [] {
                insideCodeBlock = !insideCodeBlock
            }
            // Add back descriptive text lines, but skip the last code block if it's at the end of the file
            if !insideCodeBlock || (insideCodeBlock && line != lines[len(lines) - 1]) {
                cleanedLines = append(cleanedLines, line)
            }
            // Some code blocks might've been accidentally left open, so we ensure we don't include the last code block if it's at the end of the file
            if insideCodeBlock && line == lines[len(lines) - 1] {
                insideCodeBlock = false
            }
        }

        return join(cleanedLines, "\n")
    }

    if generatedReadMe | contains("```markdown") {
        generatedReadMe = regex("```markdown\\n([\\s\\S]*?)\\n```", generatedReadMe, {"mode": "replace", "replacement": "$1", "flags": "g"})
        generatedReadMe = cleanCodeBlockAtEndOfFile(generatedReadMe)
    }
    return generatedReadMe
}

/**
  Generates an open source project LICENSE file.

  Parameters:
  - name: The name of the copyright holder.
  - year: The year the license applies to.
  - license: License type (e.g., "MIT", "Apache-2.0").

  Returns:
  - A string containing the generated license text.

  Example:
  ```sesi
  let lic = genLicense("Jane Doe", "2026", "MIT")
  show lic
  ```

  Notes:
  - Uses the `gemini-3-flash-preview` model with search enabled.
*/
export fn genLicense(name: string, year: string, license: string) -> string {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating a LICENSE file for a project."}
    prompt makeLicense {"Generate a LICENSE file for a project with the following details:

- Name: "name"
- Year: "year"
- License: "license"
"}

    let generatedLicense = model("gemini-3-flash-preview") {system: sys, search} {makeLicense}
    return generatedLicense | cleanAIResponse
}

/**
  Generates a combined README and license file string.

  Parameters:
  - `title`: The title of the project.
  - `description`: A brief description of the project.
  - `body`: The main content of the README, providing an overview of the project, its features, and other relevant information.
  - `installation`: Instructions for installing the project.
  - `usage`: Instructions for using the project.
  - `license`: The type of license for the project.
  - `name`: The name of the copyright holder.
  - `year`: The year the license applies to.

  Returns:
  - A combined markdown string containing the README and appended license.

  Example:
  ```sesi
  let fullDoc = genReadMeWithLicense("Proj", "Desc", "Body", "Inst", "Usage", "MIT", "Dev", "2026")
  show fullDoc
  ```

  Notes:
  - Automatically generates the license and appends it to the README.
*/
export fn genReadMeWithLicense(title: string, description: string, body: string, installation: string, usage: string, license: string, name: string, year: string) -> string {
    let licenseText = genLicense(name, year, license)
    let readme = genReadMe(title, description, body, installation, usage + "\n" + licenseText + "----")
    return readme
}

