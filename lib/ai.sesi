/**
  Provides utility functions for interacting with AI models, processing AI responses, and performing web searches.

  This module includes functions for cleaning AI responses, sending prompts to local AI models, finding URLs in text, and performing online searches.
  These functions aim to simplify the process of working with AI-generated content and integrating it into various applications.
*/
allow "helpers/html-minify" in with {minify_html}
allow "helpers/safe" in as Safe
allow "misc" in with {generateGitIgnore, getLines}
allow "string" in with {toPascal, toKebab, substring}
allow "timestamp" in with {formattedTime, localTime, getDate}
allow "refs" in as DOCS
allow "ansi" in as TERM
allow "usage" in with {track_model, track_structured_model, track_image}

let _ = DOCS.getBUILTINS() + "\n" + DOCS.getAUDIO() + "\n" + DOCS.getSVG_PIXELS() + "\n" + DOCS.getVARIABLES() + "\n" + DOCS.getFUNCTIONS() + "\n" + DOCS.getMAKE() + "\n" + DOCS.getHOW_TO() + "\n" + DOCS.getGUIDE()
/**
  Cleans an AI model response by extracting content from markdown code blocks or trimming raw text.

  Parameters:
  - responseText: The raw string response from an AI model.

  Returns:
  - A cleaned string containing the extracted code or trimmed response text.

  Example:
  ```sesi
  let cleaned = cleanAIResponse("```javascript\nconsole.log('hi');\n```")
  show cleaned
  ```

  Notes:
  - Automatically falls back to returning the trimmed raw response if no markdown code blocks are found.
*/
export fn cleanAIResponse(responseText: string) -> string {
    let preClean = regex("```[a-zA-Z]*\\n([\\s\\S]*?)\\n```", responseText, {"mode": "match", "flags": "g"})

    // Fall back to raw response if no code blocks exist
    if len(preClean) == 0 {
        return trim(responseText)
    }

    let cleanedText = ""
    for arr in preClean {
        cleanedText = cleanedText + arr.match + "\n"
    }

    cleanedText = regex("```[a-zA-Z]*\\n|\\n```", cleanedText, {"mode": "replace", "replacement": "", "flags": "g"})
    return trim(cleanedText)
}

/**
  Sends a prompt to the local AI model with predefined thinking and token limits.

  Parameters:
  - promptText: The text prompt to send to the local model.

  Returns:
  - A string containing the model's response.

  Example:
  ```sesi
  let resp = local("Explain recursion")
  show resp
  ```

  Notes:
  - Configured with medium thinking and a maximum of 500 tokens.
*/
export fn local(promptText: string) -> string {
    return model("local") {thinking: "medium", maxT: 500} {promptText}
}

/**
  Performs an online web search using an AI model and returns structured results including sources and links.

  Parameters:
  - query: The search query string.
  - config: Optional boolean to include configuration details in the response.

  Returns:
  - An object containing the search results, sources, links, and optionally configuration and cost.

  Example:
  ```sesi
  let info = onlineSearch("Latest developments in AI")
  show info
  ```

  Notes:
  - Uses the `gemini-3.5-flash-lite` model with web search capability enabled.
  - If `config` is true, the response will include configuration and cost details.
*/
export fn onlineSearch(query: string, config = false) -> object {
    prompt searchInstructions {"You have access to a search tool that can retrieve information from the web. Use this tool to find relevant information based on the user's query. Provide your findings, and include links to the sources."}
    let results = track_structured_model(
        "Search for the following query: " + query + "\nReturn only the relevant information and links to the sources.", {
            results: "string",
            sources: "array",
            links: "array"
        },
        {
            model_name: "gemini-3.5-flash-lite",
            system: searchInstructions,
            thinking: "medium",
            search: true,
            max_tokens: 4096,
            response: "full"
        }
    )

    let response = results.response
    if response == null { raise_error("SearchError", "An error occurred while performing the search:" + results) }
    let result = response.results
    let sources = response.sources
    let links = response.links
    show "Time taken:" results.duration
    if config {
        return {
            configuration: results.config_used,
            query: query,
            cost: results.cost,
            duration: results.duration,
            answer: result,
            sources: sources,
            links: links,
            complete_log: results
        }
    }
    return {
        query: query,
        cost: results.cost,
        duration: results.duration,
        answer: result,
        sources: sources,
        links: links
    }
}

/**
  Evaluates mathematical expressions or breaks down word problems step-by-step.

  Parameters:
  - promptText: The math expression or word problem to calculate. Can be any type.
  - config: Optional boolean to include configuration details in the response.

  Returns:
  - An object containing the calculation result, and optionally configuration and cost.

  Example:
  ```sesi
  let ans = calculate("45 * 12 / 3")
  show ans
  ```

  Notes:
  - Uses the `gemini-3.5-flash-lite` model configured with a calculator persona.
  - If `config` is true, the response will include configuration and cost details.
*/
export fn calculate(promptText: any, config = false) -> any {
    prompt calculator {"You are a reliable and accurate calculator. You are tasked with performing calculations based on user input.
If the input is a mathematical expression, evaluate it and provide the number only.
If the input is a word problem or a question that requires calculations, break down the problem step by step in human-readable form and provide the final answer."}
    let r = track_model("Calculate the following: " + promptText | str, {
            model_name: "gemini-3.5-flash-lite",
            system: calculator,
            thinking: "medium",
            response: "full"
        }
    )
    if r.response == null { raise_error("CalculationError", "An error occurred while performing the calculation:" + r) }
    show "Time taken:" r.duration
    if config {
        return {
            configuration: r.config_used,
            request: promptText,
            cost: r.cost,
            duration: r.duration,
            answer: r.response,
            complete_log: r
        }
    }
    return r.response
}

/**
  Reviews content for potential issues, improvements, and best practices.

  Parameters:
  - promptText: The content or data to review.
  - modelName: Optional. The name of the AI model to use for the review (default "gpt-6.1-terra").
  - config: Optional boolean to include configuration details in the response.

  Returns:
  - An object containing the review result, and optionally configuration and cost.

  Example:
  ```sesi
  let feedback = review("let x = [1, 2, 3];")
  show feedback
  ```

  Notes:
  - Uses the specified model for review analysis, defaulting to 'gpt-6.1-terra' if none is provided.
  - If `config` is true, the response will include configuration and cost details.
*/
export fn review(promptText: string, modelName, config = false) -> any {
    if !modelName { modelName = "gpt-6.1-terra" }
    let r = ""
    prompt sys {"You are a professional and observant analyst. You are tasked with reviewing data based on user input."}
    prompt reviewPrompt {"Review the following content for potential issues, improvements, and best practices: "promptText}
    try {
        r = track_model(reviewPrompt, {
                model_name: modelName,
                system: sys,
                thinking: "medium",
                response: "full"
            }
        ) 
    } catch (err) { TERM.error(err.message) }
    if r.response == null { raise_error("ReviewError", "An error occurred while performing the review:" + r) }
    show "Time taken:" r.duration
    if config {
        return {
            configuration: r.config_used,
            request: promptText,
            cost: r.cost,
            duration: r.duration,
            review: r.response,
            complete_log: r
        }
    }
    return r.response
}

/**
  Analyzes images and provides detailed observations and insights.

  Parameters:
  - imagePath: An array of paths to the images to analyze.
  - promptText: Additional context or instructions for the analysis.
  - useCache: Optional. A boolean indicating whether to use cached analysis results if available. Defaults to true.
  - config: Optional. A boolean to include configuration details in the response.

  Returns:
  - A string containing the analysis and observations, or an object with configuration and cost details if `config` is true.

  Example:
  ```sesi
  let analysis = askAboutIMG(["image.jpg"], "What does the image contain?", false)
  show analysis
  ```

  Notes:
  - Uses the `gpt-6-luna` model with a fallback to `gemini-3.5-flash-lite` for image analysis.
  - Supports caching of analysis results to optimize performance and reduce costs.
  - If `config` is true, the response will include configuration and cost details.
*/
export fn askAboutIMG(imagePath: array<string>, promptText: string, useCache: bool = true, config = false) -> string? | any {
    prompt sys {"You are an image analyst. You are tasked with analyzing images based on user input. Provide detailed observations and insights about the images."}
    let r = ""
    try {
        r = track_model(promptText, {
                model_name: "gpt-6-luna",
                system: sys,
                images: imagePath,
                cache: useCache
            }
        ) 
    } catch { 
        r = track_model(promptText, {
                model_name: "gemini-3.5-flash-lite",
                system: sys,
                images: imagePath,
                cache: useCache
            }
        )
    }
    if r.response == null { raise_error("ImageAnalysisError", "An error occurred while analyzing the image:" + r) }
    show "Time taken:" r.duration
    if config {
        return {
            configuration: r.config_used,
            request: promptText,
            cost: r.cost,
            duration: r.duration,
            analysis: r.response
        }
    }
    return r.response
}

/**
  Breaks down complex concepts into simple, easy-to-understand explanations.

  Parameters:
  - promptText: The concept, term, or text to explain.
  - modelName: Optional. The name of the AI model to use for the explanation (default "gpt-6-luna").
  - config: Optional. If true, returns an object with configuration and cost details (default false).

  Returns:
  - A detailed explanation string or an object with configuration and cost details if `config` is true.

  Example:
  ```sesi
  let explanation = explain("Quantum entanglement")
  show explanation
  ```

  Notes:
  - Uses the specified model for explanation, defaulting to `gpt-6-luna` with medium thinking if none is provided.
  - If `config` is true, the response will include configuration and cost details.
*/
export fn explain(promptText: string, modelName, config = false) -> any {
    if !modelName { modelName = "gpt-6-luna" }
    prompt explainer {"You break down complex concepts into simple, easy-to-understand explanations. You are tasked with explaining the following prompt in detail."}
    let r = ""
    try {
        r = track_model("Explain the following in detail: " + promptText, {
                model_name: modelName,
                system: explainer,
                thinking: "medium",
                response: "full"
            }
        ) 
    } catch (e) { TERM.error(e.message) }
    if r.response == null { raise_error("ExplanationError", "An error occurred while explaining the concept:" + r) }
    show "Time taken:" r.duration
    if config {
        return {
            configuration: r.config_used,
            request: promptText,
            cost: r.cost,
            duration: r.duration,
            explanation: r.response,
            complete_log: r
        }
    }
    return r.response
}

/**
  Summarizes text content in a clear and concise manner while understanding intent and nuance.

  Parameters:
  - promptText: The text to summarize.
  - modelName: Optional. The name of the AI model to use for the summarization (default "gpt-6-luna").
  - config: Optional. If true, returns an object with configuration and cost details (default false).

  Returns:
  - A summary string or an object with configuration and cost details if `config` is true.

  Example:
  ```sesi
  let summary = summarize(longArticleText)
  show summary
  ```

  Notes:
  - Uses the specified model for summarization, defaulting to `gpt-6-luna` with medium thinking if none is provided.
  - If `config` is true, the response will include configuration and cost details.
*/
export fn summarize(promptText: string, modelName, config = false) -> any {
    if !modelName { modelName = "gpt-6-luna" }
    prompt summarizer {"You are a professional summarizer that understands intent and nuance. You are tasked with summarizing the following prompt in a clear and concise manner."}
    let r = ""
    try {
        r = track_model(
            "Summarize the following: " + promptText, {
                model_name: modelName,
                system: summarizer,
                thinking: "medium",
                response: "full"
            }
        ) 
    } catch (e) { TERM.error(e.message) }
    if r.response == null { raise_error("SummarizationError", "An error occurred while summarizing the text:" + r) }
    show "Time taken:" r.duration
    if config {
        return {
            configuration: r.config_used,
            request: promptText,
            cost: r.cost,
            duration: r.duration,
            summary: r.response,
            complete_log: r
        }
    }
    return r.response
}

/**
  Compares and contrasts two items, providing similarities, differences, and notable points in a structured format.

  Parameters:
  - a: First item or text to compare.
  - b: Second item or text to compare.
  - modelName: Optional. The name of the AI model to use for the comparison (default "gpt-6-luna").
  - config: Optional. If true, returns an object with configuration and cost details (default false).

  Returns:
  - A string containing a table or structured comparison analysis.

  Example:
  ```sesi
  let comparison = compare("Python", "JavaScript")
  show comparison
  ```

  Notes:
  - Uses the specified model for comparison, defaulting to `gpt-6-luna` with medium thinking if none is provided.
  - If `config` is true, the response will include configuration and cost details.
*/
export fn compare(a: string, b: string, modelName, config = false) -> any {
    if !modelName { modelName = "gpt-6-luna" }
    let r = ""
    prompt comparer {"You have an innate ability to compare and contrast different pieces of information. You are tasked with comparing the following two items and providing a detailed analysis of their similarities, differences, and any notable points."}
    try {
        r = track_model(
            "Compare the following:
A: " + a + "

B: " + b + "

Return a table or structured format that clearly outlines the similarities, differences, and notable points between the two items.", {
                model_name: modelName,
                system: comparer,
                thinking: "medium",
                response: "full"
            }
        )
    } catch (e) { TERM.error(e.message) }
    if r.response == null { raise_error("ComparisonError", "An error occurred while comparing the items:" + r) }
    show "Time taken:" r.duration
    if config {
        return {
            configuration: r.config_used,
            context: {a: a, b: b},
            cost: r.cost,
            duration: r.duration,
            comparison: r.response,
            complete_log: r
        }
    }
    return r.response
}

/**
  Generates a list of insightful questions based on the provided prompt.

  Parameters:
  - promptText: The source text or topic to generate questions from.
  - modelName: Optional. The name of the AI model to use for generating questions (default "gpt-6-luna").
  - config: Optional. If true, the response will include configuration and cost details.
  

  Returns:
  - A string listing the generated questions.

  Example:
  ```sesi
  let qList = generateQuestions("The history of space exploration")
  show qList
  ```

  Notes:.
  - If 'config' is true, the response will include configuration and cost details.
*/
export fn generateQuestions(promptText: string, modelName, config = false) -> any {
    if !modelName { modelName = "gpt-6-luna" }
    let r = ""
    prompt questionGenerator {"You are an inquisitive and insightful individual. You are tasked with generating a list of questions based on the following prompt."}
    try {
        r = track_model("Generate questions based on the following: " + promptText + "
Return only the list of questions without any additional explanations or comments.", {
                model_name: modelName,
                system: questionGenerator,
                thinking: "medium"
            }
        ) 
    } catch (e) { TERM.error(e.message) }
    if r.response == null { raise_error("GenerationError", "An error occurred while generating questions:" + r) }
    show "Time taken:" r.duration
    if config {
        return {
            configuration: r.config_used,
            request: promptText,
            cost: r.cost,
            duration: r.duration,
            questions: r.response
        }
    }
    return r.response
}

/**
  Generates creative ideas, names, concepts, and suggestions based on input.

  Parameters:
  - promptText: The topic or goal to inspire ideas around.
  - modelName: Optional. The name of the AI model to use for generating inspirations (default "gpt-6-luna").
  - config: Optional. If true, the response will include configuration and cost details (default false).

  Returns:
  - A JSON object string or native Sesi object containing fields: 'ideas', 'names', 'concepts', 'suggestions', and optionally 'configuration', 'cost', and 'duration' if 'config' is true.

  Example:
  ```sesi
  let ideas = inspire("A coffee shop for programmers")
  show ideas
  ```

  Notes:
  - Cleans AI response and parses structured JSON output.
  - If 'config' is true, includes configuration, cost, and duration details in the response.
  - Uses search tool to ground inspirations in real-world context.
*/
export fn inspire(promptText: string, returnType: string = "JSON", modelName, config = false) -> object | string {
    if !modelName { modelName = "gpt-6-luna" }
    prompt inspirer {"You are a creative and inspiring individual. You are tasked with providing useful ideas, interesting names, thorough concepts, and creative suggestions based on the following prompt."}
    let resp = ""
    try {
        resp = track_structured_model("Provide inspiration based on the following: "promptText".
Each should contain 3-4 sentences.
If a field doesn't require an entry, simply leave it empty.",
            {
                ideas: "array",
                names: "array",
                concepts: "array",
                suggestions: "array"
            },
            {   
                model_name: modelName,
                system: inspirer,
                thinking: "medium",
                search: true,
                response: "full"
            }
        )
    } catch (e) { TERM.error(e.message) }
    if resp.response == null { raise_error("GenerationError", "An error occurred while generating inspirations:" + resp) }
    show "Time taken:" resp.duration
    let i = resp.response.ideas
    let n = resp.response.names
    let c = resp.response.concepts
    let s = resp.response.suggestions
    if returnType == "JSON" { 
        if config {
            return {
                configuration: resp.config_used,
                request: promptText,
                cost: resp.cost,
                duration: resp.duration,
                ideas: i,
                names: n,
                concepts: c,
                suggestions: s,
                complete_log: resp
            } | to_json 
        }
        return {
            request: promptText,
            cost: resp.cost,
            duration: resp.duration,
            ideas: i,
            names: n,
            concepts: c,
            suggestions: s
        } | to_json
    } else if returnType == "object" { 
        if config {
            return {
                configuration: resp.config_used,
                request: promptText,
                cost: resp.cost,
                duration: resp.duration,
                ideas: i,
                names: n,
                concepts: c,
                suggestions: s,
                complete_log: resp
            }
        }
        return {
            request: promptText,
            cost: resp.cost,
            duration: resp.duration,
            ideas: i,
            names: n,
            concepts: c,
            suggestions: s
        }
    }
}

/**
  Enhances a prompt to be more effective and detailed while preserving its exact intent.

  Parameters:
  - promptText: The raw prompt text to improve.
  - maxTokens: The maximum number of tokens to use when generating the improved prompt. Defaults to 1024.
  - sesiGuide: A boolean indicating whether to include SESI references in the prompt engineering process. Defaults to false.
  - modelName: Optional. The name of the AI model to use for improving the prompt (default "gpt-6-luna").
  - config: A boolean indicating whether to include configuration details in the returned result. Defaults to false.

  Returns:
  - An improved prompt string.

  Example:
  ```sesi
  let betterPrompt = improvePrompt("write a web scraper that extracts data from multiple websites efficiently", 1024, true)
  show betterPrompt
  ```

  Notes:
  - Attempts generation using the specified model first, defaulting to `gpt-6-luna` if none is provided.
  - If `sesiGuide` is set to true, SESI references will be included in the prompt engineering process.
  - If generation fails, the original prompt text will be returned.
  - If `config` is set to true, the returned result will include configuration details and the cost of the request.
  - If `config` is set to false, only the improved prompt string will be returned.
*/
export fn improvePrompt(promptText: string, maxTokens: number = 1024, sesiGuide: bool = false, modelName, config = false) -> any {
    if !modelName { modelName = "gpt-6-luna" }
    prompt promptEngineer {"You are an experienced prompt engineer. You are well versed in creating effective and detailed prompts while preserving the exact intent."}
    if sesiGuide { promptEngineer = "# SESI REFERENCES:\n" + _ + "\n" + promptEngineer }
    prompt improve {"Enhance the following prompt: "promptText"\nReturn only the improved prompt without any additional explanations or comments."}
    let resp = ""
    try {
        resp = track_model(improve, {
                model_name: modelName,
                system: promptEngineer,
                thinking: "medium",
                max_tokens: maxTokens,
                response: "full"
            }
        )
    } catch (err) {
        TERM.error(err.message)
        return promptText
    }
    show "Time taken:" resp.duration
    if config {
        return {
            configuration: resp.config_used,
            original_prompt: promptText,
            improved_prompt: resp.response,
            cost: resp.cost,
            duration: resp.duration,
            complete_log: resp
        }
    }
    return resp.response
}

/**
  Generates metadata for the provided image(s) using an AI model.

  Parameters:
  - imageRef: A reference to the image or an array of images for which metadata should be generated.
  - save: Optional. If true, the generated metadata will be saved (default true).
  - config: Optional. If true, the response will include configuration and cost details (default false).

  Returns:
  - A structured object containing the generated metadata for the provided image(s), including description, orientation, dominant colors, extracted text, and tags.
  - If the model fails to generate metadata, an error message will be returned.

  Example:
  ```sesi
  let metadata = getMetadata("image.png")
  show "Generated metadata:" metadata
  ```

  Notes:
  - The function attempts to use the `gpt-6-luna` model first. If it fails, it falls back to the `gemini-3.5-flash-lite` model.
  - The metadata includes a concise description of the subject, estimated aspect ratio or framing orientation, dominant colors, any visible OCR text, and up to 5 relevant descriptive tags.
  - Ensure that the image file(s) exist and are accessible to avoid errors.
  - If 'save' is true, the generated metadata will be saved to a report object.
  - If 'config' is true, the report object will also include configuration, cost, and duration details.
*/
export fn getMetadata(imageRef: array, save = true, config = false) -> object? | string {
    let meta = ""
    prompt metadata {"You are an experienced Image Analyst specialized in analyzing images and generating detailed metadata describing their contents.
Analyze this image thoroughly.
Extract:
  1. A concise description of the subject.
  2. Estimated aspect ratio or framing orientation.
  3. Dominant colors in hex or color names.
  4. Any visible OCR text.
  5. Up to 5 relevant descriptive tags.
    "}
    let schema = {
            description: "string",
            orientation: "string",
            dominantColors: "array",
            extractedText: "string",
            tags: "array"
        }
    try {
        meta = track_structured_model("Proceed.",
            schema,
            {
                model_name: "gpt-6-luna",
                system: metadata,
                images: imageRef,
                max_tokens: 1024,
                response: "full"
            }
        )
    } catch (e) {
        TERM.warning(e.message)
        TERM.warning("Retrying with a more capable model...")
        meta = track_structured_model("Proceed.",
            schema,
            {
                model_name: "gemini-3.5-flash-lite",
                system: metadata,
                images: imageRef,
                max_tokens: 1024,
                response: "full"
            }
        )
    }
    if meta.response | is_null { raise_error("MetadataError", "An error occurred while generating metadata for the image:" + meta) }
    if meta.response == "" { raise_error("MetadataError", "Model response came back empty, make sure the image file(s) exists.") }
    show "Time taken:" meta.duration
    let ext = get_ext(imageRef)
    let report = {
      file_path: imageRef,
      extension: ext,
      analysis_time: formattedTime(),
      description: meta.response["description"],
      orientation: meta.response["orientation"],
      dominant_colors: meta.response["dominantColors"],
      extracted_text: meta.response["extractedText"],
      tags: meta.response["tags"]
    }
    if save {
        imageRef = imageRef | swap("." + ext, "")
        if config {
            report.configuration = meta.config_used
            report.duration = meta.duration
            report.cost = meta.cost
            report.complete_log = meta
        }
        show Safe.json(imageRef + "_metadata", report)
    }
    if config {
        return {
            configuration: meta.config_used,
            metadata: report,
            cost: meta.cost,
            duration: meta.duration,
            complete_log: meta
        }
    }
    return meta.response
}

/**
  Generates source code in a specified programming language based on a user prompt.

  Parameters:
  - modelName: The name of the model to use for code generation (default is "gpt-6.1-terra").
  - promptText: Description or requirements of the code to generate.
  - language: The target programming language (default is "JavaScript").
  - config: Boolean flag indicating whether to return detailed configuration and cost information (default is false).

  Returns:
  - A string containing the generated code, or an object with detailed configuration and cost information if `config` is true.

  Example:
  ```sesi
  let code = genCode("gemini-4-argon", "Create a binary search tree", "Python")
  show code
  ```

  Notes:
  - The generated code will be in the specified programming language.
  - Ensure the model name is correct and available.
  - If `config` is set to true, the function will return an object containing the configuration used, the original prompt, the target language, the generated script, and the associated cost and duration.
*/
export fn genCode(modelName = "gpt-6.1-terra", promptText: string, language: string = "JavaScript", config = false) -> any {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating code based on user input."}
    if language == "Sesi" || language == "sesi" { sys = "# SESI LANGUAGE REFERENCE:\n" + _ + "\n" + sys }
    prompt makeCode {"Generate code in "language" for the following prompt: "promptText"\nReturn only the code without any additional explanations or comments."}
    let resp = ""
    if modelName == "" { modelName = "gpt-6.1-terra" }
    try {
        resp = track_model(makeCode, {
                model_name: modelName,
                system: sys,
                thinking: "medium",
                max_tokens: 15000,
                response: "full"
            }
        )
    } catch (err) {
        TERM.error(err.message)
        raise_error("GenerationError", "Error generating code: " + err.message)
    }
    let code = resp.response | cleanAIResponse
    if code == "" { raise_error("GenerationError", "Generated code is empty") }
    if code | is_null { raise_error("GenerationError", "An unexpected error occurred: " + resp) }
    show "Time taken:" resp.duration
    if config {
        return {
            configuration: resp.config_used,
            request: promptText,
            language: language,
            script: code,
            cost: resp.cost,
            duration: resp.duration,
            complete_log: resp
        }
    }
    return code
}

/**
  Generates an image from a text prompt and saves it to disk.

  Parameters:
  - promptText: Text prompt describing the image to generate.
  - size: Resolution or size specification (default "1K").
  - ratio: Aspect ratio (default "1:1").
  - filename: Base filename for saving the output (default "generated_image").
  - ext: File extension (default "png").
  - config: Boolean indicating whether to return detailed configuration and cost information (default false).
  - raw_data: Boolean indicating whether to return raw image data in base64 format (default false).

  Returns:
  - Either: 
    - A string representing the final saved file path.
    - An object containing detailed configuration and cost information if `config` is true.
    - An object containing raw image data in base64 format if `raw_data` is true.

  Example:
  ```sesi
  let generated = genImage("Times Square at night", "1K", "1:1", "times_square", "png", true, false)
  write_file("times_square.png.json", to_json(generated))
  ```

  Notes:
  - Uses `gemini-3-flash-preview` for prompt enhancement and `gemini-3.1-flash-image` for image generation.
  - The `config` parameter allows retrieval of detailed generation metadata, including the raw image data in base64 format.
  - The `raw_data` parameter allows retrieval of the raw image data in base64 format.
*/
export fn genImage(promptText: string, size: string = "1K", ratio: string = "1:1", filename: string = "generated_image", ext: string = "png", config = false, raw_data = false) -> any {
    if ratio == "1:1" { ratio = "square"}
    if ratio == "16:9" { ratio = "landscape"}
    if ratio == "9:16" { ratio = "portrait"}
    if ratio == "4:3" { ratio = "wide"}
    if ratio == "3:4" { ratio = "standard"}
    else {
        TERM.warning("Unknown ratio specified. Defaulting to 1:1.")
        ratio = "square"
    }
    prompt promptEngineer {"You are an experienced prompt engineer. You transform user input into a detailed and descriptive prompt for image generation. Return only ONE prompt without any additional explanations or comments."}
    let imgPrompt = track_model(promptText, {
            model_name: "gemini-3-flash-preview",
            system: promptEngineer,
            thinking: "medium",
            max_tokens: 1024
        }
    )
    let good2go = imgPrompt.response
    if good2go == "" || good2go == null { good2go = promptText }
    TERM.info("Generating image with the following prompt: " + good2go)
    let imgResponse = track_image(good2go | trim, {
            model_name: "gemini-3.1-flash-image",
            size: size,
            ratio: ratio,
            thinking: "medium",
            response: "full"
        }
    )

    if ext == "" || ext == "png" { write_image(filename + ".png", imgResponse.image_data) }
    else { write_image(filename + "." + ext, imgResponse.image_data) }
    let out = filename + "." + ext

    TERM.success("Image generated and saved as '" + out + "'")
    show "Time taken:" imgResponse.duration
    if config {
        return {
            configuration: imgResponse.config_used,
            original_request: promptText,
            enhanced_request: imgPrompt.response,
            cost: imgResponse.cost,
            duration: imgResponse.duration,
            filename: out,
            extension: ext,
            base64: imgResponse.image_data,
            complete_log: imgResponse
        }
    }
    if raw_data {
        return {
            filename: out,
            base64: imgResponse.image_data
        }
    }
    return out
}

/**
  Generates an image quickly using lighter models and saves it to disk.

  Parameters:
  - promptText: Text prompt describing the image.
  - ratio: Aspect ratio (default "1:1").
  - filename: Base filename for saving (default "generated_image").
  - ext: File extension (default "png").
  - config: Boolean indicating if configuration details should be returned (default false).
