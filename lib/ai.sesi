fn parseHTML(markup: string) -> object {
    let voidTags = ["area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr"]
    let stack = []
    let token = ""
    let quote = ""
    let insideTag = false
    let sawHTML = false
    let rawTag = ""
    let rawToken = ""

    for char in split(markup, "") {
        if rawTag != "" {
            if char == "<" {
                rawToken = "<"
            } else if rawToken != "" {
                rawToken = rawToken + char
                if char == ">" {
                    let rawTagName = regex("^</?\\s*|[\\s/>].*$", rawToken, {"mode": "replace", "replacement": "", "flags": "g"}) | to_lower
                    if (rawToken | starts_with("</")) && rawTagName == rawTag {
                        if (stack | length) == 0 || stack[(stack | length) - 1] != rawTag {
                            return {"status": "failed", "error": "Mismatched closing tag: " + rawTag}
                        }
                        stack | pop
                        rawTag = ""
                    }
                    rawToken = ""
                }
            }
        } else if insideTag {
            token = token + char
            if quote != "" {
                if char == quote {
                    quote = ""
                }
            } else if char == "\"" || char == "'" {
                quote = char
            } else if char == ">" {
                insideTag = false
                if !(token | starts_with("<!--")) && !(token | starts_with("<!")) && !(token | starts_with("<?")) {
                    let tagName = regex("^</?\\s*|[\\s/>].*$", token, {"mode": "replace", "replacement": "", "flags": "g"}) | to_lower
                    if token | starts_with("</") {
                        if (stack | length) == 0 || stack[(stack | length) - 1] != tagName {
                            return {"status": "failed", "error": "Mismatched closing tag: " + tagName}
                        }
                        stack | pop
                    } else if !(voidTags | includes(tagName)) && !(token | ends_with("/>")) {
                        stack | push(tagName)
                        if tagName == "html" {
                            sawHTML = true
                        }
                        if tagName == "script" || tagName == "style" {
                            rawTag = tagName
                        }
                    }
                }
                token = ""
            }
        } else if char == "<" {
            insideTag = true
            token = "<"
        }
    }

    if insideTag { return {"status": "failed", "error": "Unterminated HTML tag"} }
    if (stack | length) > 0 { return {"status": "failed", "error": "Unclosed HTML tag: " + stack[(stack | length) - 1]} }
    if !sawHTML { return {"status": "failed", "error": "Missing html document root"} } 

    return {"status": "passed", "error": ""} 
}

let generationRunId = str(random()) + "_" + formattedTime()
let timestamp = formattedTime()

/**
  Record the result of a website-generation step.

  Parameters:
  - stepName: Human-readable name of the generation step.
  - stepNumber: Numeric order of the step within the generation process.
  - modelName: Name of the AI model used for the step.
  - thinkingLevel: Reasoning level supplied to the model.
  - systemPrompt: System instruction provided to the model.
  - input: Prompt or source content sent to the model.
  - output: Generated output or error information to record.
  - expectsHTML: Whether the output should be validated as an HTML document. Defaultsto `true`.
  - executionStatus: Status of the step, such as `"completed"` or `"failed"`. Defaults to `"completed"`.

  Returns:
  - None.

  Example:
  ```sesi
  logSteps("draft", 1, "gemini-3-flash-preview", "medium", systemPrompt, userPrompt, htmlOutput)
  ```

  Notes:
  - Creates the `site_generation_logs` directory when necessary.
  - Stores one JSON log entry per generation step.
  - HTML output is cleaned and validated when `expectsHTML` is `true`.
  - Validation status is marked as failed when the output is empty, execution fails, or HTML parsing fails.
*/
fn logSteps(stepName: string, stepNumber: number, modelName: string, thinkingLevel: string, systemPrompt: string, input: string, output: any, expectsHTML: bool = true, executionStatus: string = "completed") {
    make_dir("site_generation_logs")
    let outputText = ""
    if type(output) == "string" {
        outputText = output
    } else {
        outputText = to_json(output)
    }
    let parseStatus = "not_applicable"
    let parseError = ""
    let validationStatus = "passed"


    if executionStatus != "completed" || (outputText | length) == 0 { validationStatus = "failed" }
    if expectsHTML {
        outputText = outputText | cleanAIResponse
        let parseResult = parseHTML(outputText)
        parseStatus = parseResult.status
        parseError = parseResult.error
        if parseStatus == "failed" { validationStatus = "failed" }
    }

    // Log the generation step details to a log file for future reference and debugging.
    let logEntry = {
        run_id: generationRunId,
        "model": modelName,
        thinking_level: thinkingLevel,
        step: stepName,
        step_number: stepNumber,
        system_character_count: systemPrompt | length,
        input_character_count: (systemPrompt | length) + (input | length),
        output_character_count: outputText | length,
        timestamp: getDate("name") + " at " + localTime(null, "en-US", "detailed"),
        execution_status: executionStatus,
        validation_status: validationStatus,
        html_parse_status: parseStatus,
        html_parse_error: parseError,
        output: outputText
    }
    append_file("site_generation_logs/" + "step" + stepNumber + "_at_" + timestamp + ".log", to_json(logEntry) + "\n")
}

/**
  Execute one AI website-generation step with error handling, logging, and optional HTML validation.

  Parameters:
  - stepName: Human-readable name of the generation step.
  - stepNumber: Numeric order of the step within the generation process.
  - modelName: Name of the AI model to call.
  - thinkingLevel: Reasoning level passed to the model.
  - systemPrompt: System instruction for the model.
  - input: Prompt or source content supplied to the model.
  - expectsHTML: Whether the returned content should be checked as HTML. Defaults to `true`.

  Returns:
  - A string containing the cleaned model output.

  Example:
  ```sesi
  let res = runModelStep("draft", 1, "gemini-3-flash-preview", "medium", sysPrompt, promptInput)
  show res
  ```

  Notes:
  - The response is passed through `cleanAIResponse`.
  - Successful executions are recorded with `logSteps`.
  - Model failures are logged and rethrown as a `GenerationStepFailed` error.
*/
fn runModelStep(stepName: string, stepNumber: number, modelName: string, thinkingLevel: string, systemPrompt: string, input: string, expectsHTML: bool = true) -> string {
    try {
        // Run the AI model with the specified parameters and capture the output.
        let output = track_model(input, {
                model_name: modelName,
                system: systemPrompt,
                thinking: thinkingLevel,
                max_tokens: 18500,
                response: "full"
            }
        )
        logSteps(stepName, stepNumber, modelName, thinkingLevel, systemPrompt, input, output.response | cleanAIResponse, expectsHTML)
        show Safe.json("drafts/" + stepName + "_" + stepNumber + "_" + formattedTime() + "_log", output | to_json)
        return output.response | cleanAIResponse
    } catch (error) {
        // Handle any errors that occur during the model execution.
        // Convert the error to a JSON string for logging and reporting.
        let errorText = to_json(error)
        logSteps(stepName, stepNumber, modelName, thinkingLevel, systemPrompt, input, errorText, false, "failed")
        show Safe.json("drafts/" + stepName + "_" + stepNumber + "_" + formattedTime() + "_log", errorText)
        raise_error("GenerationStepFailed", errorText)
        return ""
    }
}

/**
  Generates a fully structured, styled, and interactive HTML website through multi-step refinement.

  Parameters:
  - promptText: Initial prompt describing the desired website.
  - purpose: Specific purpose or goal of the website (default empty).
  - minify: Whether to minify the final HTML output (default false).

  Returns:
  - A string containing the final HTML/CSS/JS website code.

  Example:
  ```sesi
  let site = genHTML("Portfolio website", "Showcase my projects", true)
  write_file("index.html", site)
  ```

  Notes:
  - Generation Steps:
    1. Draft the initial website structure and content.
    2. Apply styling and visual design.
    3. Accessibility and semantic HTML validation.
    4. Optimize the website for performance and responsiveness.
    5. Enhance the website with additional features and improvements.
    6. Final review and quality assurance of the website.
    7. If necessary, iterate on previous steps to refine and improve the website based on feedback and evaluation.
    8. If set to true, minify and prepare the final version of the website for deployment.
*/
export fn genHTML(promptText: string, purpose: string = "", minify: bool = false) -> string {
    let dir = "drafts/"; make_dir(dir)
    let filename = promptText | trunc(20) | swap(" ", "_") | to_lower | trim

    // Save an intermediate HTML generation result to the drafts directory.
    //
    // Parameters:
    // - filename: Base name used to construct the draft output path.
    // - content: HTML content to save.
    // - stage: Numeric generation stage associated with the draft.
    // - step: Human-readable name of the generation step.
    //
    // Returns:
    // - `true` when the draft is saved successfully; otherwise, an error message.
    //
    // Notes:
    // - The output filename includes the stage, normalized step name, and source filename.
    // - File-writing errors are caught and reported through the terminal helper.
    fn saveDraft(filename: string, content: string, stage: number = 0, step: string) -> any {
        filename = dir + "step" + (stage | str) + "_" + (to_lower(step) | trim) + "_for_" + filename + "_draft.html"
        try {
            write_file(filename, content)
            TERM.success("Saved step " + stage + ": " + step)
            return true
        } catch (e) {
            TERM.error("Failed to save " + step + " draft at step " + stage)
            return e.message
        }
    }

    // Improve the initial prompt and purpose for better website generation.
    let improved = improvePrompt(
        "Website prompt: " + promptText + "
        Website purpose: " + purpose + "
        # IMPORTANT: Return the improved prompt and purpose as a JSON object with the fields 'prompt' and 'purpose'."
    ) | from_json
    promptText = improved["prompt"]
    purpose = improved["purpose"]
    // Define system prompts for different aspects of website generation
    prompt sys1 {"You are a product-oriented frontend architect."}
    prompt sys2 {"You are a senior UI/visual designer specializing in production CSS."}
    prompt sys3 {"You are an HTML semantics and accessibility specialist."}
    prompt sys4 {"You are a responsive frontend engineer specializing in mobile layouts."}
    prompt sys5 {"You are a senior vanilla JavaScript engineer focused on robust UI behavior."}
    prompt eval {"You are a frontend QA engineer. Find defects. Do not redesign."}
    prompt makeSite {"Draft a website for the following purpose: "purpose" and based on the following prompt: "promptText"
    Return only the HTML/CSS template code for the website without any additional explanations or comments."}

    // Generate the website in multiple steps, including drafting, styling, optimizing, enhancing interactivity, evaluating for defects, fixing defects if found, and minifying the final output.
    let logStep1 = "Step 1: Drafting the initial website structure and content based on the prompt...\n"
    TERM.info(logStep1)
    let step1 = runModelStep("draft", 1, "gpt-6.1-terra", "medium", sys1, makeSite)
    saveDraft(filename, step1, 1, "Initial Draft")

    let logStep2 = "Step 2: Improving the CSS styling and JS logic...\n"
    TERM.info(logStep2)
    prompt step2Input {"Improve the CSS styling, enhance the layout, and ensure JS is functional:
    " step1 "
    Return only the improved HTML/CSS code without any additional explanations or comments."}

    let step2 = runModelStep("styling", 2, "gemini-3.8-flash", "medium", sys2, step2Input)
    saveDraft(filename, step2, 2, "CSS Enhancement")

    let logStep3 = "Step 3: Ensuring proper semantic tags and accessibility...\n"
    TERM.info(logStep3)
    prompt step3Input {"Ensure proper semantic tags without altering the existing design and functionality:
    " step2 "
    Return only the optimized HTML/CSS code without any additional explanations or comments. DO NOT REMOVE ANY EXISTING FUNCTIONALITY, CONTENT, OR DESIGN ELEMENTS."}

    let step3 = runModelStep("optimization", 3, "gpt-6.1-sol", "medium", sys3, step3Input)
    saveDraft(filename, step3, 3, "Semantics and Accessibility")

    let logStep4 = "Step 4: Ensuring the website is responsive and mobile-friendly...\n"
    TERM.info(logStep4)
    prompt step4Input {"Ensure the website is responsive and mobile-friendly without altering the existing design and functionality:
    " step3 "
    Return only the responsive and mobile-friendly HTML/CSS code without any additional explanations or comments."}

    let step4 = runModelStep("responsive", 4, "gpt-6.1-sol", "medium", sys4, step4Input)
    saveDraft(filename, step4, 4, "Responsive Check")

    let finalLog = "Final Step: Adding or enhancing present JavaScript functionality and interactivity...\n"
    TERM.info(finalLog)
    prompt finalInput {"Add or enhance present JavaScript functionality and interactive elements:
    " step4 "
    Return only the final self-contained HTML/CSS/JS code for the website, without any additional explanations or comments."}

    let finalStep = runModelStep("interactivity", 5, "gemini-3.8-flash", "medium", sys5, finalInput)
    saveDraft(filename, finalStep, 5, "JS Functionality")

    let evalLog = "Evaluation Step: Reviewing the final website for any defects, issues, or areas of improvement...\n"
    TERM.info(evalLog)
    prompt evalInput {"Original purpose:
    " purpose "

    Original website request:
    " promptText "

    Inspect this implementation, do not rewrite it.

    Find:
    - broken functionality
    - semantic problems
    - accessibility problems
    - responsive issues
    - JS bugs
    - violations of original requirements

    Return a JSON object of the following structure. Use an empty string for every field with no defect:
    {
        \"broken\": string,
        \"semantic\": string,
        \"accessibility\": string,
        \"responsive\": string,
        \"js\": string,
        \"requirements\": string
    }
    " finalStep}

    // Run the evaluation step to review the final website for defects and issues.
    let evalRaw = runModelStep("evaluation", 6, "gemini-3.5-flash-lite", "high", eval, evalInput, false)
    // Parse the evaluation output into a structured format.
    let evalStep = {}
    try {
        evalStep = structured_output({broken: string, semantic: string, accessibility: string, responsive: string, js: string, requirements: string})(evalRaw)
    } catch (error) {
        let errorText = to_json(error)
        logSteps("evaluation_parse", 6, "gemini-3.5-flash-lite", "high", eval, evalInput, errorText, false, "failed")
        raise_error("EvaluationParseFailed", errorText)
    }

    // Check if any defects were found and handle accordingly.
    if evalStep.broken == "" && evalStep.semantic == "" && evalStep.accessibility == "" && evalStep.responsive == "" && evalStep.js == "" && evalStep.requirements == "" {
        TERM.success("No defects found in the final website implementation.")
    } else {
        TERM.warning("Detected errors, patching before final delivery...")
        prompt defectFixer {"You are a professional and organized software developer. You are tasked with fixing the following defects in this HTML code."}
        prompt fixedInput {"Bugs to patch:
        " to_json(evalStep) "
        Code to fix:
        " finalStep "
        Return only the fixed HTML/CSS/JS code without any additional explanations or commentse."}

        let fixedStep = runModelStep("defect_fix", 7, "gpt-6.1-sol", "medium", defectFixer, fixedInput)
        saveDraft(filename, fixedStep, 7, "Defect Revision")
        finalStep = fixedStep
    }

    if minify {
        let minifyLog = "Minification Step: Minifying the final HTML for optimal performance...\n"
        TERM.info(minifyLog)
        let minifiedStep = minify_html(finalStep)
        saveDraft(filename, minifiedStep, 8, "HTML Minification")
        finalStep = minifiedStep
    }

    TERM.success("Website generated!")
    return finalStep
}

/**
  Generates an HTML website quickly with a fast-track pass and automated defect patching.

  Parameters:
  - promptText: Prompt describing the website.
  - purpose: Purpose of the website (default empty).
  - minify: Whether to minify the final output (default false).

  Returns:
  - A string containing the resulting HTML code or an error message.

  Example:
  ```sesi
  let html = genHTMLFast("Landing page", "Sell widgets", true)
  ```

  Notes:
  - Generation Steps:
    1. Improve the prompt and purpose for better results.
    2. Generate the initial HTML based on the improved prompt and purpose.
    3. Evaluate the generated HTML for defects.
    4. Fix any detected defects.
    5. Minify the final HTML if the minify flag is set.
*/
export fn genHTMLFast(promptText: string, purpose: string = "", minify: bool = false) -> string {
    let dir = "drafts/"; make_dir(dir)
    let filename = promptText | trunc(20) | swap(" ", "_") | to_lower | trim
    filename = dir + filename + "_draft.html"
    prompt sys1 {"You are a product-oriented frontend architect."}
    prompt sys2 {"You are a senior UI/visual designer specializing in production CSS."}
    prompt evalSite {"You are a frontend QA engineer. Find defects. Do not redesign."}
    prompt makeSite {"Create a website for the following purpose: "purpose" and based on the following prompt: "promptText"
    Return only the HTML/CSS/JS code for the website without any additional explanations or comments."}
    prompt evalInput {"Original purpose:
    " purpose "

    Original website request:
    " promptText "

    Inspect this implementation, do not rewrite it.

    Find:
    - broken functionality
    - semantic problems
    - accessibility problems
    - responsive issues
    - JS bugs
    - violations of original requirements

    Return a JSON object of the following structure. Use an empty string for every field with no defect:
    {
        \"broken\": string,
        \"semantic\": string,
        \"accessibility\": string,
        \"responsive\": string,
        \"js\": string,
        \"requirements\": string
    }
    "}

    let pass1 = ""
    let review = ""
    let eval = ""
    let final = ""

    try {
        TERM.info("Enhancing prompt and purpose to best suit your needs...")
        let improved = improvePrompt(
            "Website prompt: " + promptText + "
            Website purpose: " + purpose + "
            # IMPORTANT: Return the improved prompt and purpose as a JSON object with the fields 'prompt' and 'purpose'."
        ) | from_json
        promptText = improved["prompt"]
        purpose = improved["purpose"]
        TERM.info("Generating HTML with prompt:
" + promptText + "
========
with the purpose to:
========
" + purpose + "
...")
        try {
            pass1 = track_model(makeSite, {
                    model_name: "gpt-6.1-terra",
                    system: sys1,
                    thinking: "medium"
                }
            )
        } catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            pass1 = track_model(makeSite, {
                    model_name: "gemini-3.6-flash",
                    system: sys1,
                    thinking: "medium"
                }
            )
        }
        TERM.info("Enhancing CSS and making sure site is functional...\n")
        write_file(filename, pass1)
        try {
            review = track_model("Enhance the following CSS and make sure the JS logic is functional rather than placeholder:\n" + cleanAIResponse(pass1.response) + "\n\nReturn only the complete code for the website without any additional explanations or comments.", {
                    model_name: "gpt-6.1-terra",
                    system: sys2,
                    thinking: "medium"
                }
            )
        }
        catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            review = track_model("Enhance the following CSS and make sure the JS logic is functional rather than placeholder:\n" + cleanAIResponse(pass1.response) + "\n\nReturn only the complete code for the website without any additional explanations or comments.", {
                    model_name: "gemini-3.8-flash",
                    system: sys2,
                    thinking: "medium"
                }
            )
        }
        try {
            eval = track_model(evalInput + "Implementation:\n" + cleanAIResponse(pass1.response), {
                    model_name: "gpt-6-luna",
                    system: evalSite,
                    thinking: "medium"
                }
            )
        } catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            eval = track_model(evalInput + "Implementation:\n" + cleanAIResponse(pass1.response), {
                    model_name: "gemini-3.5-flash-lite",
                    system: evalSite,
                    thinking: "medium"
                }
            )
        }
        if eval.response.broken != "" || eval.response.semantic != "" || eval.response.accessibility != "" || eval.response.responsive != "" || eval.response.js != "" || eval.response.requirements != "" {
            TERM.warning("Detected errors, patching before final delivery...")
            prompt defectFixer {"You are a professional and organized software developer. You are tasked with fixing the following defects in this HTML code. Preserve semantics, accessibility, word usage/text, and responsive design. Do not redesign the website."}
            prompt fixedInput {"Bugs to patch:
            " to_json(eval.response | cleanAIResponse) "
            Code to fix:
            " cleanAIResponse(review.response) "
            Return only the complete fixed code without any additional explanations or comments."}
            final = track_model(fixedInput, {
                    model_name: "gpt-6.1-sol",
                    system: defectFixer,
                    thinking: "medium"
                }
            )
        } else {
            TERM.success("No defects found in the final website implementation.")
        }
    } catch (e) {
        TERM.error(e.message)
        return "Error generating HTML: " + e.message
    }
    TERM.success("Successfully generated HTML!")

    if minify {
        return minify_html(final)
    }
    Safe.json((promptText | to_lower | trim | swap(" ", "_")) + "_log_" + formattedTime(), {
        request: promptText,
        purpose: purpose,
        draft_1: pass1,
        draft_2: review,
        evaluation: eval,
        final: final
    })
    return final.response | cleanAIResponse
}

/**
  Generates an HTML website quickly using reference files for context and guidance.

  Parameters:
   - promptText: The main prompt describing the website to generate.
   - purpose: The purpose of the website.
   - filenames: An array of reference file paths to include in the generation.
   - minify: Whether to minify the final HTML output (default: true).
  Returns:
  - A string containing the generated HTML code or an error message.

  Example:
  ```sesi
  let site = genHTMLFastWithRef("Portfolio", "Showcase work", ["style_guide.md"], true)
  ```

  Notes:
  - Incorporates file contents as reference context within system prompts.
*/
export fn genHTMLFastWithRef(promptText: string, purpose: string, filenames: array<string>, minify: bool = true) -> string {
    let contents = {}
    if filenames != null {
        for filename in filenames {
            let ext = get_ext(filename)
            contents[filename | swap("." + ext, "")] = read_file(filename)
            TERM.info("Adding reference from file: " + filename)
        }
    } else if !(filenames[0] | ends_with(".md")) {
        for file in filenames {
           contents = file
        }
    } else {
        return "Error: No reference files provided."
    }
    let dir = "drafts/"; make_dir(dir)
    let filename = promptText | trunc(20) | swap(" ", "_") | to_lower | trim
    filename = dir + filename + "_draft.html"
    prompt sys1 {"
    # REFERENCE:
    "contents"
    You are a product-oriented frontend architect."}
    prompt sys2 {"
    # REFERENCE:
    "contents"
    You are a senior UI/visual designer specializing in production CSS."}
    prompt makeSite {"Create a website for the following purpose: "purpose" and based on the following prompt: "promptText"

    # REFERENCE:
    "contents"

    Return only the HTML/CSS/JS code for the website without any additional explanations or comments."}
    prompt evalSite {"
    # REFERENCE:
    "contents"
    You are a frontend QA engineer. Find defects. Do not redesign."}
    prompt evalInput {"Original purpose:
    " purpose "

    Original website request:
    " promptText "

    Inspect this implementation, do not rewrite it.

    Find:
    - broken functionality
    - semantic problems
    - accessibility problems
    - responsive issues
    - JS bugs
    - violations of original requirements

    Return a JSON object of the following structure. Use an empty string for every field with no defect:
    {
        \"broken\": string,
        \"semantic\": string,
        \"accessibility\": string,
        \"responsive\": string,
        \"js\": string,
        \"requirements\": string
    }
    "}

    let pass1 = ""
    let review = ""
    let eval = ""
    let final = ""

    try {
        TERM.info("Enhancing prompt and purpose to best suit your needs...")
        let improved = improvePrompt(
            "Website prompt: " + promptText + "
            Website purpose: " + purpose + "
            # IMPORTANT: Return the improved prompt and purpose as a JSON object with the fields 'prompt' and 'purpose'."
        ) | from_json
        promptText = improved["prompt"]
        purpose = improved["purpose"]
        TERM.info("Generating HTML with prompt:
" + promptText + "
========
with the purpose to:
========
" + purpose + "
...
")
        try {
            pass1 = track_model(makeSite, {
                    model_name: "gpt-6.1-terra",
                    system: sys1,
                    thinking: "medium"
                }
            )
        } catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            pass1 = track_model(makeSite, {
                    model_name: "gemini-3.6-flash",
                    system: sys1,
                    thinking: "medium"
                }
            )
        }
        TERM.info("Enhancing CSS and making sure site is functional...\n")
        write_file(filename, pass1)
        try {
            review = track_model("Enhance the following CSS and make sure the JS logic is functional rather than placeholder:\n" + cleanAIResponse(pass1.response) + "\n\nReturn only the complete code for the website without any additional explanations or comments.", {
                    model_name: "gpt-6.1-terra",
                    system: sys2,
                    thinking: "medium"
                }
            )
        }
        catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            review = track_model("Enhance the following CSS and make sure the JS logic is functional rather than placeholder:\n" + cleanAIResponse(pass1.response) + "\n\nReturn only the complete code for the website without any additional explanations or comments.", {
                    model_name: "gemini-3.8-flash",
                    system: sys2,
                    thinking: "medium"
                }
            )
        }
        try {
            eval = track_model(evalInput + "Implementation:\n" + cleanAIResponse(pass1.response), {
                    model_name: "gpt-6-luna",
                    system: evalSite,
                    thinking: "medium"
                }
            )
        } catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            eval = track_model(evalInput + "Implementation:\n" + cleanAIResponse(pass1.response), {
                    model_name: "gemini-3.5-flash-lite",
                    system: evalSite,
                    thinking: "medium"
                }
            )
        }
        if eval.response.broken != "" || eval.response.semantic != "" || eval.response.accessibility != "" || eval.response.responsive != "" || eval.response.js != "" || eval.response.requirements != "" {
            TERM.warning("Detected errors, patching before final delivery...")
            prompt defectFixer {"You are a professional and organized software developer. You are tasked with fixing the following defects in this HTML code. Preserve semantics, accessibility, word usage/text, and responsive design. Do not redesign the website."}
            prompt fixedInput {"Bugs to patch:
            " to_json(eval.response | cleanAIResponse) "
            Code to fix:
            " cleanAIResponse(review.response) "
            Return only the complete fixed code without any additional explanations or comments."}
            final = track_model(fixedInput, {
                    model_name: "gpt-6.1-sol",
                    system: defectFixer,
                    thinking: "medium"
                }
            )
        } else {
            TERM.success("No defects found in the final website implementation.")
        }
    } catch (e) {
        TERM.error(e.message)
        return "Error generating HTML: " + e.message
    }
    TERM.success("Successfully generated HTML!")

    if minify {
        return minify_html(final)
    }
    Safe.json((promptText | to_lower | trim | swap(" ", "_")) + "_log_" + formattedTime(), {
        request: promptText,
        purpose: purpose,
        draft_1: pass1,
        draft_2: review,
        evaluation: eval,
        final: final
    })
    return final.response | cleanAIResponse
}

/**
  Generates a comprehensive, multi-step HTML website using reference files for contextual guidance.

  Parameters:
  - promptText: Prompt describing the website.
  - purpose: Purpose of the website.
  - filenames: Array of reference files.
  - minify: Whether to minify the final HTML (default true).

  Returns:
  - A string containing the final generated HTML website code.

  Example:
  ```sesi
  let site = genHTMLWithRef("Landing Page", "Lead gen", ["docs.md"], true)
  ```

  Notes:
  - Uses full iterative staging pipeline including drafting, styling, semantics, responsiveness, JS functionality, and evaluation with reference context.
*/
export fn genHTMLWithRef(promptText: string, purpose: string, filenames: array<string>, minify: bool = true) -> string {
    let contents = {}
    if filenames != null && (filenames[0] | ends_with(".md")) {
        for filename in filenames {
            let ext = get_ext(filename)
            contents[filename | swap("." + ext, "")] = read_file(filename)
            TERM.info("Adding reference from file: " + filename)
        }
    } else if !(filenames[0] | ends_with(".md")) {
        for file in filenames {
           contents = file
        }
    } else {
        return "Error: No reference files provided."
    }
    let dir = "drafts/"; make_dir(dir)
    let filename = promptText | trunc(20) | swap(" ", "_") | to_lower | trim

    // Save an intermediate HTML generation result to the drafts directory.
    //
    // Parameters:
    // - filename: Base name used to construct the draft output path.
    // - content: HTML content to save.
    // - stage: Numeric generation stage associated with the draft.
    // - step: Human-readable name of the generation step.
    //
    // Returns:
    // - `true` when the draft is saved successfully; otherwise, an error message.
    //
    // Notes:
    // - The output filename includes the stage, normalized step name, and source filename.
    // - File-writing errors are caught and reported through the terminal helper.
    fn saveDraft(filename: string, content: string, stage: number = 0, step: string) -> any {
        filename = dir + "step" + (stage | str) + "_" + (to_lower(step) | swap(" ", "_") | trim) + "_for_" + filename + "_draft.html"
        try {
            write_file(filename, content)
            TERM.success("Saved step " + stage + ": " + step)
            return true
        } catch (e) {
            TERM.error("Failed to save " + step + " draft at step " + stage)
            return e.message
        }
    }

    let improved = improvePrompt(
        "Website prompt: " + promptText + "
        Website purpose: " + purpose + "
        # IMPORTANT: Return the improved prompt and purpose as a JSON object with the fields 'prompt' and 'purpose'."
    ) | from_json
    promptText = improved["prompt"]
    purpose = improved["purpose"]
    // Define system prompts for different aspects of website generation
    prompt sys1 {"
    # REFERENCE:
    "contents"
    You are a product-oriented frontend architect."}
    prompt sys2 {"
    # REFERENCE:
    "contents"
    You are a senior UI/visual designer specializing in production CSS."}
    prompt sys3 {"
    # REFERENCE:
    "contents"
    You are an HTML semantics and accessibility specialist."}
    prompt sys4 {"
    # REFERENCE:
    "contents"
    You are a responsive frontend engineer specializing in mobile layouts."}
    prompt sys5 {"
    # REFERENCE:
    "contents"
    You are a senior vanilla JavaScript engineer focused on robust UI behavior."}
    prompt eval {"
    # REFERENCE:
    "contents"
    You are a frontend QA engineer. Find defects. Do not redesign."}
    prompt makeSite {"Draft a website for the following purpose: "purpose" and based on the following prompt: "promptText"

    # REFERENCE:
    "contents"

    Return only the HTML/CSS template code for the website without any additional explanations or comments."}

    // Generate the website in multiple steps, including drafting, styling, optimizing, enhancing interactivity, evaluating for defects, fixing defects if found, and minifying the final output.
    let logStep1 = "Step 1: Drafting the initial website structure and content based on the prompt...\n"
    TERM.info(logStep1)
    let step1 = runModelStep("draft", 1, "gpt-6.1-terra", "medium", sys1, makeSite)
    saveDraft(filename, step1, 1, "Initial Draft")

    let logStep2 = "Step 2: Improving the CSS styling and JS logic...\n"
    TERM.info(logStep2)
    prompt step2Input {"Improve the CSS styling, enhance the layout, and ensure JS is functional:
    " step1 "
    Return only the improved HTML/CSS code without any additional explanations or comments."}

    let step2 = runModelStep("styling", 2, "gpt-6.1-sol", "medium", sys2, step2Input)
    saveDraft(filename, step2, 2, "CSS Enhancement")

    let logStep3 = "Step 3: Ensuring proper semantic tags...\n"
    TERM.info(logStep3)
    prompt step3Input {"Ensure proper semantic tags are applied without altering the existing design and functionality:
    " step2 "
    Return only the HTML/CSS code with the applied semantic tags without any additional explanations or comments. DO NOT REMOVE ANY EXISTING FUNCTIONALITY, CONTENT, OR DESIGN ELEMENTS."}

    let step3 = runModelStep("semantics", 3, "gemini-3.8-flash", "medium", sys3, step3Input)
    saveDraft(filename, step3, 3, "Semantics Tagging")

    let logStep4 = "Step 4: Ensuring the website is responsive and mobile-friendly...\n"
    TERM.info(logStep4)
    prompt step4Input {"Ensure the website is responsive and mobile-friendly without altering the existing design and functionality:
    " step3 "
    Return only the responsive and mobile-friendly HTML/CSS code without any additional explanations or comments."}

    let step4 = runModelStep("responsive", 4, "gpt-6.1-terra", "medium", sys4, step4Input)
    saveDraft(filename, step4, 4, "Responsive Check")

    let finalLog = "Final Step: Adding or enhancing present JavaScript functionality and interactivity...\n"
    TERM.info(finalLog)
    prompt finalInput {"Add or enhance present JavaScript functionality and interactive elements:
    " step4 "
    Return only the final self-contained HTML/CSS/JS code for the website, without any additional explanations or comments."}

    let finalStep = runModelStep("interactivity", 5, "gemini-3.8-flash", "medium", sys5, finalInput)
    saveDraft(filename, finalStep, 5, "JS Functionality")

    let evalLog = "Evaluation Step: Reviewing the final website for any defects, issues, or areas of improvement...\n"
    TERM.info(evalLog)
    prompt evalInput {"
    Original purpose:
    " purpose "

    Original website request:
    " promptText "

    Inspect this implementation, do not rewrite it.

    Find:
    - broken functionality
    - semantic problems
    - accessibility problems
    - responsive issues
    - JS bugs
    - violations of original requirements
    - introduced undocumented content or features

    Return a JSON object of the following structure. Use an empty string for every field with no defect:
    {
        \"broken\": string,
        \"semantic\": string,
        \"accessibility\": string,
        \"responsive\": string,
        \"js\": string,
        \"requirements\": string
    }
    " finalStep}

    // Run the evaluation step to check for defects in the final website implementation.
    let evalRaw = runModelStep("evaluation", 6, "gemini-3.5-flash-lite", "medium", eval, evalInput, false)
    // Parse the raw evaluation output into a structured JSON object.
    let evalStep = {}
    try {
        evalStep = structured_output({broken: string, semantic: string, accessibility: string, responsive: string, js: string, requirements: string})(evalRaw)
    } catch (error) {
        let errorText = to_json(error)
        logSteps("evaluation_parse", 6, "gemini-3.5-flash-lite", "medium", eval, evalInput, errorText, false, "failed")
        raise_error("EvaluationParseFailed", errorText)
    }

    if evalStep.broken == "" && evalStep.semantic == "" && evalStep.accessibility == "" && evalStep.responsive == "" && evalStep.js == "" && evalStep.requirements == "" {
        TERM.success("No defects found in the final website implementation.")
    } else {
        TERM.warning("Detected errors, patching before final delivery...")
        prompt defectFixer {"You are a professional and organized software developer. You are tasked with fixing the following defects in this HTML code."}
        prompt fixedInput {"Bugs to patch:
        " to_json(evalStep) "
        Code to fix:
        " finalStep "
        Return only the fixed HTML/CSS/JS code without any additional explanations or commentse."}

        let fixedStep = runModelStep("defect_fix", 7, "gpt-6.1-sol", "medium", defectFixer, fixedInput)
        saveDraft(filename, fixedStep, 7, "Defect Revision")
        finalStep = fixedStep
    }

    if minify {
        let minifyLog = "Minification Step: Minifying the final HTML for optimal performance...\n"
        TERM.info(minifyLog)
        let minifiedStep = minify_html(finalStep)
        saveDraft(filename, minifiedStep, 8, "HTML Minification")
        finalStep = minifiedStep
    }
    TERM.success("Website generated!")
    return finalStep
}

/**
  Generates a package.json file string for a Node.js project.

  Parameters:
  - name: Name of the project.
  - description: Brief description of the package.
  - author: The author of the project.
  - config: Optional boolean indicating whether to return detailed configuration and cost information. Defaults to false.

  Returns:
  - A string containing the generated package.json contents if `config` is false, otherwise an object with detailed configuration and cost information.

  Example:
  ```sesi
  let pkg = genPkgJSON("my-tool", "A CLI utility", "Alice")
  show pkg
  ```

  Notes:
  - Uses `gpt-6-luna` to enhance the description and format JSON, falling back to `gemini-3.5-flash-lite` if necessary.
*/
export fn genPkgJSON(name: string, description: string, author: string, config = false) -> any {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating a package.json file for a Node.js project."}
    prompt makePkgJSON {"Generate a package.json file for a Node.js project with the following details:
- Name: "name"
- Description: "description" <- Improve this description to be more detailed and informative, yet concise.
- Author: "author"
- License: MIT"}

    let generatedPkg = ""
    try {
        generatedPkg = track_model(makePkgJSON, {
                model_name: "gpt-6-luna",
                system: sys,
                max_tokens: 2048,
                response: "full"
            }
        )
    } catch (e) {
        TERM.warning(e.message)
        TERM.warning("Retrying with a more capable model...")
        generatedPkg = track_model(makePkgJSON, {
                model_name: "gemini-3.5-flash-lite",
                system: sys,
                max_tokens: 2048,
                response: "full"
            }
        )
    }
    if config {
        return {
            configuration: generatedPkg.config_used,
            cost: generatedPkg.cost,
            duration: generatedPkg.duration,
            package_name: name,
            description: description,
            author: author,
            license: "MIT",
            package_json: generatedPkg.response,
            complete_log: generatedPkg
        }
    }
    return generatedPkg.response
}

/**
  Generates a project README.md file based on provided project details.

  Parameters:
  - title: The title of the project.
  - description: A brief description of the project.
  - body: The main content of the README, providing an overview of the project, its features, and other relevant information.
  - installation: Instructions for installing the project.
  - usage: Instructions for using the project.
  - config: A boolean indicating whether to return detailed configuration and generation information. Defaults to false.

  Returns:
  - A string containing the generated markdown README content, or an object with detailed configuration and generation information if `config` is true.

  Example:
  ```sesi
  let readme = genReadMe("MyLib", "A fast library", "Details...", "npm install mylib", "import mylib", true)
  show readme.complete_log
  ```

  Notes:
  - Attempts generation using `gpt-6.1-terra`, falling back to `gemini-3.6-flash`.
  - The requested parameters and generated parameters are isolated, useful for debugging and understanding how the final README content was derived.
  - If `config` is true, the returned object will include the complete generation log under `complete_log`.
  - If `config` is false, only the generated README content as a string will be returned.
*/
export fn genReadMe(title: string, description: string, body: string, installation: string, usage: string, config = false) -> any {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating a README.md file for a project."}
    prompt makeReadMe {"Generate a README.md file for a project with the following details:
- Title: "title"
- Description: "description" <- Improve this description to be more detailed and informative, yet concise.
- Body: "body" <- If the body is empty, generate a body that provides an overview of the project, its potential features, and any other relevant information. Otherwise, improve the body to be more detailed and informative.
- Installation: "installation" <- Verify that the installation instructions are clear and accurate/up to date. If they are not, provide improved installation instructions.
- Usage: "usage" <- Verify that the usage instructions are clear and accurate. If they are not, provide improved usage instructions.
"}

    let generatedReadMe = ""
    try {
        generatedReadMe = track_structured_model(makeReadMe, {
                title: "string",
                description: "string",
                installation: "string",
                usage: "string",
                readme: "string"
            },
            {
                model_name: "gpt-6.1-terra",
                system: sys,
                search: true,
                response: "full"
            }
        )
    } catch (e) {
        TERM.warning(e.message)
        TERM.warning("Retrying with a more capable model...")
        generatedReadMe = track_structured_model(makeReadMe, {
                title: "string",
                description: "string",
                installation: "string",
                usage: "string",
                readme: "string"
            },
            {
                model_name: "gemini-3.8-flash",
                system: sys,
                search: true,
                response: "full"
            }
        )
    }
    if config {
        return {
            configuration: generatedReadMe.config_used,
            cost: generatedReadMe.cost,
            duration: generatedReadMe.duration,
            title: generatedReadMe.title,
            description: generatedReadMe.description,
            installation: generatedReadMe.installation,
            usage: generatedReadMe.usage,
            readme: generatedReadMe.readme,
            complete_log: generatedReadMe
        }
    }
    return generatedReadMe.readme
}

/**
  Generates an open source project LICENSE file.

  Parameters:
  - name: The name of the copyright holder.
  - year: The year the license applies to.
  - license: License type (e.g., "MIT", "Apache-2.0").
  - config: Optional boolean indicating whether to return detailed configuration and cost information. Defaults to false.

  Returns:
  - A string containing the generated license text if `config` is false, otherwise an object with detailed configuration and cost information.

  Example:
  ```sesi
  let lic = genLicense("Jane Doe", "2026", "MIT")
  show lic
  ```

  Notes:
  - Uses the `gemini-3.1-flash-lite` model with search enabled.
  - If `config` is true, the function returns an object containing the configuration used, cost, duration, licensee, year, license text, and the complete log.
  - If `config` is false, the function returns only the generated license text.
*/
export fn genLicense(name: string, year: string, license: string, config = false) -> any {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating a LICENSE file for a project."}
    prompt makeLicense {"Generate a LICENSE file for a project with the following details:

- Name: "name"
- Year: "year"
- License: "license"
"}

    let generatedLicense = track_model(makeLicense, {
            model_name: "gemini-3.1-flash-lite",
            system: sys,
            search: true,
            max_tokens: 1024,
            response: "full"
        }
    )
    if config {
        return {
            configuration: generatedLicense.config_used,
            cost: generatedLicense.cost,
            duration: generatedLicense.duration,
            copyright_holder: name,
            year: year,
            license_type: license,
            license: generatedLicense.license | cleanAIResponse,
            complete_log: generatedLicense
        }
    }
    return generatedLicense.license | cleanAIResponse
}

/**
  Generates a combined README and license file string.

  Parameters:
  - `title`: The title of the project.
  - `description`: A brief description of the project.
  - `body`: The main content of the README, providing an overview of the project, its features, and other relevant information.
  - `installation`: Instructions for installing the project.
  - `usage`: Instructions for using the project.
  - `license`: The type of license for the project.
  - `name`: The name of the copyright holder.
  - `year`: The year the license applies to.
  - `config`: Whether to return the full configuration and log along with the generated content. Defaults to false.

  Returns:
  - A combined markdown string containing the README and appended license.
  - If `config` is true, returns an object with `readme` and `license` logs containing the generated content and configuration details.

  Example:
  ```sesi
  let fullDoc = genReadMeWithLicense("Proj", "Desc", "Body", "Inst", "Usage", "MIT", "Dev", "2026")
  show fullDoc
  ```

  Notes:
  - Automatically generates the license and appends it to the README.
*/
export fn genReadMeWithLicense(title: string, description: string, body: string, installation: string, usage: string, license: string, name: string, year: string, config = false) -> any {
    let licenseText = genLicense(name, year, license, config)
    let readme = genReadMe(title, description, body, installation, usage + "\n" + licenseText + "----", config)
    if config {
        return {
            readme: readme,
            license: licenseText
        }
    }
    return readme
}

/**
  Generates a requirements.txt file for Python projects.

  Parameters:
  - purpose: Description of the project requirements or purpose.
  - `config`: Whether to return the full configuration and log along with the generated content. Defaults to false.

  Returns:
  - A string containing the generated requirements.txt contents.
  - If `config` is true, returns an object with configuration, cost, duration, purpose, requirements, and complete log.

  Example:
  ```sesi
  let reqs = genRequirements("Web scraping")
  show reqs
  ```

  Notes:
  - Uses `gemini-3.5-flash-lite` with search enabled.
*/
export fn genRequirements(purpose: string, config = false) -> any {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating a requirements.txt file for a Python project. Do not conversate or provide any explanations. Only provide the requirements.txt file content."}
    prompt makeRequirements {"Generate a requirements.txt file for a Python project with the following purpose:

" purpose}

    let generatedRequirements = track_model(makeRequirements, {
            model_name: "gemini-3.5-flash-lite",
            system: sys,
            search: true,
            response: "full"
        }
    )
    if config {
        return {
            configuration: generatedRequirements.config_used,
            cost: generatedRequirements.cost,
            duration: generatedRequirements.duration,
            purpose: purpose,
            requirements: generatedRequirements.response | cleanAIResponse,
            complete_log: generatedRequirements
        }
    }
    return generatedRequirements.response | cleanAIResponse
}

/**
  Generates an .env.example file template based on project purpose.

  Parameters:
  - purpose: Description of the project.
  - `config`: Whether to return the full configuration and log along with the generated content. Defaults to false.

  Returns:
  - A string containing environment variable examples.
  - If `config` is true, returns an object with configuration, cost, duration, purpose, env_example, and complete log.

  Example:
  ```sesi
  let envs = genEnvExample("Express server with PostgreSQL and JWT")
  show envs
  ```

  Notes:
  - Uses `gemini-3.5-flash-lite` with search enabled.
*/
export fn genEnvExample(purpose: string, config = false) -> any {
    prompt sys {"You are a professional and organized software developer. You are tasked with generating an .env.example file for a project."}
    prompt makeEnvExample {"Generate an .env.example file for a project with the following purpose:

" purpose}

    let generatedEnvExample = track_model(makeEnvExample, {
            model_name: "gemini-3.5-flash-lite",
            system: sys,
            search: true,
            response: "full",
            max_tokens: 800
        }
    )
    if config {
        return {
            configuration: generatedEnvExample.config_used,
            cost: generatedEnvExample.cost,
            duration: generatedEnvExample.duration,
            purpose: purpose,
            env_example: generatedEnvExample.response | cleanAIResponse,
            complete_log: generatedEnvExample
        }
    }
    return generatedEnvExample.response | cleanAIResponse
}

// Templates

/**
  Represents an AI-assisted project scaffolding and file generation template.

  Fields:
  - directory: The target root directory for the project.
  - projectName: The PascalCased project name.
  - purpose: The core purpose or description of the project.
  - name: The author or creator name.
  - licenseType: The license type (defaults to MIT).

  Notes:
  - Provides methods to initialize configuration (`start`), create the directory structure (`scaffold`), and generate all standard project files (`createFiles`).
*/
export make AIProject {
    let directory = ""
    let projectName = ""
    let purpose = ""
    let name = ""
    let licenseType = ""
    let config = false

    // Initializes the AIProject instance with project metadata.
    //
    // Parameters:
    // - title: Project title/name.
    // - purpose: Purpose of the project.
    // - name: Author name.
    // - directory: Root target directory.
    // - licenseType: License type.
    //
    // Returns:
    // - None.
    //
    // Notes:
    // - Formats project name as PascalCase and directory as kebab-case. Default license is MIT.
    fn start(self, title: string = projectName, purpose: string, name: string,  directory: string, licenseType: string, config: bool = false) {
        self.name = name
        self.projectName = title | toPascal
        self.purpose = purpose
        self.directory = directory | toKebab
        self.licenseType = licenseType
        if self.licenseType == "" || self.licenseType | is_null {
            self.licenseType = "MIT"
        }
        self.config = config
    }

    // Creates the project directory on disk.
    //
    // Parameters:
    // - None (uses `self` instance state).
    //
    // Returns:
    // - None.
    //
    // Notes:
    // - Logs success or error messages via TERM.
    fn scaffold(self) {
        let projectPath = self.directory + "/" + self.projectName
        try {
            make_dir(projectPath)
            TERM.success("Project directory created at: " + projectPath)
        } catch (e) {
            TERM.error("Error creating project directory: " + e)
            return
        }
    }

    // Generates and writes all standard project documentation and configuration files.
    //
    // Parameters:
    // - None (uses `self` instance state).
    //
    // Returns:
    // - None.
    //
    // Notes:
    // - Automatically generates README, LICENSE, requirements.txt, .env.example, package.json, and a custom .gitignore using AI tools.
    fn createFiles(self) {
        let projectPath = self.directory + "/" + self.projectName
        let gitignore = ""

        try {// Generate project files
            TERM.info("Generating README...")
            let README = genReadMe(self.projectName, self.purpose, "", "", "", self.config)
            TERM.info("Generating LICENSE...")
            let LICENSE = genLicense(self.name, "2026", self.licenseType, self.config)
            TERM.info("Generating requirements.txt...")
            let requirements = genRequirements(self.purpose, self.config)
            TERM.info("Generating .env.example...")
            let envExample = genEnvExample(self.purpose, self.config)
            TERM.info("Generating package.json...")
            let pkgJSON = genPkgJSON(self.projectName, self.purpose, self.name, self.config)

            try {// Generate .gitignore file based on the project purpose
                TERM.info("Generating .gitignore file based on the project purpose...")
                // Tool for generating a .gitignore file based on the project purpose.
                define_tool("generateGitIgnore", generateGitIgnore, "Generate a .gitignore file for a project based on the provided contents.")
                // Use the AI model to generate the contents of the .gitignore file based on the project purpose and current workspace context.
                let generatedContents = track_structured_model("Use the generateGitIgnore tool for a project with the following purpose:
" + self.purpose + "

Here's the current workspace context:
==== README.md ====
" + README + "
==== LICENSE ====
" + LICENSE + "
==== requirements.txt ====
" + requirements + "
==== .env.example ====
" + envExample + "
==== package.json ====
" + pkgJSON,
                    {
                        gitignore: "string"
                    },
                    {
                        model_name: "gemini-3.5-flash-lite",
                        tools: [generateGitIgnore],
                        max_tool_calls: 4,
                        system: "You are a professional and organized software developer. You are tasked with generating a .gitignore file for a project.",
                        response: "full",
                        max_tokens: 1024
                    }
                )
                gitignore = generatedContents.response.gitignore
            } catch (e1) {
                TERM.error("Error generating .gitignore file: " + e1)
                gitignore = ""
            }

            // Write the generated files to the project directory
            if self.config {
                Safe.json(projectPath + "/README.md", README | to_json)
                Safe.json(projectPath + "/LICENSE", LICENSE | to_json)
                Safe.json(projectPath + "/.gitignore", gitignore | to_json)
                Safe.json(projectPath + "/requirements.txt", requirements | to_json)
                Safe.json(projectPath + "/.env.example", envExample | to_json)
                Safe.json(projectPath + "/package.json", pkgJSON | to_json)
                write_file(projectPath + "/README.md", README.readme)
                write_file(projectPath + "/LICENSE", LICENSE.license)
                write_file(projectPath + "/.gitignore", gitignore.gitignore)
                write_file(projectPath + "/requirements.txt", requirements.requirements)
                write_file(projectPath + "/.env.example", envExample.env_example)
                write_file(projectPath + "/package.json", pkgJSON.package_json)
            } else {
                write_file(projectPath + "/README.md", README)
                write_file(projectPath + "/LICENSE", LICENSE)
                write_file(projectPath + "/.gitignore", gitignore)
                write_file(projectPath + "/requirements.txt", requirements)
                write_file(projectPath + "/.env.example", envExample)
                write_file(projectPath + "/package.json", pkgJSON)
            }
            TERM.success("Project files created successfully.")
        } catch (e2) {
            TERM.error("Error creating project files: " + e2)
        }
    }
}

// Sesi Specific Helpers

/**
  Debugs the given Sesi code content and returns the debugged result. Provides detailed feedback and suggestions for improvement if any issues are found.

  Parameters:
  - content: The Sesi code content to be debugged. Can be a string containing the code or a file path to the Sesi source file.
  - config: Optional boolean flag indicating whether to return detailed configuration and debugging information. Defaults to false.

  Returns:
  - A detailed review of the Sesi code, including any identified issues, suggestions for improvement, and the corrected code if applicable.
  - If config is true, also includes detailed configuration and debugging information used during the process.

  Example:
  ```sesi
  let result = debugSesi("examples.sesi")
  show result
  ```

  Notes:
  - The function attempts to debug the Sesi code using the "gpt-6.1-sol" model first. If it fails, it falls back to the "gemini-4-argon" model.
  - Any errors encountered during the debugging process will be returned as error messages.
  - If config is true, the returned result will also include detailed configuration and debugging information.
*/
export fn debugSesi(content: string, config = false) -> any {
    let c = ""
    let debugged = ""
    prompt fix {"# SESI REFERENCE: "_"\nYou are an expert in debugging Sesi code. You find syntax errors, bad practices, and hallucinated/mistaken code patterns in Sesi. If none of these issues are present, indicate that the code is correct. Otherwise, provide detailed feedback and suggestions for improvement.
    # SPECIFICALLY FOR YOU, NOT THE USER\nMODEL CONFIGURATION BLOCKS `{}` CANNOT BE SEPARATED BY NEWLINE. SAME GOES FOR OTHER BUILTINS THAT USE CURLY BRACES AND ANY OTHER SESI-SPECIFIC SYNTAX. THAT IS NOT VALID SESI. THAT IS JS/PYTHON/ETC. NOT SESI. YOU HAVE THE LITERAL EXAMPLES AND PROPER USAGE IN THE REFERENCE ABOVE. DO NOT INSINUATE OTHERWISE OR STUBBORNLY IGNORE THIS RULE WHEN WRITING SESI CODE AND OFFERING SUGGESTIONS."}
    TERM.info("Debugging Sesi code...")
    if (content | get_ext) == null { c = content } else if (content | get_ext) != null { c = read_file(content) }
    try {
        debugged = track_model(c, {
                model_name: "gpt-6.1-sol",
                system: fix,
                thinking: "medium",
                cache: true,
                max_tokens: 10000,
                response: "full"
            }
        )
        TERM.success("Sesi code debugged successfully.")
    } catch (e) {
        try {
            debugged = track_model(c, {
                    model_name: "gemini-4-argon",
                    system: fix,
                    thinking: "medium",
                    cache: true,
                    max_tokens: 10000,
                    response: "full"
                }
            )
            TERM.success("Sesi code debugged successfully.")
        } catch (e2) {
            return TERM.error("Error debugging Sesi code: " + e2.message)
        }
    }
    if config {
        return {
            configuration: debugged.config_used,
            input: content,
            cost: debugged.cost,
            duration: debugged.duration,
            result: debugged.response,
            complete_log: debugged
        }
    }
    return debugged.response
}

/**
  Verifies and patches errors or issues in a Sesi source file using automated tooling.

  Parameters:
  - file: Path to the Sesi source file to check and patch.
  - modelChoice: The model to use for patching, either "gpt" or "gemini".
  - config: Boolean flag indicating whether to include configuration details in the return value.

  Returns:
  - `None` if no issues were found or the file could not be patched.
  - If `config` is true, the return value will include detailed configuration information along with the patched code.

  Example:
  ```sesi
  let result = patchSesi("examples.sesi")
  show result
  ```

  Notes:
  - The function uses the "gpt-6.1-terra" model to verify and patch the Sesi code, falling back to the "gemini-4-argon" model if necessary.
  - It relies on the "verify" and "view" tools to identify and understand issues in the Sesi file.
  - The function will attempt to patch the file in place using the specified model and configuration, creating a backup.
  - If the file could not be patched, the function will return `None`.
  - The `config` parameter allows users to obtain detailed information about the patching process, including the configuration used, cost, duration, and complete log.
*/
export fn patchSesi(file: string, modelChoice: string = "gemini", config = false) -> any {
    // Checks the correctness of a Sesi file by running it and returning the log output.
    //
    // Parameters:
    // - file: Path to the file to check.
    //
    // Returns:
    // - A string containing the log output of the check process.
    //
    // Notes:
    // - Trashes existing log files before running.
    // - Helper utility used by tools.    
    fn check(file: string) {
        let tmp = "tmp.sesi.chk.log"
        Safe.remove(tmp, true)
        let output = run("node bin/sesi.js -c " + file + " 2>&1 || true")
        Safe.log("tmp.sesi.chk", output)
        return read_file(tmp)
    }
    // Reads the content of the specified Sesi file.
    //
    // Parameters:
    // - file: Path to the file to read.
    //
    // Returns:
    // - A string containing the file contents.
    //
    // Notes:
    // - Helper utility used by tools.    
    fn read(file: string) {
        TERM.info("Reading " + file + "...")
        return Safe.read(file)
    }

    fn write(code: string) {
        TERM.info("Writing to " + file + ".patched")
        let written = Safe.write(file + ".patched", code)
        TERM.info(written)
        let backup = ".backup/" + time() + "_" + file
        TERM.info("Backup file saved to " + backup)
        if exists(file + ".patched") {
            archive(file, backup)
            rename(backup, file)
            TERM.success("File patched successfully.\n")
        } else {
            TERM.error("Failed to create patched file.\n")
        }
        return written
    }

    define_tool("verify", check, "Verifies the correctness of a Sesi file by checking for errors and issues.")
    define_tool("view", read, "Reads the content of a Sesi file.")
    define_tool("write_code", write, "Write the corrected Sesi code patch file and save to disk.")

    let s = ""
    let i = _ + "\n\nYou are an expert in verifying Sesi code for correctness and identifying errors."
    prompt patcher {i "
Use the check tool to check the correctness of the Sesi file: "file"
Call verify exactly once. If it reports errors or issues, call view exactly once to inspect the file.
Do not call verify or view again.
Use the write_code tool to save the corrected code to a patch file.
Otherwise, return 'No issues found!' exactly.
Do not provide any explanations or commentary."}

    if modelChoice == "gpt" {
        try {
            s = track_model("Proceed.", {
                    model_name: "gpt-6.1-terra",
                    system: patcher,
                    tools: [check, read, write],
                    max_tool_calls: 7,
                    thinking: "low",
                    cache: false,
                    max_tokens: 10000,
                    response: "full"
                }
            )
        } catch (e) {
            TERM.warning(e.message)
            TERM.warning("Retrying with a more capable model...")
            s = track_model("Proceed.", {
                    model_name: "gemini-4-argon",
                    system: patcher,
                    tools: [check, read, write],
                    max_tool_calls: 7,
                    thinking: "low",
                    cache: false,
                    max_tokens: 10000,
                    response: "full"
                }
            )
        }
    } else {
        s = track_model("Proceed.", {
            model_name: "gemini-4-argon",
            system: patcher,
            tools: [check, read, write],
            max_tool_calls: 7,
            thinking: "low",
            cache: false,
            max_tokens: 10000,
            response: "full"
        })
    }
    
    if s.response == "No issues found!" {
        TERM.success(file + " has been checked and verified for errors, none found!")
        if config {
            return {
                configuration: s.config_used,
                cost: s.cost,
                duration: s.duration,
                file_to_patch: file,
                results: s.response,
                complete_log: s
            }
        }
        return s.response
    } else {
        TERM.success(file + " has been patched!") 
        if config {
            return {
                configuration: s.config_used,
                cost: s.cost,
                duration: s.duration,
                file_to_patch: file,
                results: s.response,
                complete_log: s
            }
        }
        return s.response
    }
}

/**
  Patches all Sesi files in a directory or a list of files.

  Parameters:
  - dir: The path to the directory containing Sesi files to be patched. If null, the function will use the 'files' parameter.
  - files: An array of specific Sesi files to be patched. If null or empty, the function will use the 'dir' parameter.
  - config: Optional boolean flag to indicate whether to use a specific configuration during patching. Defaults to false.

  Returns:
  - None. The function patches the files in place and creates backup copies.
  - The function will respect the 'config' flag when calling patchSesi for each file.

  Example:
  ```sesi
  patchAllSesi("/path/to/sesi/files")
  patchAllSesi(null, ["file1.sesi", "file2.sesi"])
  ```

  Notes:
  - The function will create a backup of each file before patching it.
  - If a file has already been patched, it will skip that file and continue with the next one.
  - This tool is especially helpful if updating versioned Sesi files across a project.
*/
export fn patchAllSesi(dir: string? = null, files: array<string>? = null, config = false) {
    if files != null {
        for file in files {
            show "Patching" file "\n"
            try {
                patchSesi(file, "gemini", config)
            } catch (e) {
                show "File already patched or could not be patched."
                show e.message + "\n"
                continue
            }
            
        }
    } else if dir != null {
        for file in list_dir(dir) {
            if ((dir + "/" + file | get_ext) == "sesi") {
                show "Patching" file "\n"
                try {
                    patchSesi(dir + "/" + file, "gemini", config)
                } catch (e) {
                    show "File already patched or could not be patched."
                    show e.message + "\n"
                    continue
                }
            }
        }
    }
}

/**
  Automatically generates and applies documentation comments to a Sesi source file.

  Parameters:
  - `file`: Path to the target Sesi source file.
  - `modelName`: Name of the AI provider to use for generating documentation. Defaults to "gemini".
  - `config`: Optional configuration flag for the documentation generation process. Defaults to false.

  Returns:
  - Either:
    - The updated source code with applied documentation comments.
    - An error message if the documentation generation process failed.
    - An object containing detailed logs of the documentation generation and application process.

  Example:
  ```sesi
  autoDoc("src/main.sesi")
  ```

  Notes:
  - Uses AI models to generate detailed documentation based on Sesi reference guidelines & follows the standard Sesi documentation format, including descriptions, parameters, return values, examples, and notes, and applies them back to the source file.
  - If the source file already contains documentation comments, they will be left untouched unless comments appear outdated.
  - If the returned code contains errors, it's passed to the patchSesi() function for automatic correction.
  - The detailed logs object contains information about the documentation generation and application process, and the final applied comments.
*/
export fn autoDoc(file: string, modelName: string = "gemini", config = false) -> any {
    let contents = read_file(file)
    // Generate function comments for the given source file
    prompt docQuery {"## SESI REFERENCE:
"_"

## TASK
Generate detailed function/make comments and documentation header for the source code supplied by the user. Only return the generated comments with a note of which functions they belong to, and line numbers, do not include the actual source code.

Format:

/**
  Detailed function comments for the source file. (DO NOT INCLUDE THE `fn ...` lines themselves, only the comments.)

  Include descriptions for all functions, their parameters, return values, example usage, and any relevant notes. eg.:

  Description of the function.
   
  Parameters:
  - param1: Description of the first parameter. <- THESE MUST BE HYPEN ITEMS
  - param2: Description of the second parameter. <- THESE MUST BE HYPEN ITEMS

  Returns:
  - Description of the return value. <- THIS MUST BE A HYPEN ITEM. If the function does not return a value, indicate it as `None.`.

  Example:
  ```sesi <- sesi code fence is automatically recognized by the system, you MUST include it.
  // Example usage of the function, exact usage depends on function and expected workflow builtin usages
  let result = exampleFunction(param1, param2)
  show result // or the expected function action to perform if not `show`
  write_file(\"output.sesi\", result) // Example of writing the result to a file. Refer to the attached SESI REFERENCE for other available functions and usage examples.
  ``` <- end of the sesi code fence
  Notes: <- (Optional, but reccomended for good pratice) Provide any additional information about the function. This includes expected return shapes, data types, and any other relevant details. This is a non-negotiable.
  - Any additional notes or important information about the function.

  // The following applies to variables/objects/arrays only (defined in `let` statements).
  Fields:
  - field1: Description of the first field.
  - field2: Description of the second field.

  Notes:
  - Any additional notes or important information about the variable/object/array.

  Output:
  - Description of the expected/final state of the variable/object/array.

  <-- IF THE FUNCTION IS NESTED WITHIN ANOTHER FUNCTION OR OBJECT LIKE A `MAKE` TEMPLATE, THE COMMENTS FOLLOW `/** ... * ... */`. USE `*` FOR EACH LINE OF COMMENT, INCLUDING NEWLINES.
  Example of nested function comments:
  /**
  * Description of the nested function.
  *
  * Parameters:
  * - param1: Description of the first parameter.
  * - param2: Description of the second parameter.
  *
  * Returns:
  * - Description of the return value. If the function does not return a value, indicate it as `None.`.
  *
  * - Notes:
  * - Any additional notes/important information.
  */
  <-- END OF NESTED FUNCTION COMMENTS -->
*/

# STRICT REQUIREMENTS:

YOU ARE NOT DEBUGGING CODE AT ALL.
DO NOT LEAVE ANY FUNCTIONS UNDOCUMENTED. THIS IS A NON-NEGOTIABLE.
ONLY DOCUMENT SESI FUNCTIONS, MODULES, AND VARIABLES.
DO NOT PRIORITIZE BREVITY, THESE COMMENTS ARE FOR THE USER TO UNDERSTAND HOW TO USE FUNCTIONS, MODULES, AND VARIABLES WHEN IMPORTED IN OTHER SCRIPTS OR USED WITHIN THE SAME SCRIPT.
DO NOT HYPERFIXATE ON DOCUMENTING EVERY VARIABLE. ONLY VARIABLES CONTAINING ARRAYS AND OBJECTS THAT ABSOLUTELY REQUIRE DOCUMENTATION SHOULD BE DOCUMENTED.
YOU MUST FOLLOW THE FORMAT EXACTLY AS SHOWN ABOVE OTHERWISE THE PARSER WILL FAIL TO RECOGNIZE THE COMMENTS CORRECTLY.
    "}

    prompt verify {"
Apply each of the following function comments contained in `/**...*/` blocks directly above their respective functions in the source code.
Do not wrap the final output in additional code blocks or comments.
    " docQuery}

    try {
        TERM.info("Generating documentation for " + file + " ...")
        let docs = ""
        if modelName == "gpt" {
            try {
                docs = track_model(contents, {
                        model_name: "gpt-6.1-terra",
                        system: docQuery,
                        thinking: "low",
                        cache: true,
                        response: "full"
                    }
                )
            } catch (e) {
                TERM.warning(e.message)
                TERM.warning("Retrying with a more capable model...")
                docs = track_model(contents, {
                        model_name: "gemini-3.6-flash",
                        system: docQuery,
                        thinking: "low",
                        cache: true,
                        response: "full"
                    }
                )
            }
        } else {
            docs = track_model(contents, {
                    model_name: "gemini-3.6-flash",
                    system: docQuery,
                    thinking: "low",
                    cache: true,
                    response: "full"
                }
            )
        }
        
        TERM.info("Applying comments now...")
        let addedComments = track_model(docs.response + "\n" + contents, {
                model_name: "gemini-3.5-flash-lite",
                system: verify,
                thinking: "medium",
                cache: true,
                response: "full"
            }
        )
        let finalComments = addedComments.response
        Safe.tempFile("sesi_test", addedComments.response, "sesi")
        Safe.archiveFile("sesi_test_temp.sesi")
        let parserCheck = patchSesi("sesi_test_temp.sesi", "gpt", true)
        if parserCheck.response != "No issues found!" {
            finalComments = parserCheck.response
        }

        try {
            if parserCheck.response == "No issues found!" { write_file(file, addedComments.response) }
            else { write_file(file, finalComments) }
            Safe.remove("sesi_test_temp.sesi", true)
            TERM.success("Successfully applied!")
            if config {
                return {
                    configuration: {
                        documentation: docs.config_used,
                        application: addedComments.config_used
                    },
                    cost: {
                        documentation: docs.cost,
                        application: addedComments.cost,
                    },
                    duration: {
                        documentation: docs.duration,
                        application: addedComments.duration,
                    },
                    sesi_file: file,
                    documentation: docs.response,
                    result: parserCheck,
                    output: addedComments.response,
                    complete_log: {
                        documentation: docs,
                        application: addedComments
                    }
                }
            }
            return "Success!"
        } catch (e3) {
            TERM.error("Error applying comments to the source file: " + e3.message)
            return e3
        }
    } catch (e) {
        TERM.error("Error generating documentation: " + e.message)
        return e
    }
}
// Alternate documenter
/**
  Reads a Sesi source file, generates idiomatic documentation comments
  for functions, object templates, and variable declarations, and writes
  the documented version back to disk.

  Parameters:
  - `filePath`: The relative or absolute path to the target `.sesi` file.
  - `config`: Optional boolean flag indicating whether to return detailed configuration and cost information. Defaults to `false`.

  Returns:
  - `true` if the file was documented and saved successfully, `false` otherwise.
  - If `config` is `true`, returns an object containing detailed configuration, cost, duration, and documentation information.

  Example:
  ```sesi
  let success = autoDocumentFile("src/service.sesi")
  if success {
    show "Documentation completed successfully."
  }
  ```

  Notes:
  - If `config` is `true`, the returned object will include:
    - `configuration`: The configuration used for documentation generation.
    - `cost`: The cost associated with the documentation generation.
    - `duration`: The time taken for the documentation generation.
    - `sesi_file`: The path to the documented Sesi file.
    - `documentation`: The generated documentation content.
    - `complete_log`: The complete log of the documentation generation process.
  - Uses 'gpt-6-luna' model for generating documentation, falls back to 'gemini-3.5-flash-lite' if necessary.
  - Creates a safety backup of the original file via `archive()` before rewriting.
  - Cleans markdown fences if emitted by the model.
*/
export fn autoDocumentFile(filePath: string, config = false) -> any {
  if !exists(filePath) {
    TERM.error("Target file does not exist at path:" + filePath)
    return false
  }

  show "Reading source file:" filePath
  let sourceCode = ""
  try {
    sourceCode = read_file(filePath)
  } catch (err) {
    TERM.error("Failed to read file:" + err)
    return false
  }

  if (sourceCode | len) == 0 {
    TERM.warning("File is empty. Nothing to document.")
    return false
  }

  // Backup the original file to .archive/
  try {
    archive(filePath, ".backup/" + filePath)
    TERM.info("Created backup in .archive/ for safety.")
  } catch (err) {
    TERM.warning("Notice: Could not create archive backup:" + err)
  }

  prompt docPrompt {"You are an expert Sesi documentation generator. Inspect the following Sesi source code and insert idiomatic multi-line documentation comments (/** ... */) directly above each undocumented function (fn), object template (make), and major variable declaration (let).

Formatting Rules:

1. For Functions ('fn' / 'async fn'):
/**
  Brief description of what the function performs.

  Parameters:
  - `param1`: Description of parameter.
  - `param2`: Description of parameter.

  Returns:
  - Description of the returned value.

  Example: <-- MUST BE PRESENT
  ```sesi
  let res = functionName(...)
  ```

  Notes:
  - Any additional notes.
*/

2. For Object Templates ('make'):
/**
  Brief description of the template and its purpose.
*/

3. For Complex Variables ('let' with objects, arrays, or important states):
/**
  Description of the variable purpose.

  Fields / Elements:
  - `key1`: Explanation of field.

  Notes:
  - Additional information.
*/

4. For nested items within functions/make templates:
/**
*   Description
*
*   Paramaters:
*   -
*   -
*
*   Returns:
*   -
*
*   etc...
*/

Preserve all existing code logic, imports, whitespace, and existing valid doc comments.
Return ONLY the raw executable Sesi code. Do not wrap the response in markdown code blocks or code fences.

Source Code:
" sourceCode}

  TERM.info("Generating documentation comments...")
  let updatedCode = ""
  try {
    updatedCode = track_model(docPrompt, {
            model_name: "gpt-6-luna",
            thinking: "low",
            response: "full"
        }
    )
  } catch {e} {
    updatedCode = track_model(docPrompt, {
            model_name: "gemini-3.5-flash-lite",
            thinking: "medium",
            response: "full"
        }
    )
  }

  if updatedCode.response | is_null || (updatedCode.response | len) == 0 {
    TERM.error("Failed to generate documentation from model.")
    return false
  }

  // Strip accidental markdown fences if returned by the model
  let cleaned = updatedCode.response
  if cleaned | starts_with("```sesi") {
    cleaned = slice(cleaned, 7)
  } else if cleaned | starts_with("```") {
    cleaned = slice(cleaned, 3)
  }

  if cleaned | ends_with("```") {
    cleaned = slice(cleaned, 0, (cleaned | len) - 3)
  }

  cleaned = trim(cleaned)

  try {
    write_file(filePath, cleaned)
    TERM.success("Successfully updated and documented:" + filePath)
    if config {
        return {
            configuration: updatedCode.config_used,
            cost: updatedCode.cost,
            duration: updatedCode.duration,
            sesi_file: filePath,
            documentation: updatedCode.response,
            complete_log: updatedCode
        }
    }
    return true
  } catch (err) {
    TERM.error("Failed to write documented code back to file:" + err)
    if config {
        return {
            error: err | to_json,
            configuration: updatedCode.config_used,
            cost: updatedCode.cost,
            duration: updatedCode.duration,
            sesi_file: filePath,
            documentation: updatedCode.response,
            complete_log: updatedCode
        }
    }
    return false
  }
}