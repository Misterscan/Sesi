allow "std/draw" in as draw
allow "math" in as math

/**
  Generates a placeholder image with centered text and a solid background, optionally saving it to a file.

  Parameters:
  - text: The text string to display inside the placeholder.
  - size: The dimension (width and height) of the square placeholder image in pixels.
  - outPath: The optional file path to save the generated SVG image.

  Returns:
  - The rendered image data string.

  Examples:
  ```sesi
  let img = placeholder("Test", 200, "placeholder.svg")
  show img
  ```
*/
export fn placeholder(text: string, size: number = 150, outPath: string = "") -> string {
    draw.clear()

    // Background canvas
    draw.rect(0, 0, size, size, "#a8a8a8")

    // Calculated font size based on container width
    let fontSize = size / 10
    // If word is too long, allow it to fit
    if (text | length) > 10 {
        fontSize = size / (text | length)
    }

    // Centered text using SVG text-anchor and dominant-baseline attributes
    draw.text(size / 2, size / 2, text, fontSize, "#121212", {
        "text-anchor": "middle",
        "dominant-baseline": "central"
    })

    let img = draw.render(size, size)

    if outPath != "" {
        draw.save_svg(outPath, size, size)
        show "Generated placeholder for" text "at" outPath
    }
    return img
}

/**
  Generates a user avatar graphic featuring initials centered inside a colored circular background.

  Parameters:
  - initials: The string of initials to display on the avatar.
  - bg: The background color of the circle.
  - fg: The foreground color for the initials text.
  - size: The dimensions (width and height) of the square avatar in pixels.
  - outPath: The optional file path to save the generated SVG image.

  Returns:
  - The rendered image data string.

  Examples:
  ```sesi
  let avatarImg = avatar("JD", "#2563eb", "#ffffff", 200, "avatar.svg")
  show avatarImg
  ```
*/
export fn avatar(initials: string, bg: string = "#2563eb", fg: string = "#ffffff", size: number = 200, outPath: string = "") -> string {
    draw.clear()

    let center = size / 2
    let fontSize = size / 2.5

    // Circle background centered at (center, center)
    draw.circle(center, center, center, bg)

    // Centered initials
    draw.text(center, center, initials, fontSize, fg, {
        "text-anchor": "middle",
        "dominant-baseline": "central"
    })

    let img = draw.render(size, size)
    if outPath != "" {
        draw.save_svg(outPath, size, size)
        show "Generated avatar for" initials "at" outPath
    }
    return img
}

/**
  Generates a stylized vector logo featuring concentric circles and radial line markers.

  Parameters:
  - outPath: The optional file path to save the generated SVG logo.
  - size: The dimensions (width and height) of the square logo in pixels.

  Returns:
  - The rendered image data string.

  Examples:
  ```sesi
  let logoImg = logo("logo.svg", 500)
  show logoImg
  ```
*/
export fn logo(outPath: string = "", size: number = 500) -> string {
    draw.clear()
    draw.rect(0, 0, size, size, "#ffffff00")
    draw.circle(size / 2, size / 2, size / 2, "#2563eb")
    draw.circle(size / 2, size / 2, size / 2.5, "#ffffff")
    draw.circle(size / 2, size / 2, size / 3, "#2563eb")

    let steps = 10
    let stepAngle = 360 / steps

    for i in range(steps) {
        let angle = i * stepAngle
        let rad = angle * (math.PI / 180)

        let x1 = size / 2 + (size / 3) * math.cos(rad)
        let y1 = size / 2 + (size / 3) * math.sin(rad)

        let x2 = size / 2 + (size / 2) * math.cos(rad)
        let y2 = size / 2 + (size / 2) * math.sin(rad)

        draw.line(x1, y1, x2, y2, "#ffffff")
    }

    // add dots
    for i in range(steps) {
        let angle = i * stepAngle
        let rad = angle * (math.PI / 180)

        let x1 = size / 2 + (size / 3) * math.cos(rad)
        let y1 = size / 2 + (size / 3) * math.sin(rad)

        draw.circle(x1, y1, 5, "#ffffff")
    }

    let img = draw.render(size, size)
    if outPath != "" {
        draw.save_svg(outPath, size, size)
        show "Generated logo at" outPath
    }
    return img
}

// ─── Pixel Grid & Raster Utilities ──────────────────────────────────────────

/**
  Pixel Grid Raster Generator
  Draws a palette-indexed grid into the raster buffer and outputs an RGBA PNG file.

  Parameters:
  - grid: Array of strings or array of color index arrays representing the pixel map.
  - palette: Map of character keys or indexes to color values.
  - scale: Pixel expansion factor determining the size of each grid cell in pixels.
  - outPath: Target output .png file path.

  Returns:
  - The raster image data string.

  Examples:
  ```sesi
  let palette = { ".": "transparent", "1": "#38bdf8" }
  let grid = ["..1..", ".111."]
  let img = render_pixel_grid(grid, palette, 16, "grid.png")
  show img
  ```
*/
export fn render_pixel_grid(grid: array, palette: object, scale: number = 16, outPath: string = "") -> string {
    draw.clear()

    // Draw grid to raster buffer
    let img = draw.pixel_grid(grid, palette, scale)

    // Calculate dimensions
    let gridHeight = grid | length
    let gridWidth = 0
    if gridHeight > 0 {
        gridWidth = grid[0] | length
    }

    let realWidth = gridWidth * scale
    let realHeight = gridHeight * scale

    if outPath != "" {
        // Save RGBA PNG
        draw.save_png(outPath, realWidth, realHeight, "transparent")
        show "Saved pixel grid graphic to" outPath
    }
    return img
}

/**
  Sprite Presets.
  Generates common retro sprite graphics using pre-configured character grids.

  Parameters:
  - type: The identifier string for the preset sprite (e.g. "invader", "heart", "alien", "diamond", "arrow", "robot").
  - scale: Pixel expansion factor for the sprite grid cells.
  - outPath: Target output .png file path.

  Returns:
  - A boolean value indicating whether the sprite was successfully rendered and saved.

  Examples:
  ```sesi
  let success = pixel_art_preset("heart", 16, "heart.png")
  show success
  ```
*/
export fn pixel_art_preset(type: string = "invader", scale: number = 16, outPath: string = "sprite.png") -> bool {
    let palette = {
        ".": "transparent",
        "1": "#38bdf8",
        "2": "#ef4444",
        "3": "#f59e0b"
    }

    let grid = []

    if type == "heart" {
        palette["1"] = "#ef4444"
        grid = [
            "..11...11..",
            ".1111.1111.",
            "11111111111",
            "11111111111",
            ".111111111.",
            "..1111111..",
            "...11111...",
            "....111....",
            ".....1....."
        ]
    } else if type == "alien" {
        palette["1"] = "#10b981"
        grid = [
            "..11111..",
            ".1111111.",
            "111111111",
            "11.111.11",
            "111111111",
            ".1111111.",
            "..1...1..",
            "..1...1..",
            "........."
        ]
    } else if type == "diamond" {
        palette["1"] = "#f43f5e"
        grid = [
            "....1....",
            "...111...",
            "..11111..",
            ".1111111.",
            "111111111",
            ".1111111.",
            "..11111..",
            "...111...",
            "....1...."
        ]
    } else if type == "arrow" {
        palette["1"] = "#f97316"
        grid = [
            "....1....",
            "...111...",
            "..11111..",
            ".1111111.",
            "111111111",
            "....1....",
            "....1....",
            "....1....",
            "........."
        ]
    } else if type == "robot" {
        palette["1"] = "#6b7280"
        palette["2"] = "#f43f5e"
        grid = [
            "..111111..",
            ".1......1.",
            "1..11..11.",
            "1..11..11.",
            "1........1",
            ".11111111.",
            "...1..1...",
            "...1..1...",
            "...1111..."
        ]
    } else {
        // Default: Retro Invader
        grid = [
            "..1.....1..",
            "...1...1...",
            "..1111111..",
            ".11.111.11.",
            "11111111111",
            "1.1111111.1",
            "1.1.....1.1",
            "...11.11..."
        ]
    }

    return render_pixel_grid(grid, palette, scale, outPath)
}

fn test_all() {
    let dir = "imgs/"
    try {
        placeholder("Test", 200, dir + "placeholder.svg")
        avatar("JD", "#2563eb", "#ffffff", 200, dir + "avatar.svg")
        logo(dir + "logo.svg", 500)
        render_pixel_grid(["..1..", ".111."], { ".": "transparent", "1": "#38bdf8" }, 16, dir + "grid.png")
        pixel_art_preset("heart", 16, dir + "heart.png")
        show "\nAll tests passed successfully!"
    } catch (e) {
        show e
    }
}

if args[0] == "test" { test_all() }