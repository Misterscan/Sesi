/**
  Akai MPC production functions.

  This module exposes the native `std/mpc` production engine through the local
  Sesi library. It provides sequence, program, pad, sampling, performance,
  effects, arrangement, playback, and rendering functions.

  Import this module from the repository with:
  ```sesi
  allow "lib/mpc" in as MPC
  ```
*/
allow "std/mpc" in as Native

/**
  Get the default pad information for an MPC drum kit.

  Returns:
  - An array of pad configuration objects for the default 16-pad setup.

  Example:
  ```sesi
  let pads = DefaultPadInfo()
  ```
*/
fn DefaultPadInfo() -> array<string> {
  return [{ pad: 1, sound: 'kick', name: 'Bass Drum 1' },
      { pad: 2, sound: 'rimshot', name: 'Side Stick' },
      { pad: 3, sound: 'snare', name: 'Acoustic Snare' },
      { pad: 4, sound: 'clap', name: 'Hand Clap' },
      { pad: 5, sound: 'hat', name: 'Closed Hi-Hat', mute_group: 1 },
      { pad: 6, sound: 'tom', name: 'Low Tom' },
      { pad: 7, sound: 'open_hat', name: 'Open Hi-Hat', mute_group: 1 }, // Choked by closed hat!
      { pad: 8, sound: 'tom', name: 'Mid Tom' },
      { pad: 9, sound: 'tom', name: 'High Tom' },
      { pad: 10, sound: 'crash', name: 'Crash Cymbal' },
      { pad: 11, sound: 'ride', name: 'Ride Cymbal' },
      { pad: 12, sound: 'perc', name: 'Shaker/Perc' },
      { pad: 13, sound: '808', name: '808 Sub Kick' },
      { pad: 14, sound: 'snare', name: 'Tight Snare' },
      { pad: 15, sound: 'hat', name: 'Pedal Hi-Hat', mute_group: 1 },
      { pad: 16, sound: 'perc', name: 'Cowbell/Perc' }]
}

/**
  Create an MPC project from a configuration object.

  Parameters:
  - `config`: Optional project settings such as `name`, `bars`, `bpm`,
    `swing`, `vintage`, and `time_signature`.

  Returns:
  - An MPC sequence object representing the project.

  Example:
  ```sesi
  let project = create({"name": "Beat", "bars": 4, "bpm": 92})
  ```
*/
export fn create(config: object = null) -> any {
  return Native.create(config)
}

/**
  Create an MPC project using the `project` alias.

  Parameters:
  - `config`: Optional project settings.

  Returns:
  - An MPC sequence object representing the project.

  Example:
  ```sesi
  let project = project({"name": "Album Session", "bpm": 88, "swing": 57})
  ```
*/
export fn project(config: object = null) -> any {
  return Native.project(config)
}

/**
  Create an MPC sequence.

  Parameters:
  - `name`: Sequence name.
  - `bars`: Number of bars. Defaults to `2`.
  - `bpm`: Tempo in beats per minute. Defaults to `90`.
  - `time_signature`: Musical time signature. Defaults to `"4/4"`.

  Returns:
  - A sequence object with track, timing, effect, playback, and render methods.

  Example:
  ```sesi
  let seq = sequence("Boom Bap", 2, 92, "4/4")
  ```
*/
export fn sequence(name: string, bars: number = 2, bpm: number = 90, time_signature: string = "4/4") -> any {
  return Native.sequence(name, bars, bpm, time_signature)
}

/**
  Create a 16-pad MPC drum kit.

  Parameters:
  - `name`: Name assigned to the kit.

  Returns:
  - A drum-kit object with pad configuration and 16 Levels methods.

  Example:
  ```sesi
  let kit = drum_kit("Boom Bap Kit")
  ```
*/
export fn drum_kit(name: string = "Akai MPC Kit") -> any {
  return Native.drum_kit(name)
}

/**
  Create an MPC drum program.

  Parameters:
  - `name`: Name assigned to the program.

  Returns:
  - An MPC drum-kit object.

  Example:
  ```sesi
  let drums = program("Studio Drums")
  ```

  Notes:
  - `program` is the program-oriented alias of `drum_kit`.
*/
export fn program(name: string = "Akai MPC Kit") -> any {
  return Native.program(name)
}

/**
  Define an MPC pad.

  Parameters:
  - `pad_number`: Pad number, normally from `1` through `16`.
  - `sound`: Synthesized sound name or sample reference.
  - `options`: Optional level, pan, tune, envelope, filter, play-mode, and
    mute-group settings.

  Returns:
  - A pad configuration object.

  Example:
  ```sesi
  let kick = pad(1, "kick", {"level": 1.0, "tune": -1})
  ```
*/
export fn pad(pad_number: number, sound: string = "kick", options: object = null) -> any {
  return Native.pad(pad_number, sound, options)
}

/**
  Spread one pad across the MPC 16 Levels performance layout.

  Parameters:
  - `source_pad`: Pad configuration to spread across the sixteen pads.
  - `mode`: One of `"velocity"`, `"tune"`, `"filter"`, `"decay"`, or
    `"attack"`.
  - `options`: Optional mode-specific settings.

  Returns:
  - An array containing sixteen pad configurations.

  Example:
  ```sesi
  let bass_pad = pad(13, "808")
  let tuned_bass = sixteen_levels(bass_pad, "tune")
  ```
*/
export fn sixteen_levels(source_pad: object, mode: string = "velocity", options: object = null) -> any {
  return Native.sixteen_levels(source_pad, mode, options)
}

/**
  Generate quantized MPC Note Repeat events.

  Parameters:
  - `pad_number`: Pad triggered by each generated event.
  - `rate`: Repeat division such as `"1/16"`, `"1/32"`, or `"1/16T"`.
  - `bars`: Number of bars for which events are generated.
  - `options`: Optional velocity, ramp, accent, swing, and duration settings.

  Returns:
  - An array of MPC note events.

  Example:
  ```sesi
  let roll = note_repeat(5, "1/32", 1, {"ramp": "crescendo"})
  ```
*/
export fn note_repeat(pad_number: number, rate: string = "1/16", bars: number = 1, options: object = null) -> any {
  return Native.note_repeat(pad_number, rate, bars, options)
}

/**
  Apply Roger Linn-style MPC swing offsets to note events.

  Parameters:
  - `events`: Array of events containing step positions.
  - `percent`: Swing amount from `50` for straight timing through `75` for
    heavy swing.
  - `grid`: Timing grid used for swing calculation.

  Returns:
  - A new event array containing `swing_offset_ms` values.

  Example:
  ```sesi
  let events = [{"pad": 1, "step": 0}, {"pad": 1, "step": 1}]
  let swung_events = swing(events, 58, "1/16")
  ```
*/
export fn swing(events: array, percent: number = 58, grid: string = "1/16") -> array {
  return Native.swing(events, percent, grid)
}

/**
  Chop a WAV file or audio sample into an MPC drum kit.

  Parameters:
  - `source`: WAV path or in-memory audio sample.
  - `slices`: Number of slices to create.
  - `options`: Optional chop method and kit name settings.

  Returns:
  - A drum kit with each slice assigned to a pad and a shared mute group.

  Example:
  ```sesi
  let sample = "samples/break.wav"
  let chops = chop(sample, 16, {"name": "Break Chops"})
  ```
*/
export fn chop(source: any, slices: number = 16, options: object = null) -> any {
  return Native.chop(source, slices, options)
}

/**
  Chop a WAV file or audio sample using the `slice` alias.

  Parameters:
  - `source`: WAV path or in-memory audio sample.
  - `slices`: Number of slices to create.
  - `options`: Optional chop settings.

  Returns:
  - A drum kit containing the generated sample slices.

  Example:
  ```sesi
  let sample = "samples/vocal.wav"
  let slices = slice(sample, 8)
  ```
*/
export fn slice(source: any, slices: number = 16, options: object = null) -> any {
  return Native.slice(source, slices, options)
}

/**
  Load a WAV sample or synthesize an MPC drum sound.

  Parameters:
  - `type_or_path`: Drum type such as `"kick"`, `"snare"`, `"hat"`, or
    `"808"`, or a path to a WAV file.
  - `options`: Optional synthesis settings such as duration, volume, tuning,
    and frequency.

  Returns:
  - An in-memory audio sample.

  Example:
  ```sesi
  let kick = sample("kick", {"ms": 300, "vol": 0.9})
  let breakbeat = sample("samples/break.wav")
  ```
*/
export fn sample(type_or_path: string = "kick", options: object = null) -> any {
  return Native.sample(type_or_path, options)
}

/**
  Apply vintage sampler coloration to an audio sample.

  Parameters:
  - `mode`: Converter model: `"mpc60"`, `"mpc3000"`, or `"sp1200"`.
  - `audio`: In-memory audio sample to process.

  Returns:
  - A processed audio sample without modifying the supplied sample.

  Example:
  ```sesi
  let clean_kick = sample("kick")
  let colored_kick = vintage("mpc60", clean_kick)
  ```
*/
export fn vintage(mode: string, audio: object) -> any {
  return Native.vintage(mode, audio)
}

/**
  Define an MPC effect.

  Parameters:
  - `type`: Effect type such as `"filter"`, `"delay"`, `"reverb"`,
    `"compressor"`, `"lofi"`, or `"eq"`.
  - `params`: Effect-specific parameter object.

  Returns:
  - An MPC effect configuration object.

  Example:
  ```sesi
  let delay = effect("delay", {"time_ms": 240, "feedback": 0.35})
  ```
*/
export fn effect(type: string, params: object = null) -> any {
  return Native.effect(type, params)
}

/**
  Define an MPC effect using the short `fx` alias.

  Parameters:
  - `type`: Effect type.
  - `params`: Effect-specific parameter object.

  Returns:
  - An MPC effect configuration object.

  Example:
  ```sesi
  let filter = fx("filter", {"type": "lowpass", "cutoff": 8000})
  ```
*/
export fn fx(type: string, params: object = null) -> any {
  return Native.fx(type, params)
}

/**
  Arrange sequences into an MPC song.

  Parameters:
  - `name`: Song name.
  - `steps`: Array of song steps. Each step may contain `sequence`, `repeats`, and `mutes` fields.

  Returns:
  - An MPC song object.

  Example:
  ```sesi
  let arrangement = song("My Song",
    [{"sequence": verse, "repeats": 2}]
  )
  ```
*/
export fn song(name: string = "MPC Song", steps: array) -> any {
  return Native.song(steps, name)
}

/**
  Render a sequence, song, or audio sample to WAV.

  Parameters:
  - `target`: MPC sequence, song, or in-memory audio sample.
  - `path`: Output WAV path. Use `"memory"` to return audio without writing a
    file.
  - `options`: Optional render settings reserved by the MPC engine.

  Returns:
  - `true` after writing a file, or an audio sample when `path` is `"memory"`.

  Example:
  ```sesi
  let seq = sequence("Render Test", 1, 100, "4/4")
  let audio = render_wav(seq, "memory")
  render_wav(seq, "render-test.wav")
  ```
*/
export fn render_wav(target: object, path: string = "mpc_render.wav", options: object = null) -> any {
  return Native.render_wav(target, path, options)
}

/**
  Render an MPC sequence to a Standard MIDI File.

  Parameters:
  - `target`: MPC sequence to export.
  - `path`: Destination MIDI path.

  Returns:
  - `true` after the MIDI file is written successfully.

  Example:
  ```sesi
  let seq = sequence("MIDI Export", 4, 110, "4/4")
  render_midi(seq, "midi-export.mid")
  ```
*/
export fn render_midi(target: object, path: string = "mpc_sequence.mid") -> bool {
  return Native.render_midi(target, path)
}

/**
  Audition a sequence, song, or audio sample through the system audio device.

  Parameters:
  - `target`: MPC sequence, song, or in-memory audio sample.
  - `options`: Optional playback settings reserved by the MPC engine.

  Returns:
  - `null` after playback completes.

  Example:
  ```sesi
  let snare = sample("snare")
  play(snare)
  ```

  Notes:
  - Playback invokes the platform audio player and requires local mode.
*/
export fn play(target: object, options: object = null) -> any {
  return Native.play(target, options)
}

/**
  Generate a textual representation of a sequence grid.

  Parameters:
  - `size`: Grid size as a string, e.g., `"8x8"`, `"4x8"`, `"4x4"`. Defaults to an 8x2 grid.

  Returns:
  - A string representing the grid with empty steps.

  Example:
  ```sesi
  let grid = sequence_grid("4x4")
  ```

  Notes:
  - The grid is represented as a series of rows with empty steps denoted by `[ ]`.
  - You can use the `pattern_fill` function to fill the grid with a specific pattern.
*/
export fn sequence_grid(size: string = "") -> string {
  if size == "8x8" {
    return "
  [ ][ ][ ][ ][ ][ ][ ][ ]
  [ ][ ][ ][ ][ ][ ][ ][ ]
  [ ][ ][ ][ ][ ][ ][ ][ ]
  [ ][ ][ ][ ][ ][ ][ ][ ]
  [ ][ ][ ][ ][ ][ ][ ][ ]
  [ ][ ][ ][ ][ ][ ][ ][ ]
  [ ][ ][ ][ ][ ][ ][ ][ ]
  [ ][ ][ ][ ][ ][ ][ ][ ]
  "
  }
  if size == "4x8" {
    return "
  [ ][ ][ ][ ][ ][ ][ ][ ]
  [ ][ ][ ][ ][ ][ ][ ][ ]
  [ ][ ][ ][ ][ ][ ][ ][ ]
  [ ][ ][ ][ ][ ][ ][ ][ ]
  "
  }
  if size == "4x4" {
    return "
  [ ][ ][ ][ ]
  [ ][ ][ ][ ]
  [ ][ ][ ][ ]
  [ ][ ][ ][ ]
  "
  }
  if size == "" {
    return "
  [ ][ ][ ][ ][ ][ ][ ][ ]
  [ ][ ][ ][ ][ ][ ][ ][ ]
  "
  }
}

/**
  Fill a sequence grid with a specific pattern based on frequency.

  Parameters:
  - `freq`: Frequency of the pattern. Every `freq`-th step will be filled.
  - `grid`: The textual representation of the sequence grid.

  Returns:
  - A string representing the grid with the pattern applied.

  Example:
  ```sesi
  let grid = sequence_grid("4x4")
  let filled_grid = pattern_fill(2, grid)
  ```
*/
export fn pattern_fill(freq: number, grid: string) -> string {
  if freq == null {
    return grid
  }
  if freq <= 0 {
    return grid
  }

  let parts = grid | split("[ ]")
  if len(parts) <= 1 {
    return grid
  }

  let filled = parts[0]
  for i = 1 to len(parts) {
    let step = i - 1
    if step % freq == 0 {
      filled = filled + "[x]"
    } else {
      filled = filled + "[ ]"
    }
    filled = filled + parts[i]
  }

  return filled
}

/**
  Clear all filled steps in a sequence grid.

  Parameters:
  - `grid`: The textual representation of the sequence grid.

  Returns:
  - A string representing the grid with all steps cleared.

  Example:
  ```sesi
  let grid = "
  [x], [ ], [x], [ ]
  [ ], [x], [ ], [x]
  [x], [ ], [x], [ ]
  [ ], [x], [ ], [x]
  "
  let cleared_grid = pattern_clear(grid)
  ```
*/
export fn pattern_clear(grid: string) -> string {
  return grid | swap("[x]", "[ ]")
}

/**
  Apply a preset pattern to a sequence grid.

  Parameters:
  - `preset`: The name of the preset pattern (e.g., "Hip Hop", "House", "Rock").
  - `grid`: The textual representation of the sequence grid. If null, a default grid will be used.

  Returns:
  - A string representing the grid with the preset pattern applied.

  Example:
  ```sesi
  let grid = sequence_grid("4x4")
  let hip_hop_grid = pattern_preset("House", grid)
  ```
*/
export fn pattern_preset(preset: string = "Hip Hop", grid: string = null) -> string {
  // WIP (feel free to any any)
  if preset == "Hip Hop" || preset == "Rap" || preset == "Boom Bap" {
    return "
  [x][ ][x][ ]
  [ ][ ][x][ ]
  [ ][ ][x][ ]
  [ ][ ][x][ ]
  "
  }
  if preset == "House" {
    return pattern_fill(2, grid)
  }
  if preset == "Rock" {
    return pattern_fill(1, grid)
  }
}