/**
  Reference functions for accessing various documentation files.

  The functions in this file provide easy access to various documentation files, such as README, QUICKSTART, GUIDE, and other specific sections of the documentation.

  Use these for quick file reference or in your AI-assisted development.
*/
allow "helpers/safe" in with {read}
/* Get the contents of the README file. */
export fn getREADME() -> str { return web_get("https://raw.githubusercontent.com/Misterscan/Sesi/refs/heads/main/README.md") }
/* Get the contents of the QUICKSTART file. */
export fn getQUICKSTART() -> str { return web_get("https://raw.githubusercontent.com/Misterscan/Sesi/refs/heads/main/QUICKSTART.md") }
/* Get the contents of the GUIDE file. */
export fn getGUIDE() -> any { return read("GUIDE.md") || web_get("https://raw.githubusercontent.com/Misterscan/Sesi/refs/heads/main/GUIDE.md") }
/**
  Get the contents of all documentation files in the "docs" directory, excluding certain files.

  Returns:
  - An array of objects containing the filename and contents of each documentation file.
*/
export fn getDocs() -> array<str> {
  let docDir = "docs/"
  let docs = []
  let docFiles = ""
  try { docFiles = list_dir(docDir) }
  catch (e) { docFiles = ["https://raw.githubusercontent.com/Misterscan/Sesi/refs/heads/main/docs/"] }
  let contents = ""
  if docFiles | is_array {
    for file in docFiles {
      if (file | get_ext) == "md" {
        if file == "BUILDING_SESIRA.md" || file == "ffmpeg-cheatsheet.md" { continue }
        contents = read(docDir + file)
        docs | push({filename: file, contents: contents})
      }
    }
  } else {
    let names = ["ARCHITECTURE.md", "BUILTINS.md", "CLI.md", "COMPARISON.md", "IMAGE_GENERATION.md", "LOCAL_MODELS.md", "REASONING.md", "REGEX.md", "ROADMAP.md", "SPECIFICATION.md", "VIDEO_GENERATION.md", "WRITING_SCRIPTS.md"]
    for name in names { docs | push({filename: docFiles + name, contents: web_get(docFiles + name)}) }
  }
  return docs
}
/**
  Get the contents of all documentation files in the "getting-started" directory, including optional files.

  Returns:
  - An array of objects containing the filename and contents of each documentation file.
*/
export fn getGettingStarted() -> array<str> {
  let mainDir = "getting-started/"
  let optDir = mainDir + "optional/"
  let docs = []
  let mainFiles = ""
  let optFiles = ""
  try {
    mainFiles = list_dir(mainDir)
    optFiles = list_dir(optDir)
  } catch {}
  let contents = ""
  if (mainFiles | is_array) && (optFiles | is_array) {
    for file in mainFiles {
      if (file | get_ext) == "md" {
        contents = read(mainDir + file)
        docs | push({filename: file, contents: contents})
      }
    }
    for file in optFiles {
      contents = read(optDir + file)
      docs | push({filename: file, contents: contents})
    }
  } else {
    mainFiles = "https://raw.githubusercontent.com/Misterscan/Sesi/refs/heads/main/getting-started/"
    optFiles = "https://raw.githubusercontent.com/Misterscan/Sesi/refs/heads/main/getting-started/optional/"
    let names = ["AUDIO.md", "CONDITIONALS.md", "DATABASE.md", "FILE-IO.md", "FUNCTIONS.md", "GAME.md", "LOOPS.md", "MAKE.md", "MODULES.md", "NETWORK.md", "PROMPTS.md", "PYTHON-IN-SESI.md", "SVG-AND-PIXELS.md", "TTS.md", "VARIABLES.md", "VIDEO.md"]
    for name in names { docs | push({filename: mainFiles + name, contents: web_get(mainFiles + name)}) }
    docs | push({filename: optFiles + "CONFIG.md", contents: web_get(optFiles + "CONFIG.md")})
  }
  return docs
}
let docs = getDocs()
