/*
  Sesi command-line tutorial

  Start:  npm run tutorial
  Set name: npm run tutorial name <your-name>
  Narrate: npm run tutorial narrate
  Move:   npm run tutorial next
  Review: npm run tutorial back
  Index:  npm run tutorial list
  Reset:  npm run tutorial reset
*/
allow "helpers/safe" in as safe
allow "lib/ansi" in as TERM

// File to track tutorial progress.
let PROGRESS_FILE = "tutorial/.sesi_tutorial_progress"
// Accessibility setting for the tutorial. Default is `false`/`n`.
let accessibility = false
if is_null(accessibility) || accessibility == "" || accessibility == false { accessibility = "n" }
// Derived boolean flag for enabling accessibility features.
let enableAccessibility = ""

/**
  List of tutorial lessons with their titles, learning points, examples, and challenges.

  Fields:
  - title: The title of the lesson.
  - learn: A list of key learning points.
  - example: A code snippet demonstrating the lesson.
  - challenge: A task for the user to complete.

  Each lesson is represented as an object with the above fields.
*/
let lessons = [
  {
    "title": "Run your first program",
    "learn": [
      "A Sesi file is a sequence of statements.",
      "Newlines normally end statements; semicolons are useful for inline code.",
      "show accepts multiple values and inserts spaces between them."
    ],
    "example": "show \"Hello from Sesi!\"
show \"The answer is:\" 6 * 7",
    "challenge": "Create hello.sesi, show your name and a number, then run: sesi   hello.sesi"
  },
  {
    "title": "Values and variables",
    "learn": [
      "Use let once when declaring a binding.",
      "Reassign later without repeating let.",
      "Core values include numbers, strings, booleans, null, arrays, and objects."
    ],
    "example": "let quantity = 4
let price = 12.5
let total = quantity * price
let expensive = total > 40
show \"Total:\" total
show \"Expensive?\" expensive",
    "challenge": "Change quantity and price, then use type(total) to confirm the computed value is a number."
  },
  {
    "title": "Collections and JSON",
    "learn": [
      "Arrays are ordered and zero-indexed.",
      "Objects store values under named keys.",
      "to_json and from_json cross the text/data boundary."
    ],
    "example": "let stages = [\"lint\", \"test\"]
push(stages, \"build\")
let project = {name: \"Sesi\", ready: true}
show join(stages, \" -> \")
show project.name project.ready",
    "challenge": "Add a version key to project and show every key by looping over keys(project)."
  },
  {
    "title": "Conditionals and loops",
    "learn": [
      "if, else if, and else branch on ordinary expressions.",
      "for item in array iterates values.",
      "Numeric for ranges exclude the right boundary; break and continue control a loop."
    ],
    "example": "let total = 0
for n in [1, 2, 3, 4, 5] {
  if n % 2 == 0 {
    continue
  }
  total = total + n
}
show \"Odd total:\" total",
    "challenge": "Change the loop to total only even numbers. The result should be 6."
  },
  {
    "title": "Functions and types",
    "learn": [
      "Declare reusable behavior with fn.",
      "return sends a value back to the caller.",
      "Parameter types, return types, and default values communicate a function's contract."
    ],
    "example": "fn greet(name: string, punctuation: string = \"!\") -> string {
  return \"Hello, \" + name + punctuation
}
show greet(\"Ada\")
show greet(\"Sesi\", \".\")",
    "challenge": "Write a typed area(width, height) function and call it with 6 and 7."
  },
  {
    "title": "Functions as data and pipelines",
    "learn": [
      "map transforms, filter selects, reduce combines, and find locates.",
      "These helpers receive functions as callback values.",
      "The pipe operator passes the left result as the next function's first argument.",
      "Use | for data pipelines 'arrays, strings, objects, or multi-step transformations' and () for standard syntax."
    ],
    "example": "fn add(a, b) { return a + b }
fn multiply(a, b) { return a * b }
let piped = 10 | add(5) | multiply(2)
show piped

fn double(n) { return n * 2 }
show map([1, 2, 3], double)",
    "challenge": "Filter [1, 2, 3, 4] to even values, double them, and reduce them to 12."
  },
  {
    "title": "Errors and cleanup",
    "learn": [
      "Wrap failure-prone work in try and catch.",
      "raise_error can attach a type, message, and structured data.",
      "finally runs for success, failure, and early return paths."
    ],
    "example": "try {
  raise_error(\"ValidationError\", \"Missing name\", {field: \"name\"})
} catch (err) {
  show err.type err.data.field
} finally {
  show \"Validation finished\"
}",
    "challenge": "Raise a ValidationError when a quantity is negative and show a useful message from catch."
  },
  {
    "title": "Files and modules",
    "learn": [
      "read_file, write_file, list_dir, archive, rename, and trash cover common filesystem work.",
      "Safe mode restricts paths to approved directories.",
      "allow loads standard or local modules as named bindings or a namespace."
    ],
    "example": "allow \"std/math\" in with Math
let record = {name: \"Sesi\", power: Math.pow(2, 5)}
write_file(\"tutorial/.cli_example.json\", to_json(record))
let loaded = \"tutorial/.cli_example.json\" | read_file | from_json
show loaded.name loaded.power
trash(\"tutorial/.cli_example.json\", true)",
    "challenge": "Save an array as JSON, load it back, show its length, and remove only the temporary file you created."
  },
  {
    "title": "Arguments and the CLI",
    "learn": [
      "Arguments after a script name appear in the global args array.",
      "Validate len(args) before indexing.",
      "--tokens and --ast expose how Sesi reads a program; -e evaluates inline code."
    ],
    "example": "let name = \"Developer\"
if len(args) > 0 {
  name = args[0]
}
show \"Hello,\" name \"!\"",
    "challenge": "Save the example as greet.sesi, then run: sesi   greet.sesi Ada"
  },
  {
    "title": "Optional reasoning",
    "learn": [
      "Sesi is a general-purpose language; model calls are optional.",
      "prompt blocks are useful string templates with or without AI.",
      "Keep model work explicit, handle errors, and validate structured results."
    ],
    "example": "let topic = \"small, testable functions\"
prompt request {\"Explain in two short sentences:\" topic}
try {
  let answer = model(\"gemini-3-flash-preview\") {thinkingLevel: \"low\"} {request}
  show answer
} catch (err) {
  show \"Optional model call unavailable\"
}",
    "challenge": "First use a prompt block in a normal show statement. Only run model() if GEMINI_API_KEY is configured."
  }
]

/**
  Loads the saved tutorial progress from a JSON file. 
  
  Returns:
  An object with the current step, user name, and completion status.
*/
fn load_progress() {
  try {
    let saved = PROGRESS_FILE + ".json" | safe.read | from_json
    if type(saved) == "object" { return saved }
  } catch (err) { /* A missing or invalid progress file simply starts a new course. */ }
  return {step: 0, name: "Developer", complete: false}
}

/**
  Saves the current tutorial progress to a JSON file.
  Accepts an object with the current step, user name, and completion status.
*/
fn save_progress(progress) {
  try { safe.json(PROGRESS_FILE, progress) }
  catch (err) {
    TERM.warning("Warning: tutorial progress could not be saved.")
    TERM.error(err)
  }
}

/**
  Displays the help information for the tutorial commands.
  Prompts the user to enable accessibility features (text-to-speech).
*/
fn show_help() {
  TERM.header("Commands:")
  TERM.info("  npm run tutorial: narrate    Read the lesson aloud (accessibility)")
  TERM.info("  npm run tutorial: next       Go to the next lesson")
  TERM.info("  npm run tutorial: back       Review the previous lesson")
  TERM.info("  npm run tutorial: list       Show the course index")
  TERM.info("  npm run tutorial: name Ada   Personalize the greeting")
  TERM.info("  npm run tutorial: reset      Clear saved progress")
  show ""
  TERM.info("For the full interactive course, run: npm run tutorial")
  accessibility = input("Enable accessibility features (text-to-speech) (y/n, default: n): ")
  enableAccessibility = accessibility == "y" || accessibility == "Y"
  if enableAccessibility {
    speech("Commands:
  npm run tutorial:   narrate,    Read the lesson aloud (accessibility)
  npm run tutorial:   next,       Go to the next lesson
  npm run tutorial:   back,      Review the previous lesson
  npm run tutorial:   list,       Show the course index
  npm run tutorial:   name Ada,   Personalize the greeting
  npm run tutorial:   reset,      Clear saved progress
For the full interactive course, run: npm run tutorial")
  }
}

/**
  Displays the course index with the current progress.

  Parameters:
  - progress: An object with the current step, user name, and completion status.

  Returns:
  None. This function only displays the course index.
*/
fn show_index(progress) {
  accessibility = input("Enable accessibility features (text-to-speech) (y/n, default: n): ")
  enableAccessibility = accessibility == "y" || accessibility == "Y"
  show ""
  TERM.header("Sesi CLI Tutorial — Course Index")
  TERM.divider("-", 65)
  if enableAccessibility { speech("Sey-see   tutorial. Course index.") }
  for i = 0 to len(lessons) {
    let marker = " "
    if i < progress.step || progress.complete {
      marker = "✓"
    } else if i == progress.step {
      marker = "→"
    }
    TERM.info(marker + str(i + 1) + "." + lessons[i].title)
  }
  show ""
  show_help()
}

/**
  Displays the current lesson with its title, learning objectives, example, and practice challenge.

  Parameters:
  - progress: An object with the current step, user name, and completion status.

  Returns:
  None. This function only displays the current lesson.
*/
fn show_lesson(progress) {
  let index = progress.step
  // Current lesson index.
  let lesson = lessons[index]
  enableAccessibility = accessibility == "y" || accessibility == "Y" || accessibility == true

  show ""
  TERM.header("SESI CLI TUTORIAL · LESSON " + str(index + 1) + " OF " + str(len(lessons)))
  if enableAccessibility {
    speech("Sey-see   tutorial. Lesson " + str(index + 1) + " of " + str(len(lessons)) + ".")
  }
  show ""
  TERM.info(lesson.title)
  show ""
  TERM.info("What you will learn")
  if enableAccessibility {
    speech(lesson.title + ". What you will learn:")
  }
  for item in lesson.learn {
    show "  • " + item
    if enableAccessibility {
      if contains(item, "Sesi") || contains(item, "sesi") {
        let accessSesi = swap(item, "Sesi", "sey-see")
        accessSesi = swap(accessSesi, "sesi", "sey-see")
        speech(accessSesi)
      } else {
        speech(item)
      }
    }
  }
  show ""
  TERM.info("Example")
  TERM.divider("-", 65)
  show lesson.example
  if enableAccessibility {
    if contains(lesson.example, "--") {
      let accessExample = swap(lesson.example, "--", "dash dash ")
      speech("Example: " + accessExample)
    } else if contains(lesson.example, "sesi") || contains(lesson.example, "Sesi") {
      let accessSesi = swap(lesson.example, "sesi", "sey-see")
      accessSesi = swap(accessSesi, "Sesi", "sey-see")
      speech("Example: " + accessSesi)
    } else {speech("Example: " + lesson.example)}
  }
  TERM.divider("-", 65)
  show ""
  TERM.info("Practice")
  TERM.box(lesson.challenge)
  if enableAccessibility {
    if contains(lesson.challenge, "--") {
      let accessExample = swap(lesson.challenge, "--", "dash dash ")
      speech("Practice: " + accessExample)
    } else if contains(lesson.challenge, "sesi") || contains(lesson.challenge, "Sesi") {
      let accessSesi = swap(lesson.challenge, "sesi", "sey-see")
      accessSesi = swap(accessSesi, "Sesi", "sey-see")
      speech("Practice: " + accessSesi)
    } else {speech("Practice: " + lesson.challenge)}
  }
  show ""

  if index == len(lessons) - 1 {
    TERM.warning("This is the final lesson.")
    TERM.info("Run 'npm run tutorial:cli next' to mark the course complete.")
    if enableAccessibility {
      speech("This is the final lesson. Run 'npm run tutorial see el eye next' to mark the course complete.")
    }
  } else {
    TERM.info("Continue: npm run tutorial:cli next")
    if enableAccessibility {
      speech("Continue: npm run tutorial see el eye next")
    }
  }
  TERM.info("Auto-narrate: npm run tutorial:cli narrate")
  TERM.info("Review:       npm run tutorial:cli back")
  TERM.info("Index:        npm run tutorial:cli list")
}

// Current progress object.
let progress = load_progress()

// Command entered by the user.
let command = ""
if len(args) > 0 { command = args[0] }
if progress.step < 0 { progress.step = 0 }
if progress.step >= len(lessons) { progress.step = len(lessons) - 1 }

if command == "reset" {
  progress = {step: 0, name: "Developer", complete: false}
  save_progress(progress)
  TERM.success("Tutorial progress reset.")
  if enableAccessibility { speech("Tutorial progress reset.") }
  show_lesson(progress)
} else if command == "name" {
  if len(args) < 2 {
    TERM.info("Usage: npm run tutorial:cli name <your-name>")
    if enableAccessibility { speech("Usage: npm run tutorial see el eye name `your name`.") }
  } else {
    progress["name"] = args[1]
    save_progress(progress)
    TERM.success("Welcome, " + progress.name + ".")
    if enableAccessibility { speech("Welcome, " + progress.name + ".") }
    show_lesson(progress)
  }
} else if command == "next" {
  if progress.step < len(lessons) - 1 {
    progress.step = progress.step + 1
    save_progress(progress)
    show_lesson(progress)
  } else {
    progress.complete = true
    save_progress(progress)
    show ""
    TERM.success("Course complete — well done, " + progress.name + "!")
    TERM.info("You now have the core tools to build grounded Sesi scripts")
    TERM.warning("Add reasoning only when a problem benefits from it!")
    if enableAccessibility { speech("Course complete. Well done, " + progress.name + "! You now have the core tools to build grounded sey-see scripts and add reasoning only when a problem benefits from it.") }
    show ""
    TERM.info("Open the practice lab: npm run tutorial")
    TERM.info("Browse more examples: examples/main/")
    TERM.info("Restart this course: npm run tutorial:cli reset")
  }
} else if command == "back" {
  if progress.step > 0 {
    progress.step = progress.step - 1
    progress.complete = false
    save_progress(progress)
  }
  show_lesson(progress)
} else if command == "list" { show_index(progress)
} else if command == "help" { show_help()
} else if command == "" {
  show ""
  TERM.success("Welcome, " + progress["name"] + ".")
  TERM.info("This ten-lesson path teaches Sesi from first principles.")
  if enableAccessibility { speech("Welcome, " + progress.name + ". This ten-lesson path teaches Sesi from first principles.") }
  show_lesson(progress)
} else if command == "narrate" {
  accessibility = true
  enableAccessibility = true
  if progress["step"] < len(lessons) - 1 {
    progress["step"] = progress["step"] + 1
    save_progress(progress)
    show_lesson(progress)
  } else {
    progress["complete"] = true
    save_progress(progress)
    show ""
    TERM.success("Course complete — well done, " + progress.name + "!")
    TERM.info("You now have the core tools to build grounded Sesi scripts")
    TERM.info("and add reasoning only when a problem benefits from it.")
    if enableAccessibility { speech("Course complete. Well done, " + progress.name + "! You now have the core tools to build grounded sey-see scripts and add reasoning only when a problem benefits from it.") }
    show ""
    TERM.info("Open the practice lab: npm run tutorial")
    TERM.info("Browse more examples: examples/main/")
    TERM.info("Restart this course: npm run tutorial:cli reset")
  }
} else {
  TERM.error("Unknown tutorial command: " + command)
  if enableAccessibility { speech("Sorry, don't recognize this command: " + command) }
  show_help()
}