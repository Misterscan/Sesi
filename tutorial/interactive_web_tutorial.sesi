/*
  Sesi interactive tutorial server

  Start it from the repository root:
    npm run tutorial

  The browser sends code to POST /run. Each request is written to a uniquely
  named file, checked by Sesi, executed in safe mode, and then deleted.
*/
allow "shell-automation" in with {run_sesi}
allow "std/time" in with {sleep}
allow "helpers/safe" in as safe
allow "lib/ansi" in as TERM
allow "lib/env" in with {DEV_PORT, LOCAL_HOST}

// Port on which the tutorial server will listen.
let PORT = DEV_PORT
let HOST = LOCAL_HOST
// Path to the frontend HTML file for the tutorial.
let FRONTEND = "tutorial/tutorial_frontend.html"
// Maximum length of the code that can be submitted in the tutorial.
let MAX_CODE_LENGTH = 50000

/**
  Returns a JSON response with the given status and payload.

  Parameters:
  - status: HTTP status code.
  - payload: Object to be converted to JSON and sent as the response body.

  Returns:
  A JSON response object.
*/
fn json_response(status, payload) {
  return {
    status: status,
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "no-store"
    },
    body: to_json(payload)
  }
}

/**
  Handles incoming HTTP requests for the tutorial server.

  Supports the following endpoints:
  - `GET /`: Serves the tutorial frontend HTML.
  - `GET /health`: Returns a simple health check JSON response.
  - `POST /run`: Executes submitted Sesi code and returns the output as JSON.

  Parameters:
  - req: The HTTP request object.

  Returns:
  An HTTP response object.
*/
fn handleRequest(req) {
  if req.method == "GET" && req.path == "/" {
    try {
      return {
        status: 200,
        headers: {
          "Content-Type": "text/html; charset=utf-8",
          "Cache-Control": "no-store",
          "X-Content-Type-Options": "nosniff"
        },
        body: safe.read(FRONTEND)
      }
    } catch (err) {
      return {
        status: 500,
        headers: {"Content-Type": "text/plain; charset=utf-8"},
        body: "Could not load tutorial/tutorial_frontend.html.\n" + str(err)
      }
    }
  }
  if req.method == "GET" && req.path == "/styles.css" {
    try {
      return {
        status: 200,
        headers: {
          "Content-Type": "text/css; charset=utf-8",
          "Cache-Control": "no-store",
          "X-Content-Type-Options": "nosniff"
        },
        body: safe.read("tutorial/styles.css")
      }
    } catch (err) {
      return {
        status: 500,
        headers: {"Content-Type": "text/plain; charset=utf-8"},
        body: "Could not load tutorial/styles.css.\n" + str(err)
      }
    }
  }
  if req.method == "GET" && req.path == "/tutorial.js" {
    try {
      return {
        status: 200,
        headers: {
          "Content-Type": "application/javascript; charset=utf-8",
          "Cache-Control": "no-store",
          "X-Content-Type-Options": "nosniff"
        },
        body: safe.read("tutorial/tutorial.js")
      }
    } catch (err) {
      return {
        status: 500,
        headers: {"Content-Type": "text/plain; charset=utf-8"},
        body: "Could not load tutorial/tutorial.js.\n" + str(err)
      }
    }
  }
  if req.method == "POST" && req.path == "/run" {
    let temp_file = null
    let response = null
    try {
      let payload = from_json(req.body)
      let code = payload.code
      if type(code) != "string" { return json_response(400, {error: "The request must include a string field named 'code'."}) }
      if len(trim(code)) == 0 { return json_response(400, {error: "Write some Sesi code before running the lesson."}) }
      if len(code) > MAX_CODE_LENGTH { return json_response(413, {"error": "Code is limited to 50,000 characters in the tutorial."}) }
      temp_file = "tutorial/.tmp_run_" + str(time()) + ".sesi"
      safe.write(temp_file, code)
      run_sesi(temp_file, false, true)
      let out = run("sesi " + temp_file)
      response = json_response(200, {output: out})
    } catch (err) { response = json_response(200, {error: str(err)}) }
    if temp_file != null {
      try { safe.remove(temp_file) } 
      catch (cleanup_error) {}
    }
    return response
  }
  if req.method == "GET" && req.path == "/health" { return json_response(200, {ok: true, service: "sesi-tutorial"}) }
  return json_response(404, {error: "Not found"})
}

let server = listen(PORT, handleRequest)
TERM.header("Sesi Learning Lab is starting...")
sleep(500)
TERM.box("Online!")
try { open(HOST) } 
catch (e) { TERM.error("Could not automatically open browser. Please visit " + HOST) }
TERM.info("Press Enter anytime to stop the server...\n")
let end = input("")
server.close(end)